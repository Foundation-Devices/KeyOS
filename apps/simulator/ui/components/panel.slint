import { Theme } from "theme.slint";

// Panel — the neumorphic section container (gradient surface + gradient
// border + drop shadow). The inner layout is supplied by the caller via
// `@children`, so panels can be a single inline row or a header + body.
export component Panel inherits Rectangle {
    in property <bool> is-dark: true;
    in property <brush> surface-brush: Theme.panel-surface(root.is-dark);
    in property <brush> border-brush: Theme.panel-border(root.is-dark);
    in property <length> stroke-width: 1px;
    in property <length> corner-radius: 11.2px;

    border-radius: root.corner-radius;
    border-width: root.stroke-width;
    border-color: root.border-brush;
    background: root.surface-brush;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 12px;
    drop-shadow-color: Theme.panel-shadow(root.is-dark);
    clip: true;

    @children
}

// PanelHeading — the section title text style (e.g. "Theme", "Scale").
export component PanelHeading inherits Text {
    in property <bool> is-dark: true;

    color: Theme.heading(root.is-dark);
    font-family: Theme.font-primary;
    font-size: 20px;
    font-weight: 500;
    vertical-alignment: center;
    horizontal-alignment: left;
}

// PanelDivider — engraved hairline: a dark line over a light one.
export component PanelDivider inherits Rectangle {
    in property <bool> is-dark: true;

    height: 1.4px;

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 0.7px;
            background: Theme.divider-dark-line(root.is-dark);
        }

        Rectangle {
            height: 0.7px;
            background: Theme.divider-light-line(root.is-dark);
        }
    }
}
