import { ControlPanel } from "components/control_panel.slint";

@rust-attr(derive(serde::Serialize, serde::Deserialize))
struct Settings {
    scale: float,
}

export component MainWindow inherits Window {
    title: "Passport Simulator Control Panel";

    in-out property <Settings> settings: { scale: 1.0 };
    in-out property <bool> capture-entire-device: false;
    in-out property <bool> is-dark-theme: false;

    callback screenshot(bool);
    callback record(bool);
    callback stop();
    callback scale-set(float);
    callback theme-set(bool);

    // The window sizes to the control panel's content (see ControlPanel's
    // preferred-*), keeping the 24px padding symmetric on all sides.
    width: 494px;

    cp := ControlPanel {
        width: parent.width;

        // Map the simulator's state onto the panel's 0-based selections.
        theme-index: root.is-dark-theme ? 1 : 0;
        scale-index: root.settings.scale == 0.5 ? 0 : root.settings.scale == 1.5 ? 2 : root.settings.scale == 2.0 ? 3 : 1;
        capture-index: root.capture-entire-device ? 1 : 0;

        theme-changed(i) => {
            root.is-dark-theme = (i == 1);
            root.theme-set(i == 1);
        }
        scale-changed(i) => {
            root.scale-set(i == 0 ? 0.5 : i == 2 ? 1.5 : i == 3 ? 2.0 : 1.0);
        }
        capture-changed(i) => {
            root.capture-entire-device = (i == 1);
        }
        screenshot() => {
            root.screenshot(root.capture-entire-device);
        }
        // ControlPanel toggles its own `recording` before firing this, so
        // `cp.recording` already reflects the new state.
        record() => {
            if (cp.recording) {
                root.record(root.capture-entire-device);
            } else {
                root.stop();
            }
        }
    }
}
