import {
    BasePage,
    Button,
    TextSm,
    PageBody,
    ButtonSection,
    ContentSection,
    MenuSection,
    MenuSectionLayout,
    MenuItemLayout,
    ItemTextPreview,
    NavHeader,
    TitledInput,
} from "@ui/widgets.slint";
import { ApplyPassphrase } from "@ui/pages.slint";
import { Importance, Palette } from "@ui/theme.slint";
import { TR2, TrId } from "../../gen/tr.slint";

import { Navigate } from "../../gen/navigate.slint";
import {
    EnterPassphrase,
    EnterPassphraseState,
} from "../../enter-passphrase.slint";
import { CreateAccount } from "../../create-account.slint";
import { Settings } from "../../settings.slint";

component ApplyPage inherits Rectangle {
    property <string> new-label;
    property <string> label-message;
    property <bool> label-valid: new-label != "" && label-message == "";

    ApplyPassphrase {
        strings: {
            warning-header: TR2.lookup(TrId.PassphraseModalHeader),
            warning-content: TR2.lookup(TrId.PassphraseModalContent),
            warning-dismiss: TR2.lookup(TrId.CommonButtonDontShowAgain),
            warning-confirm: TR2.lookup(TrId.CommonButtonConfirm),
            enter-title: TR2.lookup(TrId.EnterPassphraseTitle),
            enter-content: TR2.lookup(TrId.EnterPassphraseContent),
            enter-filler: TR2.lookup(TrId.EnterPassphraseFillerText),
            enter-apply: TR2.lookup(TrId.CommonButtonApply),
            details-title: TR2.lookup(TrId.PassphraseDetailsTitle),
            details-header: TR2.lookup(TrId.PassphraseDetailsDetails),
            details-passphrase: TR2.lookup(TrId.ConfirmPassphrasePassphrase),
            details-fingerprint: TR2.lookup(TrId.ConfirmPassphraseFingerprint),
            details-content: TR2.lookup(TrId.ConfirmPassphraseContent),
            details-confirm: TR2.lookup(TrId.CommonButtonConfirm),
        };
        warning-enabled: Settings.show-passphrase-warning;
        passphrase <=> EnterPassphrase.passphrase;
        fingerprint: EnterPassphrase.fingerprint;
        fingerprint-loading: EnterPassphrase.fingerprint-loading;
        confirm-enabled: !EnterPassphrase.no-accounts || label-valid;

        warning-toggled => {
            Settings.set-show-passphrase-warning(!Settings.show-passphrase-warning);
        }

        try(passphrase) => {
            new-label = "";
            label-message = "";
            EnterPassphrase.try(passphrase);
        }

        confirm(passphrase) => {
            EnterPassphrase.slider-index = 1;
            if (new-label != "") {
                EnterPassphrase.create-initial-account(new-label);
            } else {
                EnterPassphrase.confirm(passphrase);
            }
        }

        back => {
            EnterPassphrase.clear-state();
            Navigate.backward();
        }

        if EnterPassphrase.no-accounts: TitledInput {
            title: TR2.lookup(TrId.ConfirmPassphraseLabelAccount0);
            placeholder: TR2.lookup(TrId.CreateAccountLabelFillerText);
            text <=> root.new-label;
            message: root.label-message;
            has-notice: !root.label-valid;
            caps-mode: sentences;

            edited(text) => {
                root.label-message = CreateAccount.validate-new-label(text);
            }
        }

        if EnterPassphrase.no-accounts: TextSm {
            text: TR2.lookup(TrId.ConfirmPassphraseLabelExplainer);
            horizontal-alignment: TextHorizontalAlignment.center;
            color: Palette.content-tertiary;
        }
    }
}

component ClearPage inherits BasePage {
    VerticalLayout {
        NavHeader {
            title: TR2.lookup(TrId.PassphraseDetailsTitle);
            clicked => {
                Navigate.backward();
            }
        }

        PageBody {
            ContentSection {
                MenuSection {
                    title: TR2.lookup(TrId.PassphraseDetailsDetails);
                    MenuSectionLayout {
                        MenuItemLayout {
                            first: true;
                            last: true;
                            label: TR2.lookup(TrId.ConfirmPassphraseFingerprint);
                            ItemTextPreview {
                                text: EnterPassphrase.fingerprint;
                            }
                        }
                    }
                }

                TextSm {
                    text: TR2.lookup(TrId.ConfirmPassphraseContent);
                    horizontal-alignment: TextHorizontalAlignment.center;
                    color: Palette.content-tertiary;
                }
            }

            ButtonSection {
                Button {
                    icon: "shield-x";
                    label: TR2.lookup(TrId.PassphraseDetailsClearPassphrase);
                    importance: Importance.primary;

                    clicked => {
                        EnterPassphrase.clear-state();
                        EnterPassphrase.clear-passphrase();
                        EnterPassphrase.state = EnterPassphraseState.Idle;
                        Navigate.backward();
                    }
                }
            }
        }
    }
}

export component EnterPassphrasePage inherits Rectangle {
    if EnterPassphrase.state != EnterPassphraseState.Clear: ApplyPage { }
    if EnterPassphrase.state == EnterPassphraseState.Clear: ClearPage { }
}
