import { Callbacks as CB } from "../../callbacks.slint";
import { SeedView, SeedViewType } from "../../types.slint";
import {
    Palette,
    Size,
    Importance,
    CallbackResult,
    ResultLevel,
    Utils,
} from "@ui/theme.slint";
import {
    IconButton,
    AppHeader,
    BasePage,
    PageBody,
    ScrollBody,
    ContentSection,
    ErrorModal,
    Dropdown,
    DropdownOverlay,
    TitledInput,
    ButtonSection,
    Button,
    TextMd,
    ShowHide,
    Link,
    QrOverlay,
} from "@ui/widgets.slint";
import { CreateProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { TR2, TrId } from "../../gen/tr.slint";

export component CreatePage inherits BasePage {
    in property <CreateProps> props;

    property <SeedView> new-seed;
    property <CallbackResult> result: { level: ResultLevel.info, success: true, text: "", title: "" };
    property <bool> has-errors: type-picker.selected-index == -1 || label-error || (CB.index-required(new-seed.seed-type) && index-error) || (new-seed.seed-type == SeedViewType.password-generated && length-error);
    property <bool> label-error: true;
    property <string> index-message: "";
    property <bool> index-error: index-message != "";
    property <string> next-available-index: "";
    property <string> password-length: "21";
    property <bool> length-error: false;
    property <string> learn-more-url: "";

    property <bool> index-input-has-focus: false;
    property <bool> length-input-has-focus: false;
    property <bool> generated-inputs-have-focus: index-input-has-focus || length-input-has-focus;

    // Trigger auto-scroll when index/length inputs gain focus
    changed generated-inputs-have-focus => {
        if (generated-inputs-have-focus && new-seed.seed-type == SeedViewType.password-generated) {
            content-scroll.viewport-y = -350px;
        }
    }

    property <[SeedViewType]> seed-view-types: [
        SeedViewType.bitcoin-12,
        SeedViewType.bitcoin-24,
        SeedViewType.password-generated,
        SeedViewType.nostr-key,
    ];

    pure function index-to-seed-view-type(index: int) -> SeedViewType {
        if (index < 0 || index >= seed-view-types.length) {
            return SeedViewType.bitcoin-12;
        }
        return seed-view-types[index];
    }

    VerticalLayout {
        AppHeader {
            title: TR2.lookup(TrId.CreateItemTitle);

            IconButton {
                icon: "chevron-left";
                size: Size.sz8;
                importance: Importance.normal;
                clicked => {
                    Navigate.backward();
                }
            }
        }

        PageBody {
            p-x: Size.sz4;
            p-y: Size.sz4;

            content-scroll := ScrollBody {
                p-x: Size.zero;
                p-y: Size.zero;

                ContentSection {
                    type-picker := Dropdown {
                        title: TR2.lookup(TrId.CreateItemType);
                        placeholder: TR2.lookup(TrId.CreateItemTypeTextFiller);
                        model: [
                            {
                                label: CB.get-seed-name(SeedViewType.bitcoin-12),
                                value: "bitcoin-12",
                                icon: "acorn",
                            },
                            {
                                label: CB.get-seed-name(SeedViewType.bitcoin-24),
                                value: "bitcoin-24",
                                icon: "acorn",
                            },
                            {
                                label: CB.get-seed-name(SeedViewType.password-generated),
                                value: "password-generated",
                                icon: "pin",
                            },
                            {
                                label: CB.get-seed-name(SeedViewType.nostr-key),
                                value: "nostr-key",
                                icon: "nostr",
                            },
                        ];

                        changed(index, value) => {
                            new-seed.seed-type = index-to-seed-view-type(index);
                        }
                    }

                    if type-picker.selected-index != -1: TitledInput {
                        title: TR2.lookup(TrId.CreateItemItemLabel);
                        placeholder: CB.item-label-filler-text(new-seed.seed-type);
                        text: new-seed.label;
                        message: TR2.lookup(TrId.CreateItemSeedErrorsMissingField);
                        has-notice: self.message != "";
                        caps-mode: sentences;

                        edited(text) => {
                            new-seed.label = text;
                            self.message = CB.validate-new-label(text);
                            self.has-notice = self.message != "";
                            label-error = self.has-notice;
                        }
                    }

                    if (type-picker.selected-index != -1 && new-seed.seed-type == SeedViewType.password-generated): TitledInput {
                        title: TR2.lookup(TrId.CreateItemAccount);
                        placeholder: TR2.lookup(TrId.CreateItemAccountFillerText);
                        text: new-seed.password.account;
                        caps-mode: sentences;

                        edited(text) => {
                            new-seed.password.account = text;
                        }
                    }

                    if (type-picker.selected-index != -1 && new-seed.seed-type == SeedViewType.password-generated): TitledInput {
                        title: TR2.lookup(TrId.CreateItemPassword);
                        placeholder: TR2.lookup(TrId.CreateItemPasswordFillerText);
                        text: new-seed.password.password;
                        has-notice: self.text == "";
                        show-password: false;
                        input-type: InputType.password;
                        locked: true;
                    }

                    if (type-picker.selected-index != -1 && CB.index-required(new-seed.seed-type)): ShowHide {
                        text: TR2.lookup(TrId.CreateItemAdvancedOptions);

                        VerticalLayout {
                            spacing: Size.sz6;
                            padding-bottom: Size.sz6;

                            TitledInput {
                                title: TR2.lookup(TrId.CreateItemIndex);
                                text: new-seed.indexed-seed.index;
                                message: index-message;
                                has-notice: self.message != "" || self.text == "";
                                input-type: InputType.number;
                                bounded-number: true;
                                minimum: "0";
                                maximum: "2147483647";  // BIP32 hardened indices use bit 31 as flag, so max is 2^31-1

                                changed has-focus => {
                                    index-input-has-focus = self.has-focus;
                                }

                                edited(text) => {
                                    new-seed.indexed-seed.index = text;

                                    if (new-seed.seed-type == SeedViewType.password-generated) {
                                        new-seed.password.password = CB.generate-password(text, password-length);
                                    }
                                    self.message = CB.validate-new-index(new-seed.indexed-seed.index, new-seed.seed-type);
                                    self.has-notice = self.message != "" || text == "";  // TODO: maybe add error copy for empty index, it's unlikely though
                                    index-error = self.has-notice;
                                }

                                accepted(text) => {
                                    if (text == "") {
                                        self.text = next-available-index;
                                        self.edited(self.text);
                                    }
                                }
                            }

                            if (new-seed.seed-type == SeedViewType.password-generated): TitledInput {
                                title: TR2.lookup(TrId.CreateItemLength);
                                text: password-length;
                                has-notice: self.text == "";
                                input-type: InputType.number;
                                bounded-number: true;
                                minimum: "10";
                                maximum: "80";

                                changed has-focus => {
                                    length-input-has-focus = self.has-focus;
                                }

                                edited(text) => {
                                    password-length = text;

                                    if (text == "") {
                                        new-seed.password.password = "";
                                        self.has-notice = true;
                                        length-error = true;
                                    } else if (!Utils.is-in-bounds(text, self.minimum, self.maximum)) {
                                        new-seed.password.password = "";
                                        self.has-notice = true;
                                        length-error = true;
                                    } else {
                                        new-seed.password.password = CB.generate-password(new-seed.indexed-seed.index, text);
                                        self.has-notice = false;
                                        length-error = false;
                                    }
                                }

                                accepted(text) => {
                                    if (text == "") {
                                        self.text = "21";
                                        self.edited(self.text);
                                    }
                                }
                            }

                            // Conditional spacer for keyboard scrolling
                            if (generated-inputs-have-focus && new-seed.seed-type == SeedViewType.password-generated): Rectangle {
                                height: 250px;
                            }
                        }
                    }
                }
            }

            ButtonSection {
                save-button := Button {
                    label: TR2.lookup(TrId.CommonButtonSave);
                    enabled: !has-errors;
                    clicked => {
                        // Navigation is handled by rust code
                        new-seed.color = CB.get-default-color(new-seed.seed-type);
                        result = CB.save(new-seed);
                    }
                }
            }
        }
    }

    if type-picker.selected-index == -1: VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;
            padding-left: Size.sz6;
            padding-right: Size.sz6;

            VerticalLayout {
                spacing: Size.sz3;

                TextMd {
                    text: TR2.lookup(TrId.CreateItemContent);
                    color: Palette.content-tertiary;
                    horizontal-alignment: center;
                }

                Link {
                    label: TR2.lookup(TrId.CommonButtonLearnMore);
                    clicked => {
                        learn-more-url = "https://docs.foundation.xyz/prime/prime-apps/vault/";
                    }
                }
            }
        }
    }

    if type-picker.showing: DropdownOverlay {
        dropdown-x: type-picker.absolute-position.x;
        dropdown-y: type-picker.absolute-position.y;
        dropdown-width: type-picker.width;
        model: type-picker.model;
        selected-index: type-picker.selected-index;

        item-selected(index, value) => {
            type-picker.selected-index = index;
            type-picker.selected-value = value;
            new-seed.seed-type = index-to-seed-view-type(index);

            if (CB.index-required(new-seed.seed-type)) {
                next-available-index = CB.get-next-index-string(new-seed.seed-type);
                new-seed.indexed-seed.index = next-available-index;
                index-message = CB.validate-new-index(new-seed.indexed-seed.index, new-seed.seed-type);
            }
            if (new-seed.seed-type == SeedViewType.password-generated) {
                new-seed.password.password = CB.generate-password(new-seed.indexed-seed.index, password-length);
            }
            type-picker.showing = false;
        }

        touched-off => {
            type-picker.showing = false;
        }
    }

    if learn-more-url != "": QrOverlay {
        url <=> learn-more-url;
        title: TR2.lookup(TrId.CommonSupportModalDocumentationHeader);
    }

    if !result.success: ErrorModal {
        icon: result.level == ResultLevel.info ? "info" : "alert";
        icon-color: result.level == ResultLevel.info ? Palette.content-brand : Palette.content-notice;
        title: result.title;
        text: result.text;
        confirm-button-label: TR2.lookup(TrId.CommonButtonConfirm);

        confirm-clicked => {
            result.success = true;
        }
    }
}
