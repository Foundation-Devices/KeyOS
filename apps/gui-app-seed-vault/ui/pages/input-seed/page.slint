                if (!SeedState.is-seed-valid): TextSm {
                    text: TR2.lookup(TrId.CommonRecoverWordsIncorrectTryAgain);
                    color: Palette.content-lightcopper-brand;
                    horizontal-alignment: center;
                }

                Button {
                    label: TR2.lookup(TrId.CommonButtonContinue);
                    enabled: SeedState.is-seed-valid;
                    clicked => {
                        CB.set-pending-imported-seed(
                            CB.words-to-entropy(SeedState.words),
                            CB.get-seed-fingerprint(SeedState.words),
