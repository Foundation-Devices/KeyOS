import { Callbacks as CB } from "../../callbacks.slint";
import { SeedView, SeedViewType } from "../../types.slint";
import { Palette, Size, Importance, CallbackResult, ResultLevel,
         CardColor } from "@ui/theme.slint";
import { IconButton, TextSm,
         AppHeader, BasePage, PageBody, ScrollBody, ContentSection,
         ResultModal,
         TitledInput, ButtonSection, Button, ConfirmationModal,
         CardColorPicker, CircleIcon } from "@ui/widgets.slint";
import { DetailsProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";
import { EditPageVersion } from "@ui/pages.slint";
import { TR2, TrId } from "../../gen/tr.slint";

export component DetailsPage inherits BasePage {
    in property <DetailsProps> props;

    property <SeedView> seed;
    property <string> fingerprint;

    init => {
        seed = CB.get-seed-details(props.index);

        if CB.is-bitcoin(seed.seed-type) {
            fingerprint = CB.get-fingerprint(seed.index);
        }
    }

    property <string> new-label: seed.label;
    property <int> new-color: seed.color;
    property <string> new-account: seed.password.account;
    property <string> new-password: seed.password.password;
    property <bool> is-delete-modal-open: false;
    property <bool> is-display-modal-open: false;
    property <bool> has-changes: new-label != seed.label || (CB.is-password(seed.seed-type) && (new-account != seed.password.account || new-password != seed.password.password)) || new-color != seed.color;
    property <bool> has-error: label-error || (CB.is-password(seed.seed-type) && password-error);
    property <bool> label-error: false;
    property <bool> password-error: false;
    property <bool> password-has-focus: false;
    property <CallbackResult> result: {
        success: true,
    };

    // Trigger auto-scroll when password input gains focus
    changed password-has-focus => {
        if (password-has-focus) {
            content-scroll.viewport-y = -150px;
        }
    }

    VerticalLayout {
        AppHeader {
            title: props.version == EditPageVersion.edit ? TR2.lookup(TrId.ItemDetailsTitle) : TR2.lookup(TrId.ArchivedItemTitle);

            IconButton {
                icon: "chevron-left";
                size: Size.sz8;
                importance: Importance.normal;
                clicked => {
                    Navigate.backward();
                }
            }
        }

        PageBody {
            p-x: Size.sz4;
            p-y: Size.sz4;

            content-scroll := ScrollBody {
                p-x: Size.zero;
                p-y: Size.zero;

                ContentSection {
                    HorizontalLayout {
                        spacing: Size.sz4;

                        TitledInput {
                            title: TR2.lookup(TrId.CreateItemItemLabel);
                            placeholder: TR2.lookup(TrId.CreateItemItemLabelFillerText);
                            text: seed.label;
                            enabled: props.version != EditPageVersion.archive;

                            caps-mode: sentences;

                            edited(text) => {
                                new-label = text;
                                self.message = CB.validate-edit-label(seed.index, text);
                                self.has-notice = self.message != "";
                                label-error = self.has-notice;
                            }
                        }

                        VerticalLayout {
                            spacing: Size.sz2;

                            TextSm {
                                text: TR2.lookup(TrId.ItemDetailsIcon);
                                color: Palette.content-tertiary;
                                horizontal-alignment: TextHorizontalAlignment.center;
                            }

                            CircleIcon {
                                icon: CB.get-icon(seed.seed-type);
                                line-color: CardColor.light-copper;
                                shadow: false;
                            }
                        }
                    }

                    VerticalLayout {
                        padding-left: Size.sz4;
                        spacing: Size.sz2;

                        HorizontalLayout {
                            alignment: start;
                            TextSm {
                                text: TR2.lookup(TrId.ItemDetailsInformation);
                                color: Palette.content-tertiary;
                            }
                        }

                        HorizontalLayout {
                            alignment: start;
                            spacing: Size.sz4;

                            TextSm {
                                text: TR2.lookup(TrId.CreateItemType) + ":";
                                color: Palette.content-primary;
                                width: 78px;
                            }

                            TextSm {
                                text: CB.get-seed-name(seed.seed-type);
                                color: Palette.content-primary;
                            }
                        }

                        HorizontalLayout {
                            alignment: start;
                            spacing: Size.sz4;

                            TextSm {
                                text: TR2.lookup(TrId.CreateItemSource) + ":";
                                color: Palette.content-primary;
                                width: 78px;
                            }

                            TextSm {
                                text: CB.index-required(seed.seed-type) ? TR2.lookup(TrId.CreateItemGeneratedFromMasterKey) : TR2.lookup(TrId.CreateItemImported);
                                color: Palette.content-primary;
                            }
                        }

                        if CB.index-required(seed.seed-type): HorizontalLayout {
                            alignment: start;
                            spacing: Size.sz4;

                            TextSm {
                                text: TR2.lookup(TrId.CreateItemIndex) + ":";
                                color: Palette.content-primary;
                                width: 78px;
                            }

                            TextSm {
                                text: seed.indexed-seed.index;
                                color: Palette.content-primary;
                            }
                        }

                        if CB.is-bitcoin(seed.seed-type): HorizontalLayout {
                            alignment: start;
                            spacing: Size.sz4;

                            TextSm {
                                text: TR2.lookup(TrId.CreateItemFingerprint) + ":";
                                color: Palette.content-primary;
                                width: 120px;
                            }

                            TextSm {
                                text: fingerprint;
                                color: Palette.content-primary;
                            }
                        }
                    }

                    if CB.is-password(seed.seed-type): TitledInput {
                        title: TR2.lookup(TrId.CreateItemAccount);
                        placeholder: TR2.lookup(TrId.CreateItemAccountFillerText);
                        text: seed.password.account;
                        caps-mode: sentences;
                        enabled: props.version != EditPageVersion.archive;

                        edited(text) => {
                            new-account = text;
                        }
                    }

                    if CB.is-password(seed.seed-type): TitledInput {
                        title: TR2.lookup(TrId.CreateItemPassword);
                        placeholder: TR2.lookup(TrId.CreateItemPasswordFillerText);
                        text: seed.password.password;
                        has-notice: self.text == "";
                        show-password: false;
                        enabled: props.version != EditPageVersion.archive;
                        input-type: InputType.password;
                        locked: seed.seed-type == SeedViewType.password-generated;

                        edited(text) => {
                            new-password = text;
                            self.has-notice = text == "";
                            password-error = self.has-notice;
                        }

                        changed has-focus => {
                            password-has-focus = self.has-focus;
                        }
                    }

                    if props.version != EditPageVersion.archive: CardColorPicker {
                        selected-index: seed.color;
                        title: TR2.lookup(TrId.ItemDetailsColor);
                        changed(index) => {
                            new-color = index;
                        }
                    }

                    // Conditional spacer for keyboard scrolling
                    if password-has-focus: Rectangle {
                        height: 250px;
                    }
                }
            }

            ButtonSection {
                if CB.supports-qr(seed.seed-type): Button {
                    icon: "scan-qr";
                    label: CB.is-nostr(seed.seed-type) ? TR2.lookup(TrId.ItemDetailsNostrKeyViewKey) : TR2.lookup(TrId.ItemDetailsSeedViewSeed);
                    importance: props.version == EditPageVersion.edit ? Importance.primary : Importance.secondary;

                    clicked => {
                        is-display-modal-open = true;
                    }
                }

                if props.version == EditPageVersion.edit && has-changes: Button {
                    icon: "";
                    label: TR2.lookup(TrId.CommonButtonSave);
                    enabled: !has-error;
                    importance: Importance.primary;

                    clicked => {
                        result = CB.is-password(seed.seed-type) ? CB.edit-password(seed.index, new-label, new-account, new-password, new-color) : CB.edit-indexed(seed.index, new-label, new-color);

                        if (result.success) {
                            Navigate.backward();
                        }
                    }
                }

                if props.version == EditPageVersion.edit && !has-changes: Button {
                    icon: "archive";
                    label: TR2.lookup(TrId.ItemDetailsArchive);
                    enabled: !has-changes;
                    importance: Importance.secondary;

                    clicked => {
                        CB.set-archived(seed.index, true);
                        Navigate.backward();
                    }
                }

                // TODO: Allow delete for imports only? would make is-import() function
                if CB.is-import(seed.seed-type) && props.version == EditPageVersion.archive: Button {
                    icon: "";
                    label: TR2.lookup(TrId.CommonButtonDelete);
                    importance: Importance.negative;

                    clicked => {
                        is-delete-modal-open = true;
                    }
                }

                if props.version == EditPageVersion.archive: Button {
                    icon: "export";
                    label: CB.is-password(seed.seed-type) ? TR2.lookup(TrId.ArchivedItemPasswordRestorePassword) : (CB.is-nostr(seed.seed-type) ? TR2.lookup(TrId.ArchivedItemNostrKeyRestoreKey) : TR2.lookup(TrId.ArchivedItemSeedRestoreSeed));
                    importance: Importance.primary;

                    clicked => {
                        CB.set-archived(seed.index, false);
                        Navigate.backward();
                    }
                }
            }
        }
    }

    if is-delete-modal-open: ConfirmationModal {
        icon: "alert";
        icon-color: Palette.content-notice;
        title: TR2.lookup(TrId.PasswordDeleteModalHeader);
        text: TR2.format(TrId.PasswordDeleteModalContent1, [
            seed.label,
        ]);
        extra-warning: TR2.lookup(TrId.SeedDeleteModalContent2);
        extra-warning-color: Palette.content-notice;
        confirm-button-label: TR2.lookup(TrId.CommonButtonConfirm);
        cancel-button-label: TR2.lookup(TrId.CommonButtonCancel);

        cancel-clicked => {
            is-delete-modal-open = false;
        }

        confirm-clicked => {
            is-delete-modal-open = false;
            CB.delete(seed.index);
            Navigate.backward();
        }
    }

    if is-display-modal-open: ConfirmationModal {
        icon: "alert";
        icon-color: Palette.content-notice;
        title: TR2.lookup(TrId.ArchivedItemSeedModalRevealHeader);
        text: CB.is-nostr(seed.seed-type) ? TR2.lookup(TrId.ArchivedItemNostrKeyModalRevealContent1) : TR2.lookup(TrId.ArchivedItemSeedModalRevealContent1);
        extra-warning: CB.is-nostr(seed.seed-type) ? TR2.lookup(TrId.ArchivedItemNostrKeyModalRevealContent2) : TR2.lookup(TrId.ArchivedItemSeedModalRevealContent2);
        confirm-button-label: TR2.lookup(TrId.CommonButtonConfirm);
        cancel-button-label: TR2.lookup(TrId.CommonButtonCancel);

        cancel-clicked => {
            is-display-modal-open = false;
        }

        confirm-clicked => {
            Navigate.view({ index: seed.index, version: props.version }, { });
        }
    }

    // This shouldn't happen due to disabling the save button,
    // but it's useful to catch and report unexpected errors
    if !result.success: ResultModal {
        result: result;
        confirm-button-label: TR2.lookup(TrId.CommonButtonConfirm);

        confirm-clicked => {
            result.success = true;
        }
    }
}
