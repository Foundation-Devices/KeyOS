import { SeedWordsWarning } from "@ui/pages.slint";
import { SeedWordsWarningProps } from "./props.slint";
import { Navigate } from "../../gen/navigate.slint";

export component SeedWordsWarningPage inherits SeedWordsWarning {
    in property <SeedWordsWarningProps> props;

    tr-id-prefix: "settings.accessSeedWords.";

    // Replace so this gate leaves the history stack: "Done" on the seed
    // words returns to settings, not back into this warning.
    view-seed => {
        Navigate.view-seed-words({ replace: true });
    }
    back => {
        Navigate.backward();
    }
}
