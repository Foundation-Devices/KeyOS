export struct AppEntryValue {
    name: string,
    app-id: string,
}

export struct SettingsEntryValue {
    name: string,
    app-id: string,
    enabled: bool,
}

/// A single word-position challenge for the seed-deletion quiz.
export struct SeedWordChallenge {
    /// 0-based index of the word being tested.
    word-index: int,
    /// The four candidate words (exactly one is correct).
    options: [string],
    /// Index into `options` of the correct answer.
    correct-option-index: int,
}

export global Callbacks {
    callback app-clicked(string);
    pure callback pid-to-title(int) -> string;
    callback display-touched(length, length, bool);
    callback app-toggled(string, bool);
    callback theme-changed();
    callback back-from-running();
    callback confirm-seed-import([string]);
    pure callback validate-seed-word(string) -> bool;
    pure callback validate-full-seed([string]) -> bool;
    callback derive-new-seed();
    callback confirm-seed-derive();
    /// Returns the 24 seed words for the currently-configured seed.
    pure callback get-seed-words() -> [string];
    /// Returns a standard SeedQR image (4-digit BIP39 indices).
    pure callback get-standard-seed-qr() -> image;
    /// Returns a compact SeedQR image (raw entropy bytes).
    pure callback get-compact-seed-qr() -> image;
    /// Generates `count` word-position challenges for the deletion quiz.
    pure callback generate-seed-word-challenges(count: int) -> [SeedWordChallenge];
    /// Clears the seed config from persistent storage and navigates to intro.
    callback remove-seed();
}

export global Global {
    in property <int> crashed-pid: 0;
    in property <int> exit-code: 0;
    in property <[AppEntryValue]> apps: [];
    in property <bool> app-running: false;
    in property <image> display-image;
    in property <[SettingsEntryValue]> all-apps: [];
    in property <bool> seed-configured: false;
}
