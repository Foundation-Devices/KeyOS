# SDK-only compatibility crate. It intentionally contains BluetoothError but
# none of the KeyOS Bluetooth service API.
[package]
name = "bt"
version = "1.0.0"
edition = "2021"
description = "Bluetooth error compatibility type for the SDK quantum-link crate"
publish = false

[dependencies]
log = { workspace = true }
postcard = { workspace = true }
rkyv = { workspace = true }
server = { workspace = true }
thiserror = { workspace = true }
xous = { workspace = true }

[lints.rust]
unexpected_cfgs = { level = "warn", check-cfg = ['cfg(keyos)'] }
