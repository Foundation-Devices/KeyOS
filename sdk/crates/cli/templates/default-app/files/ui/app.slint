import {
    Theme,
    UISize,
    Images,
    ControlSize,
} from "@ui/theme.slint";
import { Callbacks } from "callbacks.slint";
import { Button } from "@ui/button.slint";
import { Card } from "@ui/card.slint";

export { Callbacks, Theme, Images, ControlSize }
export component AppWindow inherits Window {
    title: "{{friendly_app_name}}";
    preferred-width: UISize.screen-width;
    preferred-height: UISize.screen-height;
    background: Theme.palette-background;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.palette-background;

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: Theme.spacing-xl;
            padding-right: Theme.spacing-xl;
            padding-top: Theme.spacing-xl + UISize.control-center-status-bar-height;
            padding-bottom: Theme.spacing-xl;
            spacing: Theme.spacing-xl;

            Text {
                text: "{{friendly_app_name}}";
                color: Theme.palette-muted;
                font-family: Theme.font-primary;
                font-size: Theme.font-size-body;
                font-weight: Theme.font-weight-semibold;
                horizontal-alignment: center;
            }

            Rectangle {
                width: 100%;
                height: 154px;
                background: Theme.palette-card;
                border-radius: Theme.radius-default;
                clip: true;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: Images.image("checkmark");
                    image-fit: cover;
                }
            }

            Text {
                text: "WELCOME";
                color: Theme.palette-muted;
                font-family: Theme.font-primary;
                font-size: Theme.font-size-label;
                font-weight: Theme.font-weight-semibold;
                horizontal-alignment: center;
            }

            Card {
                width: 100%;
                title: "Welcome to {{friendly_app_name}}";
                body: "A simple, secure experience starts here.";
                footer: "Tap below to get started.";
            }

            Rectangle {
                vertical-stretch: 1;
            }

            Button {
                width: 100%;
                text: "Get started";
                size: ControlSize.lg;
                full-width: true;
                clicked => {
                    Callbacks.button-clicked();
                }
            }
        }
    }
}
