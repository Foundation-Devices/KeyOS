import { Theme, UISize, ControlSize } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { Card } from "@ui/card.slint";
import { Navigate } from "../../gen/navigate.slint";

export component SecondPagePage inherits Rectangle {
    background: Theme.palette-background;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: Theme.spacing-xl;
        padding-right: Theme.spacing-xl;
        padding-top: Theme.spacing-xl + UISize.control-center-status-bar-height;
        padding-bottom: Theme.spacing-xl;
        spacing: Theme.spacing-lg;

        Text {
            text: "Page 2";
            color: Theme.palette-foreground;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-title;
            font-weight: Theme.font-weight-bold;
            horizontal-alignment: center;
        }

        Text {
            text: "A second screen for more content and actions.";
            color: Theme.palette-muted;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-subtitle;
            font-weight: Theme.font-weight-medium;
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        Card {
            width: 100%;
            size: ControlSize.lg;
            title: "You made it";
            body: "Use this page for the next step in your app's flow.";
        }

        Rectangle {
            vertical-stretch: 1;
        }

        Button {
            width: 100%;
            text: "Back to home";
            size: ControlSize.md;
            full-width: true;
            clicked => {
                Navigate.backward();
            }
        }
    }
}
