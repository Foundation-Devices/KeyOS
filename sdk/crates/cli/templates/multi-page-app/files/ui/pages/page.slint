import { Theme, UISize, Images, ControlSize } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { Card } from "@ui/card.slint";
import { Navigate } from "../gen/navigate.slint";

export component MainPagePage inherits Rectangle {
    background: Theme.palette-background;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: Theme.spacing-xl;
        padding-right: Theme.spacing-xl;
        padding-top: Theme.spacing-xl + UISize.control-center-status-bar-height;
        padding-bottom: Theme.spacing-xl;
        spacing: Theme.spacing-lg;

        Text {
            text: "{{friendly_app_name}}";
            color: Theme.palette-foreground;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-title;
            font-weight: Theme.font-weight-bold;
            horizontal-alignment: center;
        }

        Text {
            text: "A simple app with room to grow.";
            color: Theme.palette-muted;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-subtitle;
            font-weight: Theme.font-weight-medium;
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        Rectangle {
            width: 100%;
            height: 148px;
            background: Theme.palette-card;
            border-radius: Theme.radius-default;
            clip: true;

            Image {
                width: parent.width;
                height: parent.height;
                source: Images.image("sample-scene");
                image-fit: cover;
            }
        }

        Text {
            text: "HOME";
            color: Theme.palette-muted;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-label;
            font-weight: Theme.font-weight-semibold;
            horizontal-alignment: center;
        }

        Card {
            width: 100%;
            size: ControlSize.lg;
            title: "Welcome to {{friendly_app_name}}";
            body: "This is your home screen. Add the content and actions that matter most.";
            footer: "Use the button below to explore the second page.";
        }

        Rectangle {
            vertical-stretch: 1;
        }

        Button {
            width: 100%;
            text: "Go to second page";
            size: ControlSize.md;
            full-width: true;
            clicked => {
                Navigate.second-page({ });
            }
        }
    }
}
