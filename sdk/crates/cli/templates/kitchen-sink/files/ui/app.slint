                                    width: parent.width;
                                    spacing: 10px;
                                    Rectangle {
                                        width: Theme.control-size-sm;
                                        height: 10px;
                                        background: Theme.palette-border;
                                        border-radius: 5px;
                                    }

                                    Rectangle {
                                        width: Theme.control-size-md;
                                        height: 10px;
                                        background: Theme.palette-border;
                                        border-radius: 5px;
                                    }

                                    Rectangle {
                                        width: Theme.control-size-lg;
                                        height: 10px;
                                        background: Theme.palette-border;
                                        border-radius: 5px;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            width: parent.width;
                            height: 24px;
                            background: transparent;
                        }
                    }
                }
            }
        }
    }
}
