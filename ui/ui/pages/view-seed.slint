import { Palette, Size } from "../theme.slint";
import { NavHeader } from "../widgets/app-header.slint";
import { Button } from "../widgets/button.slint";
import { ButtonSection } from "../widgets/base-page.slint";
import { SeedWords } from "../widgets/seed-words.slint";
import { QrPages } from "../widgets/qr-pages.slint";

/// Localized strings for the View Seed screen. Passed in because settings and
/// Legacy store them under different catalog keys.
export struct ViewSeedStrings {
    title: string,
    standard-qr-header: string,
    compact-qr-header: string,
    next-words: string,
    done: string,
}

/// The View Seed screen: the mnemonic words with a header toggle to the two
/// SeedQR pages (standard and compact). Shared by settings and the Legacy app.
/// On all but the last words page the primary button reads `next-words` and
/// advances the pager; on the last words page and the QR pages it reads `done`
/// and fires `back`.
export component ViewSeed inherits VerticalLayout {
    in property <[string]> words;
    in property <image> standard-qr;
    in property <image> compact-qr;
    in property <ViewSeedStrings> strings;

    /// Header back or Done tapped.
    callback back();

    private property <bool> qr-view: false;
    private property <int> words-page: 0;
    // Matches SeedWords' default page size (2 columns x 6 rows).
    private property <int> words-pages: Math.ceil(words.length / 12);
    private property <bool> has-next-words: !qr-view && words-page < words-pages - 1;

    NavHeader {
        title: strings.title;
        left-icon: "chevron-left";
        right-icon: qr-view ? "list" : "scan-qr";
        clicked => {
            back();
        }
        right-clicked => {
            qr-view = !qr-view;
        }
    }

    VerticalLayout {
        padding-top: qr-view ? Size.sz2 : Size.sz16;
        padding-bottom: Size.sz4;

        if !qr-view: SeedWords {
            words: root.words;
            current-page <=> root.words-page;
        }

        if qr-view: QrPages {
            model: [
                {
                    code: standard-qr,
                    header: strings.standard-qr-header,
                },
                {
                    code: compact-qr,
                    header: strings.compact-qr-header,
                },
            ];
        }

        ButtonSection {
            padding: Size.sz6;
            Button {
                label: root.has-next-words ? strings.next-words : strings.done;
                clicked => {
                    if (root.has-next-words) {
                        root.words-page += 1;
                    } else {
                        back();
                    }
                }
            }
        }
    }
}
