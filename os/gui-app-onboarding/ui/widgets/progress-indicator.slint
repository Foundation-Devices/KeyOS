import { Palette } from "@ui/theme.slint";
import { Size } from "@ui/types.slint";
import { TextSm } from "@ui/widgets.slint";

export component ProgressIndicator {
    in property <int> current;
    in property <int> total;

    // Promote to float to avoid integer division truncation
    property <float> fill-frac: (current + 1) * 1.0 / total;

    VerticalLayout {
        alignment: center;
        spacing: Size.sz0_5;

        TextSm {
            text: "\{current + 1}/\{total}";
            color: Palette.content-tertiary;
            horizontal-alignment: center;
        }

        track := Rectangle {
            height: Size.sz3;
            width: 120px;
            background: Palette.content-disabled;
            border-radius: self.height / 2;

            Rectangle {
                // Minimum width equals height so each step renders as at least a dot
                width: Math.max(parent.height, parent.width * fill-frac);
                height: parent.height;
                background: Palette.content-brand;
                border-radius: self.height / 2;
                x: 0;
                y: 0;
            }
        }
    }
}
