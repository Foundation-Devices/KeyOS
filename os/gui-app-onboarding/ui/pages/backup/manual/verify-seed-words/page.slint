import { SeedVerifyQuiz } from "@ui/pages.slint";
import { OnboardingBasePage } from "../../../../widgets/base-page.slint";
import { VerifySeedWordsProps } from "props.slint";
import { Navigate } from "../../../../gen/navigate.slint";
import {
    SeedGlobal,
    SeedWordChallenge,
} from "../../../../onboarding-callbacks.slint";

export component VerifySeedWordsPage inherits OnboardingBasePage {
    in property <VerifySeedWordsProps> props;

    // One challenge per word in shuffled order, generated once when the screen opens.
    property <[SeedWordChallenge]> challenges;
    init => {
        root.challenges = SeedGlobal.generate-seed-verify-challenges();
    }

    SeedVerifyQuiz {
        challenges: root.challenges;
        tr-id-prefix: "backupManualVerify.";
        regenerate-challenge(word-index) => {
            SeedGlobal.regenerate-seed-verify-challenge(word-index)
        }
        verified => {
            Navigate.backup-created({ });
        }
        back => {
            Navigate.backward();
        }
    }
}
