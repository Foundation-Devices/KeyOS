import {
    Button,
    Shield,
    Icon,
    HeadingMd,
    HeadingLg,
    Checkbox,
    WrappedIcon,
    TextLg,
    TextSm,
    TextMd,
    TextXs,
    TimerCircularProgress,
    Shimmer,
    IconButton,
    StepList,
    PopupMenu,
} from "@ui/widgets.slint";
import {
    Size,
    Palette,
    UISize,
    Importance,
    Utils,
    Images,
} from "@ui/theme.slint";
import { StepModel } from "@ui/widgets/step-list.slint";
import { AppHeader } from "@ui/widgets/app-header.slint";
import { JumboIcon } from "@ui/widgets/jumbo-icon.slint";
import { SegmentedControl } from "@ui/widgets/segmented-control.slint";
import { RoundContainer } from "@ui/widgets/round-container.slint";
import { Divider } from "@ui/widgets/divider.slint";
import { TR } from "@ui/i18n/i18n.slint";
import { IconSize } from "@ui/types.slint";
import { GenericAlertGlobal } from "../../globals/globals.slint";
import { Callbacks } from "../../callbacks.slint";

export component GenericAlertPage inherits Rectangle {
    width: UISize.screen-width;
    height: UISize.popup-app-height - Size.sz8;
    background: Palette.background-primary;
    private property <bool> compact-icon: GenericAlertGlobal.button3-title != "";

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: Size.sz6;
        padding-right: Size.sz6;
        padding-top: Size.sz4;
        padding-bottom: Size.sz6;
        spacing: Size.sz5;
        alignment: stretch;

        if GenericAlertGlobal.app-title != "": AppHeader {
            title: GenericAlertGlobal.app-title;
        }

        VerticalLayout {
            alignment: stretch;
            spacing: Size.sz5;

            // The decorative icon is the first element that gives way when text wraps. A
            // three-action alert requests the compact circle at its designed size instead of
            // resampling the jumbo circle, while the area can still shrink to keep buttons visible.
            icon-area := Rectangle {
                preferred-height: root.compact-icon ? IconSize.px128 : IconSize.px184;
                min-height: 0;
                vertical-stretch: 0;
                clip: true;

                WrappedIcon {
                    compact: root.compact-icon;
                    width: min(icon-area.height, self.compact ? IconSize.px128 : IconSize.px184);
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    outer-icon: "jumbo-circle";
                    inner-icon: GenericAlertGlobal.icon == "alert"
                        ? "alert-wrapped"
                        : GenericAlertGlobal.icon;
                }
            }

            HeadingLg {
                text: GenericAlertGlobal.title;
                horizontal-alignment: center;
            }

            TextSm {
                text: GenericAlertGlobal.line1;
                color: Palette.content-tertiary;
                horizontal-alignment: center;
            }

            if GenericAlertGlobal.line2 != "": TextSm {
                text: GenericAlertGlobal.line2;
                color: Palette.content-tertiary;
                horizontal-alignment: center;
            }

            // Fill the space
            Rectangle {
                vertical-stretch: 1;
            }

            Button {
                label: GenericAlertGlobal.button1-title;
                importance: Importance.primary;
                clicked(id) => {
                    Callbacks.button1-clicked();
                }
            }

            if GenericAlertGlobal.button2-title != "": Button {
                label: GenericAlertGlobal.button2-title;
                importance: Importance.secondary;
                clicked(id) => {
                    Callbacks.button2-clicked();
                }
            }

            if GenericAlertGlobal.button3-title != "": Button {
                label: GenericAlertGlobal.button3-title;
                importance: Importance.tertiary;
                clicked(id) => {
                    Callbacks.button3-clicked();
                }
            }
        }
    }
}
