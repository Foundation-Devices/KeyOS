import { Router } from "./gen/router.slint";
import { LauncherCallbacks, State } from "./launcher-callbacks.slint";
import {
    Images,
    CurrentTheme,
    Utils,
    Size,
    Palette,
    Importance,
} from "@ui/theme.slint";
import { TR } from "@ui/i18n/i18n.slint";
import { TR2, TrId } from "./gen/tr.slint";
import {
    BaseWindow,
    PopupMenu,
    TimerLoader,
    HeadingMd,
    TextSm,
    Modal,
    ErrorModal,
    ConfirmationModal,
    Button,
} from "@ui/widgets.slint";

export component AppWindow inherits BaseWindow {
    background-image-light: @image-url("assets/launcher-bg-light.png");
    background-image-dark: @image-url("assets/launcher-bg-dark.png");

    Router { }

    if State.remove-confirm-item-id != "": ConfirmationModal {
        icon: "alert";
        icon-color: Palette.content-notice;
        title: TR2.lookup(TrId.RemoveAppHeader);
        text: TR2.format(TrId.RemoveAppContent, [State.remove-confirm-item-label]);
        cancel-button-label: TR2.lookup(TrId.CommonButtonCancel);
        confirm-button-label: TR2.lookup(TrId.CommonButtonDelete);

        cancel-clicked => {
            State.remove-confirm-item-id = "";
        }

        confirm-clicked => {
            LauncherCallbacks.remove-item-confirmed(State.remove-confirm-item-id);
            State.remove-confirm-item-id = "";
        }
    }

    if State.remove-error-message != "": ErrorModal {
        icon: "alert";
        icon-color: Palette.content-notice;
        title: TR2.lookup(TrId.RemoveAppFailedHeader);
        text: State.remove-error-message;
        confirm-button-label: TR2.lookup(TrId.CommonButtonConfirm);
        confirm-clicked => {
            State.remove-error-message = "";
        }
    }

    if State.remove-blocked-by-legacy-apps: Modal {
        icon: "alert";
        icon-color: Palette.content-notice;
        title: TR2.lookup(TrId.RemoveAppFailedHeader);
        text: TR2.lookup(TrId.RemoveAppRemoveLegacyAppsFirst);

        Button {
            icon: "";
            label: TR2.lookup(TrId.ButtonGoToSettings);
            importance: Importance.secondary;
            clicked => {
                State.remove-blocked-by-legacy-apps = false;
                LauncherCallbacks.remove-blocked-go-to-settings();
            }
        }

        Button {
            icon: "";
            label: TR2.lookup(TrId.CommonButtonConfirm);
            importance: Importance.primary;
            clicked => {
                State.remove-blocked-by-legacy-apps = false;
            }
        }
    }

    if State.update-resume-active: Rectangle {
        width: parent.width;
        height: parent.height;
        background: Palette.black.transparentize(0.45);
        z: 1000;

        PopupMenu {
            width: 424px;
            x: parent.width / 2 - self.width / 2;
            y: parent.height / 2 - self.height / 2;
            z: 1001;

            VerticalLayout {
                padding-left: Size.sz8;
                padding-right: Size.sz8;

                padding-top: Size.sz16;
                padding-bottom: Size.sz16;

                spacing: Size.sz8;

                VerticalLayout {
                    spacing: Size.sz4;
                    alignment: center;

                    HeadingMd {
                        text: TR2.lookup(TrId.MainUpdateResumeHeader);
                        color: Palette.content-primary;
                        horizontal-alignment: center;
                    }

                    TextSm {
                        text: TR2.lookup(TrId.MainUpdateResumeDescription);
                        color: Palette.content-tertiary;
                        horizontal-alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    TimerLoader {
                        size: Size.sz16;
                    }
                }
            }
        }

        TouchArea { }
    }

    // Centered pop-up for a blocked launch (matches the Figma pop-up): Go to Settings above
    // Dismiss, where the certificate fix lives.
    if State.app-blocked-reason != "": ConfirmationModal {
        width: parent.width;
        height: parent.height;
        z: 1000;
        title: TR2.lookup(TrId.AppBlockedModalHeader);
        text: State.app-blocked-reason;
        cancel-button-label: TR2.lookup(TrId.ButtonGoToSettings);
        confirm-button-label: TR2.lookup(TrId.CommonButtonDismiss);
        cancel-clicked => {
            LauncherCallbacks.app-blocked-go-to-settings();
        }
        confirm-clicked => {
            State.app-blocked-reason = "";
        }
    }
}

export * from "gen/exports.slint";
export { TR, Utils, Images, CurrentTheme }
export { LauncherCallbacks, State }
export { GraphLayout }from "./pages/main/page.slint";
