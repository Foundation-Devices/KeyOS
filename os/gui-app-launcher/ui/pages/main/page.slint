import {
    LauncherCallbacks as CB,
    State,
    LauncherPageData,
    LauncherItemData,
} from "../../launcher-callbacks.slint";
import { MainProps } from "./props.slint";
import {
    BasePage,
    Circle,
    Divider,
    HeadingMd,
    HeadingXl,
    Icon,
    IconButton,
    PopupMenu,
    TextMd,
    TextSm,
    TimerLoader,
} from "@ui/widgets.slint";
import {
    CurrentTheme,
    IconSize,
    Images,
    Palette,
    Size,
    Timings,
    UISize,
    Utils,
} from "@ui/theme.slint";
import { TR2, TrId } from "../../gen/tr.slint";

component PageDot inherits Rectangle {
    in property <int> page-index;
    in property <bool> selected;

    width: 12px;
    height: 12px;
    border-radius: self.height / 2;
    background: selected ? Palette.content-brand : Palette.content-disabled;

    animate background { duration: Timings.prop-change; }

    callback selected-page(int);

    TouchArea {
        enabled: !State.rearrange-mode;
        clicked => {
            selected-page(page-index);
        }
    }
}

struct DropTarget {
    id: string,
    left: length,
    top: length,
    width: length,
    height: length,
    item-count: int,
    slot-count: int,
    columns: int,
    shell-size: length,
    slot-height: length,
    row-gap: length,
    column-gap: length,
}

component PriceGraph inherits Rectangle {
    in property <length> content-width;
    in property <length> card-height;
    in property <length> shadow-top-overhang;

    // Scrub marker coordinates arrive in the rendered bitmap's coordinate space.
    property <length> graph-width: max(1px, State.bitcoin-graph-image.width * 1px);
    property <length> graph-height: max(1px, State.bitcoin-graph-image.height * 1px);
    property <length> shadow-horizontal-overhang: 12px;
    property <length> shadow-bottom-overhang: 18px;
    property <length> scrub-marker-size: 10px;
    property <bool> is-touch-active: false;
    property <bool> is-scrubbing-gesture: false;
    private property <bool> show-last-update: State.is-price-stale && !State.is-price-expired && !State.bitcoin-scrub-active;

    width: content-width;
    height: card-height;

    // This image contains only the exterior shadow, leaving the transparent
    // graph tile and its contents unobscured.
    Image {
        x: (parent.width - root.graph-width) / 2 - root.shadow-horizontal-overhang;
        y: -root.shadow-top-overhang;
        width: root.graph-width + root.shadow-horizontal-overhang * 2;
        height: parent.height + root.shadow-top-overhang + root.shadow-bottom-overhang;
        source: Images.nine-slice("images/launcher-graph-shadow");
        image-fit: fill;
    }

    HorizontalLayout {
        alignment: space-between;
        padding-left: Size.sz4 + (parent.width - root.graph-width) / 2;
        padding-right: Size.sz4 + (parent.width - root.graph-width) / 2;
        padding-top: Size.sz2_5;

        VerticalLayout {
            alignment: start;
            spacing: 0px;
            vertical-stretch: 0;

            HorizontalLayout {
                alignment: start;
                spacing: Size.sz1;

                HeadingXl {
                    text: (State.is-price-expired && !State.bitcoin-scrub-active) ? "" : Utils.currency-symbol(State.bitcoin-currency-code);
                    color: root.show-last-update ? Palette.content-disabled : Palette.content-tertiary;
                }

                HeadingXl {
                    text: (State.is-price-expired && !State.bitcoin-scrub-active) ? "" : (State.bitcoin-scrub-active ? State.bitcoin-scrub-price : State.bitcoin-price);
                    color: root.show-last-update ? Palette.content-disabled : Palette.content-primary;
                }
            }

            TextSm {
                text: (!State.is-price-stale || State.bitcoin-scrub-active) ? TR2.lookup(TrId.MainBitcoin) + " " + State.bitcoin-currency-code : "";
                color: Palette.content-tertiary;
            }
        }

        if !State.bitcoin-scrub-active && !State.is-price-stale: Rectangle {
            width: pill-content.preferred-width;
            height: 32px;
            vertical-stretch: 0;
            border-radius: self.height / 2;
            background: State.is-price-positive ? Palette.content-positive : Palette.content-negative;

            pill-content := HorizontalLayout {
                alignment: center;
                spacing: Size.sz2;
                padding-top: Size.sz1;
                padding-bottom: Size.sz1;
                padding-left: Size.sz3;
                padding-right: Size.sz3;

                VerticalLayout {
                    alignment: center;

                    Icon {
                        name: State.is-price-positive ? "trend-up" : "trend-down";
                        size: Size.sz6;
                        color: State.is-price-positive ? Palette.background-positive-subtle : Palette.background-negative-subtle;
                    }
                }

                TextSm {
                    text: State.bitcoin-price-change-percent;
                    color: State.is-price-positive ? Palette.background-positive-subtle : Palette.background-negative-subtle;
                    vertical-alignment: center;
                }
            }
        }

        if root.show-last-update: VerticalLayout {
            alignment: start;
            spacing: Size.sz1;
            vertical-stretch: 0;

            TextSm {
                text: TR2.lookup(TrId.MainLastUpdate);
                color: Palette.content-tertiary;
                horizontal-alignment: right;
            }

            TextSm {
                text: TR2.format(TrId.MainXAgo, [State.last-update-time]);
                color: Palette.content-tertiary;
                horizontal-alignment: right;
            }
        }

        if !State.bitcoin-scrub-active && State.is-price-stale && State.is-price-expired: TextSm {
            text: State.is-envoy-connected ? TR2.lookup(TrId.MainLoadingData) : TR2.lookup(TrId.MainDisconnected);
            color: Palette.content-tertiary;
            vertical-stretch: 0;
        }

        if State.bitcoin-scrub-active: VerticalLayout {
            alignment: start;
            spacing: 0px;
            vertical-stretch: 0;

            TextSm {
                text: State.bitcoin-point-date;
                color: Palette.content-tertiary;
                horizontal-alignment: right;
            }

            TextSm {
                text: State.bitcoin-point-time;
                color: Palette.content-tertiary;
                horizontal-alignment: right;
            }
        }
    }

    graph-strip := Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height;
        width: root.graph-width;
        height: root.graph-height;
        background: transparent;
        border-top-left-radius: 0px;
        border-top-right-radius: 0px;
        border-bottom-left-radius: 16px;
        border-bottom-right-radius: 16px;
        clip: true;

        Image {
            width: parent.width;
            height: parent.height;
            source: State.bitcoin-graph-image;
        }

        if State.bitcoin-scrub-active: Circle {
            size: root.scrub-marker-size;
            x: State.bitcoin-scrub-marker-x;
            y: State.bitcoin-scrub-marker-y;
            background: Palette.content-secondary;
        }
    }

    touch-area := TouchArea {
        enabled: !State.rearrange-mode;

        pointer-event(e) => {
            if self.enabled {
                if (e.kind == PointerEventKind.down) {
                    root.is-touch-active = true;
                    // Scrub starts on press: show the price at the touched point right away.
                    if State.bitcoin-scrub-enabled {
                        root.is-scrubbing-gesture = true;
                        CB.bitcoin-scrub-update(self.mouse-x - graph-strip.x, graph-strip.width);
                    }
                } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                    root.is-touch-active = false;
                    if root.is-scrubbing-gesture {
                        root.is-scrubbing-gesture = false;
                        CB.bitcoin-scrub-end();
                    }
                }
            }
        }

        moved => {
            if self.enabled && root.is-touch-active && root.is-scrubbing-gesture {
                CB.bitcoin-scrub-update(self.mouse-x - graph-strip.x, graph-strip.width);
            }
        }
    }
}

component RemoveBadge inherits Rectangle {
    width: 36px;
    height: 36px;
    border-radius: self.height / 2;
    background: CurrentTheme.is-dark ? #2b2b2b : #f3f3f3;
    border-width: 1px;
    border-color: Palette.white;
    property <brush> mark-color: CurrentTheme.is-dark ? Palette.white : Palette.content-primary;

    Icon {
        width: parent.width;
        height: parent.height;
        name: "close";
        size: 36px;
        color: root.mark-color;
    }

    callback clicked();

    TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.clicked();
        }
    }
}

component LauncherCollectionItem inherits Rectangle {
    in property <LauncherItemData> item;
    in property <bool> show-label: true;
    in property <bool> is-dragging: false;
    in property <bool> is-leaving: false;
    in property <length> jiggle-x: 0px;
    in property <length> jiggle-y: 0px;

    width: 128px;
    height: show-label ? 160px : 128px;
    opacity: is-leaving ? 0% : (item.enabled ? 100% : 55%);
    clip: false;
    private property <bool> ignore-release-click: false;
    private property <brush> icon-foreground-color: CurrentTheme.is-dark ? #e0e0e0 : #404040;
    private property <length> visual-offset-x: State.rearrange-mode && !is-dragging ? jiggle-x : 0px;
    private property <length> visual-offset-y: State.rearrange-mode && !is-dragging ? jiggle-y : 0px;
    private property <length> press-offset-y: touch.pressed && !is-dragging ? 4px : 0px;

    animate opacity {
        duration: 180ms;
        easing: ease-in-out;
    }

    callback activate(length, length, string);
    callback drag-started();
    callback drag-moved();
    callback drag-finished();

    function store-pointer() {
        State.drag-pointer-abs-x = touch.absolute-position.x + touch.mouse-x;
        State.drag-pointer-abs-y = touch.absolute-position.y + touch.mouse-y;
    }
    function store-grab() {
        State.drag-grab-x = touch.mouse-x;
        State.drag-grab-y = touch.mouse-y;
    }

    hold-timer := Timer {
        interval: 450ms;
        running: false;
        triggered() => {
            self.running = false;
            root.ignore-release-click = true;
            if (State.rearrange-mode) {
                root.drag-finished();
                State.rearrange-mode = false;
            } else {
                State.rearrange-mode = true;
                root.store-pointer();
                root.store-grab();
                root.drag-started();
            }
        }
    }

    shell := Rectangle {
        width: 128px;
        height: 128px;
        x: root.visual-offset-x;
        y: root.visual-offset-y + root.press-offset-y;
        clip: false;

        Image {
            x: -8px;
            y: -8px;
            width: 144px;
            height: 144px;
            source: CurrentTheme.is-dark ? @image-url("../../assets/icon-bg-dark.png") : @image-url("../../assets/icon-bg-light.png");
            image-fit: fill;
        }

        Rectangle {
            width: 110px;
            height: 110px;
            x: (parent.width - self.width) / 2;
            y: 9px;
            background: transparent;

            if !root.is-dragging && State.loading-item-id == root.item.id: TimerLoader {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: 56px;
                loader-color: CurrentTheme.is-dark ? #54cad8aa : #0ea6b3aa;
                active-color: Palette.content-brand;
            }

            if State.loading-item-id != root.item.id || root.is-dragging: Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: parent.height;
                background: transparent;

                property <image> app-icon: CB.app-icon(root.item.icon-key, CurrentTheme.is-dark);

                if self.app-icon.width > 0: Image {
                    width: parent.width;
                    height: parent.height;
                    source: parent.app-icon;
                    image-fit: contain;
                }

                // Fallback glyph for apps that ship no bundled icon.
                if self.app-icon.width <= 0: Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    name: "grid-view";
                    size: 64px;
                    color: root.icon-foreground-color;
                }
            }
        }
    }

    if show-label: Text {
        x: -8px + root.visual-offset-x;
        y: 132px + root.visual-offset-y + root.press-offset-y;
        width: parent.width + 16px;
        height: 28px;
        text: item.label;
        color: CurrentTheme.is-dark ? Palette.white : Palette.content-primary;
        font-size: 20px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            hold-timer.running = false;
            if (root.ignore-release-click) {
                root.ignore-release-click = false;
                return;
            }
            // A dimmed tile still reports its tap: the launch is attempted, and Rust shows why it
            // was refused. `enabled` only dims the tile.
            if (!State.rearrange-mode) {
                root.activate(shell.absolute-position.x + shell.width / 2, shell.absolute-position.y + shell.height / 2, root.item.id);
            }
        }

        moved => {
            if (Math.abs(self.mouse-x - self.pressed-x) > 10px || Math.abs(self.mouse-y - self.pressed-y) > 10px) {
                root.ignore-release-click = true;
                hold-timer.running = false;
                root.ignore-release-click = true;
            }
            if (State.rearrange-mode) {
                root.store-pointer();
                root.drag-moved();
            }
        }

        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.ignore-release-click = false;
                hold-timer.running = false;
                if (State.rearrange-mode) {
                    root.store-pointer();
                    root.store-grab();
                    root.drag-started();
                } else {
                    hold-timer.running = true;
                }
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                hold-timer.running = false;
                if (State.rearrange-mode) {
                    root.store-pointer();
                    root.drag-moved();
                    root.drag-finished();
                }
            }
        }
    }

    if State.rearrange-mode && root.item.can-remove: RemoveBadge {
        x: root.visual-offset-x - 4px;
        y: root.visual-offset-y - 4px;
        z: 100;
        clicked => {
            hold-timer.running = false;
            root.ignore-release-click = true;
            CB.remove-item-requested(root.item.id);
        }
    }
}

component LauncherCollection inherits Rectangle {
    in property <[LauncherItemData]> items;
    in property <string> collection-id;
    in property <DropTarget> cross-target: {
        id: "",
        left: 0px,
        top: 0px,
        width: 0px,
        height: 0px,
        item-count: 0,
        slot-count: 0,
        columns: 3,
        shell-size: 128px,
        slot-height: 160px,
        row-gap: 24px,
        column-gap: 24px,
    };
    in property <DropTarget> page-target: {
        id: "",
        left: 0px,
        top: 0px,
        width: 0px,
        height: 0px,
        item-count: 0,
        slot-count: 0,
        columns: 3,
        shell-size: 128px,
        slot-height: 160px,
        row-gap: 24px,
        column-gap: 24px,
    };
    in property <bool> show-labels: true;
    in property <bool> handles-background-input: true;
    in property <int> columns: 3;
    in property <int> slot-count: items.length;
    in property <length> slot-height: show-labels ? 160px : 128px;
    in property <length> shell-size: 128px;
    in property <length> row-gap: 24px;
    in property <length> column-gap: show-labels ? 24px : 8px;

    private property <int> safe-columns: Math.max(1, columns);
    private property <int> bounded-slot-count: Math.max(items.length, slot-count);
    private property <bool> drag-active: false;
    private property <int> dragged-index: -1;
    private property <int> target-index: -1;
    private property <[length]> jiggle-table: [-1.5px, 1.0px, 0.5px, -0.5px, 1.5px, -1.0px];
    private property <bool> active-local-drag:
        drag-active && State.drag-overlay-visible && State.drag-source-collection-id == root.collection-id;
    private property <bool> external-hover-active:
        State.drag-overlay-visible && State.drag-source-collection-id != "" && State.drag-source-collection-id != root.collection-id && State.drag-hover-collection-id == root.collection-id;

    width: safe-columns * shell-size + Math.max(0, safe-columns - 1) * column-gap;
    height: Math.ceil(bounded-slot-count / safe-columns) * slot-height + Math.max(0, Math.ceil(bounded-slot-count / safe-columns) - 1) * row-gap;
    z: active-local-drag ? 900 : 0;

    function slot-x(index: int) -> length {
        Math.mod(index, safe-columns) * (shell-size + column-gap);
    }
    function slot-y(index: int) -> length {
        Math.floor(index / safe-columns) * (slot-height + row-gap);
    }
    function jiggle-x-for(index: int) -> length {
        root.jiggle-table[Math.mod(index * 3 + State.jiggle-step, 6)]
    }
    function jiggle-y-for(index: int) -> length {
        root.jiggle-table[Math.mod(index * 5 + State.jiggle-step, 6)]
    }
    function clamped-display-slot(index: int) -> int {
        Math.max(0, Math.min(root.bounded-slot-count - 1, index))
    }
    function local-drag-display-slot(index: int) -> int {
        if (index == root.dragged-index) {
            return root.dragged-index;
        }
        if (root.target-index > root.dragged-index && index > root.dragged-index && index <= root.target-index) {
            return index - 1;
        }
        if (root.target-index < root.dragged-index && index >= root.target-index && index < root.dragged-index) {
            return index + 1;
        }
        return index;
    }
    // Mirrors how the drop slides its run: toward the free slot the model picked,
    // which can sit on either side of the hovered one.
    function external-hover-display-slot(index: int) -> int {
        if (State.drag-hover-slide-target < 0) {
            return index;
        }
        if (index >= State.drag-hover-index && index < State.drag-hover-slide-target) {
            return index + 1;
        }
        if (index > State.drag-hover-slide-target && index <= State.drag-hover-index) {
            return index - 1;
        }
        return index;
    }
    // A full dock swaps the hovered icon out; a full page pushes its last one onto
    // the next page. Either way that icon is leaving, so fade it instead of stacking
    // it on a neighbour.
    function external-hover-leaves(index: int) -> bool {
        if (!root.external-hover-active) {
            return false;
        }
        if (State.drag-hover-slide-target < 0) {
            return index == State.drag-hover-index;
        }
        return root.external-hover-display-slot(index) >= root.bounded-slot-count;
    }
    // Map the model slot to the animated visual slot while drag operations make room.
    function display-slot(index: int) -> int {
        if (root.active-local-drag) {
            return root.clamped-display-slot(root.local-drag-display-slot(index));
        }
        if (root.external-hover-active) {
            return root.clamped-display-slot(root.external-hover-display-slot(index));
        }
        return root.clamped-display-slot(index);
    }
    // Center of the dragged icon, which trails the finger by wherever inside the
    // icon the drag began.
    function drag-center-x() -> length {
        State.drag-overlay-abs-x + root.shell-size / 2
    }
    function drag-center-y() -> length {
        State.drag-overlay-abs-y + root.shell-size / 2
    }
    function drag-hit-x() -> length {
        State.drag-pointer-abs-x
    }
    function drag-hit-y() -> length {
        State.drag-pointer-abs-y
    }
    function clamped-axis-index(position: length, origin: length, item-size: length, gap: length, count: int) -> int {
        Math.max(0, Math.min(Math.max(0, count - 1), Math.round((position - origin - item-size / 2) / (item-size + gap))))
    }
    function grid-index(position-x: length, position-y: length, left: length, top: length, item-width: length, item-height: length, column-gap: length, row-gap: length, columns: int, rows: int, max-index: int, ) -> int {
        Math.max(
            0,
            Math.min(
                max-index,
                root.clamped-axis-index(position-x, left, item-width, column-gap, columns) + root.clamped-axis-index(
                    position-y,
                    top,
                    item-height,
                    row-gap,
                    rows,
                ) * Math.max(1, columns)))
    }
    function target-slot-count(target: DropTarget) -> int {
        Math.max(target.item-count, target.slot-count)
    }
    function is-point-over-target(target: DropTarget, x: length, y: length, x-slack: length) -> bool {
        target.id != "" && x >= target.left - x-slack && x <= target.left + target.width + x-slack && y >= target.top && y <= target.top + target.height
    }
    // Either point can land the drop. The finger alone rejects drops that visibly
    // sit on the target; the icon center alone can want a finger position off the
    // bottom of the screen, because the dock is hard against the edge.
    function is-over-target(target: DropTarget, x-slack: length) -> bool {
        root.is-point-over-target(target, root.drag-hit-x(), root.drag-hit-y(), x-slack) || root.is-point-over-target(target, root.drag-center-x(), root.drag-center-y(), x-slack)
    }
    // Land where the icon looks like it will land, falling back to the finger
    // when the icon is off the target.
    function drop-target-x(target: DropTarget, x-slack: length) -> length {
        if (root.is-point-over-target(target, root.drag-center-x(), root.drag-center-y(), x-slack)) {
            return root.drag-center-x();
        }
        return root.drag-hit-x();
    }
    function drop-target-y(target: DropTarget, x-slack: length) -> length {
        if (root.is-point-over-target(target, root.drag-center-x(), root.drag-center-y(), x-slack)) {
            return root.drag-center-y();
        }
        return root.drag-hit-y();
    }
    function drop-target-index(target: DropTarget, x-slack: length) -> int {
        root.grid-index(
            root.drop-target-x(target, x-slack),
            root.drop-target-y(target, x-slack),
            target.left,
            target.top,
            target.shell-size,
            target.slot-height,
            target.column-gap,
            target.row-gap,
            Math.max(1, target.columns),
            Math.ceil((root.target-slot-count(target) + 1) / Math.max(1, target.columns)),
            root.target-slot-count(target),
        )
    }
    function is-over-cross-target() -> bool {
        root.is-over-target(root.cross-target, 0px)
    }
    function cross-target-index() -> int {
        root.drop-target-index(root.cross-target, 0px)
    }
    // Horizontal slack so releases inside the screen-edge flip zones still count
    // as drops on the visible page.
    property <length> page-target-x-slack: 48px;
    function is-over-page-target() -> bool {
        root.is-over-target(root.page-target, root.page-target-x-slack)
    }
    function page-target-index() -> int {
        root.drop-target-index(root.page-target, root.page-target-x-slack)
    }

    // Nearest same-collection slot for the dragged item. Rounding is relative to the
    // slot origin so the flip boundary sits halfway between slots, and each axis is
    // clamped to the grid so drift on one axis cannot push the index out of range.
    function clamped-target() -> int {
        root.grid-index(
            root.drag-center-x(),
            root.drag-center-y(),
            root.absolute-position.x,
            root.absolute-position.y,
            root.shell-size,
            root.slot-height,
            root.column-gap,
            root.row-gap,
            root.safe-columns,
            Math.ceil(root.bounded-slot-count / root.safe-columns),
            root.bounded-slot-count - 1,
        )
    }
    function overlay-abs-x() -> length {
        State.drag-pointer-abs-x - State.drag-grab-x
    }
    function overlay-abs-y() -> length {
        State.drag-pointer-abs-y - State.drag-grab-y
    }

    function clear-drag-state() {
        State.drag-source-collection-id = "";
        State.drag-overlay-visible = false;
        State.drag-hover-collection-id = "";
        State.drag-hover-index = -1;
        State.drag-hover-slide-target = -1;
        State.drag-displaced-active = false;
        root.drag-active = false;
        root.dragged-index = -1;
        root.target-index = -1;
    }
    TouchArea {
        width: root.width;
        height: root.height;
        enabled: root.handles-background-input && State.rearrange-mode && State.drag-source-collection-id == "";

        clicked => {
            State.rearrange-mode = false;
            root.clear-drag-state();
        }
    }

    // Kept alive for the whole drag so the swap cross-fades: a fresh element would
    // start at full opacity.
    if root.active-local-drag: LauncherCollectionItem {
        item: State.drag-displaced-item;
        show-label: root.show-labels;
        is-leaving: !State.drag-displaced-active;
        x: root.slot-x(root.dragged-index);
        y: root.slot-y(root.dragged-index);
    }

    for item[index] in items: icon := LauncherCollectionItem {
        item: item;
        show-label: root.show-labels;
        is-dragging: root.active-local-drag && root.dragged-index == item.slot-index;
        jiggle-x: root.jiggle-x-for(item.slot-index);
        jiggle-y: root.jiggle-y-for(item.slot-index);
        x: root.slot-x(root.display-slot(item.slot-index));
        y: root.slot-y(root.display-slot(item.slot-index));
        visible: !(root.active-local-drag && root.dragged-index == item.slot-index);
        is-leaving: root.external-hover-leaves(item.slot-index);

        animate x {
            duration: 180ms;
            easing: ease-in-out;
        }

        animate y {
            duration: 180ms;
            easing: ease-in-out;
        }

        activate(abs-x, abs-y, item-id) => {
            CB.item-clicked(abs-x, abs-y, item-id);
        }

        drag-started => {
            root.drag-active = true;
            root.dragged-index = item.slot-index;
            root.target-index = item.slot-index;
            State.drag-source-collection-id = root.collection-id;
            State.drag-hover-collection-id = "";
            State.drag-hover-index = -1;
            State.drag-hover-slide-target = -1;
            State.drag-displaced-active = false;
            State.drag-overlay-visible = true;
            State.drag-overlay-show-label = root.show-labels;
            State.drag-overlay-item = item;
            State.drag-overlay-abs-x = root.overlay-abs-x();
            State.drag-overlay-abs-y = root.overlay-abs-y();
        }

        drag-moved => {
            if (root.active-local-drag && root.dragged-index == item.slot-index) {
                State.drag-overlay-abs-x = root.overlay-abs-x();
                State.drag-overlay-abs-y = root.overlay-abs-y();
                if (root.is-over-page-target()) {
                    State.drag-hover-collection-id = root.page-target.id;
                    State.drag-hover-index = root.page-target-index();
                    State.drag-hover-slide-target = CB.drop-slide-target(root.page-target.id, State.drag-hover-index);
                    State.drag-displaced-item = CB.displaced-item(root.page-target.id, State.drag-hover-index);
                    State.drag-displaced-active = State.drag-displaced-item.id != "";
                    root.target-index = root.dragged-index;
                } else if (root.is-over-cross-target()) {
                    State.drag-hover-collection-id = root.cross-target.id;
                    State.drag-hover-index = root.cross-target-index();
                    State.drag-hover-slide-target = CB.drop-slide-target(root.cross-target.id, State.drag-hover-index);
                    State.drag-displaced-item = CB.displaced-item(root.cross-target.id, State.drag-hover-index);
                    State.drag-displaced-active = State.drag-displaced-item.id != "";
                    root.target-index = root.dragged-index;
                } else {
                    State.drag-hover-collection-id = "";
                    State.drag-hover-index = -1;
                    State.drag-hover-slide-target = -1;
                    State.drag-displaced-active = false;
                    root.target-index = root.clamped-target();
                }
            }
        }

        drag-finished => {
            if (root.active-local-drag && root.dragged-index == item.slot-index) {
                if (root.is-over-page-target()) {
                    CB.move-item(
                        root.collection-id,
                        root.dragged-index,
                        root.page-target.id,
                        root.page-target-index(),
                    );
                } else if (root.is-over-cross-target()) {
                    CB.move-item(
                        root.collection-id,
                        root.dragged-index,
                        root.cross-target.id,
                        root.cross-target-index(),
                    );
                } else if (root.target-index != root.dragged-index) {
                    CB.move-item(root.collection-id, root.dragged-index, root.collection-id, root.target-index);
                }
                root.clear-drag-state();
            }
        }
    }
}

component Dock inherits Rectangle {
    in property <length> content-width;
    in property <DropTarget> active-target: {
        id: "",
        left: 0px,
        top: 0px,
        width: 0px,
        height: 0px,
        item-count: 0,
        slot-count: 0,
        columns: 3,
        shell-size: 128px,
        slot-height: 160px,
        row-gap: 24px,
        column-gap: 24px,
    };
    private property <length> icon-inset-x: 24px;
    private property <length> icon-inset-y: 12px;
    private property <length> image-side-margin: 12px;
    private property <length> image-bottom-margin: 12px;

    width: content-width;
    height: 164px;
    background: transparent;
    clip: false;
    z: State.drag-source-collection-id == "dock" ? 950 : 0;

    Image {
        x: root.image-side-margin;
        y: parent.height - self.height - root.image-bottom-margin;
        width: 456px;
        height: 152px;
        source: CurrentTheme.is-dark ? @image-url("../../assets/launcher-dock-dark.png") : @image-url("../../assets/launcher-dock-light.png");
        image-fit: fill;
    }

    LauncherCollection {
        x: root.icon-inset-x;
        y: root.icon-inset-y;
        width: parent.width - root.icon-inset-x * 2;
        height: 128px;
        items: State.dock-items;
        collection-id: "dock";
        show-labels: false;
        columns: 3;
        slot-count: 3;
        slot-height: 128px;
        row-gap: 0px;
        column-gap: 24px;
        cross-target: root.active-target;
    }
}

component LauncherPaginator inherits Rectangle {
    in property <[LauncherPageData]> pages: [];
    in-out property <int> current-page: 0;
    in property <length> first-collection-height: 344px;
    in property <length> standard-collection-height: 528px;
    in property <length> content-width;
    in property <length> collection-inset-x: 12px;
    in property <length> collection-offset-y: -3px;
    in property <length> graph-shadow-top-overhang;
    in property <DropTarget> dock-target: {
        id: "",
        left: 0px,
        top: 0px,
        width: 0px,
        height: 0px,
        item-count: 0,
        slot-count: 0,
        columns: 3,
        shell-size: 128px,
        slot-height: 128px,
        row-gap: 0px,
        column-gap: 24px,
    };
    in property <DropTarget> active-target: {
        id: "",
        left: 0px,
        top: 0px,
        width: 0px,
        height: 0px,
        item-count: 0,
        slot-count: 0,
        columns: 3,
        shell-size: 128px,
        slot-height: 160px,
        row-gap: 24px,
        column-gap: 24px,
    };
    in property <length> page-gap: 64px;

    private property <DropTarget> empty-target: {
        id: "",
        left: 0px,
        top: 0px,
        width: 0px,
        height: 0px,
        item-count: 0,
        slot-count: 0,
        columns: 3,
        shell-size: 128px,
        slot-height: 160px,
        row-gap: 24px,
        column-gap: 24px,
    };
    private property <length> rearrange-top-bleed: State.rearrange-mode ? 16px : 0px;
    private property <length> graph-region-height: 198px;
    private property <length> first-page-content-height: first-collection-height + graph-region-height;
    private property <length> page-viewport-height: first-page-content-height > standard-collection-height ? first-page-content-height : standard-collection-height;
    private property <length> page-span: content-width + page-gap;
    private property <length> graph-card-height: 178px;
    private property <bool> source-is-only-item-on-last-page:
        root.pages.length > 0 && State.drag-source-collection-id == root.pages[root.pages.length - 1].id && root.pages[root.pages.length - 1].items.length == 1;
    // The price graph owns its scrub gesture; the page swipe hit area starts
    // below it while page 0 is visible.
    private property <length> swipe-hit-top: root.current-page == 0 ? root.graph-card-height : 0px;
    // While dragging an icon, holding the finger inside an edge zone flips to the
    // adjacent page after a short dwell so the icon can be dropped there.
    private property <length> edge-zone-width: 18px;
    private property <bool> drag-in-progress: State.drag-overlay-visible && State.drag-source-collection-id != "";
    private property <int> drag-edge-direction: !drag-in-progress ? 0 : (State.drag-pointer-abs-x < root.absolute-position.x + edge-zone-width ? -1 : (State.drag-pointer-abs-x > root.absolute-position.x + root.width - edge-zone-width ? 1 : 0));
    private property <bool> can-open-new-page-target:
        drag-in-progress && !root.source-is-only-item-on-last-page && root.current-page >= root.pages.length - 1;
    private property <bool> show-new-page-target:
        root.can-open-new-page-target && (root.drag-edge-direction > 0 || root.current-page == root.pages.length);
    private property <int> visible-page-count: root.pages.length + (root.show-new-page-target ? 1 : 0);
    private property <int> max-visible-page-index: Math.max(0, root.visible-page-count - 1);

    changed drag-in-progress => {
        if (!self.drag-in-progress && root.current-page >= root.pages.length) {
            root.current-page = Math.max(0, root.pages.length - 1);
        }
    }

    edge-flip-timer := Timer {
        interval: 800ms;
        running: root.drag-edge-direction != 0 && root.current-page + root.drag-edge-direction >= 0 && root.current-page + root.drag-edge-direction <= root.max-visible-page-index;
        triggered() => {
            root.current-page = Math.max(0, Math.min(root.max-visible-page-index, root.current-page + root.drag-edge-direction));
        }
    }

    width: content-width;
    height: page-viewport-height + (visible-page-count > 1 ? 28px : 0px);
    clip: false;
    z: State.drag-source-collection-id != "" && State.drag-source-collection-id != "dock" ? 950 : 0;

    function page-collection-y(page-index: int) -> length {
        page-index == 0 ? root.graph-region-height + root.collection-offset-y : 0px
    }
    function page-collection-height(page-index: int) -> length {
        page-index == 0 ? root.first-collection-height : root.standard-collection-height
    }
    function page-collection-slot-count(page-index: int) -> int {
        (page-index == 0 ? 2 : 3) * 3
    }
    function commit-page-swipe(dx: length) {
        if (dx > root.width / 4) {
            root.current-page = Math.max(0, root.current-page - 1);
        } else if (dx < -root.width / 4) {
            root.current-page = Math.min(root.pages.length - 1, root.current-page + 1);
        }
    }
    private property <bool> page-swiping: sgr.swiping || rearrange-sgr.swiping;
    private property <length> page-swipe-dx: sgr.swiping ? sgr.current-position.x - sgr.pressed-position.x : rearrange-sgr.swiping ? rearrange-sgr.current-position.x - rearrange-sgr.pressed-position.x : 0px;

    VerticalLayout {
        width: root.width;
        height: root.height;
        alignment: start;
        spacing: 0px;

        Rectangle {
            width: root.width;
            height: root.page-viewport-height;
            background: transparent;
            clip: false;

            Rectangle {
                y: -root.rearrange-top-bleed - root.graph-shadow-top-overhang;
                width: parent.width;
                height: root.page-viewport-height + root.rearrange-top-bleed + root.graph-shadow-top-overhang;
                background: transparent;
                clip: true;

                property <length> swipe-area-top: root.rearrange-top-bleed + root.graph-shadow-top-overhang + root.swipe-hit-top;

                rearrange-sgr := SwipeGestureHandler {
                    enabled: State.rearrange-mode && State.drag-source-collection-id == "";
                    x: 0px;
                    y: parent.swipe-area-top;
                    width: root.content-width;
                    height: max(0px, root.page-viewport-height - root.swipe-hit-top);
                    handle-swipe-right: root.current-page > 0;
                    handle-swipe-left: root.current-page < root.pages.length - 1;

                    swiped => {
                        root.commit-page-swipe(self.current-position.x - self.pressed-position.x);
                    }

                    background-touch := TouchArea {
                        property <bool> moved-past-click-threshold: false;
                        width: parent.width;
                        height: parent.height;
                        enabled: parent.enabled;

                        clicked => {
                            if (!self.moved-past-click-threshold) {
                                State.rearrange-mode = false;
                            }
                        }

                        moved => {
                            if (Math.abs(self.mouse-x - self.pressed-x) > 10px || Math.abs(self.mouse-y - self.pressed-y) > 10px) {
                                self.moved-past-click-threshold = true;
                            }
                        }

                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                self.moved-past-click-threshold = false;
                            }
                        }
                    }
                }

                sgr := SwipeGestureHandler {
                    enabled: !State.rearrange-mode && State.drag-source-collection-id == "";
                    x: 0px;
                    y: parent.swipe-area-top;
                    width: root.content-width;
                    height: max(0px, root.page-viewport-height - root.swipe-hit-top);
                    handle-swipe-right: root.current-page > 0;
                    handle-swipe-left: root.current-page < root.pages.length - 1;

                    swiped => {
                        root.commit-page-swipe(self.current-position.x - self.pressed-position.x);
                    }

                    HorizontalLayout {
                        property <length> position: -root.current-page * root.page-span;
                        property <length> swipe-offset;
                        x: position + swipe-offset;
                        y: -root.swipe-hit-top;
                        spacing: root.page-gap;

                        animate position {
                            duration: 200ms;
                            easing: ease-in-out;
                        }

                        states [
                            swiping when root.page-swiping: {
                                swipe-offset: root.page-swipe-dx;
                                // Animate only on release so the strip tracks the finger while dragging.
                                out {
                                    animate swipe-offset {
                                        duration: 200ms;
                                        easing: ease-in-out;
                                    }
                                }
                            }
                        ]

                        for page[page-index] in root.pages: Rectangle {
                            width: root.content-width;
                            height: root.page-viewport-height;

                            if page-index == 0: PriceGraph {
                                x: 0px;
                                y: 0px;
                                content-width: root.content-width;
                                card-height: root.graph-card-height;
                                shadow-top-overhang: root.graph-shadow-top-overhang;
                            }

                            LauncherCollection {
                                x: root.collection-inset-x;
                                y: root.page-collection-y(page-index);
                                width: root.content-width - root.collection-inset-x * 2;
                                height: root.page-collection-height(page-index);
                                items: page.items;
                                collection-id: page.id;
                                show-labels: true;
                                handles-background-input: false;
                                columns: 3;
                                slot-height: 160px;
                                row-gap: 24px;
                                column-gap: 24px;
                                slot-count: root.page-collection-slot-count(page-index);
                                cross-target: root.dock-target;
                                page-target: root.current-page != page-index ? root.active-target : root.empty-target;
                            }
                        }
                    }

                    if root.show-new-page-target: Rectangle {
                        width: root.content-width;
                        height: root.page-viewport-height;
                        background: transparent;
                    }
                }
            }
        }

        if visible-page-count > 1: HorizontalLayout {
            width: root.width;
            height: 28px;
            alignment: center;
            spacing: 12px;
            padding-top: 16px;

            for page[page-index] in pages: PageDot {
                page-index: page-index;
                selected: page-index == root.current-page;
                selected-page(idx) => {
                    root.current-page = idx;
                }
            }

            if root.show-new-page-target: PageDot {
                page-index: root.pages.length;
                selected: root.current-page == root.pages.length;
                selected-page(idx) => {
                    root.current-page = idx;
                }
            }
        }
    }
}

export component MainPage inherits BasePage {
    in property <MainProps> props;

    private property <length> grid-side-padding: 24px;
    private property <length> frame-side-padding: 12px;
    private property <length> page-collection-inset: grid-side-padding - frame-side-padding;
    private property <length> page-collection-offset-y: -3px;
    private property <length> paginator-top: 12px;
    private property <length> content-width: root.width - frame-side-padding * 2;
    private property <length> dock-left: 0px;
    private property <length> dock-height: 164px;
    private property <length> dock-top: root.height - dock-height;
    private property <length> dock-width: root.width;
    private property <length> icon-row-height: 160px;
    private property <length> icon-row-gap: 24px;
    private property <int> graph-page-grid-rows: 2;
    private property <int> standard-page-grid-rows: 3;
    private property <length> graph-height: 178px;
    private property <length> graph-bottom-gap: 20px;
    private property <length> graph-shadow-top-overhang: 6px;
    private property <length> graph-page-height: graph-page-grid-rows * icon-row-height + Math.max(0, graph-page-grid-rows - 1) * icon-row-gap;
    private property <length> standard-page-height: standard-page-grid-rows * icon-row-height + Math.max(0, standard-page-grid-rows - 1) * icon-row-gap;
    private property <length> active-page-left: frame-side-padding + page-collection-inset;
    private property <length> active-page-top:
        paginator-top + (State.current-page == 0 ? graph-height + graph-bottom-gap + page-collection-offset-y : 0px);
    private property <length> active-page-width: content-width - page-collection-inset * 2;
    private property <length> active-page-height: State.current-page == 0 ? graph-page-height : standard-page-height;
    private property <bool> active-page-is-new-page: State.current-page >= State.pages.length;
    private property <int> active-page-existing-index: Math.min(State.current-page, Math.max(0, State.pages.length - 1));
    private property <length> dock-icon-inset-x: 24px;
    private property <length> dock-icon-inset-y: 12px;
    private property <length> dock-collection-left: dock-left + dock-icon-inset-x;
    private property <length> dock-collection-top: dock-top + dock-icon-inset-y;
    private property <length> dock-collection-width: dock-width - dock-icon-inset-x * 2;
    private property <length> dock-collection-height: 128px;
    private property <DropTarget> active-page-target: {
        id: root.active-page-is-new-page ? "new-page" : State.pages[root.active-page-existing-index].id,
        left: root.active-page-left,
        top: root.active-page-top,
        width: root.active-page-width,
        height: root.active-page-height,
        item-count: root.active-page-is-new-page ? 0 : State.pages[root.active-page-existing-index].items.length,
        slot-count: (State.current-page == 0 ? graph-page-grid-rows : standard-page-grid-rows) * 3,
        columns: 3,
        shell-size: 128px,
        slot-height: 160px,
        row-gap: 24px,
        column-gap: 24px,
    };
    private property <DropTarget> dock-target: {
        id: "dock",
        left: root.dock-collection-left,
        top: root.dock-collection-top,
        width: root.dock-collection-width,
        height: root.dock-collection-height,
        item-count: State.dock-items.length,
        slot-count: 3,
        columns: 3,
        shell-size: 128px,
        slot-height: 128px,
        row-gap: 0px,
        column-gap: 24px,
    };

    background: transparent;

    Timer {
        interval: 130ms;
        running: State.rearrange-mode;
        triggered() => {
            State.jiggle-step = Math.mod(State.jiggle-step + 1, 6);
        }
    }

    LauncherPaginator {
        x: frame-side-padding;
        y: paginator-top;
        content-width: root.content-width;
        collection-inset-x: root.page-collection-inset;
        collection-offset-y: root.page-collection-offset-y;
        graph-shadow-top-overhang: root.graph-shadow-top-overhang;
        first-collection-height: root.graph-page-height;
        standard-collection-height: root.standard-page-height;
        pages: State.pages;
        current-page <=> State.current-page;
        dock-target: root.dock-target;
        active-target: root.active-page-target;
    }

    Dock {
        x: root.dock-left;
        y: root.dock-top;
        content-width: root.dock-width;
        active-target: root.active-page-target;
    }

    if State.drag-overlay-visible: LauncherCollectionItem {
        item: State.drag-overlay-item;
        show-label: State.drag-overlay-show-label;
        is-dragging: true;
        x: State.drag-overlay-abs-x - root.absolute-position.x;
        y: State.drag-overlay-abs-y - root.absolute-position.y;
        z: 2000;
    }
}
