// One permission subgroup: the unit the user sees and toggles. The individual
// messages behind it stay internal to the OS.
export struct AppPermissionSubgroup {
    key: string,
    label: string,
    approved: bool,
}

// A top-level permission group, under which the subgroups collapse.
export struct AppPermissionGroup {
    key: string,
    label: string,
    subgroups: [AppPermissionSubgroup],
}

export struct InstalledApp {
    app_id: string,
    name: string,
    publisher: string,
    can_launch: bool,
    // Why the app cannot be launched, ready to show; empty when it can.
    launch_blocked_reason: string,
    can_remove: bool,
    // A Flux child app runs inside the Flux emulator, so it has no direct-launch
    // affordance here: the play button and Open App button are hidden for it.
    is_flux: bool,
    version: string,
    size: string,
    app_hash: string,
    description: string,
    basic_permissions: [AppPermissionGroup],
    approvable_permissions: [AppPermissionGroup],
}

// A single row in the unified, virtualized apps list. The list mixes section
// headers, installed-app cards, and the fixed settings rows into one ListView
// model (Slint can't concatenate the dynamic apps model with static rows, so
// Rust assembles it). `kind` + `action_id` identify each row so the delegate
// can pick localized text and behavior; `first`/`last`/`show_divider` drive the
// per-row card chrome (rounded corners on group edges, dividers between rows).
export enum AppsListRowKind {
    section-header,
    app,
    action,
    toggle,
    empty,
}

export struct AppsListRow {
    kind: AppsListRowKind,
    action_id: int,
    app: InstalledApp,
    first: bool,
    last: bool,
    show_divider: bool,
}

export struct AllowedPublisher {
    claimed_name: string,
    claimed_organization: string,
    confirmation_claimed_name: string,
    confirmation_claimed_organization: string,
    contact_email: string,
    support_url: string,
    fingerprint: string,
    fingerprint_display: string,
    short_fingerprint: string,
    status: string,
    list_metadata: string,
    expiration_date: string,
    date_added: string,
    public_key_display: string,
    serial_number: string,
    subject: string,
    basic_constraints: string,
    key_usage: string,
    extended_key_usage: string,
}

export enum AllowedPublisherPreviewResult {
    canceled,
    ready,
    failed,
    // A certificate Passport accepts, outside its validity window right now. Kept apart from
    // `failed` so the page can point at the date instead of at the certificate.
    not-valid-now,
}

export struct AllowedPublisherRemovalResult {
    success: bool,
    title: string,
    text: string,
}

// Outcome of installing an app from an archive the user picked. `canceled` means the
// user backed out of the file picker, so nothing is shown; otherwise the page shows
// `title`/`text` in a success or error modal.
export struct InstallAppResult {
    canceled: bool,
    success: bool,
    title: string,
    text: string,
}

export enum AllowedPublisherImportResult {
    installed,
    invalid,
    not-valid-now,
    save-failed,
}

export global AppManagementGlobal {
    in property <[AppsListRow]> apps-list-rows: [];
    in-out property <InstalledApp> selected-app;
    callback refresh-installed-apps();
    callback select-installed-app(string) -> bool;
    callback launch-installed-app(string);
    callback set-app-permission-subgroup-grant(string, string, bool) -> bool;
    callback remove-installed-app(string) -> string;
    /// Starts an install and returns at once; the result arrives on `install-result`, which is
    /// unset again while one is running so a second tap cannot start over the first.
    callback install-app();
    in property <bool> installing;
    /// in-out so the page can clear it when the user dismisses the outcome: a page-side dismissed
    /// flag would have to be assigned, and an assignment drops its binding for good.
    in-out property <InstallAppResult> install-result;
    /// Bundled app icon for an app id, in its dark variant when the second
    /// argument is true and the app ships one.
    pure callback app-icon(string, bool) -> image;

    in property <[AllowedPublisher]> allowed-publishers: [];
    in-out property <AllowedPublisher> selected-allowed-publisher;
    in property <AllowedPublisher> pending-allowed-publisher;
    /// Why the certificate the user just picked cannot be used, ready to show.
    in property <string> publisher-problem;
    callback select-allowed-publisher(string) -> bool;
    callback refresh-allowed-publishers();
    callback preview-allowed-publisher() -> AllowedPublisherPreviewResult;
    callback allow-pending-publisher() -> AllowedPublisherImportResult;
    callback clear-pending-allowed-publisher();
    callback remove-allowed-publisher(string) -> AllowedPublisherRemovalResult;
}
