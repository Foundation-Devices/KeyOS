import { TR2, TrId } from "../../gen/tr.slint";
import {
    TextSm,
    Button,
    SwitchControlled,
    MenuSectionContainer,
    MenuItemLayout,
    MenuSectionLayout,
    MenuActionItem,
    HLine,
    BasePage,
    PageBody,
    ContentSection,
    Dialog,
} from "@ui/widgets.slint";
import { Size, Palette, Timings, UISize } from "@ui/theme.slint";

import { SettingsNavHeader } from "../../widgets/nav-header.slint";
import { Navigate } from "../../gen/navigate.slint";

import { BackupProps } from "props.slint";
import { EraseStatus } from "../settings/advanced/erase-device/props.slint";
import { BackupGlobal, BackupStatus } from "../../globals/backup-global.slint";
import { QlGlobal } from "../../globals/ql-global.slint";

export component BackupPage inherits BasePage {
    in property <BackupProps> props;

    private property <bool> envoy-connected: QlGlobal.ql-live;
    private property <bool> creating-backup: BackupGlobal.status == BackupStatus.Creating;

    VerticalLayout {
        SettingsNavHeader {
            title: TR2.lookup(TrId.BackupTitle);
        }

        PageBody {
            ContentSection {
                VerticalLayout {
                    spacing: Size.sz4;

                    if !envoy-connected: HorizontalLayout {
                        alignment: start;
                        TextSm {
                            color: Palette.content-tertiary;
                            text: TR2.lookup(TrId.BackupContent);
                        }
                    }

                    MenuSectionContainer {
                        VerticalLayout {
                            padding: Size.sz0_25;
                            alignment: start;
                            MenuItemLayout {
                                first: true;
                                last: true;
                                label: TR2.lookup(TrId.BackupMagicBackups);

                                switch := SwitchControlled {
                                    checked: BackupGlobal.magic-backup-enabled;
                                    enabled: false; // see SFT-6525
                                }

                                clicked => {
                                    BackupGlobal.set-magic-backup-enabled(switch.checked);
                                }
                            }
                        }
                    }

                    TextSm {
                        color: Palette.content-tertiary;
                        text: BackupGlobal.last-backup-duration == "" ? TR2.lookup(TrId.CommonBackupNeverBackedUp) : TR2.format(TrId.BackupLastUpdatedXAgo, [BackupGlobal.last-backup-duration]);
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                if BackupGlobal.magic-backup-enabled: Button {
                    label: creating-backup ? TR2.lookup(TrId.BackupBackingUp) : TR2.lookup(TrId.BackupBackUpNow);
                    enabled: envoy-connected && !creating-backup;
                    loading: creating-backup;
                    background: Palette.background-brand;
                    clicked => {
                        BackupGlobal.create-backup()
                    }
                }

                MenuSectionContainer {
                    MenuSectionLayout {
                        MenuActionItem {
                            first: true;
                            last: true;
                            label: TR2.lookup(TrId.BackupVerifyKeycards);
                            clicked => {
                                Navigate.verify-backup({ });
                            }
                        }
                    }
                }

                MenuSectionContainer {
                    MenuSectionLayout {
                        MenuActionItem {
                            first: true;
                            label: TR2.lookup(TrId.BackupAdvancedBackups);
                            clicked => {
                                Navigate.advanced-backup({ });
                            }
                        }

                        HLine { }

                        MenuActionItem {
                            last: true;
                            label: TR2.lookup(TrId.BackupRestoreBackup);
                            clicked => {
                                Navigate.erase-device({ status: EraseStatus.confirmation }, { });
                            }
                        }
                    }
                }
            }
        }
    }

    if BackupGlobal.status == BackupStatus.Error: Rectangle {
        background: Palette.overlay;
        Dialog {
            icon: "decline-circle";
            title: TR2.lookup(TrId.BackupModalBackupFailedHeader);
            message: TR2.lookup(TrId.BackupModalBackupFailedContent);
            show-ok: true;
            show-cancel: true;
            ok-text: TR2.lookup(TrId.CommonButtonDismiss);
            cancel-text: TR2.lookup(TrId.CommonButtonRetry);
            width: UISize.modal-width;
            on-ok => {
                BackupGlobal.status = BackupStatus.Idle;
            }
            on-cancel => {
                BackupGlobal.create-backup();
            }
        }
    }
}
