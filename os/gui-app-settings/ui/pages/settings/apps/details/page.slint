import {
    BasePage,
    Button,
    ConfirmationModal,
    ContentSection,
    ErrorModal,
    HLine,
    Icon,
    MenuSection,
    MenuSectionLayout,
    ScrollFadeMask,
    Switch,
    TextLg,
    TextMd,
    TextSm,
} from "@ui/widgets.slint";
import {
    CurrentTheme,
    Font,
    IconSize,
    Importance,
    Palette,
    Size,
} from "@ui/theme.slint";

import { Navigate } from "../../../../gen/navigate.slint";
import { TR2, TrId } from "../../../../gen/tr.slint";
import {
    AppManagementGlobal,
    AppPermissionGroup,
    InstalledApp,
} from "../../../../globals/app-management-global.slint";
import { SettingsNavHeader } from "../../../../widgets/nav-header.slint";
import { AppDetailsProps } from "props.slint";

component AppSummaryCard inherits Rectangle {
    in property <InstalledApp> app;

    height: 84px;

    HorizontalLayout {
        padding-left: Size.sz4;
        padding-right: Size.sz4;
        padding-top: Size.sz4;
        padding-bottom: Size.sz4;
        spacing: Size.sz4;

        icon-frame := Rectangle {
            // Empty image (width 0) means the app ships no icon.bin; fall back to
            // the shield placeholder.
            property <image> app-icon: AppManagementGlobal.app-icon(root.app.app_id, CurrentTheme.is-dark);

            width: Size.sz13;
            height: Size.sz13;
            background: Palette.transparent;

            if icon-frame.app-icon.width > 0: Image {
                width: Size.sz13;
                height: Size.sz13;
                source: icon-frame.app-icon;
                image-fit: contain;
            }

            if icon-frame.app-icon.width <= 0: Icon {
                name: "grid-view";
                size: Size.sz13;
                color: Palette.content-primary;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: Size.sz1;

            TextLg {
                text: root.app.name;
                color: Palette.content-primary;
            }
        }
    }
}

component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <length> value-width: 260px;

    height: value-text.preferred-height + Size.sz8 < 64px ? 64px : value-text.preferred-height + Size.sz8;

    HorizontalLayout {
        alignment: space-between;
        padding-left: Size.sz4;
        padding-right: Size.sz4;
        spacing: Size.sz4;

        VerticalLayout {
            alignment: center;

            TextSm {
                text: root.label;
                color: Palette.content-tertiary;
            }
        }

        VerticalLayout {
            alignment: center;

            value-text := TextMd {
                width: root.value-width;
                text: root.value;
                color: Palette.content-primary;
                horizontal-alignment: right;
                wrap: word-wrap;
                overflow: clip;
            }
        }
    }
}

component DescriptionRow inherits Rectangle {
    in property <string> description;

    height: description-text.preferred-height + Size.sz8;

    description-text := TextSm {
        x: Size.sz4;
        y: Size.sz4;
        width: parent.width - (Size.sz4 * 2);
        text: root.description;
        color: Palette.content-primary;
        wrap: word-wrap;
    }
}

component AppHashRow inherits Rectangle {
    in property <string> hash;

    height: hash-text.preferred-height + Size.sz8;

    hash-text := TextMd {
        x: Size.sz4;
        y: Size.sz4;
        width: parent.width - (Size.sz4 * 2);
        text: root.hash;
        color: Palette.content-primary;
        font-family: "Source Code Pro";
        font-size: Font.text-sm.size;
        wrap: word-wrap;
    }
}

component GrantSwitch inherits Rectangle {
    in property <bool> approved;

    callback changed(bool);

    width: Size.sz14;
    height: Size.sz7;

    switch := Switch {
        checked: root.approved;

        changed => {
            root.changed(!root.approved);
        }
    }
}

// One permission subgroup, named by its OS-owned label; the messages behind it
// are not user-facing.
component PermissionSubgroupRow inherits Rectangle {
    in property <string> label;
    in property <length> left-padding: Size.sz4;
    in property <bool> show-switch: false;
    in property <bool> approved;

    callback grant-changed(bool);

    property <length> switch-space: root.show-switch ? Size.sz16 + Size.sz2 : 0px;
    height: label-text.preferred-height + Size.sz8 < 56px ? 56px : label-text.preferred-height + Size.sz8;

    label-text := TextSm {
        x: root.left-padding;
        y: (root.height - self.preferred-height) / 2;
        width: parent.width - root.left-padding - Size.sz4 - root.switch-space;
        text: root.label;
        color: Palette.content-primary;
        wrap: word-wrap;
        overflow: clip;
    }

    if root.show-switch: GrantSwitch {
        x: parent.width - Size.sz4 - self.width;
        y: (parent.height - self.height) / 2;
        approved: root.approved;

        changed(approved) => {
            root.grant-changed(approved);
        }
    }
}

// A top-level permission group header; tapping it collapses or expands its subgroups.
component PermissionGroupRow inherits Rectangle {
    in property <string> label;
    in property <bool> open;

    callback clicked();

    height: label-text.preferred-height + Size.sz8 < 56px ? 56px : label-text.preferred-height + Size.sz8;

    TouchArea {
        clicked => {
            root.clicked();
        }
    }

    label-text := TextSm {
        x: Size.sz4;
        y: (root.height - self.preferred-height) / 2;
        width: parent.width - Size.sz4 - Size.sz4 - Size.sz8;
        text: root.label;
        color: Palette.content-primary;
        wrap: word-wrap;
        overflow: clip;
    }

    Icon {
        x: parent.width - Size.sz4 - self.width;
        y: (parent.height - self.height) / 2;
        name: root.open ? "chevron-up" : "chevron-down";
        color: Palette.content-tertiary;
    }
}

// The collapsible group tree shared by the grantable and the auto-granted sections; the
// only difference between them is whether the subgroup rows carry switches.
component PermissionGroupList inherits VerticalLayout {
    in property <[AppPermissionGroup]> groups;
    in property <bool> toggleable: false;
    in property <string> app-id;

    alignment: start;

    for group[group-index] in root.groups: group-block := VerticalLayout {
        alignment: start;
        property <bool> open: true;

        if group-index > 0: HLine { }

        PermissionGroupRow {
            label: group.label;
            open: group-block.open;

            clicked => {
                group-block.open = !group-block.open;
            }
        }

        if group-block.open: VerticalLayout {
            alignment: start;

            for subgroup[subgroup-index] in group.subgroups: VerticalLayout {
                HLine { }

                PermissionSubgroupRow {
                    label: subgroup.label;
                    left-padding: Size.sz8;
                    show-switch: root.toggleable;
                    approved: subgroup.approved;

                    grant-changed(approved) => {
                        AppManagementGlobal.set-app-permission-subgroup-grant(root.app-id, subgroup.key, approved);
                    }
                }
            }
        }
    }
}

export component AppDetailsPage inherits BasePage {
    in property <AppDetailsProps> props;

    private property <bool> remove-confirm-visible: false;
    private property <string> remove-error-message: "";
    property <bool> at-top: flickable.viewport-y == 0;
    property <bool> at-bottom: -flickable.viewport-y + flickable.height >= flickable.viewport-height;
    private property <length> shadow-gutter: Size.sz2;

    init => {
        AppManagementGlobal.select-installed-app(props.app_id);
    }

    header := SettingsNavHeader {
        y: 0px;
        title: TR2.lookup(TrId.AppsDetailsTitle);
    }

    flickable := Flickable {
        y: header.height;
        width: parent.width;
        height: parent.height - header.height;
        viewport-width: self.width;

        ContentSection {
            x: Size.sz6 + root.shadow-gutter;
            width: flickable.width - ((Size.sz6 + root.shadow-gutter) * 2);
            padding-top: Size.sz6 + root.shadow-gutter;
            padding-bottom: Size.sz6 + root.shadow-gutter;
            spacing: Size.sz7;

            MenuSection {
                title: "";

                AppSummaryCard {
                    app: AppManagementGlobal.selected-app;
                }
            }

            MenuSection {
                title: "";

                MenuSectionLayout {
                    InfoRow {
                        label: TR2.lookup(TrId.AppsAllowedPublisherFingerprint);
                        value: AppManagementGlobal.selected-app.publisher;
                        value-width: 120px;
                    }

                    HLine { }

                    InfoRow {
                        label: TR2.lookup(TrId.AppsVersion);
                        value: AppManagementGlobal.selected-app.version;
                    }

                    HLine { }

                    InfoRow {
                        label: TR2.lookup(TrId.AppsSize);
                        value: AppManagementGlobal.selected-app.size;
                    }

                    HLine { }

                    InfoRow {
                        label: TR2.lookup(TrId.AppsAppId);
                        value: AppManagementGlobal.selected-app.app_id;
                    }
                }
            }

            MenuSection {
                title: TR2.lookup(TrId.AppsAppHash);

                MenuSectionLayout {
                    AppHashRow {
                        hash: AppManagementGlobal.selected-app.app_hash;
                    }
                }
            }

            MenuSection {
                title: TR2.lookup(TrId.AppsDescription);

                MenuSectionLayout {
                    DescriptionRow {
                        description: AppManagementGlobal.selected-app.description;
                    }
                }
            }

            if AppManagementGlobal.selected-app.approvable_permissions.length > 0: MenuSection {
                title: TR2.lookup(TrId.AppsRequestedPermissions);

                MenuSectionLayout {
                    PermissionGroupList {
                        groups: AppManagementGlobal.selected-app.approvable_permissions;
                        toggleable: true;
                        app-id: props.app_id;
                    }
                }
            }

            // Auto-granted permissions, shown read-only (no switches): informational, so the user
            // sees what the app can do without a prompt.
            if AppManagementGlobal.selected-app.basic_permissions.length > 0: MenuSection {
                title: TR2.lookup(TrId.AppsAutomaticallyGranted);

                MenuSectionLayout {
                    PermissionGroupList {
                        groups: AppManagementGlobal.selected-app.basic_permissions;
                    }
                }
            }

            Button {
                label: TR2.lookup(TrId.AppsOpenApp);
                importance: Importance.primary;
                // A Flux child only runs inside the Flux emulator; opening it from here
                // makes no sense, so the button disappears rather than sits disabled.
                visible: !AppManagementGlobal.selected-app.is_flux;
                enabled: AppManagementGlobal.selected-app.can_launch;
                clicked => {
                    AppManagementGlobal.launch-installed-app(props.app_id);
                }
            }

            // Same condition as the button above: a Flux child has no Open App button for this to
            // explain.
            if !AppManagementGlobal.selected-app.is_flux && AppManagementGlobal.selected-app.launch_blocked_reason != "": VerticalLayout {
                spacing: Size.sz1;

                HorizontalLayout {
                    alignment: center;

                    Icon {
                        name: "alert";
                        size: IconSize.px32;
                        color: Palette.content-notice;
                    }
                }

                TextSm {
                    text: AppManagementGlobal.selected-app.launch_blocked_reason;
                    color: Palette.content-notice;
                    bold: true;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            Button {
                label: TR2.lookup(TrId.AppsRemoveApp);
                importance: Importance.negative;
                visible: AppManagementGlobal.selected-app.can_remove;
                clicked => {
                    root.remove-confirm-visible = true;
                }
            }
        }
    }

    ScrollFadeMask {
        y: flickable.y;
        width: flickable.width;
        height: flickable.height;
        at-top: root.at-top;
        at-bottom: root.at-bottom;
    }

    if remove-confirm-visible: ConfirmationModal {
        icon: "alert";
        title: TR2.lookup(TrId.AppsRemoveAppDialogHeader);
        text: TR2.format(TrId.AppsRemoveAppDialogContent, [AppManagementGlobal.selected-app.name]);
        cancel-button-label: TR2.lookup(TrId.CommonButtonCancel);
        confirm-button-label: TR2.lookup(TrId.AppsRemoveAppDialogRemove);
        critical: true;

        cancel-clicked => {
            root.remove-confirm-visible = false;
        }

        confirm-clicked => {
            root.remove-confirm-visible = false;
            root.remove-error-message = AppManagementGlobal.remove-installed-app(props.app_id);
            if root.remove-error-message == "" {
                Navigate.backward();
            }
        }
    }

    if remove-error-message != "": ErrorModal {
        icon: "alert";
        title: TR2.lookup(TrId.AppsUnableToRemoveApp);
        text: root.remove-error-message;
        confirm-button-label: TR2.lookup(TrId.CommonButtonDismiss);

        confirm-clicked => {
            root.remove-error-message = "";
        }
    }
}
