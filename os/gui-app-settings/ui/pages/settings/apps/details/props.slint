@rust-attr(route(path = "/details?{app_id}&{name}&{publisher}&{version}&{size}&{description}"))
export struct AppDetailsProps {
    app_id: string,
    name: string,
    publisher: string,
    version: string,
    size: string,
    description: string,
}
