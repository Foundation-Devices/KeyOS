import {
    BasePage,
    HLine,
    MenuActionItem,
    MenuBooleanItem,
    TextMd,
    TextSm
} from "@ui/widgets.slint";
import { ListView } from "std-widgets.slint";
import { Palette, Size } from "@ui/theme.slint";

import { Navigate } from "../../../gen/navigate.slint";
import { TR2, TrId } from "../../../gen/tr.slint";
import { AppManagementGlobal, AppsListRow, AppsListRowKind, InstalledApp } from "../../../globals/app-management-global.slint";
import { SettingGlobal } from "../../../globals/setting-global.slint";
import { SettingsNavHeader } from "../../../widgets/nav-header.slint";
import { AppsProps } from "props.slint";

component AppListCard inherits Rectangle {
    in property <InstalledApp> app;
    in property <bool> first;
    in property <bool> last;

    callback clicked();

    property <duration> select-anim-duration: 100ms;
    animate background { duration: select-anim-duration; }

    height: 84px;
    border-top-left-radius: first ? Size.sz6 : 0px;
    border-top-right-radius: first ? Size.sz6 : 0px;
    border-bottom-left-radius: last ? Size.sz6 : 0px;
    border-bottom-right-radius: last ? Size.sz6 : 0px;

    TouchArea {
        width: parent.width;
        height: parent.height;

        clicked => {
            root.background = Palette.background-pressed;
            select-timer.running = true;
        }
    }

    select-timer := Timer {
        interval: root.select-anim-duration;
        running: false;

        triggered() => {
            select-timer.running = false;
            root.background = Palette.transparent;
            root.clicked();
        }
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: Size.sz4;
        padding-right: Size.sz4;
        padding-top: Size.sz4;
        padding-bottom: Size.sz4;
        spacing: Size.sz4;

        icon-column := Rectangle {
            width: Size.sz13;
            height: Size.sz13;
            background: Palette.transparent;

            Image {
                width: Size.sz13;
                height: Size.sz13;
                source: AppManagementGlobal.app-icon(root.app.icon_key);
                image-fit: contain;
            }
        }

        content-column := VerticalLayout {
            alignment: center;
            spacing: Size.sz1;
            width: root.width - (Size.sz4 * 2) - icon-column.width - parent.spacing;

            TextMd {
                width: parent.width;
                text: root.app.name;
                color: Palette.content-primary;
                horizontal-alignment: left;
                wrap: no-wrap;
                overflow: elide;
            }

            TextSm {
                width: parent.width;
                text: root.app.publisher;
                color: Palette.content-tertiary;
                horizontal-alignment: left;
                wrap: no-wrap;
                overflow: elide;
            }
        }
    }
}

export component AppsPage inherits BasePage {
    in property <AppsProps> props;

    init => {
        AppManagementGlobal.refresh-installed-apps();
    }

    VerticalLayout {
        SettingsNavHeader {
            title: TR2.lookup(TrId.AppsTitle);
        }

        // One virtualized list for the whole page: section headers, installed
        // app cards, and the fixed settings rows are flattened into a single
        // row model in Rust so only on-screen rows (and their icons) are ever
        // instantiated. Each card row repaints the group card background and
        // rounds its first/last corners; the group drop-shadow is dropped.
        ListView {
            for row in AppManagementGlobal.apps-list-rows: Rectangle {
                // Delegate width is auto-bound to the ListView width. Height is
                // explicit per row kind so geometry flows strictly top-down,
                // which avoids a layout binding loop with AppListCard's
                // content column (it derives its width from the card width).
                height: row.kind == AppsListRowKind.section-header ? 56px : row.kind == AppsListRowKind.app ? (84px + (row.show_divider ? 1px : 0px)) : (64px + (row.show_divider ? 1px : 0px));

                if row.kind == AppsListRowKind.section-header: TextSm {
                    x: Size.sz6 + Size.sz4;
                    y: Size.sz6;
                    width: parent.width - (Size.sz6 + Size.sz4) - Size.sz6;
                    text: row.action_id == 0 ? TR2.lookup(TrId.AppsInstalledApps) : TR2.lookup(TrId.AppsSectionSettings);
                    color: Palette.content-tertiary;
                    horizontal-alignment: left;
                }

                if row.kind != AppsListRowKind.section-header: Rectangle {
                    x: Size.sz6;
                    width: parent.width - Size.sz6 * 2;
                    height: parent.height;
                    background: Palette.background-primary;
                    border-top-left-radius: row.first ? Size.sz6 : 0px;
                    border-top-right-radius: row.first ? Size.sz6 : 0px;
                    border-bottom-left-radius: row.last ? Size.sz6 : 0px;
                    border-bottom-right-radius: row.last ? Size.sz6 : 0px;

                    if row.kind == AppsListRowKind.app: AppListCard {
                        width: parent.width;
                        app: row.app;
                        first: row.first;
                        last: row.last;

                        clicked => {
                            Navigate.app-details({
                                app-id: row.app.app_id,
                                icon-key: row.app.icon_key,
                                name: row.app.name,
                                publisher: row.app.publisher,
                                version: row.app.version,
                                size: row.app.size,
                                description: row.app.description,
                                permissions: row.app.permissions,
                            }, { });
                        }
                    }

                    if row.kind == AppsListRowKind.action: MenuActionItem {
                        width: parent.width;
                        first: row.first;
                        last: row.last;
                        label: TR2.lookup(TrId.AppsTrustedPublishers);
                        clicked => {
                            if row.action_id == 0 {
                                Navigate.trusted-publishers({ });
                            }
                        }
                    }

                    if row.kind == AppsListRowKind.toggle: MenuBooleanItem {
                        width: parent.width;
                        first: row.first;
                        last: row.last;
                        label: TR2.lookup(TrId.AppsDeveloperMode);
                        checked: SettingGlobal.developer-mode;
                        changed(enabled) => {
                            if row.action_id == 1 {
                                SettingGlobal.set-developer-mode(enabled);
                            }
                        }
                    }

                    if row.kind == AppsListRowKind.empty: TextSm {
                        x: Size.sz4;
                        y: (parent.height - self.preferred-height) / 2;
                        width: parent.width - (Size.sz4 * 2);
                        text: TR2.lookup(TrId.AppsNoInstalledApps);
                        color: Palette.content-tertiary;
                    }

                    if row.show_divider: HLine {
                        y: parent.height - 1px;
                        width: parent.width;
                    }
                }
            }
        }
    }
}
