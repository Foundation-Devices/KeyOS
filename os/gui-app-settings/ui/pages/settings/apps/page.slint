import {
    BasePage,
    Button,
    ButtonSection,
    ConfirmationModal,
    ErrorModal,
    HLine,
    IconButton,
    Icon,
    MenuActionItem,
    MenuBooleanItem,
    Modal,
    ScrollFadeMask,
    TextMd,
    TextSm,
} from "@ui/widgets.slint";
import { ListView } from "std-widgets.slint";
import { CurrentTheme, Palette, Size } from "@ui/theme.slint";

import { Navigate } from "../../../gen/navigate.slint";
import { TR2, TrId } from "../../../gen/tr.slint";
import {
    AppManagementGlobal,
    AppsListRow,
    AppsListRowKind,
    InstallAppResult,
    InstalledApp,
} from "../../../globals/app-management-global.slint";
import { SettingGlobal } from "../../../globals/setting-global.slint";
import { SettingsNavHeader } from "../../../widgets/nav-header.slint";
import { AppsProps } from "props.slint";

component AppListCard inherits Rectangle {
    in property <InstalledApp> app;
    in property <bool> first;
    in property <bool> last;

    callback clicked();
    callback launch-clicked();

    property <duration> select-anim-duration: 100ms;
    animate background { duration: select-anim-duration; }

    height: 84px;
    border-top-left-radius: first ? Size.sz6 : 0px;
    border-top-right-radius: first ? Size.sz6 : 0px;
    border-bottom-left-radius: last ? Size.sz6 : 0px;
    border-bottom-right-radius: last ? Size.sz6 : 0px;

    TouchArea {
        width: parent.width - Size.sz16;
        height: parent.height;

        clicked => {
            root.background = Palette.background-pressed;
            select-timer.running = true;
        }
    }

    select-timer := Timer {
        interval: root.select-anim-duration;
        running: false;

        triggered() => {
            select-timer.running = false;
            root.background = Palette.transparent;
            root.clicked();
        }
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: Size.sz4;
        padding-right: Size.sz4;
        padding-top: Size.sz4;
        padding-bottom: Size.sz4;
        spacing: Size.sz4;

        icon-column := Rectangle {
            // Empty image (width 0) means the app ships no icon.bin; fall back to
            // the shield placeholder.
            property <image> app-icon: AppManagementGlobal.app-icon(root.app.app_id, CurrentTheme.is-dark);

            width: Size.sz13;
            height: Size.sz13;
            background: Palette.transparent;

            if icon-column.app-icon.width > 0: Image {
                width: Size.sz13;
                height: Size.sz13;
                source: icon-column.app-icon;
                image-fit: contain;
            }

            if icon-column.app-icon.width <= 0: Icon {
                name: "grid-view";
                size: Size.sz13;
                color: Palette.content-primary;
            }
        }

        content-column := VerticalLayout {
            alignment: center;
            spacing: Size.sz1;
            width: root.width - (Size.sz4 * 2) - icon-column.width - launch-column.width - (parent.spacing * 2);

            TextMd {
                width: parent.width;
                text: root.app.name;
                color: Palette.content-primary;
                horizontal-alignment: left;
                wrap: no-wrap;
                overflow: elide;
            }

            TextSm {
                width: parent.width;
                text: root.app.publisher;
                color: Palette.content-tertiary;
                horizontal-alignment: left;
                wrap: no-wrap;
                overflow: elide;
            }
        }

        launch-column := Rectangle {
            // Flux children never get a play button: they only run inside the Flux emulator.
            property <bool> show-launch: root.app.can_launch && !root.app.is_flux;

            width: self.show-launch ? Size.sz10 : 0px;
            height: parent.height;
            visible: self.show-launch;
            background: Palette.transparent;

            VerticalLayout {
                alignment: center;

                IconButton {
                    icon: "play";
                    size: Size.sz10;
                    icon-size: Size.sz6;

                    clicked => {
                        root.launch-clicked();
                    }
                }
            }
        }
    }
}

export component AppsPage inherits BasePage {
    in property <AppsProps> props;

    private property <InstallAppResult> install-result: AppManagementGlobal.install-result;
    // A pure binding, never assigned: dismissing clears the result on the global instead, since
    // assigning a property here would drop its binding and hide every later outcome.
    private property <bool> install-outcome-visible: !install-result.canceled
        && install-result.title != "";
    // Height the Install App button reserves at the bottom of the page: the button plus the
    // gutter below it. Size.sz8 is what a PageBody-based page leaves under its ButtonSection
    // (its own Size.sz6 padding plus the section's Size.sz2), so this page's button sits where
    // every other page's does.
    private property <length> install-button-band: Size.sz15 + Size.sz8;
    private property <bool> developer-mode-confirm-visible;

    init => {
        AppManagementGlobal.refresh-installed-apps();
    }

    header := SettingsNavHeader {
        y: 0px;
        title: TR2.lookup(TrId.AppsTitle);
    }

    // One virtualized list for the whole page: section headers, installed app
    // cards, and the fixed settings rows are flattened into a single row model
    // in Rust so only on-screen rows (and their icons) are ever instantiated.
    // Keep the list constrained below the header so it can scroll when many
    // sideloaded apps are installed.
    apps-list := ListView {
        y: header.height;
        width: parent.width;
        height: parent.height - header.height - root.install-button-band;
        viewport-width: self.width;
        mouse-drag-pan-enabled: true;
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;

        for row in AppManagementGlobal.apps-list-rows: row-delegate := Rectangle {
            // Delegate width is auto-bound to the ListView width. Height is
            // explicit per row kind so geometry flows strictly top-down, which
            // avoids a layout binding loop with AppListCard's content column
            // (it derives its width from the card width).
            property <length> content-height: row.kind == AppsListRowKind.section-header ? 56px : row.kind == AppsListRowKind.app ? 84px : 64px;
            property <length> divider-height: row.show_divider ? 1px : 0px;
            height: content-height + (row.kind == AppsListRowKind.section-header ? 0px : divider-height);

            if row.kind == AppsListRowKind.section-header: TextSm {
                x: Size.sz6 + Size.sz4;
                y: Size.sz6;
                width: parent.width - (Size.sz6 + Size.sz4) - Size.sz6;
                height: row-delegate.content-height;
                text: row.action_id == 0 ? TR2.lookup(TrId.AppsInstalledApps) : TR2.lookup(TrId.AppsSectionSettings);
                color: Palette.content-tertiary;
                horizontal-alignment: left;
            }

            if row.kind != AppsListRowKind.section-header: Rectangle {
                x: Size.sz6;
                width: parent.width - Size.sz6 * 2;
                height: parent.height;
                background: Palette.background-primary;
                border-width: Size.sz0_25;
                border-color: Palette.border-tertiary;
                border-top-left-radius: row.first ? Size.sz6 : 0px;
                border-top-right-radius: row.first ? Size.sz6 : 0px;
                border-bottom-left-radius: row.last ? Size.sz6 : 0px;
                border-bottom-right-radius: row.last ? Size.sz6 : 0px;

                if row.kind == AppsListRowKind.app: AppListCard {
                    width: parent.width;
                    height: row-delegate.content-height;
                    app: row.app;
                    first: row.first;
                    last: row.last;

                    clicked => {
                        if AppManagementGlobal.select-installed-app(row.app.app_id) {
                            Navigate.app-details({ app-id: row.app.app_id, focus: "" }, { });
                        }
                    }

                    launch-clicked => {
                        AppManagementGlobal.launch-installed-app(row.app.app_id);
                    }
                }

                if row.kind == AppsListRowKind.action: MenuActionItem {
                    width: parent.width;
                    height: row-delegate.content-height;
                    first: row.first;
                    last: row.last;
                    label: TR2.lookup(TrId.AppsAllowedPublishers);
                    text: AppManagementGlobal.allowed-publisher-count;
                    clicked => {
                        if row.action_id == 0 {
                            Navigate.allowed-publishers({ });
                        }
                    }
                }

                if row.kind == AppsListRowKind.toggle: MenuBooleanItem {
                    width: parent.width;
                    height: row-delegate.content-height;
                    first: row.first;
                    last: row.last;
                    label: TR2.lookup(TrId.AppsDeveloperMode);
                    checked: SettingGlobal.developer-mode;
                    changed(enabled) => {
                        if row.action_id == 1 {
                            if enabled {
                                root.developer-mode-confirm-visible = true;
                            } else {
                                SettingGlobal.set-developer-mode(false);
                            }
                        }
                    }
                }

                if row.kind == AppsListRowKind.empty: TextSm {
                    x: Size.sz4;
                    y: (parent.height - self.preferred-height) / 2;
                    width: parent.width - (Size.sz4 * 2);
                    height: row-delegate.content-height;
                    text: TR2.lookup(TrId.AppsNoInstalledApps);
                    color: Palette.content-tertiary;
                }

                if row.show_divider: HLine {
                    y: row-delegate.content-height;
                    width: parent.width;
                }
            }
        }
    }

    ScrollFadeMask {
        y: apps-list.y;
        width: apps-list.width;
        height: apps-list.height;
        at-top: apps-list.viewport-y == 0;
        at-bottom: -apps-list.viewport-y + apps-list.height >= apps-list.viewport-height;
    }

    ButtonSection {
        x: Size.sz6;
        y: parent.height - root.install-button-band;
        width: parent.width - Size.sz6 * 2;
        height: root.install-button-band;
        padding-bottom: Size.sz8;

        Button {
            label: TR2.lookup(TrId.AppsInstallApp);

            enabled: !AppManagementGlobal.installing;

            clicked => {
                AppManagementGlobal.install-app();
            }
        }
    }

    if developer-mode-confirm-visible: ConfirmationModal {
        modal-width: 400px;
        modal-border-width: 0px;
        modal-level: 4;
        button-section-padding: 0px;
        icon: "alert";
        notice: true;
        title: TR2.lookup(TrId.AppsModalDeveloperModeRisksTitle);
        text: TR2.lookup(TrId.AppsModalDeveloperModeRisksContent);
        cancel-button-label: TR2.lookup(TrId.CommonButtonCancel);
        confirm-button-label: TR2.lookup(TrId.AppsModalDeveloperModeRisksEnableDeveloperMode);

        cancel-clicked => {
            root.developer-mode-confirm-visible = false;
        }

        confirm-clicked => {
            root.developer-mode-confirm-visible = false;
            SettingGlobal.set-developer-mode(true);
        }
    }

    if install-outcome-visible && install-result.success: Modal {
        modal-width: 400px;
        modal-border-width: 0px;
        modal-level: 4;
        button-section-padding: 0px;
        title: root.install-result.title;
        text: root.install-result.text;

        Button {
            label: TR2.lookup(TrId.CommonButtonDone);
            clicked => {
                AppManagementGlobal.install-result = { canceled: true };
            }
        }
    }

    if install-outcome-visible && !install-result.success: ErrorModal {
        icon: "alert";
        modal-width: 400px;
        modal-border-width: 0px;
        modal-level: 4;
        button-section-padding: 0px;
        title: root.install-result.title;
        text: root.install-result.text;
        confirm-button-label: TR2.lookup(TrId.CommonButtonDismiss);

        confirm-clicked => {
            AppManagementGlobal.install-result = { canceled: true };
        }
    }
}
