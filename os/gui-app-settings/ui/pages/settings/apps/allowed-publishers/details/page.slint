import {
    BasePage,
    Button,
    ContentSection,
    ConfirmationModal,
    ErrorModal,
    ScrollFadeMask,
} from "@ui/widgets.slint";
import { Importance, Palette, Size } from "@ui/theme.slint";

import { AllowedPublisherDetailField } from "../detail-field.slint";
import { Navigate } from "../../../../../gen/navigate.slint";
import { TR2, TrId } from "../../../../../gen/tr.slint";
import {
    AppManagementGlobal,
} from "../../../../../globals/app-management-global.slint";
import { SettingsNavHeader } from "../../../../../widgets/nav-header.slint";
import { AllowedPublisherDetailsProps } from "props.slint";

export component AllowedPublisherDetailsPage inherits BasePage {
    in property <AllowedPublisherDetailsProps> props;

    private property <bool> remove-confirm-visible: false;
    private property <string> remove-error-title: "";
    private property <string> remove-error-message: "";

    property <bool> at-top: flickable.viewport-y == 0;
    property <bool> at-bottom: -flickable.viewport-y + flickable.height >= flickable.viewport-height;
    private property <length> shadow-gutter: Size.sz2;

    header := SettingsNavHeader {
        y: 0px;
        title: TR2.lookup(TrId.AppsAllowedPublisherDetails);
    }

    flickable := Flickable {
        y: header.height;
        width: parent.width;
        height: parent.height - header.height;
        viewport-width: self.width;

        ContentSection {
            x: Size.sz6 + root.shadow-gutter;
            width: flickable.width - ((Size.sz6 + root.shadow-gutter) * 2);
            padding-top: Size.sz6 + root.shadow-gutter;
            padding-bottom: Size.sz6 + root.shadow-gutter;
            spacing: Size.sz7;

            details := VerticalLayout {
                width: parent.width;
                spacing: Size.sz5;

                AllowedPublisherDetailField {
                    field-width: parent.width;
                    label: TR2.lookup(TrId.AppsAllowedPublisherFingerprint);
                    value: props.fingerprint;
                    fixed-width: true;
                }

                AllowedPublisherDetailField {
                    field-width: parent.width;
                    label: TR2.lookup(TrId.AppsAllowedPublisherStatus);
                    value: props.status;
                }

                AllowedPublisherDetailField {
                    field-width: parent.width;
                    label: TR2.lookup(TrId.AppsAllowedPublisherExpirationDate);
                    value: props.expiration_date;
                }

                AllowedPublisherDetailField {
                    field-width: parent.width;
                    label: TR2.lookup(TrId.AppsAllowedPublisherDateAdded);
                    value: props.date_added;
                }

                AllowedPublisherDetailField {
                    field-width: parent.width;
                    label: TR2.lookup(TrId.AppsAllowedPublisherClaimedName);
                    value: props.claimed_name;
                }

                AllowedPublisherDetailField {
                    field-width: parent.width;
                    label: TR2.lookup(TrId.AppsAllowedPublisherClaimedOrganization);
                    value: props.claimed_organization;
                }

                AllowedPublisherDetailField {
                    field-width: parent.width;
                    label: TR2.lookup(TrId.AppsAllowedPublisherClaimedContactEmail);
                    value: props.contact_email;
                }

                AllowedPublisherDetailField {
                    field-width: parent.width;
                    label: TR2.lookup(TrId.AppsAllowedPublisherClaimedSupportUrl);
                    value: props.support_url;
                }

                AllowedPublisherDetailField {
                    field-width: parent.width;
                    label: TR2.lookup(TrId.AppsAllowedPublisherPublicKey);
                    value: props.public_key_display;
                    fixed-width: true;
                }

                AllowedPublisherDetailField {
                    field-width: parent.width;
                    label: TR2.lookup(TrId.AppsAllowedPublisherClaimedSerialNumber);
                    value: props.serial_number;
                    fixed-width: true;
                }

                AllowedPublisherDetailField {
                    field-width: parent.width;
                    label: TR2.lookup(TrId.AppsAllowedPublisherClaimedSubject);
                    value: props.subject;
                }

                AllowedPublisherDetailField {
                    field-width: parent.width;
                    label: TR2.lookup(TrId.AppsAllowedPublisherBasicConstraints);
                    value: props.basic_constraints;
                }

                AllowedPublisherDetailField {
                    field-width: parent.width;
                    label: TR2.lookup(TrId.AppsAllowedPublisherKeyUsage);
                    value: props.key_usage;
                }

                AllowedPublisherDetailField {
                    field-width: parent.width;
                    label: TR2.lookup(TrId.AppsAllowedPublisherExtendedKeyUsage);
                    value: props.extended_key_usage;
                }
            }

            Button {
                label: TR2.lookup(TrId.AppsRemovePublisher);
                importance: Importance.negative;
                clicked => {
                    root.remove-confirm-visible = true;
                }
            }
        }
    }

    ScrollFadeMask {
        y: flickable.y;
        width: flickable.width;
        height: flickable.height;
        at-top: root.at-top;
        at-bottom: root.at-bottom;
    }

    if remove-confirm-visible: ConfirmationModal {
        modal-width: 400px;
        modal-border-width: 0px;
        modal-level: 4;
        button-section-padding: 0px;
        icon: "alert";
        icon-color: Palette.content-notice;
        title: TR2.lookup(TrId.AppsRemovePublisher);
        text: TR2.lookup(TrId.AppsRemovePublisherConfirm);
        cancel-button-label: TR2.lookup(TrId.CommonButtonCancel);
        confirm-button-label: TR2.lookup(TrId.AppsRemovePublisherConfirmButton);
        critical: true;

        cancel-clicked => {
            root.remove-confirm-visible = false;
        }

        confirm-clicked => {
            root.remove-confirm-visible = false;
            let result = AppManagementGlobal.remove-allowed-publisher(props.public_key);
            if result.success {
                Navigate.backward();
            } else {
                root.remove-error-title = result.title;
                root.remove-error-message = result.text;
            }
        }
    }

    if remove-error-message != "": ErrorModal {
        modal-width: 400px;
        modal-border-width: 0px;
        modal-level: 4;
        button-section-padding: 0px;
        icon: "alert";
        title: root.remove-error-title;
        text: root.remove-error-message;
        confirm-button-label: TR2.lookup(TrId.CommonButtonDismiss);

        confirm-clicked => {
            root.remove-error-title = "";
            root.remove-error-message = "";
        }
    }
}
