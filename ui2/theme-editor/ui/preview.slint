        input-suffix-icon = "none";
        story-input-default-value = "";
        story-input-filled-value = "";
        story-input-outlined-value = "";
        story-input-focused-value = "hello@keyos.app";
        story-input-error-value = "hello";
        story-input-disabled-value = "Unavailable";
        textarea-value = "Design review notes:\n- tighten spacing around the header\n- confirm icon color contrast in dark mode";
        textarea-placeholder = "Write a detailed note...";
        textarea-label = "Project notes";
        textarea-description = "Use this field for longer descriptions, feedback, and summaries.";
        textarea-variant = 0;
        textarea-disabled = false;
        textarea-read-only = false;
        textarea-clearable = false;
        textarea-focused = false;
        textarea-required = false;
        textarea-disable-autosize = false;
        textarea-min-rows = 3.0;
        textarea-max-rows = 8.0;
        textarea-error = "";
        story-textarea-flat-value = "";
        story-textarea-bordered-value = "Release summary:\nShipped new tabs component.\nNeed follow-up QA on dark mode.";
        story-textarea-faded-value = "This autosizes when content grows.\nAdd a few more lines to see it expand inside the card.";
        story-textarea-focused-value = "Focused text areas should clearly show the active border.";
        story-textarea-error-value = "This note is missing required details.";
        story-textarea-disabled-value = "Editing is disabled for this field.";

        search-value = "";
        search-placeholder = "Search components";
        search-label = "Search";
        search-variant = 1;
        search-disabled = false;
        search-read-only = false;
        search-clearable = true;
        search-focused = false;
        search-error = "";
        story-search-default-value = "";
        story-search-focused-value = "button";
        story-search-disabled-value = "Unavailable";

        dropdown-label = "Team";
        dropdown-placeholder = "Choose a team";
        dropdown-selected-index = 1;
        dropdown-disabled = false;
        story-dropdown-selected-index = -1;

        checkbox-label = "Email updates";
        checkbox-description = "Receive launch and billing notifications.";
        checkbox-checked = false;
        checkbox-indeterminate = false;
        checkbox-disabled = false;

        radio-label = "Pro plan";
        radio-description = "Best for teams shipping every week.";
        radio-checked = true;
        radio-disabled = false;

        radio-group-selected-index = 1;
        radio-group-disabled = false;
        story-radio-group-selected-index = 1;

        switch-label = "Enable sync";
        switch-description = "Keep the workspace up to date across devices.";
        switch-checked = true;
        switch-disabled = false;

        slider-minimum = 0;
        slider-maximum = 100;
        slider-step = 1;
        slider-value = 64;
        slider-size = 1;
        slider-disabled = false;
        slider-focused = false;

        segmented-selected-index = 0;
        segmented-disabled = false;
        segmented-variant = 0;
        segmented-color = 1;
        segmented-orientation = 0;
        segmented-full-width = true;
        segmented-show-panel = true;
        story-segmented-selected-index = 0;

        slide-label = "Confirm";
        slide-hint = "Slide to publish";
        slide-confirmed-label = "Published";
        slide-confirmed = false;
        slide-disabled = false;
        story-slide-confirmed = false;

        link-label = "Open documentation";
        link-disabled = false;
        link-external = true;
        link-visited = false;
        link-underlined = true;

        card-eyebrow = "Workspace";
        card-title = "Launch checklist";
        card-subtitle = "Three items need review before you ship.";
        card-body = "Invite QA, validate the billing copy, and confirm the launch window with support.";
        card-footer = "Updated 8 minutes ago";
        card-selected = false;
        card-interactive = true;
        card-icon = "clipboard";

        menu-selected-index = 1;
        menu-full-width = false;

        menu-item-label = "Share";
        menu-item-subtitle = "Invite someone to this project.";
        menu-item-trailing-text = "Cmd+K";
        menu-item-selected = false;
        menu-item-destructive = false;
        menu-item-disabled = false;
        menu-item-start-icon = "share";
        menu-item-end-icon = "chevron-right";

        accordion-allow-multiple = false;
        accordion-item-0-title = "Release notes";
        accordion-item-0-subtitle = "Updated today";
        accordion-item-0-body = "Document migrations, feature flags, and support considerations before the deploy starts.";
        accordion-item-0-disabled = false;
        accordion-open-0 = true;
        accordion-item-1-title = "Rollback plan";
        accordion-item-1-subtitle = "Ready if needed";
        accordion-item-1-body = "Include the trigger, owner, and exact command sequence used to revert the change.";
        accordion-item-1-disabled = false;
        accordion-open-1 = false;
        accordion-item-2-title = "Locked section";
        accordion-item-2-subtitle = "Disabled";
        accordion-item-2-body = "This section is unavailable until the environment is provisioned.";
        accordion-item-2-disabled = true;
        accordion-open-2 = false;
        accordion-story-multi-open-0 = true;
        accordion-story-multi-open-1 = true;
        accordion-story-multi-open-2 = false;

        dialog-open = true;
        dialog-title = "Delete release";
        dialog-message = "This action removes the release notes draft for everyone on the team.";
        dialog-variant = 0;
        dialog-primary-action = "Delete";
        dialog-secondary-action = "Cancel";
        dialog-dismissable = true;
        dialog-icon = "circle-alert";

        sheet-open = true;
        sheet-title = "Share workspace";
        sheet-body = "Invite teammates, copy a link, or update permissions without leaving the current page.";
        sheet-show-handle = true;
        sheet-dismissable = true;
        sheet-detent-index = 1;

        toast-open = true;
        toast-message = "Workspace published successfully.";
        toast-action = "Undo";
        toast-variant = 1;
        toast-position = 1;
        toast-icon = "check";

        progress-label = "Storage";
        progress-value-label = "";
        progress-value = 64.0;
        progress-min-value = 0.0;
        progress-max-value = 100.0;
        progress-indeterminate = false;
        progress-show-value-label = true;
        progress-disabled = false;
        progress-disable-animation = false;
        progress-tone = 0;
        progress-value-format = 0;

        spinner-size = 1;
        spinner-tone = 0;
        spinner-animation-speed = 60.0;

        image-alt = "Sample landscape";
        image-caption = "A sample illustration for the Image component preview.";
        image-rounded = true;
        image-show-border = true;
        divider-orientation = 0;
        divider-label = "Overview";
        divider-label-alignment = 1;
        divider-full-width = true;
        divider-label-gap = 8.0;
        divider-label-start-margin = 16.0;
        divider-label-end-margin = 16.0;
    }

    toggle-accordion-item(index) => {
        if index == 0 {
            if root.accordion-allow-multiple {
                root.accordion-open-0 = !root.accordion-open-0;
            } else {
                root.accordion-open-0 = !root.accordion-open-0;
                root.accordion-open-1 = false;
                root.accordion-open-2 = false;
            }
        }
        if index == 1 {
            if root.accordion-allow-multiple {
                root.accordion-open-1 = !root.accordion-open-1;
            } else {
                root.accordion-open-0 = false;
                root.accordion-open-1 = !root.accordion-open-1;
                root.accordion-open-2 = false;
            }
        }
        if index == 2 {
            if root.accordion-allow-multiple {
                root.accordion-open-2 = !root.accordion-open-2;
            } else {
                root.accordion-open-0 = false;
                root.accordion-open-1 = false;
                root.accordion-open-2 = !root.accordion-open-2;
            }
        }
    }

    toggle-accordion-story-multi-item(index) => {
        if index == 0 {
            root.accordion-story-multi-open-0 = !root.accordion-story-multi-open-0;
        }
        if index == 1 {
            root.accordion-story-multi-open-1 = !root.accordion-story-multi-open-1;
        }
        if index == 2 {
            root.accordion-story-multi-open-2 = !root.accordion-story-multi-open-2;
        }
    }

    background: dark-mode ? #1a1a1a : #f5f5f5;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        // Embedded in the theme editor (show-tabs == false) the panels go flush to
        // the edges like ComponentThemeWorkspace; only the standalone theme editor gets
        // the 16px frame. (This was the stray gray padding above the Props sidebar.)
        padding: root.show-tabs ? 16px : 0px;
        spacing: root.show-tabs ? 12px : 0px;

        // Header with title and tabs. Only shown in the standalone theme editor
        // (show-tabs). In the embedded theme editor the component name lives in
        // the central preview panel and the props sidebar, so this full-width
        // band must not render — otherwise it spans over the right sidebar and
        // pushes the Theme/Props picker down.
        if root.show-tabs: HorizontalLayout {
            spacing: 16px;

            Text {
                text: get-component-name(selected-category, selected-component);
                color: dark-mode ? #ffffff : #1a1a1a;
                font-size: 20px;
                font-weight: 600;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            if root.show-tabs: Rectangle {
                height: 36px;
                background: dark-mode ? #242424 : #ffffff;
                border-radius: 8px;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;

                    TabButton {
                        label: "Story";
                        selected: active-tab == 0;
                        dark-mode: root.dark-mode;
                        clicked => {
                            active-tab = 0;
                        }
                    }

                    TabButton {
                        label: "Props";
                        selected: active-tab == 1;
                        dark-mode: root.dark-mode;
                        clicked => {
                            active-tab = 1;
                        }
                    }
                }
            }
        }

        // Main content area
        Rectangle {
            background: dark-mode ? #242424 : #ffffff;
            border-radius: 8px;
            clip: true;

            // Story tab content - uses fixed sample values, not editable props
            if active-tab == 0: Rectangle {
                clip: true;

                Flickable {
                    viewport-height: story-content.preferred-height;

                    story-content := VerticalLayout {
                        padding: 16px;
                        spacing: 16px;

                        if root.selected-category == 0 && root.selected-component == 0: VerticalLayout {
                            spacing: 16px;

                            Text {
                                text: "States";
                                color: dark-mode ? #888888 : #666666;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                ButtonStateBox {
                                    label: "Default";
                                    dark-mode: root.dark-mode;
                                    button-text: "Button";
                                }

                                ButtonStateBox {
                                    label: "Focused";
                                    dark-mode: root.dark-mode;
                                    button-text: "Button";
                                    force-focused: true;
                                }

                                ButtonStateBox {
                                    label: "Pressed";
                                    dark-mode: root.dark-mode;
                                    button-text: "Button";
                                    force-pressed: true;
                                }

                                ButtonStateBox {
                                    label: "Disabled";
                                    dark-mode: root.dark-mode;
                                    button-text: "Button";
                                    force-disabled: true;
                                }
                            }

                            Text {
                                text: "Sizes";
                                color: dark-mode ? #888888 : #666666;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;

                                Rectangle {
                                    vertical-stretch: 0;
                                    width: small-btn.preferred-width;
