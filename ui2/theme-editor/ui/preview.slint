    in-out property <string> story-textarea-disabled-value: "Editing is disabled for this field.";

    // Search preview state
    in-out property <string> search-value: "";
    in-out property <string> search-placeholder: "Search components";
    in-out property <string> search-label: "Search";
    in-out property <int> search-variant: 1;
    in-out property <bool> search-disabled: false;
    in-out property <bool> search-read-only: false;
    in-out property <bool> search-clearable: true;
    in-out property <bool> search-focused: false;
