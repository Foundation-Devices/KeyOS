    in-out property <string> story-search-default-value: "";
    in-out property <string> story-search-focused-value: "button";
    in-out property <string> story-search-disabled-value: "Unavailable";

    // Shared sample options
    property <[string]> dropdown-options: ["Design", "Engineering", "QA", "Launch"];
    property <[string]> segmented-options: ["Overview", "Activity", "Files"];
    property <[string]> segmented-panels: [
        "Track the current release, design review notes, and priority work across the team.",
