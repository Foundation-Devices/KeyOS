// Simple toggle switch for boolean props (right-aligned like other controls)
component ToggleSwitch inherits Rectangle {
    in property <string> label;
    in property <bool> dark-mode;
    in-out property <bool> checked: false;

    height: 24px;

    HorizontalLayout {
        spacing: 8px;

        Text {
            text: label;
            color: dark-mode ? #888888 : #666666;
            font-size: 12px;
            vertical-alignment: center;
            // Shared RowLayout grid: every Props row's label sits in a fixed-width
            // column so labels and controls line up across rows and with the splitter.
            width: RowLayout.label-width;
        }

        // Stretch spacer absorbs the value-column width so the toggle stays right-
        // aligned now that the label sits in the fixed RowLayout grid column.
        Rectangle {
            horizontal-stretch: 1;
        }

        Rectangle {
            width: 36px;
            height: 20px;
            border-radius: 10px;
            background: checked ? #1a9a9a : (dark-mode ? #3a3a3a : #d0d0d0);

            animate background { duration: 150ms; }

            Rectangle {
                x: checked ? parent.width - self.width - 2px : 2px;
                y: 2px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: white;

                animate x { duration: 150ms; }
            }

            TouchArea {
                clicked => {
                    checked = !checked;
                }
            }
        }
    }
}

// Tab button
component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> dark-mode;
    callback clicked();

    height: 32px;
    border-radius: 6px;
    background: selected ? (dark-mode ? #3a3a3a : #e8e8e8) : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;

        Text {
            text: label;
            color: selected ? (dark-mode ? #ffffff : #1a1a1a) : (dark-mode ? #888888 : #666666);
            font-size: 13px;
            font-weight: selected ? 600 : 400;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// (TreeSectionHeader is the shared component from theme_editor.slint — the
// duplicate here was why the Props chevron didn't pick up the 24px size change.)

// Number input with +/- buttons
component NumberInput inherits Rectangle {
    in property <string> label;
    in property <bool> dark-mode;
    in property <string> suffix: "px";
    in property <float> step: 1.0;
    in property <float> min-value: 0.0;
    in property <float> max-value: 100.0;
    in-out property <float> value: 0.0;
    in-out property <string> edit-text: "";
    in-out property <bool> editing: false;
    property <length> suffix-slot-width: root.suffix != "" ? 28px : 0px;
    property <length> editor-width: root.suffix != "" ? 108px : 80px;

    callback sync-edit-text();
    sync-edit-text => {
        edit-text = Math.round(value * 10) / 10 + "";
    }
    callback commit-edit();
    commit-edit => {
        if (edit-text == "" || edit-text == "-" || edit-text == "." || edit-text == "-.") {
            root.sync-edit-text();
            return;
        }
        if (edit-text.is-float()) {
            value = clamp(edit-text.to-float(), min-value, max-value);
        } else {
            root.sync-edit-text();
        }
    }

    init => {
        root.sync-edit-text();
    }
    changed value => {
        if (!editing) {
            root.sync-edit-text();
        }
    }

    height: 24px;

    HorizontalLayout {
        spacing: 8px;

        Text {
            text: label;
            color: dark-mode ? #888888 : #666666;
            font-size: 12px;
            vertical-alignment: center;
            // Shared RowLayout grid: every Props row's label sits in a fixed-width
            // column so labels and controls line up across rows and with the splitter.
            width: RowLayout.label-width;
        }

        Rectangle {
            width: root.editor-width;
            height: 22px;
            background: dark-mode ? #1a1a1a : #f0f0f0;
            border-radius: 4px;

            HorizontalLayout {
                Rectangle {
                    width: 22px;
                    background: minus-touch.pressed ? (dark-mode ? #2a2a2a : #e0e0e0) : transparent;

                    Text {
                        x: (parent.width - self.preferred-width) / 2;
                        y: (parent.height - self.preferred-height) / 2;
                        text: "−";
                        color: dark-mode ? #888888 : #666666;
                        font-size: 14px;
                    }

                    minus-touch := TouchArea {
                        clicked => {
                            if (value - step >= min-value) {
                                value = value - step;
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    number-input-field := TextInput {
                        x: 4px;
                        y: 0px;
                        width: parent.width - root.suffix-slot-width - 8px;
                        height: parent.height;
                        text <=> root.edit-text;
                        color: dark-mode ? #ffffff : #1a1a1a;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        input-type: number;

                        edited => {
                            if (self.text == "" || self.text == "-" || self.text == "." || self.text == "-.") {
                                return;
                            }
                            if (self.text.is-float()) {
                                value = clamp(self.text.to-float(), min-value, max-value);
                            }
                        }

                        accepted => {
                            root.commit-edit();
                            root.sync-edit-text();
                        }

                        changed has-focus => {
                            root.editing = self.has-focus;
                            if (!self.has-focus) {
                                root.commit-edit();
                                root.sync-edit-text();
                            }
                        }
                    }

                    suffix-text := Text {
                        visible: root.suffix != "";
                        x: parent.width - root.suffix-slot-width;
                        y: 0px;
                        width: root.suffix-slot-width;
                        height: parent.height;
                        text: root.suffix;
                        color: dark-mode ? #888888 : #666666;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                Rectangle {
                    width: 22px;
                    background: plus-touch.pressed ? (dark-mode ? #2a2a2a : #e0e0e0) : transparent;

                    Text {
                        x: (parent.width - self.preferred-width) / 2;
                        y: (parent.height - self.preferred-height) / 2;
                        text: "+";
                        color: dark-mode ? #888888 : #666666;
                        font-size: 14px;
                    }

                    plus-touch := TouchArea {
                        clicked => {
                            if (value + step <= max-value) {
                                value = value + step;
                            }
                        }
                    }
                }
            }
        }
    }
}

// Text input row
component TextInputRow inherits Rectangle {
    in property <string> label;
    in property <bool> dark-mode;
    in-out property <string> value;

    height: 24px;

    HorizontalLayout {
        spacing: 8px;

        Text {
            text: label;
            color: dark-mode ? #888888 : #666666;
            font-size: 12px;
            vertical-alignment: center;
            // Shared RowLayout grid: every Props row's label sits in a fixed-width
            // column so labels and controls line up across rows and with the splitter.
            width: RowLayout.label-width;
        }

        Rectangle {
            width: 120px;
            height: 22px;
            background: transparent;

            EditorTextField {
                width: parent.width;
                text <=> value;
                dark-mode: root.dark-mode;
            }
        }
    }
}

// Enum selector row
component EnumSelector inherits Rectangle {
    in property <string> label;
    in property <bool> dark-mode;
    in property <[string]> options;
    in property <length> selector-width: 110px;
    in-out property <int> selected-index: 0;
    callback changed(int);

    height: 24px;

    HorizontalLayout {
        spacing: 8px;

        Text {
            text: label;
            color: dark-mode ? #888888 : #666666;
            font-size: 12px;
            vertical-alignment: center;
            // Shared RowLayout grid: every Props row's label sits in a fixed-width
            // column so labels and controls line up across rows and with the splitter.
            width: RowLayout.label-width;
        }

        Rectangle {
            width: root.selector-width;
            preferred-width: root.selector-width;
            height: dropdown.preferred-height;
            preferred-height: dropdown.preferred-height;

            dropdown := Dropdown {
                width: parent.width;
                label: "";
                size: ControlSize.sm;
                options: root.options;
                selected-index <=> root.selected-index;
                placeholder: root.options.length > 0 ? root.options[0] : "";
                max-visible-items: 8;
                font-size: 11px;
                control-height: 22px;
                option-height: 24px;
                padding-horizontal: 8px;
                icon-size: 12px;
                border-radius: 4px;
                changed(index, _label) => {
                    root.changed(index);
                }
            }
        }
    }
}

component IconSelectorRow inherits Rectangle {
    in property <string> label;
    in property <bool> dark-mode;
    in-out property <string> value: "none";
    in property <[string]> icon-results: [];
    pure callback icon-image(string) -> image;
    callback filter-icons(string);

    property <bool> picker-open: false;
    in-out property <string> search-query: "";

    height: picker-open ? 208px : 24px;
    clip: true;

    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: label;
                color: dark-mode ? #888888 : #666666;
                font-size: 12px;
                vertical-alignment: center;
                width: RowLayout.label-width;
            }

            Rectangle {
                width: 140px;
                height: 22px;
                background: dark-mode ? #1a1a1a : #f0f0f0;
                border-radius: 4px;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 6px;

                    Rectangle {
                        width: 14px;
                        height: parent.height;
                        vertical-stretch: 0;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            source: root.icon-image(root.value);
                            colorize: dark-mode ? #cccccc : #444444;
                        }
                    }

                    Text {
                        text: root.value == "" || root.value == "none" ? "none" : root.value;
                        color: dark-mode ? #ffffff : #1a1a1a;
                        font-size: 10px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Text {
                        text: picker-open ? "▲" : "▼";
                        color: dark-mode ? #666666 : #999999;
                        font-size: 8px;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => {
                        picker-open = !picker-open;
                        if (picker-open) {
                            root.filter-icons(root.search-query);
                        }
                    }
                }
            }
        }

        if picker-open: Rectangle {
            height: 176px;
            background: dark-mode ? #1a1a1a : #f0f0f0;
            border-radius: 6px;

            VerticalLayout {
                padding: 8px;
                spacing: 8px;

                Rectangle {
                    height: 24px;
                    background: transparent;

                    icon-search := EditorTextField {
                        width: parent.width;
                        field-height: parent.height;
                        dark-mode: root.dark-mode;
                        text <=> root.search-query;
                        text-font-size: 12px;
                        text-padding-left: 8px;
                        text-padding-right: 8px;
                        field-background: dark-mode ? #2a2a2a : #ffffff;
                        focused-border-width: 2px;
                        unfocused-border-width: 1px;
                        unfocused-border-color: dark-mode ? #3a3a3a : #d0d0d0;
                        edited(value) => {
                            root.filter-icons(value);
                        }
                    }
                }

                Flickable {
                    viewport-height: icon-results-layout.preferred-height;

                    icon-results-layout := VerticalLayout {
                        spacing: 4px;

                        for icon-name in root.icon-results: Rectangle {
                            height: 28px;
                            border-radius: 4px;
                            background: icon-touch.has-hover ? (dark-mode ? #2a2a2a : #ffffff) : transparent;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;

                                Rectangle {
                                    width: 14px;
                                    height: parent.height;
                                    vertical-stretch: 0;

                                    Image {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 14px;
                                        height: 14px;
                                        source: root.icon-image(icon-name);
                                        colorize: dark-mode ? #cccccc : #444444;
                                    }
                                }

                                Text {
                                    text: icon-name == "" || icon-name == "none" ? "none" : icon-name;
                                    color: dark-mode ? #cccccc : #444444;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }

                            icon-touch := TouchArea {
                                clicked => {
                                    root.value = icon-name;
                                    picker-open = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Button state box for Story view
component ButtonStateBox inherits Rectangle {
    in property <string> label;
    in property <bool> dark-mode;
    in property <string> button-text: "Button";
    in property <ButtonVariant> button-variant: ButtonVariant.primary;
    in property <ControlSize> button-size: ControlSize.md;
    in property <bool> force-focused: false;
    in property <bool> force-pressed: false;
    in property <bool> force-disabled: false;

    // Size based on content
    width: content-layout.preferred-width;
    height: content-layout.preferred-height;
    background: dark-mode ? #2a2a2a : #f8f8f8;
    border-radius: 6px;

    content-layout := VerticalLayout {
        padding: 8px;
        spacing: 6px;

        Text {
            text: label;
            color: dark-mode ? #888888 : #666666;
            font-size: 10px;
            font-weight: 500;
        }

        Rectangle {
            width: state-btn.preferred-width;
            height: state-btn.preferred-height;

            state-btn := Button {
                text: button-text;
                variant: root.button-variant;
                size: root.button-size;
                disabled: force-disabled;
                force-focused: root.force-focused;
                force-pressed: root.force-pressed;
                touch-expansion: 0px;  // Disable touch expansion in story view
            }
        }
    }
}

export component Preview inherits Rectangle {
    in property <bool> dark-mode;
    in property <int> selected-category;
    in property <int> selected-component;
    in property <[string]> icon-results: [];
    pure callback icon-image(string) -> image;
    callback filter-icons(string);
    in-out property <int> component-page-mode: 1;
    in property <[string]> component-page-mode-options: ["Theme", "Props"];
    callback component-page-mode-changed(int);
    in property <bool> show-tabs: true;

    // Tab state
    in-out property <int> active-tab: 0;  // 0=Story, 1=Props
    in-out property <length> props-panel-width: 320px;

    // Viewport state (internal to Props tab)
    property <length> viewport-width: 375px;
    property <bool> is-responsive: false;

    // Props state - Component props
    in-out property <string> button-text: "Click me";
    in-out property <int> button-variant: 0;
    in-out property <int> button-size: 1;
    in-out property <bool> button-disabled: false;
    in-out property <bool> button-focused: false;
    in-out property <bool> button-full-width: false;
    in-out property <string> button-start-icon: "none";
    in-out property <string> button-end-icon: "none";

    property <image> selected-start-icon: root.icon-image(button-start-icon);
    property <image> selected-end-icon: root.icon-image(button-end-icon);

    // IconButton preview state
    in-out property <int> icon-button-variant: 0;
    in-out property <int> icon-button-size: 1;
    in-out property <int> icon-button-shape: 0;
    in-out property <bool> icon-button-disabled: false;
    in-out property <bool> icon-button-focused: false;
    in-out property <string> icon-button-icon: "pencil";
    property <image> selected-icon-button-icon: root.icon-image(icon-button-icon);

    // Icon preview state
    in-out property <string> icon-name: "star";
    in-out property <int> icon-size-index: 1;
    in-out property <int> icon-tone: 0;
    property <image> selected-icon-graphic: root.icon-image(icon-name);

    // Chip preview state
    in-out property <string> chip-text: "Beta";
    in-out property <int> chip-variant: 0;
    in-out property <int> chip-color: 0;
    in-out property <int> chip-size: 1;
    in-out property <bool> chip-closable: false;
    in-out property <bool> chip-selected: false;
    in-out property <bool> chip-disabled: false;
    in-out property <string> chip-icon: "star";
    property <image> selected-chip-icon: root.icon-image(chip-icon);

    // Input preview state
    in-out property <string> input-value: "";
    in-out property <string> input-placeholder: "you@example.com";
    in-out property <string> input-label: "Email address";
    in-out property <int> input-variant: 0;
    in-out property <int> input-type-index: 0;
    in-out property <int> input-text-alignment-index: 0;
    in-out property <bool> input-disabled: false;
    in-out property <bool> input-read-only: false;
    in-out property <bool> input-clearable: false;
    in-out property <bool> input-focused: false;
