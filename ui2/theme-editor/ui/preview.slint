                                        selected-index <=> root.radio-group-selected-index;
                                    }

                                    ToggleSwitch {
                                        label: "disabled";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.radio-group-disabled;
                                    }
                                }
                            }

                            if root.selected-category == 1 && root.selected-component == 0: Rectangle {
                                height: card-props.preferred-height;

                                card-props := VerticalLayout {
                                    spacing: 6px;

                                    TextInputRow {
                                        label: "eyebrow";
                                        dark-mode: root.dark-mode;
                                        value <=> root.card-eyebrow;
                                    }

                                    TextInputRow {
                                        label: "title";
                                        dark-mode: root.dark-mode;
                                        value <=> root.card-title;
                                    }

                                    TextInputRow {
                                        label: "subtitle";
                                        dark-mode: root.dark-mode;
                                        value <=> root.card-subtitle;
                                    }

                                    TextInputRow {
                                        label: "body";
                                        dark-mode: root.dark-mode;
                                        value <=> root.card-body;
                                    }

                                    TextInputRow {
                                        label: "footer";
                                        dark-mode: root.dark-mode;
                                        value <=> root.card-footer;
                                    }

                                    IconSelectorRow {
                                        label: "icon";
                                        dark-mode: root.dark-mode;
                                        value <=> root.card-icon;
                                        icon-results: root.icon-results;
                                        icon-image(name) => {
                                            return root.icon-image(name);
                                        }
                                        filter-icons(query) => {
                                            root.filter-icons(query);
                                        }
                                    }

                                    ToggleSwitch {
                                        label: "selected";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.card-selected;
                                    }

                                    ToggleSwitch {
                                        label: "interactive";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.card-interactive;
                                    }
                                }
                            }

                            if root.selected-category == 1 && root.selected-component == 1: Rectangle {
                                height: menu-props.preferred-height;

                                menu-props := VerticalLayout {
                                    spacing: 6px;

                                    EnumSelector {
                                        label: "selection";
                                        dark-mode: root.dark-mode;
                                        options: ["dashboard", "share", "settings", "delete"];
                                        selected-index <=> root.menu-selected-index;
                                    }

                                    ToggleSwitch {
                                        label: "fill width";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.menu-full-width;
                                    }
                                }
                            }

                            if root.selected-category == 1 && root.selected-component == 2: Rectangle {
                                height: menu-item-props.preferred-height;

                                menu-item-props := VerticalLayout {
                                    spacing: 6px;

                                    TextInputRow {
                                        label: "label";
                                        dark-mode: root.dark-mode;
                                        value <=> root.menu-item-label;
                                    }

                                    TextInputRow {
                                        label: "subtitle";
                                        dark-mode: root.dark-mode;
                                        value <=> root.menu-item-subtitle;
                                    }

                                    TextInputRow {
                                        label: "trailing";
                                        dark-mode: root.dark-mode;
                                        value <=> root.menu-item-trailing-text;
                                    }

                                    IconSelectorRow {
                                        label: "start-icon";
                                        dark-mode: root.dark-mode;
                                        value <=> root.menu-item-start-icon;
                                        icon-results: root.icon-results;
                                        icon-image(name) => {
                                            return root.icon-image(name);
                                        }
                                        filter-icons(query) => {
                                            root.filter-icons(query);
                                        }
                                    }

                                    IconSelectorRow {
                                        label: "end-icon";
                                        dark-mode: root.dark-mode;
                                        value <=> root.menu-item-end-icon;
                                        icon-results: root.icon-results;
                                        icon-image(name) => {
                                            return root.icon-image(name);
                                        }
                                        filter-icons(query) => {
                                            root.filter-icons(query);
                                        }
                                    }

                                    ToggleSwitch {
                                        label: "selected";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.menu-item-selected;
                                    }

                                    ToggleSwitch {
                                        label: "destructive";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.menu-item-destructive;
                                    }

                                    ToggleSwitch {
                                        label: "disabled";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.menu-item-disabled;
                                    }
                                }
                            }

                            if root.selected-category == 1 && root.selected-component == 3: Rectangle {
                                height: accordion-props.preferred-height;

                                accordion-props := VerticalLayout {
                                    spacing: 6px;

                                    ToggleSwitch {
                                        label: "allow-multiple";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.accordion-allow-multiple;
                                    }

                                    Text {
                                        text: "Item 1";
                                        color: root.dark-mode ? #cccccc : #444444;
                                        font-size: 11px;
                                        font-weight: 600;
                                    }

                                    TextInputRow {
                                        label: "title";
                                        dark-mode: root.dark-mode;
                                        value <=> root.accordion-item-0-title;
                                    }

                                    TextInputRow {
                                        label: "subtitle";
                                        dark-mode: root.dark-mode;
                                        value <=> root.accordion-item-0-subtitle;
                                    }

                                    TextInputRow {
                                        label: "body";
                                        dark-mode: root.dark-mode;
                                        value <=> root.accordion-item-0-body;
                                    }

                                    ToggleSwitch {
                                        label: "expanded";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.accordion-open-0;
                                    }

                                    ToggleSwitch {
                                        label: "disabled";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.accordion-item-0-disabled;
                                    }

                                    Text {
                                        text: "Item 2";
                                        color: root.dark-mode ? #cccccc : #444444;
                                        font-size: 11px;
                                        font-weight: 600;
                                    }

                                    TextInputRow {
                                        label: "title";
                                        dark-mode: root.dark-mode;
                                        value <=> root.accordion-item-1-title;
                                    }

                                    TextInputRow {
                                        label: "subtitle";
                                        dark-mode: root.dark-mode;
                                        value <=> root.accordion-item-1-subtitle;
                                    }

                                    TextInputRow {
                                        label: "body";
                                        dark-mode: root.dark-mode;
                                        value <=> root.accordion-item-1-body;
                                    }

                                    ToggleSwitch {
                                        label: "expanded";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.accordion-open-1;
                                    }

                                    ToggleSwitch {
                                        label: "disabled";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.accordion-item-1-disabled;
                                    }

                                    Text {
                                        text: "Item 3";
                                        color: root.dark-mode ? #cccccc : #444444;
                                        font-size: 11px;
                                        font-weight: 600;
                                    }

                                    TextInputRow {
                                        label: "title";
                                        dark-mode: root.dark-mode;
                                        value <=> root.accordion-item-2-title;
                                    }

                                    TextInputRow {
                                        label: "subtitle";
                                        dark-mode: root.dark-mode;
                                        value <=> root.accordion-item-2-subtitle;
                                    }

                                    TextInputRow {
                                        label: "body";
                                        dark-mode: root.dark-mode;
                                        value <=> root.accordion-item-2-body;
                                    }

                                    ToggleSwitch {
                                        label: "expanded";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.accordion-open-2;
                                    }

                                    ToggleSwitch {
                                        label: "disabled";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.accordion-item-2-disabled;
                                    }
                                }
                            }

                            if root.selected-category == 1 && root.selected-component == 4: Rectangle {
                                height: image-props.preferred-height;

                                image-props := VerticalLayout {
                                    spacing: 6px;

                                    TextInputRow {
                                        label: "alt";
                                        dark-mode: root.dark-mode;
                                        value <=> root.image-alt;
                                    }

                                    TextInputRow {
                                        label: "caption";
                                        dark-mode: root.dark-mode;
                                        value <=> root.image-caption;
                                    }

                                    ToggleSwitch {
                                        label: "rounded";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.image-rounded;
                                    }

                                    ToggleSwitch {
                                        label: "show-border";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.image-show-border;
                                    }
                                }
                            }

                            if root.selected-category == 1 && root.selected-component == 5: Rectangle {
                                height: divider-props.preferred-height;

                                divider-props := VerticalLayout {
                                    spacing: 6px;

                                    EnumSelector {
                                        label: "orientation";
                                        dark-mode: root.dark-mode;
                                        options: ["horizontal", "vertical"];
                                        selected-index <=> root.divider-orientation;
                                    }

                                    TextInputRow {
                                        label: "label";
                                        dark-mode: root.dark-mode;
                                        value <=> root.divider-label;
                                    }

                                    EnumSelector {
                                        label: "alignment";
                                        dark-mode: root.dark-mode;
                                        options: ["start", "middle", "end"];
                                        selected-index <=> root.divider-label-alignment;
                                    }

                                    if root.divider-orientation == 0: ToggleSwitch {
                                        label: "fill width";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.divider-full-width;
                                    }

                                    NumberInput {
                                        label: "gap";
                                        dark-mode: root.dark-mode;
                                        value <=> root.divider-label-gap;
                                        step: 1.0;
                                        min-value: 0.0;
                                        max-value: 32.0;
                                    }

                                    NumberInput {
                                        label: "start margin";
                                        dark-mode: root.dark-mode;
                                        value <=> root.divider-label-start-margin;
                                        step: 1.0;
                                        min-value: 0.0;
                                        max-value: 96.0;
                                    }

                                    NumberInput {
                                        label: "end margin";
                                        dark-mode: root.dark-mode;
                                        value <=> root.divider-label-end-margin;
                                        step: 1.0;
                                        min-value: 0.0;
                                        max-value: 96.0;
                                    }
                                }
                            }

                            if root.selected-category == 2 && root.selected-component == 0: Rectangle {
                                height: dialog-props.preferred-height;

                                dialog-props := VerticalLayout {
                                    spacing: 6px;

                                    TextInputRow {
                                        label: "title";
                                        dark-mode: root.dark-mode;
                                        value <=> root.dialog-title;
                                    }

                                    TextInputRow {
                                        label: "message";
                                        dark-mode: root.dark-mode;
                                        value <=> root.dialog-message;
                                    }

                                    TextInputRow {
                                        label: "primary";
                                        dark-mode: root.dark-mode;
                                        value <=> root.dialog-primary-action;
                                    }

                                    TextInputRow {
                                        label: "secondary";
                                        dark-mode: root.dark-mode;
                                        value <=> root.dialog-secondary-action;
                                    }

                                    IconSelectorRow {
                                        label: "icon";
                                        dark-mode: root.dark-mode;
                                        value <=> root.dialog-icon;
                                        icon-results: root.icon-results;
                                        icon-image(name) => {
                                            return root.icon-image(name);
                                        }
                                        filter-icons(query) => {
                                            root.filter-icons(query);
                                        }
                                    }

                                    EnumSelector {
                                        label: "variant";
                                        dark-mode: root.dark-mode;
                                        options: ["default", "danger"];
                                        selected-index <=> root.dialog-variant;
                                    }

                                    ToggleSwitch {
                                        label: "open";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.dialog-open;
                                    }

                                    ToggleSwitch {
                                        label: "dismissable";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.dialog-dismissable;
                                    }
                                }
                            }

                            if root.selected-category == 2 && root.selected-component == 1: Rectangle {
                                height: sheet-props.preferred-height;

                                sheet-props := VerticalLayout {
                                    spacing: 6px;

                                    TextInputRow {
                                        label: "title";
                                        dark-mode: root.dark-mode;
                                        value <=> root.sheet-title;
                                    }

                                    TextInputRow {
                                        label: "body";
                                        dark-mode: root.dark-mode;
                                        value <=> root.sheet-body;
                                    }

                                    EnumSelector {
                                        label: "detent";
                                        dark-mode: root.dark-mode;
                                        options: ["compact", "comfort", "expand"];
                                        selected-index <=> root.sheet-detent-index;
                                    }

                                    ToggleSwitch {
                                        label: "open";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.sheet-open;
                                    }

                                    ToggleSwitch {
                                        label: "show-handle";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.sheet-show-handle;
                                    }

                                    ToggleSwitch {
                                        label: "dismissable";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.sheet-dismissable;
                                    }
                                }
                            }

                            if root.selected-category == 2 && root.selected-component == 2: Rectangle {
                                height: toast-props.preferred-height;

                                toast-props := VerticalLayout {
                                    spacing: 6px;

                                    TextInputRow {
                                        label: "message";
                                        dark-mode: root.dark-mode;
                                        value <=> root.toast-message;
                                    }

                                    TextInputRow {
                                        label: "action";
                                        dark-mode: root.dark-mode;
                                        value <=> root.toast-action;
                                    }

                                    IconSelectorRow {
                                        label: "icon";
                                        dark-mode: root.dark-mode;
                                        value <=> root.toast-icon;
                                        icon-results: root.icon-results;
                                        icon-image(name) => {
                                            return root.icon-image(name);
                                        }
                                        filter-icons(query) => {
                                            root.filter-icons(query);
                                        }
                                    }

                                    EnumSelector {
                                        label: "variant";
                                        dark-mode: root.dark-mode;
                                        options: ["default", "success", "warning", "error"];
                                        selected-index <=> root.toast-variant;
                                    }

                                    EnumSelector {
                                        label: "position";
                                        dark-mode: root.dark-mode;
                                        options: ["top", "bottom"];
                                        selected-index <=> root.toast-position;
                                    }

                                    ToggleSwitch {
                                        label: "open";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.toast-open;
                                    }
                                }
                            }

                            if root.selected-category == 3 && root.selected-component == 0: Rectangle {
                                height: progress-props.preferred-height;

                                progress-props := VerticalLayout {
                                    spacing: 6px;

                                    TextInputRow {
                                        label: "label";
                                        dark-mode: root.dark-mode;
                                        value <=> root.progress-label;
                                    }

                                    TextInputRow {
                                        label: "value-label";
                                        dark-mode: root.dark-mode;
                                        value <=> root.progress-value-label;
                                    }

                                    NumberInput {
                                        label: "value";
                                        dark-mode: root.dark-mode;
                                        suffix: "";
                                        value <=> root.progress-value;
                                        min-value: 0;
                                        max-value: 1000;
                                        step: 1;
                                    }

                                    NumberInput {
                                        label: "min";
                                        dark-mode: root.dark-mode;
                                        suffix: "";
                                        value <=> root.progress-min-value;
                                        min-value: -1000;
                                        max-value: 1000;
                                        step: 1;
                                    }

                                    NumberInput {
                                        label: "max";
                                        dark-mode: root.dark-mode;
                                        suffix: "";
                                        value <=> root.progress-max-value;
                                        min-value: -1000;
                                        max-value: 1000;
                                        step: 1;
                                    }

                                    EnumSelector {
                                        label: "color";
                                        dark-mode: root.dark-mode;
                                        options: ["default", "primary", "secondary", "success", "warning", "danger"];
                                        selected-index <=> root.progress-tone;
                                    }

                                    EnumSelector {
                                        label: "format";
                                        dark-mode: root.dark-mode;
                                        options: ["percent", "value"];
                                        selected-index <=> root.progress-value-format;
                                    }

                                    ToggleSwitch {
                                        label: "indeterminate";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.progress-indeterminate;
                                    }

                                    ToggleSwitch {
                                        label: "show value";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.progress-show-value-label;
                                    }

                                    ToggleSwitch {
                                        label: "disabled";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.progress-disabled;
                                    }

                                    ToggleSwitch {
                                        label: "disable anim";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.progress-disable-animation;
                                    }
                                }
                            }

                            if root.selected-category == 3 && root.selected-component == 1: Rectangle {
                                height: spinner-props.preferred-height;

                                spinner-props := VerticalLayout {
                                    spacing: 6px;

                                    EnumSelector {
                                        label: "size";
                                        dark-mode: root.dark-mode;
                                        options: ["sm", "md", "lg"];
                                        selected-index <=> root.spinner-size;
                                    }

                                    EnumSelector {
                                        label: "tone";
                                        dark-mode: root.dark-mode;
                                        options: ["primary", "neutral", "success", "warning", "danger"];
                                        selected-index <=> root.spinner-tone;
                                    }

                                    NumberInput {
                                        label: "speed";
                                        dark-mode: root.dark-mode;
                                        suffix: "RPM";
                                        value <=> root.spinner-animation-speed;
                                        min-value: 1.0;
                                        max-value: 240.0;
                                        step: 1.0;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    pure function get-component-name(category: int, component: int) -> string {
        if category == 0 {
            if component == 0 {
                return "Button";
            }
            if component == 1 {
                return "IconButton";
            }
            if component == 2 {
                return "Chip";
            }
            if component == 3 {
                return "Input";
            }
            if component == 4 {
                return "Search";
            }
            if component == 5 {
                return "Dropdown";
            }
            if component == 6 {
                return "Checkbox";
            }
            if component == 7 {
                return "Radio";
            }
            if component == 8 {
                return "Switch";
            }
            if component == 9 {
                return "Tabs";
            }
            if component == 10 {
                return "SlideToConfirm";
            }
            if component == 11 {
                return "Link";
            }
            if component == 12 {
                return "Slider";
            }
            if component == 13 {
                return "TextArea";
            }
            if component == 14 {
                return "RadioGroup";
            }
            if component == 15 {
                return "Icon";
            }
        }
        if category == 1 {
            if component == 0 {
                return "Card";
            }
            if component == 1 {
                return "Menu";
            }
            if component == 2 {
                return "MenuItem";
            }
            if component == 3 {
                return "Accordion";
            }
            if component == 4 {
                return "Image";
            }
            if component == 5 {
                return "Divider";
            }
        }
        if category == 2 {
            if component == 0 {
                return "Dialog";
            }
            if component == 1 {
                return "Sheet";
            }
            if component == 2 {
                return "Toast";
            }
        }
        if category == 3 {
            if component == 0 {
                return "ProgressBar";
            }
            if component == 1 {
                return "Spinner";
            }
        }
        return "Unknown";
    }
}
