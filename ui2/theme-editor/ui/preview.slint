                        if root.selected-category == 1 && root.selected-component == 1: VerticalLayout {
                            spacing: 16px;

                            Text {
                                text: "Menu";
                                color: dark-mode ? #888888 : #666666;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            Rectangle {
                                width: 340px;
                                height: demo-menu.preferred-height;
                                background: transparent;

                                demo-menu := Menu {
                                    width: parent.width;
                                    full-width: true;

                                    MenuItem {
                                        label: "Select";
                                        end-icon: root.icon-image("check");
                                        clicked => {
                                            root.menu-selected-index = 0;
                                        }
                                    }

                                    MenuItem {
                                        label: "Add Folder";
                                        end-icon: root.icon-image("plus");
                                        clicked => {
                                            root.menu-selected-index = 1;
                                        }
                                    }

                                    MenuItem {
                                        label: "Search & Sort";
                                        end-icon: root.icon-image("search");
                                        clicked => {
                                            root.menu-selected-index = 2;
                                        }
                                    }

                                    MenuRow {
                                        divider: false;
                                        content-padding-horizontal: 16px;
                                        content-padding-vertical: 14px;

                                        VerticalLayout {
                                            width: parent.width;
                                            spacing: 12px;

                                            HorizontalLayout {
                                                spacing: 10px;

                                                Rectangle {
                                                    width: 24px;
                                                    height: 24px;
                                                    background: transparent;

                                                    Image {
                                                        width: parent.width;
                                                        height: parent.height;
                                                        source: root.icon-image("info");
                                                        colorize: Theme.palette-muted;
                                                    }
                                                }

                                                Text {
                                                    text: "Quick Tip";
                                                    color: Theme.palette-muted;
                                                    font-family: "Montserrat";
                                                    font-size: 20px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            Text {
                                                text: "Tap and hold a file or folder to select it quickly.";
                                                color: Theme.palette-foreground;
                                                font-family: "Montserrat";
                                                font-size: 22px;
                                                wrap: word-wrap;
                                            }

                                            Text {
                                                text: "Dismiss";
                                                color: Theme.palette-primary;
                                                font-family: "Montserrat";
                                                font-size: 22px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if root.selected-category == 1 && root.selected-component == 2: VerticalLayout {
                            spacing: 16px;

                            Text {
                                text: "States";
                                color: dark-mode ? #888888 : #666666;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            VerticalLayout {
                                spacing: 8px;

                                MenuItem {
                                    width: 340px;
                                    label: "Default";
                                    subtitle: "Open the workspace overview.";
                                    start-icon: root.icon-image("house");
                                    end-icon: root.icon-image("chevron-right");
                                }

                                MenuItem {
                                    width: 340px;
                                    label: "Selected";
                                    subtitle: "Current destination";
                                    start-icon: root.icon-image("check");
                                    selected: true;
                                }

                                MenuItem {
                                    width: 340px;
                                    label: "Destructive";
                                    start-icon: root.icon-image("trash-2");
                                    destructive: true;
                                }

                                MenuItem {
                                    width: 340px;
                                    label: "Disabled";
                                    subtitle: "Not available in your plan.";
                                    start-icon: root.icon-image("lock");
                                    disabled: true;
                                }
                            }
                        }

                        if root.selected-category == 1 && root.selected-component == 3: VerticalLayout {
                            spacing: 12px;

                            Text {
                                text: "Single open";
                                color: dark-mode ? #cccccc : #444444;
                                font-size: 13px;
                                font-weight: 600;
                            }

                            Accordion {
                                width: 420px;
                                items: root.accordion-items;
                                expanded-states: root.accordion-expanded-states;
                                allow-multiple: false;
                                toggle-requested(index) => {
                                    root.accordion-allow-multiple = false;
                                    root.toggle-accordion-item(index);
                                }
                            }

                            Text {
                                text: "Multiple open";
                                color: dark-mode ? #cccccc : #444444;
                                font-size: 13px;
                                font-weight: 600;
                            }

                            Accordion {
                                width: 420px;
                                items: root.accordion-items;
                                expanded-states: root.accordion-story-multi-expanded-states;
                                allow-multiple: true;
                                toggle-requested(index) => {
                                    root.toggle-accordion-story-multi-item(index);
                                }
                            }
                        }

                        if root.selected-category == 1 && root.selected-component == 4: VerticalLayout {
                            spacing: 16px;

                            Text {
                                text: "States";
                                color: dark-mode ? #888888 : #666666;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 16px;
                                alignment: start;

                                Rectangle {
                                    width: 360px;
                                    height: bordered-image.preferred-height;

                                    bordered-image := MediaImage {
                                        width: parent.width;
                                        source: root.sample-media-image;
                                        alt: "Rounded image";
                                        caption: "Default presentation with rounded corners and border.";
                                        rounded: true;
                                        show-border: true;
                                    }
                                }

                                Rectangle {
                                    width: 360px;
                                    height: flat-image.preferred-height;

                                    flat-image := MediaImage {
                                        width: parent.width;
                                        source: root.sample-media-image;
                                        alt: "Full bleed image";
                                        caption: "Square corners without the card frame.";
                                        rounded: false;
                                        show-border: false;
                                    }
                                }
                            }
                        }

                        if root.selected-category == 1 && root.selected-component == 5: VerticalLayout {
                            spacing: 16px;

                            Text {
                                text: "Orientation";
                                color: dark-mode ? #888888 : #666666;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            Rectangle {
                                width: 420px;
                                height: 120px;
                                background: dark-mode ? #242424 : #ffffff;
                                border-color: dark-mode ? #2f2f2f : #ececec;
                                border-width: 1px;
                                border-radius: 12px;

                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 12px;

                                    Text {
                                        text: "Horizontal dividers";
                                        color: dark-mode ? #cccccc : #444444;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }

                                    Divider {
                                        width: parent.width;
                                        label: "Overview";
                                        label-alignment: DividerLabelAlignment.start;
                                    }

                                    Divider {
                                        width: parent.width;
                                        label: "Specifications";
                                        label-alignment: DividerLabelAlignment.middle;
                                    }

                                    Divider {
                                        width: parent.width;
                                        label: "Resources";
                                        label-alignment: DividerLabelAlignment.end;
                                    }

                                    Text {
                                        text: "Use dividers to separate related content without adding heavy chrome.";
                                        color: dark-mode ? #aaaaaa : #666666;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;
                                alignment: start;

                                Text {
                                    text: "Start";
                                    color: dark-mode ? #cccccc : #444444;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    width: 24px;
                                    height: 96px;

                                    Divider {
                                        width: parent.width;
                                        height: parent.height;
                                        orientation: DividerOrientation.vertical;
                                    }
                                }

                                Text {
                                    text: "End";
                                    color: dark-mode ? #cccccc : #444444;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if root.selected-category == 2 && root.selected-component == 0: VerticalLayout {
                            spacing: 16px;

                            Text {
                                text: "Variants";
                                color: dark-mode ? #888888 : #666666;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 16px;
                                alignment: start;

                                Rectangle {
                                    width: 420px;
                                    height: 320px;

                                    Dialog {
                                        width: parent.width;
                                        height: parent.height;
                                        title: "Invite teammate";
                                        message: "Add a collaborator to this workspace and assign editor access.";
                                        icon: root.icon-image("share");
                                        primary-action: "Send invite";
                                        secondary-action: "Cancel";
                                    }
                                }

                                Rectangle {
                                    width: 420px;
                                    height: 320px;

                                    Dialog {
                                        width: parent.width;
                                        height: parent.height;
                                        title: "Delete project";
                                        message: "This removes the project and all unpublished changes.";
                                        icon: root.icon-image("trash-2");
                                        variant: DialogVariant.danger;
                                        primary-action: "Delete";
                                        secondary-action: "Cancel";
                                    }
                                }
                            }
                        }

                        if root.selected-category == 2 && root.selected-component == 1: VerticalLayout {
                            spacing: 16px;

                            Text {
                                text: "Detents";
                                color: dark-mode ? #888888 : #666666;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 16px;
                                alignment: start;

                                Rectangle {
                                    width: 360px;
                                    height: 340px;

                                    Sheet {
                                        width: parent.width;
                                        height: parent.height;
                                        title: "Share workspace";
                                        body: "Click the handle to cycle through compact, comfortable, and expanded stops.";
                                        selected-detent: 0;
                                    }
                                }

                                Rectangle {
                                    width: 360px;
                                    height: 340px;

                                    Sheet {
                                        width: parent.width;
                                        height: parent.height;
                                        title: "Release checklist";
                                        body: "The expanded stop leaves room for details, controls, and a scrollable task list.";
                                        selected-detent: 2;
                                    }
                                }
                            }
                        }

                        if root.selected-category == 2 && root.selected-component == 2: VerticalLayout {
                            spacing: 16px;

                            Text {
                                text: "Variants";
                                color: dark-mode ? #888888 : #666666;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 16px;
                                alignment: start;

                                Rectangle {
                                    width: 380px;
                                    height: 170px;

                                    Toast {
                                        width: parent.width;
                                        height: parent.height;
                                        icon: root.icon-image("info");
                                        message: "A new version of the workspace is available.";
                                        action: "Reload";
                                        variant: ToastVariant.default;
                                        position: ToastPosition.top;
                                    }
                                }

                                Rectangle {
                                    width: 380px;
                                    height: 170px;

                                    Toast {
                                        width: parent.width;
                                        height: parent.height;
                                        icon: root.icon-image("check");
                                        message: "Workspace published successfully.";
                                        action: "Undo";
                                        variant: ToastVariant.success;
                                        position: ToastPosition.bottom;
                                    }
                                }
                            }
                        }

                        if root.selected-category == 3 && root.selected-component == 0: VerticalLayout {
                            spacing: 16px;

                            Text {
                                text: "Variants";
                                color: dark-mode ? #888888 : #666666;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            VerticalLayout {
                                spacing: 14px;

                                ProgressBar {
                                    width: 320px;
                                    label: "Default";
                                    value: 24;
                                    tone: ProgressBarTone.default;
                                }

                                ProgressBar {
                                    width: 320px;
                                    label: "Primary";
                                    value: 56;
                                    tone: ProgressBarTone.primary;
                                }

                                ProgressBar {
                                    width: 320px;
                                    label: "Secondary";
                                    value: 44;
                                    tone: ProgressBarTone.secondary;
                                }

                                ProgressBar {
                                    width: 320px;
                                    label: "Success";
                                    value: 78;
                                    tone: ProgressBarTone.success;
                                }

                                ProgressBar {
                                    width: 320px;
                                    label: "Warning";
                                    value: 62;
                                    tone: ProgressBarTone.warning;
                                }
                            }

                            Text {
                                text: "States";
                                color: dark-mode ? #888888 : #666666;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            VerticalLayout {
                                spacing: 14px;

                                ProgressBar {
                                    width: 320px;
                                    label: "Uploading";
                                    value: 68;
                                    tone: ProgressBarTone.primary;
                                }

                                ProgressBar {
                                    width: 320px;
                                    label: "Indexing";
                                    indeterminate: true;
                                    value-label: "Processing";
                                    tone: ProgressBarTone.warning;
                                }

                                ProgressBar {
                                    width: 320px;
                                    label: "Disabled";
                                    value: 38;
                                    disabled: true;
                                    tone: ProgressBarTone.danger;
                                }
                            }
                        }

                        if root.selected-category == 3 && root.selected-component == 1: VerticalLayout {
                            spacing: 16px;

                            Text {
                                text: "Sizes";
                                color: dark-mode ? #888888 : #666666;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 20px;
                                alignment: start;

                                Spinner {
                                    size: SpinnerSize.sm;
                                    tone: SpinnerTone.primary;
                                }

                                Spinner {
                                    size: SpinnerSize.md;
                                    tone: SpinnerTone.neutral;
                                }

                                Spinner {
                                    size: SpinnerSize.lg;
                                    tone: SpinnerTone.success;
                                }

                                Spinner {
                                    size: SpinnerSize.lg;
                                    tone: SpinnerTone.danger;
                                }
                            }
                        }

                        if !((root.selected-category == 0 && (root.selected-component == 0 || root.selected-component == 1 || root.selected-component == 2 || root.selected-component == 3 || root.selected-component == 4 || root.selected-component == 5 || root.selected-component == 6 || root.selected-component == 7 || root.selected-component == 8 || root.selected-component == 9 || root.selected-component == 10 || root.selected-component == 11 || root.selected-component == 12 || root.selected-component == 13 || root.selected-component == 14 || root.selected-component == 15)) || (root.selected-category == 1 && (root.selected-component == 0 || root.selected-component == 1 || root.selected-component == 2 || root.selected-component == 3 || root.selected-component == 4 || root.selected-component == 5)) || (root.selected-category == 2 && (root.selected-component == 0 || root.selected-component == 1 || root.selected-component == 2)) || (root.selected-category == 3 && (root.selected-component == 0 || root.selected-component == 1))): VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "Preview not implemented for this component yet.";
                                color: dark-mode ? #888888 : #666666;
                                font-size: 13px;
                            }
                        }
                    }
                }
            }

            // Props tab content
            if active-tab == 1: props-tab-container := Rectangle {
                // Track if splitter is being dragged
                property <bool> splitter-dragging: false;
                property <length> drag-start-total-width;  // Invariant: total content width (preview + props)
                property <bool> viewport-dragging: false;
                property <length> viewport-drag-start-width: 0px;

                HorizontalLayout {
                    spacing: 0px;

                    // Left: Live preview (takes remaining space)
                    preview-panel := Rectangle {
                        horizontal-stretch: 1;
                        background: dark-mode ? #1a1a1a : #f5f5f5;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            // Component-name heading, contained within the central
                            // panel (the standalone theme editor puts it in the top
                            // header instead, gated by show-tabs).
                            if !root.show-tabs: Text {
                                text: get-component-name(selected-category, selected-component);
                                color: dark-mode ? #ffffff : #1a1a1a;
                                font-size: 20px;
                                font-weight: 600;
                            }

                            // Header with Reset button only
                            HorizontalLayout {
                                Text {
                                    text: "Preview";
                                    color: dark-mode ? #888888 : #666666;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                Rectangle {
                                    width: 60px;
                                    height: 22px;
                                    background: dark-mode ? #2a2a2a : #e8e8e8;
                                    border-radius: 4px;

                                    Text {
                                        x: (parent.width - self.preferred-width) / 2;
                                        y: (parent.height - self.preferred-height) / 2;
                                        text: "Reset";
                                        color: dark-mode ? #cccccc : #444444;
                                        font-size: 10px;
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.reset-to-defaults();
                                        }
                                    }
                                }
                            }

                            // Preview area - constrained to viewport width when responsive
                            preview-viewport-frame := Rectangle {
                                vertical-stretch: 1;
                                background: dark-mode ? #242424 : #ffffff;
                                border-radius: 8px;
                                clip: true;
                                property <length> min-responsive-width: min(200px, self.width);
                                property <length> active-viewport-width:
                                    root.is-responsive ? clamp(root.viewport-width, self.min-responsive-width, self.width) : self.width;

                                // Constrained viewport container
                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: preview-viewport-frame.active-viewport-width;
                                    height: parent.height;
                                    background: dark-mode ? #242424 : #ffffff;
                                    clip: true;  // Clip content to viewport boundary

                                    if root.selected-category == 0 && root.selected-component == 0: Rectangle {
                                        x: root.button-full-width ? 16px : (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: root.button-full-width ? (parent.width - 32px) : min(preview-btn.preferred-width, parent.width - 32px);
                                        height: preview-btn.preferred-height;
                                        clip: true;

                                        preview-btn := Button {
                                            width: min(self.preferred-width, parent.width);
                                            text: root.button-text;
                                            variant: root.active-button-variant;
                                            size: root.active-button-size;
                                            start-icon: root.selected-start-icon;
                                            end-icon: root.selected-end-icon;
                                            disabled: root.button-disabled;
                                            force-focused: root.button-focused;
                                            full-width: root.button-full-width;
                                        }
                                    }

                                    if root.selected-category == 0 && root.selected-component == 1: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: preview-icon-btn.preferred-width;
                                        height: preview-icon-btn.preferred-height;

                                        preview-icon-btn := IconButton {
                                            label: "Icon Button";
                                            icon: root.selected-icon-button-icon;
                                            variant: root.icon-button-variant == 1 ? IconButtonVariant.ghost : root.icon-button-variant == 2 ? IconButtonVariant.outlined : IconButtonVariant.default;
                                            size: root.icon-button-size == 0 ? IconButtonSize.sm : root.icon-button-size == 2 ? IconButtonSize.lg : IconButtonSize.md;
                                            shape: root.icon-button-shape == 1 ? IconButtonShape.square : IconButtonShape.circle;
                                            disabled: root.icon-button-disabled;
                                            force-focused: root.icon-button-focused;
                                        }
                                    }

                                    if root.selected-category == 0 && root.selected-component == 15: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: preview-icon.preferred-width;
                                        height: preview-icon.preferred-height;

                                        preview-icon := Icon {
                                            icon: root.selected-icon-graphic;
                                            size: root.active-icon-size;
                                            icon-color: root.active-icon-color;
                                        }
                                    }

                                    if root.selected-category == 0 && root.selected-component == 2: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: preview-chip.preferred-width;
                                        height: preview-chip.preferred-height;

                                        preview-chip := Chip {
                                            text: root.chip-text;
                                            icon: root.selected-chip-icon;
                                            variant: root.chip-variant == 1 ? ChipVariant.outlined : root.chip-variant == 2 ? ChipVariant.soft : ChipVariant.filled;
                                            color: root.chip-color == 1 ? ChipColor.primary : root.chip-color == 2 ? ChipColor.secondary : root.chip-color == 3 ? ChipColor.success : root.chip-color == 4 ? ChipColor.warning : root.chip-color == 5 ? ChipColor.danger : ChipColor.default;
                                            size: root.chip-size == 0 ? ChipSize.sm : root.chip-size == 2 ? ChipSize.lg : ChipSize.md;
                                            closable: root.chip-closable;
                                            selected: root.chip-selected;
                                            disabled: root.chip-disabled;
                                        }
                                    }

                                    if root.selected-category == 0 && root.selected-component == 3: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(320px, parent.width - 32px);
                                        height: preview-input.preferred-height;

                                        preview-input := Input {
                                            width: parent.width;
                                            value <=> root.input-value;
                                            placeholder: root.input-placeholder;
                                            label: root.input-label;
                                            variant: root.input-variant == 1 ? InputVariant.filled : root.input-variant == 2 ? InputVariant.outlined : InputVariant.default;
                                            input-type: root.active-input-type;
                                            text-alignment: root.active-input-text-alignment;
                                            prefix-icon: root.selected-input-prefix-icon;
                                            suffix-icon: root.selected-input-suffix-icon;
                                            clearable: root.input-clearable;
                                            error: root.input-error;
                                            disabled: root.input-disabled;
                                            read-only: root.input-read-only;
                                            force-focused: root.input-focused;
                                        }
                                    }

                                    if root.selected-category == 0 && root.selected-component == 4: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(320px, parent.width - 32px);
                                        height: preview-search.preferred-height;

                                        preview-search := Search {
                                            width: parent.width;
                                            value <=> root.search-value;
                                            label: root.search-label;
                                            placeholder: root.search-placeholder;
                                            variant: root.active-search-variant;
                                            clearable: root.search-clearable;
                                            disabled: root.search-disabled;
                                            read-only: root.search-read-only;
                                            force-focused: root.search-focused;
                                            error: root.search-error;
                                        }
                                    }

                                    if root.selected-category == 0 && root.selected-component == 5: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(320px, parent.width - 32px);
                                        height: preview-dropdown.preferred-height;

                                        preview-dropdown := Dropdown {
                                            width: parent.width;
                                            label: root.dropdown-label;
                                            placeholder: root.dropdown-placeholder;
                                            options: root.dropdown-options;
                                            selected-index <=> root.dropdown-selected-index;
                                            disabled: root.dropdown-disabled;
                                        }
                                    }

                                    if root.selected-category == 0 && root.selected-component == 6: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(max(360px, preview-checkbox.preferred-width), max(0px, parent.width - 32px));
                                        height: preview-checkbox.preferred-height;

                                        preview-checkbox := Checkbox {
                                            width: parent.width;
                                            label: root.checkbox-label;
                                            description: root.checkbox-description;
                                            checked <=> root.checkbox-checked;
                                            indeterminate <=> root.checkbox-indeterminate;
                                            disabled: root.checkbox-disabled;
                                        }
                                    }

                                    if root.selected-category == 0 && root.selected-component == 7: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(max(360px, preview-radio.preferred-width), max(0px, parent.width - 32px));
                                        height: preview-radio.preferred-height;

                                        preview-radio := Radio {
                                            width: parent.width;
                                            label: root.radio-label;
                                            description: root.radio-description;
                                            checked <=> root.radio-checked;
                                            disabled: root.radio-disabled;
                                        }
                                    }

                                    if root.selected-category == 0 && root.selected-component == 8: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(360px, parent.width - 32px);
                                        height: preview-switch.preferred-height;

                                        preview-switch := Switch {
                                            width: parent.width;
                                            label: root.switch-label;
                                            description: root.switch-description;
                                            checked <=> root.switch-checked;
                                            disabled: root.switch-disabled;
                                        }
                                    }

                                    if root.selected-category == 0 && root.selected-component == 9: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(480px, parent.width - 32px);
                                        height: preview-segmented.preferred-height;

                                        preview-segmented := Tabs {
                                            width: parent.width;
                                            options: root.segmented-options;
                                            panels: root.segmented-panels;
                                            icons: root.segmented-icons;
                                            disabled-items: root.segmented-disabled-items;
                                            selected-index <=> root.segmented-selected-index;
                                            variant: root.active-tabs-variant;
                                            color: root.active-tabs-color;
                                            orientation: root.active-tabs-orientation;
                                            full-width: root.segmented-full-width;
                                            show-panel: root.segmented-show-panel;
                                            disabled: root.segmented-disabled;
                                        }
                                    }

                                    if root.selected-category == 0 && root.selected-component == 10: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(320px, parent.width - 32px);
                                        height: preview-slide.preferred-height;

                                        preview-slide := SlideToConfirm {
                                            width: parent.width;
                                            label: root.slide-label;
                                            hint: root.slide-hint;
                                            confirmed-label: root.slide-confirmed-label;
                                            confirmed <=> root.slide-confirmed;
                                            disabled: root.slide-disabled;
                                        }
                                    }

                                    if root.selected-category == 0 && root.selected-component == 11: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(preview-link.preferred-width, max(0px, parent.width - 32px));
                                        height: preview-link.preferred-height;

                                        preview-link := Link {
                                            label: root.link-label;
                                            disabled: root.link-disabled;
                                            external: root.link-external;
                                            visited: root.link-visited;
                                            underlined: root.link-underlined;
                                        }
                                    }

                                    if root.selected-category == 0 && root.selected-component == 12: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(320px, parent.width - 32px);
                                        height: preview-slider.preferred-height;

                                        preview-slider := Slider {
                                            width: parent.width;
                                            minimum: root.slider-minimum;
                                            maximum: root.slider-maximum;
                                            step: root.slider-step;
                                            value <=> root.slider-value;
                                            size: root.active-slider-size;
                                            disabled: root.slider-disabled;
                                            force-focused: root.slider-focused;
                                            track-color: Theme.palette-primary;
                                            fill-color: Theme.palette-primary;
                                            thumb-color: Theme.palette-background;
                                            thumb-border-color: Theme.palette-primary;
                                        }
                                    }

                                    if root.selected-category == 0 && root.selected-component == 13: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(420px, parent.width - 32px);
                                        height: preview-textarea.preferred-height;

                                        preview-textarea := TextArea {
                                            width: parent.width;
                                            value <=> root.textarea-value;
                                            placeholder: root.textarea-placeholder;
                                            label: root.textarea-label;
                                            description: root.textarea-description;
                                            error: root.textarea-error;
                                            variant: root.active-textarea-variant;
                                            clearable: root.textarea-clearable;
                                            disabled: root.textarea-disabled;
                                            read-only: root.textarea-read-only;
                                            required: root.textarea-required;
                                            disable-autosize: root.textarea-disable-autosize;
                                            min-rows: Math.round(root.textarea-min-rows);
                                            max-rows: Math.round(root.textarea-max-rows);
                                            force-focused: root.textarea-focused;
                                        }
                                    }

                                    if root.selected-category == 0 && root.selected-component == 14: Rectangle {
                                        x: 16px;
                                        y: 16px;
                                        width: min(420px, parent.width - 32px);
                                        height: preview-radio-group.preferred-height;

                                        preview-radio-group := RadioGroup {
                                            width: parent.width;
                                            options: root.radio-group-options;
                                            descriptions: root.radio-group-descriptions;
                                            disabled-items: root.radio-group-disabled-items;
                                            selected-index <=> root.radio-group-selected-index;
                                            disabled: root.radio-group-disabled;
                                        }
                                    }

                                    if root.selected-category == 1 && root.selected-component == 0: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(340px, parent.width - 32px);
                                        height: preview-card.preferred-height;

                                        preview-card := Card {
                                            width: parent.width;
                                            eyebrow: root.card-eyebrow;
                                            title: root.card-title;
                                            subtitle: root.card-subtitle;
                                            body: root.card-body;
                                            footer: root.card-footer;
                                            selected: root.card-selected;
                                            interactive: root.card-interactive;
                                            icon: root.selected-card-icon;
                                        }
                                    }

                                    if root.selected-category == 1 && root.selected-component == 1: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(340px, parent.width - 32px);
                                        height: preview-menu.preferred-height;

                                        preview-menu := Menu {
                                            x: root.menu-full-width ? 0px : (parent.width - self.preferred-width) / 2;
                                            width: root.menu-full-width ? parent.width : self.preferred-width;
                                            full-width: root.menu-full-width;

                                            MenuItem {
                                                label: "Select";
                                                end-icon: root.icon-image("check");
                                                clicked => {
                                                    root.menu-selected-index = 0;
                                                }
                                            }

                                            MenuItem {
                                                label: "Add Folder";
                                                end-icon: root.icon-image("plus");
                                                clicked => {
                                                    root.menu-selected-index = 1;
                                                }
                                            }

                                            MenuItem {
                                                label: "Search & Sort";
                                                end-icon: root.icon-image("search");
                                                clicked => {
                                                    root.menu-selected-index = 2;
                                                }
                                            }

                                            MenuRow {
                                                divider: false;
                                                content-padding-horizontal: 16px;
                                                content-padding-vertical: 14px;

                                                VerticalLayout {
                                                    width: parent.width;
                                                    spacing: 12px;

                                                    HorizontalLayout {
                                                        spacing: 10px;

                                                        Rectangle {
                                                            width: 24px;
                                                            height: 24px;
                                                            background: transparent;

                                                            Image {
                                                                width: parent.width;
                                                                height: parent.height;
                                                                source: root.icon-image("info");
                                                                colorize: Theme.palette-muted;
                                                            }
                                                        }

                                                        Text {
                                                            text: "Quick Tip";
                                                            color: Theme.palette-muted;
                                                            font-family: "Montserrat";
                                                            font-size: 20px;
                                                            font-weight: 600;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    Text {
                                                        text: "Tap and hold a file or folder to select it quickly.";
                                                        color: Theme.palette-foreground;
                                                        font-family: "Montserrat";
                                                        font-size: 22px;
                                                        wrap: word-wrap;
                                                    }

                                                    Text {
                                                        text: "Dismiss";
                                                        color: Theme.palette-primary;
                                                        font-family: "Montserrat";
                                                        font-size: 22px;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if root.selected-category == 1 && root.selected-component == 2: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(340px, parent.width - 32px);
                                        height: preview-menu-item.preferred-height;

                                        preview-menu-item := MenuItem {
                                            width: parent.width;
                                            divider: false;
                                            label: root.menu-item-label;
                                            subtitle: root.menu-item-subtitle;
                                            start-icon: root.selected-menu-item-start-icon;
                                            end-icon: root.selected-menu-item-end-icon;
                                            trailing-text: root.menu-item-trailing-text;
                                            selected: root.menu-item-selected;
                                            destructive: root.menu-item-destructive;
                                            disabled: root.menu-item-disabled;
                                        }
                                    }

                                    if root.selected-category == 1 && root.selected-component == 3: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(420px, parent.width - 32px);
                                        height: preview-accordion.preferred-height;

                                        preview-accordion := Accordion {
                                            width: parent.width;
                                            items: root.accordion-items;
                                            expanded-states: root.accordion-expanded-states;
                                            allow-multiple: root.accordion-allow-multiple;
                                            toggle-requested(index) => {
                                                root.toggle-accordion-item(index);
                                            }
                                        }
                                    }

                                    if root.selected-category == 1 && root.selected-component == 4: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(360px, parent.width - 32px);
                                        height: preview-media-image.preferred-height;

                                        preview-media-image := MediaImage {
                                            width: parent.width;
                                            source: root.sample-media-image;
                                            alt: root.image-alt;
                                            caption: root.image-caption;
                                            rounded: root.image-rounded;
                                            show-border: root.image-show-border;
                                        }
                                    }

                                    if root.selected-category == 1 && root.selected-component == 5: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: root.divider-orientation == 0 ? (root.divider-full-width ? min(320px, parent.width - 32px) : min(240px, parent.width - 32px)) : 48px;
                                        height: root.divider-orientation == 0 ? 48px : min(220px, parent.height - 32px);

                                        preview-divider := Divider {
                                            x: root.divider-orientation == 0 && !root.divider-full-width ? (parent.width - self.preferred-width) / 2 : 0px;
                                            width: root.divider-orientation == 1 ? parent.width : (root.divider-full-width ? parent.width : self.preferred-width);
                                            height: parent.height;
                                            orientation: root.divider-orientation == 1 ? DividerOrientation.vertical : DividerOrientation.horizontal;
                                            label: root.divider-label;
                                            label-alignment: root.active-divider-label-alignment;
                                            full-width: root.divider-full-width;
                                            label-gap: root.divider-label-gap * 1px;
                                            label-start-margin: root.divider-label-start-margin * 1px;
                                            label-end-margin: root.divider-label-end-margin * 1px;
                                        }
                                    }

                                    if root.selected-category == 2 && root.selected-component == 0: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(420px, parent.width - 32px);
                                        height: min(320px, parent.height - 32px);

                                        preview-dialog := Dialog {
                                            width: parent.width;
                                            height: parent.height;
                                            open <=> root.dialog-open;
                                            title: root.dialog-title;
                                            message: root.dialog-message;
                                            icon: root.selected-dialog-icon;
                                            variant: root.active-dialog-variant;
                                            primary-action: root.dialog-primary-action;
                                            secondary-action: root.dialog-secondary-action;
                                            dismissable: root.dialog-dismissable;
                                            dismissed => {
                                                root.dialog-open = false;
                                            }
                                        }
                                    }

                                    if root.selected-category == 2 && root.selected-component == 1: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(380px, parent.width - 32px);
                                        height: min(360px, parent.height - 32px);

                                        preview-sheet := Sheet {
                                            width: parent.width;
                                            height: parent.height;
                                            open <=> root.sheet-open;
                                            title: root.sheet-title;
                                            body: root.sheet-body;
                                            show-handle: root.sheet-show-handle;
                                            dismissable: root.sheet-dismissable;
                                            detents: root.sheet-detents;
                                            selected-detent <=> root.sheet-detent-index;
                                            dismissed => {
                                                root.sheet-open = false;
                                            }
                                        }
                                    }

                                    if root.selected-category == 2 && root.selected-component == 2: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(380px, parent.width - 32px);
                                        height: 180px;

                                        preview-toast := Toast {
                                            width: parent.width;
                                            height: parent.height;
                                            open <=> root.toast-open;
                                            message: root.toast-message;
                                            icon: root.selected-toast-icon;
                                            variant: root.active-toast-variant;
                                            position: root.active-toast-position;
                                            action: root.toast-action;
                                            dismissed => {
                                                root.toast-open = false;
                                            }
                                        }
                                    }

                                    if root.selected-category == 3 && root.selected-component == 0: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: min(320px, parent.width - 32px);
                                        height: preview-progress.preferred-height;

                                        preview-progress := ProgressBar {
                                            width: parent.width;
                                            label: root.progress-label;
                                            value-label: root.progress-value-label;
                                            value: root.progress-value;
                                            min-value: root.progress-min-value;
                                            max-value: root.progress-max-value;
                                            indeterminate: root.progress-indeterminate;
                                            show-value-label: root.progress-show-value-label;
                                            disabled: root.progress-disabled;
                                            disable-animation: root.progress-disable-animation;
                                            tone: root.active-progress-tone;
                                            value-format: root.active-progress-value-format;
                                        }
                                    }

                                    if root.selected-category == 3 && root.selected-component == 1: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: preview-spinner.preferred-width;
                                        height: preview-spinner.preferred-height;

                                        preview-spinner := Spinner {
                                            size: root.active-spinner-size;
                                            tone: root.active-spinner-tone;
                                            animation-speed: root.spinner-animation-speed;
                                        }
                                    }
                                }

                                if root.is-responsive: viewport-resize-handle := Rectangle {
                                    x: max(
                                            0px,
                                            min(
                                                preview-viewport-frame.width - self.width,
                                                preview-viewport-frame.active-viewport-width - self.width / 2));
                                    y: 0px;
                                    width: 16px;
                                    height: parent.height;
                                    background: transparent;

                                    Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: 0px;
                                        width: 2px;
                                        height: parent.height;
                                        background: props-tab-container.viewport-dragging || handle-touch.has-hover ? #7dd9ff : #5bcefa;
                                    }

                                    handle-touch := TouchArea {
                                        mouse-cursor: col-resize;

                                        pointer-event(event) => {
                                            if (event.kind == PointerEventKind.down) {
                                                props-tab-container.viewport-dragging = true;
                                                props-tab-container.viewport-drag-start-width = preview-viewport-frame.active-viewport-width;
                                            }
                                            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                                props-tab-container.viewport-dragging = false;
                                            }
                                        }

                                        moved => {
                                            if (self.pressed) {
                                                root.viewport-width = clamp(
                                                    props-tab-container.viewport-drag-start-width + (self.mouse-x - self.pressed-x),
                                                    preview-viewport-frame.min-responsive-width,
                                                    preview-viewport-frame.width);
                                            }
                                        }
                                    }
                                }

                                // Grayed out area beyond viewport
                                if root.is-responsive: Rectangle {
                                    x: preview-viewport-frame.active-viewport-width + 2px;
                                    y: 0;
                                    width: max(0px, parent.width - preview-viewport-frame.active-viewport-width - 2px);
                                    height: parent.height;
                                    background: dark-mode ? #1a1a1a : #e8e8e8;
                                    opacity: 0.7;
                                }
                            }

                            // Bottom viewport controls bar
                            Rectangle {
                                height: 36px;
                                background: dark-mode ? #242424 : #ffffff;
                                border-radius: 6px;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    alignment: space-between;

                                    // Left side: Viewport controls
                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: center;

                                        Text {
                                            text: "Viewport:";
                                            color: dark-mode ? #888888 : #666666;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }

                                    // Preset buttons
                                    for preset in [
                                            { label: "320", width: 320 },
                                            { label: "375", width: 375 },
                                            { label: "390", width: 390 },
                                            { label: "430", width: 430 }
                                        ]: Rectangle {
                                            width: 36px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: (root.viewport-width == preset.width * 1px) ? #1a9a9a : preset-touch.has-hover ? (dark-mode ? #3a3a3a : #e0e0e0) : (dark-mode ? #2a2a2a : #f0f0f0);

                                            Text {
                                                x: (parent.width - self.preferred-width) / 2;
                                                y: (parent.height - self.preferred-height) / 2;
                                                text: preset.label;
                                                color: (root.viewport-width == preset.width * 1px) ? #ffffff : (dark-mode ? #cccccc : #444444);
                                                font-size: 10px;
                                            }

                                            preset-touch := TouchArea {
                                                clicked => {
                                                    root.viewport-width = preset.width * 1px;
                                                    root.is-responsive = true;
                                                }
                                            }
                                        }

                                    // Responsive toggle
                                    Rectangle {
                                            width: 70px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: root.is-responsive ? #1a9a9a : responsive-touch.has-hover ? (dark-mode ? #3a3a3a : #e0e0e0) : (dark-mode ? #2a2a2a : #f0f0f0);

                                            Text {
                                                x: (parent.width - self.preferred-width) / 2;
                                                y: (parent.height - self.preferred-height) / 2;
                                                text: "Responsive";
                                                color: root.is-responsive ? #ffffff : (dark-mode ? #cccccc : #444444);
                                                font-size: 10px;
                                            }

                                            responsive-touch := TouchArea {
                                                clicked => {
                                                    root.is-responsive = !root.is-responsive;
                                                }
                                            }
                                        }

                                    // Slider when responsive
                                    if root.is-responsive: vp-slider := Rectangle {
                                            width: 100px;
                                            height: 24px;
                                            background: dark-mode ? #2a2a2a : #f0f0f0;
                                            border-radius: 4px;

                                            property <length> track-w: 84px;
                                            property <length> min-vp: 200px;
                                            property <length> max-vp: 600px;
                                            property <float> prog: clamp((root.viewport-width - min-vp) / (max-vp - min-vp), 0, 1);

                                            Rectangle {
                                                x: 8px;
                                                y: (parent.height - 4px) / 2;
                                                width: vp-slider.track-w;
                                                height: 4px;
                                                border-radius: 2px;
                                                background: dark-mode ? #3a3a3a : #d0d0d0;

                                                Rectangle {
                                                    x: 0px;
                                                    y: 0px;
                                                    width: vp-slider.prog * parent.width;
                                                    height: parent.height;
                                                    border-radius: 2px;
                                                    background: #1a9a9a;
                                                }
                                            }

                                            vp-touch := TouchArea {
                                                x: 8px;
                                                y: 0;
                                                width: vp-slider.track-w;
                                                height: parent.height;
                                                mouse-cursor: pointer;

                                                moved => {
                                                    if (self.pressed) {
                                                        root.viewport-width = clamp(
                                                        vp-slider.min-vp + (self.mouse-x / vp-slider.track-w) * (vp-slider.max-vp - vp-slider.min-vp),
                                                        vp-slider.min-vp,
                                                        vp-slider.max-vp);
                                                    }
                                                }
                                                clicked => {
                                                    root.viewport-width = clamp(
                                                    vp-slider.min-vp + (self.mouse-x / vp-slider.track-w) * (vp-slider.max-vp - vp-slider.min-vp),
                                                    vp-slider.min-vp,
                                                    vp-slider.max-vp);
                                                }
                                            }
                                        }

                                        // Width display
                                        Text {
                                            text: Math.round(root.viewport-width / 1px) + "px";
                                            color: dark-mode ? #888888 : #666666;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Right side: Copy buttons
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        Rectangle {
                                            width: copy-slint-text.preferred-width + 16px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: copy-slint-touch.has-hover ? (dark-mode ? #3a3a3a : #e0e0e0) : (dark-mode ? #2a2a2a : #f0f0f0);
                                            border-width: 1px;
                                            border-color: dark-mode ? #3a3a3a : #e0e0e0;

                                            copy-slint-text := Text {
                                                x: (parent.width - self.preferred-width) / 2;
                                                y: (parent.height - self.preferred-height) / 2;
                                                text: "Copy Slint";
                                                color: dark-mode ? #cccccc : #444444;
                                                font-size: 10px;
                                            }

                                            copy-slint-touch := TouchArea {
                                                // TODO: implement copy functionality
                                            }
                                        }

                                        Rectangle {
                                            width: copy-rust-text.preferred-width + 16px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: copy-rust-touch.has-hover ? (dark-mode ? #3a3a3a : #e0e0e0) : (dark-mode ? #2a2a2a : #f0f0f0);
                                            border-width: 1px;
                                            border-color: dark-mode ? #3a3a3a : #e0e0e0;

                                            copy-rust-text := Text {
                                                x: (parent.width - self.preferred-width) / 2;
                                                y: (parent.height - self.preferred-height) / 2;
                                                text: "Copy Rust";
                                                color: dark-mode ? #cccccc : #444444;
                                                font-size: 10px;
                                            }

                                            copy-rust-touch := TouchArea {
                                                // TODO: implement copy functionality
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Splitter handle (visual only, drag handled by overlay)
                    Rectangle {
                        width: 6px;
                        background: props-tab-container.splitter-dragging || splitter-hover.has-hover ? (dark-mode ? #3a3a3a : #d0d0d0) : (dark-mode ? #2a2a2a : #e0e0e0);

                        Rectangle {
                            x: 2px;
                            y: (parent.height - 40px) / 2;
                            width: 2px;
                            height: 40px;
                            border-radius: 1px;
                            background: props-tab-container.splitter-dragging ? #1a9a9a : (dark-mode ? #444444 : #bbbbbb);
                        }

                        // Drag handling - pointer capture stays with this TouchArea
                        splitter-hover := TouchArea {
                            mouse-cursor: col-resize;

                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    props-tab-container.splitter-dragging = true;
                                    // Capture total content width as invariant for clamping
                                    props-tab-container.drag-start-total-width = preview-panel.width + root.props-panel-width;
                                }
                                if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                    props-tab-container.splitter-dragging = false;
                                }
                            }

                            moved => {
                                if (self.pressed) {
                                    // Incremental update: delta from press position
                                    // delta > 0 = mouse right of press = shrink props
                                    // delta < 0 = mouse left of press = grow props
                                    root.props-panel-width = clamp(
                                        root.props-panel-width - (self.mouse-x - self.pressed-x),
                                        250px,
                                        props-tab-container.drag-start-total-width - 250px);
                                }
                            }
                        }
                    }

                    // Right: Props tree — the shared SidebarPanel frame (header band +
                    // divider + flush white + top-aligned, no-h-centering body), the same
                    // component used by the Theme and Tokens sidebars.
                    SidebarPanel {
                        // Cap width to leave at least 250px for preview panel
                        width: min(root.props-panel-width, props-tab-container.width - 250px - 6px);
                        dark-mode: root.dark-mode;
                        // Header band only when embedded in the theme editor (show-tabs
                        // == false); the standalone theme editor has its own top tab header.
                        show-mode-selector: !root.show-tabs;
                        mode-options: root.component-page-mode-options;
                        mode-index <=> root.component-page-mode;
                        mode-changed(index) => {
                            root.component-page-mode-changed(index);
                        }
                        title: root.show-tabs ? "" : get-component-name(selected-category, selected-component) + " Props";
                        // Props rows now use the shared RowLayout grid, so the column
                        // splitter aligns with them. Rows live under the "Component Props"
                        // section (padding-left: 20 inside body padding 16 → base 36).
                        splitter-base-x: 36px;

                                // Component Props section
                                component-props-header := TreeSectionHeader {
                            title: "Component Props";
                            dark-mode: root.dark-mode;
                        }

                        if component-props-header.expanded: VerticalLayout {
                            padding-left: 20px;
                            padding-top: 4px;
                            padding-bottom: 8px;
                            spacing: 6px;

                            if root.selected-category == 0 && root.selected-component == 0: Rectangle {
                                height: button-props.preferred-height;

                                button-props := VerticalLayout {
                                    spacing: 6px;

                                    TextInputRow {
                                        label: "text";
                                        dark-mode: root.dark-mode;
                                        value <=> root.button-text;
                                    }

                                    EnumSelector {
                                        label: "variant";
                                        dark-mode: root.dark-mode;
                                        options: ["primary", "secondary", "tertiary", "danger", "ghost"];
                                        selected-index <=> root.button-variant;
                                    }

                                    EnumSelector {
                                        label: "size";
                                        dark-mode: root.dark-mode;
                                        options: ["sm", "md", "lg"];
                                        selected-index <=> root.button-size;
                                    }

                                    IconSelectorRow {
                                        label: "start-icon";
                                        dark-mode: root.dark-mode;
                                        value <=> root.button-start-icon;
                                        icon-results: root.icon-results;
                                        icon-image(name) => {
                                            return root.icon-image(name);
                                        }
                                        filter-icons(query) => {
                                            root.filter-icons(query);
                                        }
                                    }

                                    IconSelectorRow {
                                        label: "end-icon";
                                        dark-mode: root.dark-mode;
                                        value <=> root.button-end-icon;
                                        icon-results: root.icon-results;
                                        icon-image(name) => {
                                            return root.icon-image(name);
                                        }
                                        filter-icons(query) => {
                                            root.filter-icons(query);
                                        }
                                    }

                                    ToggleSwitch {
                                        label: "disabled";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.button-disabled;
                                    }

                                    ToggleSwitch {
                                        label: "focused";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.button-focused;
                                    }

                                    ToggleSwitch {
                                        label: "full-width";
                                        dark-mode: root.dark-mode;
                                        checked <=> root.button-full-width;
                                    }
                                }
                            }

                            if root.selected-category == 0 && root.selected-component == 1: Rectangle {
                                height: icon-button-props.preferred-height;

                                icon-button-props := VerticalLayout {
