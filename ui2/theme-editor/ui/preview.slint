    in-out property <bool> dropdown-disabled: false;
    in-out property <int> story-dropdown-selected-index: -1;

    // Checkbox preview state
    in-out property <string> checkbox-label: "Email updates";
    in-out property <string> checkbox-description: "Receive launch and billing notifications.";
    in-out property <bool> checkbox-checked: false;
    in-out property <bool> checkbox-indeterminate: false;
    in-out property <bool> checkbox-disabled: false;

    // Radio preview state
    in-out property <string> radio-label: "Pro plan";
    in-out property <string> radio-description: "Best for teams shipping every week.";
    in-out property <bool> radio-checked: true;
    in-out property <bool> radio-disabled: false;

    // RadioGroup preview state
    property <[string]> radio-group-options: ["Starter", "Pro", "Enterprise"];
    property <[string]> radio-group-descriptions: [
        "Good for personal prototypes.",
        "Adds collaboration and exports.",
        "Advanced security and provisioning."
    ];
    property <[bool]> radio-group-disabled-items: [false, false, true];
    in-out property <int> radio-group-selected-index: 1;
    in-out property <bool> radio-group-disabled: false;
    in-out property <int> story-radio-group-selected-index: 1;

    // Switch preview state
    in-out property <string> switch-label: "Enable sync";
    in-out property <string> switch-description: "Keep the workspace up to date across devices.";
    in-out property <bool> switch-checked: true;
    in-out property <bool> switch-disabled: false;

    // Slider preview state
    in-out property <float> slider-minimum: 0.0;
    in-out property <float> slider-maximum: 100.0;
    in-out property <float> slider-step: 1.0;
    in-out property <float> slider-value: 64.0;
    in-out property <int> slider-size: 1;
    in-out property <bool> slider-disabled: false;
    in-out property <bool> slider-focused: false;

    // Segmented control preview state
    in-out property <int> segmented-selected-index: 0;
    in-out property <bool> segmented-disabled: false;
    in-out property <int> segmented-variant: 0;
    in-out property <int> segmented-color: 1;
    in-out property <int> segmented-orientation: 0;
    in-out property <bool> segmented-full-width: true;
    in-out property <bool> segmented-show-panel: true;
    in-out property <int> story-segmented-selected-index: 0;

    // Slide to confirm preview state
    in-out property <string> slide-label: "Confirm";
    in-out property <string> slide-hint: "Slide to publish";
    in-out property <string> slide-confirmed-label: "Published";
    in-out property <bool> slide-confirmed: false;
    in-out property <bool> slide-disabled: false;
    in-out property <bool> story-slide-confirmed: false;

    // Link preview state
    in-out property <string> link-label: "Open documentation";
    in-out property <bool> link-disabled: false;
    in-out property <bool> link-external: true;
    in-out property <bool> link-visited: false;
    in-out property <bool> link-underlined: true;

    // Card preview state
    in-out property <string> card-eyebrow: "Workspace";
    in-out property <string> card-title: "Launch checklist";
    in-out property <string> card-subtitle: "Three items need review before you ship.";
    in-out property <string> card-body: "Invite QA, validate the billing copy, and confirm the launch window with support.";
    in-out property <string> card-footer: "Updated 8 minutes ago";
    in-out property <bool> card-selected: false;
    in-out property <bool> card-interactive: true;
    in-out property <string> card-icon: "clipboard";
    property <image> selected-card-icon: root.icon-image(card-icon);

    // Menu preview state
    in-out property <int> menu-selected-index: 1;
    in-out property <bool> menu-full-width: false;

    // Menu item preview state
    in-out property <string> menu-item-label: "Share";
    in-out property <string> menu-item-subtitle: "Invite someone to this project.";
    in-out property <string> menu-item-trailing-text: "Cmd+K";
    in-out property <bool> menu-item-selected: false;
    in-out property <bool> menu-item-destructive: false;
    in-out property <bool> menu-item-disabled: false;
    in-out property <string> menu-item-start-icon: "share";
    in-out property <string> menu-item-end-icon: "chevron-right";
    property <image> selected-menu-item-start-icon: root.icon-image(menu-item-start-icon);
    property <image> selected-menu-item-end-icon: root.icon-image(menu-item-end-icon);

    // Accordion preview state
    in-out property <bool> accordion-allow-multiple: false;
    in-out property <string> accordion-item-0-title: "Release notes";
    in-out property <string> accordion-item-0-subtitle: "Updated today";
    in-out property <string> accordion-item-0-body: "Document migrations, feature flags, and support considerations before the deploy starts.";
    in-out property <bool> accordion-item-0-disabled: false;
    in-out property <bool> accordion-open-0: true;
    in-out property <string> accordion-item-1-title: "Rollback plan";
    in-out property <string> accordion-item-1-subtitle: "Ready if needed";
    in-out property <string> accordion-item-1-body: "Include the trigger, owner, and exact command sequence used to revert the change.";
    in-out property <bool> accordion-item-1-disabled: false;
    in-out property <bool> accordion-open-1: false;
    in-out property <string> accordion-item-2-title: "Locked section";
    in-out property <string> accordion-item-2-subtitle: "Disabled";
    in-out property <string> accordion-item-2-body: "This section is unavailable until the environment is provisioned.";
    in-out property <bool> accordion-item-2-disabled: true;
    in-out property <bool> accordion-open-2: false;
    in-out property <bool> accordion-story-multi-open-0: true;
    in-out property <bool> accordion-story-multi-open-1: true;
    in-out property <bool> accordion-story-multi-open-2: false;
    property <[AccordionItemData]> accordion-items: [
        {
            title: root.accordion-item-0-title,
            subtitle: root.accordion-item-0-subtitle,
            body: root.accordion-item-0-body,
            disabled: root.accordion-item-0-disabled,
        },
        {
            title: root.accordion-item-1-title,
            subtitle: root.accordion-item-1-subtitle,
            body: root.accordion-item-1-body,
            disabled: root.accordion-item-1-disabled,
        },
        {
            title: root.accordion-item-2-title,
            subtitle: root.accordion-item-2-subtitle,
            body: root.accordion-item-2-body,
            disabled: root.accordion-item-2-disabled,
        },
    ];
    property <[bool]> accordion-expanded-states: [
        root.accordion-open-0,
        root.accordion-open-1,
        root.accordion-open-2,
    ];
    property <[bool]> accordion-story-multi-expanded-states: [
        root.accordion-story-multi-open-0,
        root.accordion-story-multi-open-1,
        root.accordion-story-multi-open-2,
    ];

    // Dialog preview state
    in-out property <bool> dialog-open: true;
    in-out property <string> dialog-title: "Delete release";
    in-out property <string> dialog-message: "This action removes the release notes draft for everyone on the team.";
    in-out property <int> dialog-variant: 0;
    in-out property <string> dialog-primary-action: "Delete";
    in-out property <string> dialog-secondary-action: "Cancel";
    in-out property <bool> dialog-dismissable: true;
    in-out property <string> dialog-icon: "circle-alert";
    property <image> selected-dialog-icon: root.icon-image(dialog-icon);

    // Sheet preview state
    in-out property <bool> sheet-open: true;
    in-out property <string> sheet-title: "Share workspace";
    in-out property <string> sheet-body: "Invite teammates, copy a link, or update permissions without leaving the current page.";
    in-out property <bool> sheet-show-handle: true;
    in-out property <bool> sheet-dismissable: true;
    in-out property <int> sheet-detent-index: 1;
    property <[float]> sheet-detents: [0.36, 0.62, 0.88];

    // Toast preview state
    in-out property <bool> toast-open: true;
    in-out property <string> toast-message: "Workspace published successfully.";
    in-out property <string> toast-action: "Undo";
    in-out property <int> toast-variant: 1;
    in-out property <int> toast-position: 1;
    in-out property <string> toast-icon: "check";
    property <image> selected-toast-icon: root.icon-image(toast-icon);

    // Progress preview state
    in-out property <string> progress-label: "Storage";
    in-out property <string> progress-value-label: "";
    in-out property <float> progress-value: 64.0;
    in-out property <float> progress-min-value: 0.0;
    in-out property <float> progress-max-value: 100.0;
    in-out property <bool> progress-indeterminate: false;
    in-out property <bool> progress-show-value-label: true;
    in-out property <bool> progress-disabled: false;
    in-out property <bool> progress-disable-animation: false;
    in-out property <int> progress-tone: 0;
    in-out property <int> progress-value-format: 0;

    // Spinner preview state
    in-out property <int> spinner-size: 1;
    in-out property <int> spinner-tone: 0;
    in-out property <float> spinner-animation-speed: 60.0;

    // Image preview state
    in-out property <string> image-alt: "Sample landscape";
    in-out property <string> image-caption: "A sample illustration for the Image component preview.";
    in-out property <bool> image-rounded: true;
    in-out property <bool> image-show-border: true;
    property <image> sample-media-image: @image-url("images/sample-scene.svg");

    // Divider preview state
    in-out property <int> divider-orientation: 0;
    in-out property <string> divider-label: "Overview";
    in-out property <int> divider-label-alignment: 1;
    in-out property <bool> divider-full-width: true;
    in-out property <float> divider-label-gap: 8.0;
    in-out property <float> divider-label-start-margin: 16.0;
    in-out property <float> divider-label-end-margin: 16.0;

    property <InputType> active-input-type:
        input-type-index == 1 ? InputType.password : input-type-index == 2 ? InputType.number : input-type-index == 3 ? InputType.decimal : InputType.text;
    property <TextHorizontalAlignment> active-input-text-alignment:
        input-text-alignment-index == 1 ? TextHorizontalAlignment.center : input-text-alignment-index == 2 ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    property <TextAreaVariant> active-textarea-variant:
        textarea-variant == 1 ? TextAreaVariant.bordered : textarea-variant == 2 ? TextAreaVariant.faded : TextAreaVariant.flat;
    property <InputVariant> active-search-variant:
        search-variant == 0 ? InputVariant.default : search-variant == 2 ? InputVariant.outlined : InputVariant.filled;
    property <ButtonVariant> active-button-variant:
        button-variant == 1 ? ButtonVariant.secondary : button-variant == 2 ? ButtonVariant.tertiary : button-variant == 3 ? ButtonVariant.danger : button-variant == 4 ? ButtonVariant.ghost : ButtonVariant.primary;
    property <ControlSize> active-button-size:
        button-size == 0 ? ControlSize.sm : button-size == 2 ? ControlSize.lg : ControlSize.md;
    property <ControlSize> active-icon-size:
        icon-size-index == 0 ? ControlSize.sm : icon-size-index == 2 ? ControlSize.lg : ControlSize.md;
    property <color> active-icon-color:
        icon-tone == 1 ? Theme.palette-primary : icon-tone == 2 ? Theme.palette-muted : icon-tone == 3 ? #16a34a : icon-tone == 4 ? #d97706 : icon-tone == 5 ? Theme.palette-danger : Theme.palette-foreground;
    property <DialogVariant> active-dialog-variant:
        dialog-variant == 1 ? DialogVariant.danger : DialogVariant.default;
    property <ToastVariant> active-toast-variant:
        toast-variant == 1 ? ToastVariant.success : toast-variant == 2 ? ToastVariant.warning : toast-variant == 3 ? ToastVariant.error : ToastVariant.default;
    property <ToastPosition> active-toast-position:
        toast-position == 0 ? ToastPosition.top : ToastPosition.bottom;
    property <ProgressBarTone> active-progress-tone:
        progress-tone == 0 ? ProgressBarTone.default : progress-tone == 2 ? ProgressBarTone.secondary : progress-tone == 3 ? ProgressBarTone.success : progress-tone == 4 ? ProgressBarTone.warning : progress-tone == 5 ? ProgressBarTone.danger : ProgressBarTone.primary;
    property <ProgressValueFormat> active-progress-value-format:
        progress-value-format == 1 ? ProgressValueFormat.value : ProgressValueFormat.percent;
    property <SpinnerSize> active-spinner-size:
        spinner-size == 0 ? SpinnerSize.sm : spinner-size == 2 ? SpinnerSize.lg : SpinnerSize.md;
    property <SpinnerTone> active-spinner-tone:
        spinner-tone == 1 ? SpinnerTone.neutral : spinner-tone == 2 ? SpinnerTone.success : spinner-tone == 3 ? SpinnerTone.warning : spinner-tone == 4 ? SpinnerTone.danger : SpinnerTone.primary;
    property <ControlSize> active-slider-size:
        slider-size == 0 ? ControlSize.sm : slider-size == 2 ? ControlSize.lg : ControlSize.md;
    property <TabsVariant> active-tabs-variant:
        segmented-variant == 1 ? TabsVariant.bordered : segmented-variant == 2 ? TabsVariant.light : segmented-variant == 3 ? TabsVariant.underlined : TabsVariant.solid;
    property <TabsColor> active-tabs-color:
        segmented-color == 0 ? TabsColor.default : segmented-color == 2 ? TabsColor.secondary : segmented-color == 3 ? TabsColor.success : segmented-color == 4 ? TabsColor.warning : segmented-color == 5 ? TabsColor.danger : TabsColor.primary;
    property <TabsOrientation> active-tabs-orientation:
        segmented-orientation == 1 ? TabsOrientation.vertical : TabsOrientation.horizontal;
    property <DividerLabelAlignment> active-divider-label-alignment:
        divider-label-alignment == 0 ? DividerLabelAlignment.start : divider-label-alignment == 2 ? DividerLabelAlignment.end : DividerLabelAlignment.middle;

    // Reset callback
    callback reset-to-defaults();
    callback toggle-accordion-item(int);
    callback toggle-accordion-story-multi-item(int);
    reset-to-defaults => {
        button-text = "Click me";
        button-variant = 0;
        button-size = 1;
        button-disabled = false;
        button-focused = false;
        button-full-width = false;
        button-start-icon = "none";
        button-end-icon = "none";

        icon-button-variant = 0;
        icon-button-size = 1;
        icon-button-shape = 0;
        icon-button-disabled = false;
        icon-button-focused = false;
        icon-button-icon = "pencil";

        icon-name = "star";
        icon-size-index = 1;
        icon-tone = 0;

        chip-text = "Beta";
