        font-size: root.size-prop("font-size", root.preview-version).is-overridden ? root.size-prop("font-size", root.preview-version).float-value * 1px : 0px;
        row-height: root.size-prop("row-height", root.preview-version).is-overridden ? root.size-prop("row-height", root.preview-version).float-value * 1px : 0px;
        icon-size: root.size-prop("icon-size", root.preview-version).is-overridden ? root.size-prop("icon-size", root.preview-version).float-value * 1px : 0px;
    }

    if root.component-key == "card": Card {
        width: root.size-prop("card-width", root.preview-version).is-overridden ? root.size-prop("card-width", root.preview-version).float-value * 1px : 240px;
        height: root.size-prop("card-height", root.preview-version).is-overridden ? root.size-prop("card-height", root.preview-version).float-value * 1px : 168px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        eyebrow: "Overview";
        title: "Launch readiness";
        subtitle: "Shipping checklist";
        body: "Review blockers, approvals, and rollout timing for the release.";
        footer: "Updated 5 min ago";
        icon: @image-url("../../resources/icons/star.svg");
        size: root.control-size();
        interactive: true;
        selected: root.preview-selected;
        font-family: root.size-prop("font-family", root.preview-version).is-overridden ? root.size-prop("font-family", root.preview-version).string-value : "Montserrat";
        font-size: root.size-prop("font-size", root.preview-version).is-overridden ? root.size-prop("font-size", root.preview-version).float-value * 1px : 0px;
        card-padding: root.size-prop("card-padding", root.preview-version).is-overridden ? root.size-prop("card-padding", root.preview-version).float-value * 1px : 0px;
        icon-size: root.size-prop("icon-size", root.preview-version).is-overridden ? root.size-prop("icon-size", root.preview-version).float-value * 1px : 0px;
        border-radius: root.size-prop("border-radius", root.preview-version).is-overridden ? root.size-prop("border-radius", root.preview-version).float-value * 1px : 0px;
    }

    if root.component-key == "menu": Menu {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        full-width: true;
        size: root.control-size();
        menu-background: root.variant-prop("menu-background", root.preview-version).is-overridden ? root.variant-prop("menu-background", root.preview-version).color-value : transparent;
        menu-border-color: root.variant-prop("menu-border-color", root.preview-version).is-overridden ? root.variant-prop("menu-border-color", root.preview-version).color-value : transparent;
        menu-border-width: root.variant-prop("menu-border-width", root.preview-version).is-overridden ? root.variant-prop("menu-border-width", root.preview-version).float-value * 1px : 0px;
        menu-height: root.size-prop("menu-height", root.preview-version).is-overridden ? root.size-prop("menu-height", root.preview-version).float-value * 1px : 0px;
        menu-border-radius: root.size-prop("menu-border-radius", root.preview-version).is-overridden ? root.size-prop("menu-border-radius", root.preview-version).float-value * 1px : 0px;
        menu-padding: root.size-prop("menu-padding", root.preview-version).is-overridden ? root.size-prop("menu-padding", root.preview-version).float-value * 1px : 0px;

        MenuItem {
            label: "Select";
            end-icon: @image-url("../../resources/icons/check.svg");
            size: root.control-size();
        }

        MenuItem {
            label: "Add Folder";
            end-icon: @image-url("../../resources/icons/plus.svg");
            size: root.control-size();
        }

        MenuItem {
            label: "Search & Sort";
            end-icon: @image-url("../../resources/icons/search.svg");
            size: root.control-size();
            divider: false;
        }
    }

    if root.component-key == "menu_item": MenuItem {
        x: 10px;
        y: (parent.height - self.preferred-height) / 2;
        width: parent.width - 20px;
        label: "Rename";
        subtitle: "Update the workspace label";
        start-icon: @image-url("../../resources/icons/pencil.svg");
        trailing-text: "R";
        size: root.control-size();
        selected: root.preview-selected;
        destructive: root.variant-key == "danger";
        disabled: root.preview-disabled;
        divider: false;
        font-family: root.size-prop("font-family", root.preview-version).is-overridden ? root.size-prop("font-family", root.preview-version).string-value : "Montserrat";
        font-size: root.size-prop("font-size", root.preview-version).is-overridden ? root.size-prop("font-size", root.preview-version).float-value * 1px : 0px;
        item-height: root.size-prop("item-height", root.preview-version).is-overridden ? root.size-prop("item-height", root.preview-version).float-value * 1px : 0px;
        padding-horizontal: root.size-prop("padding-horizontal", root.preview-version).is-overridden ? root.size-prop("padding-horizontal", root.preview-version).float-value * 1px : 0px;
        icon-size: root.size-prop("icon-size", root.preview-version).is-overridden ? root.size-prop("icon-size", root.preview-version).float-value * 1px : 0px;
    }

    if root.component-key == "accordion": Accordion {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        items: root.accordion-items;
        expanded-states: root.accordion-expanded;
        allow-multiple: root.preview-focused || root.preview-pressed;
        size: root.control-size();
        font-family: root.size-prop("font-family", root.preview-version).is-overridden ? root.size-prop("font-family", root.preview-version).string-value : "Montserrat";
        font-size: root.size-prop("font-size", root.preview-version).is-overridden ? root.size-prop("font-size", root.preview-version).float-value * 1px : 0px;
        header-height: root.size-prop("header-height", root.preview-version).is-overridden ? root.size-prop("header-height", root.preview-version).float-value * 1px : 0px;
        padding-horizontal: root.size-prop("padding-horizontal", root.preview-version).is-overridden ? root.size-prop("padding-horizontal", root.preview-version).float-value * 1px : 0px;
        icon-size: root.size-prop("icon-size", root.preview-version).is-overridden ? root.size-prop("icon-size", root.preview-version).float-value * 1px : 0px;
    }

    if root.component-key == "dialog": Dialog {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        open: true;
        title: "Delete release";
        message: "This removes rollout history and cannot be undone.";
        icon: @image-url("../../resources/icons/circle-alert.svg");
        size: root.control-size();
        variant: root.dialog-variant();
        primary-action: "Delete";
        secondary-action: "Cancel";
        dismissable: !root.preview-disabled;
        font-family: root.size-prop("font-family", root.preview-version).is-overridden ? root.size-prop("font-family", root.preview-version).string-value : "Montserrat";
        font-size: root.size-prop("font-size", root.preview-version).is-overridden ? root.size-prop("font-size", root.preview-version).float-value * 1px : 0px;
        panel-width: root.size-prop("panel-width", root.preview-version).is-overridden ? root.size-prop("panel-width", root.preview-version).float-value * 1px : 0px;
        panel-padding: root.size-prop("panel-padding", root.preview-version).is-overridden ? root.size-prop("panel-padding", root.preview-version).float-value * 1px : 0px;
        icon-size: root.size-prop("icon-size", root.preview-version).is-overridden ? root.size-prop("icon-size", root.preview-version).float-value * 1px : 0px;
        border-radius: root.size-prop("border-radius", root.preview-version).is-overridden ? root.size-prop("border-radius", root.preview-version).float-value * 1px : 0px;
    }

    if root.component-key == "sheet": Sheet {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        open: true;
        title: "Project settings";
        body: "Update access, alerts, and publishing preferences.";
        size: root.control-size();
        selected-detent: root.preview-focused ? 2 : 1;
        dismissable: !root.preview-disabled;
        font-family: root.size-prop("font-family", root.preview-version).is-overridden ? root.size-prop("font-family", root.preview-version).string-value : "Montserrat";
        font-size: root.size-prop("font-size", root.preview-version).is-overridden ? root.size-prop("font-size", root.preview-version).float-value * 1px : 0px;
        panel-padding: root.size-prop("panel-padding", root.preview-version).is-overridden ? root.size-prop("panel-padding", root.preview-version).float-value * 1px : 0px;
        content-padding: root.size-prop("content-padding", root.preview-version).is-overridden ? root.size-prop("content-padding", root.preview-version).float-value * 1px : 0px;
        border-radius: root.size-prop("border-radius", root.preview-version).is-overridden ? root.size-prop("border-radius", root.preview-version).float-value * 1px : 0px;
        handle-width: root.size-prop("handle-width", root.preview-version).is-overridden ? root.size-prop("handle-width", root.preview-version).float-value * 1px : 0px;
    }

    if root.component-key == "toast": Toast {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        open: true;
        message: "Changes saved to the active theme.";
        icon: @image-url("../../resources/icons/info.svg");
        size: root.control-size();
        variant: root.toast-variant();
        action: root.preview-disabled ? "" : "Undo";
        font-family: root.size-prop("font-family", root.preview-version).is-overridden ? root.size-prop("font-family", root.preview-version).string-value : "Montserrat";
        font-size: root.size-prop("font-size", root.preview-version).is-overridden ? root.size-prop("font-size", root.preview-version).float-value * 1px : 0px;
        card-width: root.size-prop("card-width", root.preview-version).is-overridden ? root.size-prop("card-width", root.preview-version).float-value * 1px : 0px;
        toast-padding: root.size-prop("toast-padding", root.preview-version).is-overridden ? root.size-prop("toast-padding", root.preview-version).float-value * 1px : 0px;
        icon-size: root.size-prop("icon-size", root.preview-version).is-overridden ? root.size-prop("icon-size", root.preview-version).float-value * 1px : 0px;
        border-radius: root.size-prop("border-radius", root.preview-version).is-overridden ? root.size-prop("border-radius", root.preview-version).float-value * 1px : 0px;
    }

    if root.component-key == "progress_bar": ProgressBar {
        x: 12px;
        y: (parent.height - self.preferred-height) / 2;
        width: parent.width - 24px;
        label: "Storage";
        value: root.preview-disabled ? 24 : 68;
        min-value: 0;
        max-value: 100;
        indeterminate: root.preview-pressed;
        show-value-label: true;
        disabled: root.preview-disabled;
        value-format: ProgressValueFormat.percent;
        size: root.control-size();
        tone: root.progress-tone();
        track-color: root.variant-prop("track-color", root.preview-version).is-overridden ? root.variant-prop("track-color", root.preview-version).color-value : transparent;
        fill-color-override: root.variant-prop("fill-color-override", root.preview-version).is-overridden ? root.variant-prop("fill-color-override", root.preview-version).color-value : transparent;
        label-color: root.variant-prop("label-color", root.preview-version).is-overridden ? root.variant-prop("label-color", root.preview-version).color-value : transparent;
        value-color: root.variant-prop("value-color", root.preview-version).is-overridden ? root.variant-prop("value-color", root.preview-version).color-value : transparent;
        font-family: root.size-prop("font-family", root.preview-version).is-overridden ? root.size-prop("font-family", root.preview-version).string-value : "Montserrat";
        font-size: root.size-prop("font-size", root.preview-version).is-overridden ? root.size-prop("font-size", root.preview-version).float-value * 1px : 0px;
        label-gap: root.size-prop("label-gap", root.preview-version).is-overridden ? root.size-prop("label-gap", root.preview-version).float-value * 1px : 0px;
        bar-height: root.size-prop("bar-height", root.preview-version).is-overridden ? root.size-prop("bar-height", root.preview-version).float-value * 1px : 0px;
        border-radius: root.size-prop("border-radius", root.preview-version).is-overridden ? root.size-prop("border-radius", root.preview-version).float-value * 1px : 0px;
    }

    if root.component-key == "spinner": Spinner {
        x: (parent.width - self.preferred-width) / 2;
        y: (parent.height - self.preferred-height) / 2;
        size: root.spinner-size();
        tone: root.spinner-tone();
        track-color: root.variant-prop("track-color", root.preview-version).is-overridden ? root.variant-prop("track-color", root.preview-version).color-value : transparent;
        accent-color-override: root.variant-prop("accent-color-override", root.preview-version).is-overridden ? root.variant-prop("accent-color-override", root.preview-version).color-value : transparent;
        spinner-size: root.size-prop("spinner-size", root.preview-version).is-overridden ? root.size-prop("spinner-size", root.preview-version).float-value * 1px : 0px;
        stroke-width: root.size-prop("stroke-width", root.preview-version).is-overridden ? root.size-prop("stroke-width", root.preview-version).float-value * 1px : 0px;
        animation-speed: root.size-prop("animation-speed", root.preview-version).is-overridden ? root.size-prop("animation-speed", root.preview-version).float-value : 60.0;
    }

    if root.component-key == "image": MediaImage {
        property <length> image-width:
            root.size-prop("frame-width", root.preview-version).is-overridden ? root.size-prop("frame-width", root.preview-version).float-value * 1px : 320px;
        x: (parent.width - self.width) / 2;
        y: 10px;
        width: image-width;
        source: @image-url("images/sample-scene.svg");
        alt: "Sample";
        caption: "Marketing illustration";
        rounded: true;
        show-border: true;
        frame-width: image-width;
        frame-height: root.size-prop("frame-height", root.preview-version).is-overridden ? root.size-prop("frame-height", root.preview-version).float-value * 1px : 0px;
    }

    if root.component-key == "divider": Divider {
        x: 12px;
        y: (parent.height - self.preferred-height) / 2;
        width: parent.width - 24px;
        orientation: DividerOrientation.horizontal;
        label: "Section";
        label-alignment: DividerLabelAlignment.middle;
        divider-color: root.variant-prop("divider-color", root.preview-version).is-overridden ? root.variant-prop("divider-color", root.preview-version).color-value : transparent;
        label-color: root.variant-prop("label-color", root.preview-version).is-overridden ? root.variant-prop("label-color", root.preview-version).color-value : transparent;
        font-family: root.size-prop("font-family", root.preview-version).is-overridden ? root.size-prop("font-family", root.preview-version).string-value : "Montserrat";
        font-size: root.size-prop("font-size", root.preview-version).is-overridden ? root.size-prop("font-size", root.preview-version).float-value * 1px : 0px;
        label-gap: root.size-prop("label-gap", root.preview-version).is-overridden ? root.size-prop("label-gap", root.preview-version).float-value * 1px : 0px;
        label-start-margin: root.size-prop("label-start-margin", root.preview-version).is-overridden ? root.size-prop("label-start-margin", root.preview-version).float-value * 1px : 0px;
        label-end-margin: root.size-prop("label-end-margin", root.preview-version).is-overridden ? root.size-prop("label-end-margin", root.preview-version).float-value * 1px : 0px;
        thickness: root.size-prop("thickness", root.preview-version).is-overridden ? root.size-prop("thickness", root.preview-version).float-value * 1px : 0px;
    }
}

// Number input with +/- buttons
component NumberInput inherits Rectangle {
    in property <string> label;
    // Left inset applied to the label text only (for sub-prop tree nesting); the
    // label column keeps its RowLayout.label-width, so the value column stays aligned.
    in property <length> indent: 0px;
    in property <bool> dark-mode;
    in property <string> suffix: "px";
    in property <float> step: 1.0;
    in property <float> min-value: 0.0;
    in property <float> max-value: 100.0;
    in property <float> default-value: 0.0;  // Parent/default value for comparison
    in-out property <float> value: 0.0;
    // When false, only shows if value != default (overridden)
    in property <bool> show-all: true;
    in property <bool> allow-reset: true;
    in property <bool> allow-token-mode: true;

    // Callback to check if float values are equal (connected from Rust)
    callback check-equal(float, float) -> bool;
    // Debug callback for visibility tracking
    callback debug(string, bool, bool, bool);

    // Override state - two-way bound to parent for persistence
    in-out property <bool> is-overridden: false;
    // For styling, use the inverse
    property <bool> is-inherited: !is-overridden;

    // Token mode: false = direct value (#), true = token reference ($)
    in-out property <bool> is-token-mode: false;
    // Available number tokens for selection (spacing, radius, control scale, etc.)
    in property <[string]> number-tokens: [
        "font-size-sm",
        "font-size-md",
        "font-size-lg",
        "spacing-xs",
        "spacing-sm",
        "spacing-md",
        "spacing-lg",
        "spacing-xl",
        "radius-sm",
        "radius-default",
        "radius-lg",
        "radius-full",
        "control-size-sm",
        "control-size-md",
        "control-size-lg",
        "icon-size-sm",
        "icon-size-md",
        "icon-size-lg",
        "control-radius-sm",
        "control-radius-md",
        "control-radius-lg",
        "control-padding-inline-sm",
        "control-padding-inline-md",
        "control-padding-inline-lg"
    ];
    // Resolved values for the available number tokens (same order as number-tokens)
    in property <[float]> token-values: [];
    // Selected token index
    in-out property <int> selected-token: 0;
    property <float> selected-token-value:
        selected-token >= 0 && selected-token < token-values.length ? token-values[selected-token] : default-value;
    in-out property <string> edit-text: "";
    in-out property <bool> editing: false;
    property <length> suffix-slot-width: root.suffix != "" ? 28px : 0px;
    property <length> editor-width: root.suffix != "" ? 120px : 92px;

    callback reset();
    callback sync-edit-text();
    sync-edit-text => {
        edit-text = Math.round(value * 10) / 10 + "";
    }
    callback commit-edit();
    commit-edit => {
        if (edit-text == "" || edit-text == "-" || edit-text == "." || edit-text == "-.") {
            root.sync-edit-text();
            return;
        }
        if (edit-text.is-float()) {
            value = clamp(edit-text.to-float(), min-value, max-value);
            // is-overridden is driven by the parent (from Rust's prop-value.is-overridden
            // via sync-from-prop). DO NOT auto-derive it here: in GenericSizePropEditor
            // both `value` and `default-value` are bound to root.local-float, so
            // `value == default-value` is always true and this used to silently flip
            // every prop's override flag to false whenever a `changed` callback fired
            // during sync — which is what was causing the reset-icon bleed bug.
        } else {
            root.sync-edit-text();
        }
    }
    init => { root.sync-edit-text(); }
    reset => {
        value = default-value;
        is-overridden = false;
        is-token-mode = false;
        root.sync-edit-text();
    }
    changed selected-token-value => {
        if (is-token-mode) {
            value = selected-token-value;
            // See commit-edit comment: do NOT auto-set is-overridden here. Rust drives it
            // through prop-value.is-overridden and sync-from-prop; the leaf only forwards
            // user edits via value/selected-token changes that emit-current passes back.
            root.sync-edit-text();
        }
    }
    changed value => {
        if (!editing) {
            root.sync-edit-text();
        }
    }

    // Use 0 height when hidden to collapse the row (include 6px spacing when visible)
    // Visibility: show if show-all OR if overridden (inline for better reactivity)
    height: (show-all || is-overridden) ? 30px : 0px;  // 24px content + 6px spacing
    clip: true;  // Clip content when height is 0 instead of using visible

    HorizontalLayout {
        spacing: 8px;  // gap between the label column and the value fields
        padding-bottom: 6px;  // spacing between rows

        HorizontalLayout {
            width: RowLayout.label-width;
            padding-left: root.indent;

            Text {
                text: label;
                color: is-inherited ?
                    (dark-mode ? #555555 : #aaaaaa) :
                    (dark-mode ? #cccccc : #444444);
                font-size: 12px;
                font-weight: is-inherited ? 400 : 500;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        // Control column: label has a fixed shared width, so every row's
        // label/control boundary lines up; the control column fills the rest.
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 4px;

        // Reset button (only shown when overridden) - to the left of value editor
        if allow-reset && !is-inherited: Rectangle {
            width: 18px;
            height: 24px;  // Match row height for vertical centering

            Rectangle {
                x: 0;
                y: (parent.height - 18px) / 2;
                width: 18px;
                height: 18px;
                border-radius: 4px;
                background: reset-touch.has-hover ? (dark-mode ? #3a3a3a : #e0e0e0) : transparent;

                Text {
                    x: (parent.width - self.preferred-width) / 2;
                    y: (parent.height - self.preferred-height) / 2;
                    text: "↺";
                    color: dark-mode ? #888888 : #666666;
                    font-size: 12px;
                }

                reset-touch := TouchArea {
                    clicked => { root.reset(); }
                }
            }
        }

        // Value editor (shown when NOT in token mode)
        if !is-token-mode || !allow-token-mode: Rectangle {
            width: root.editor-width;
            height: 22px;
            background: dark-mode ? #1a1a1a : #f0f0f0;
            border-radius: 4px;
            opacity: is-inherited ? 0.7 : 1.0;

            HorizontalLayout {
                Rectangle {
                    width: 22px;
                    background: minus-touch.pressed ? (dark-mode ? #2a2a2a : #e0e0e0) : transparent;

                    Text {
                        x: (parent.width - self.preferred-width) / 2;
                        y: (parent.height - self.preferred-height) / 2;
                        text: "−";
                        color: dark-mode ? #888888 : #666666;
                        font-size: 14px;
                    }

                    minus-touch := TouchArea {
                        clicked => {
                            if (value - step >= min-value) {
                                value = value - step;
                                is-overridden = !check-equal(value, default-value);
                                debug(label, show-all, is-overridden, show-all || is-overridden);
                                root.sync-edit-text();
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    number-input-field := TextInput {
                        x: 4px;
                        y: 0px;
                        width: parent.width - root.suffix-slot-width - 8px;
                        height: parent.height;
                        text <=> root.edit-text;
                        color: dark-mode ? #ffffff : #1a1a1a;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        input-type: number;

                        edited => {
                            if (self.text == "" || self.text == "-" || self.text == "." || self.text == "-.") {
                                return;
                            }
                            if (self.text.is-float()) {
                                value = clamp(self.text.to-float(), min-value, max-value);
                                is-overridden = !check-equal(value, default-value);
                                debug(label, show-all, is-overridden, show-all || is-overridden);
                            }
                        }

                        accepted => {
                            root.commit-edit();
                            root.sync-edit-text();
                        }

                        changed has-focus => {
                            root.editing = self.has-focus;
                            if (!self.has-focus) {
                                root.commit-edit();
                                root.sync-edit-text();
                            }
                        }
                    }

                    suffix-text := Text {
                        visible: root.suffix != "";
                        x: parent.width - root.suffix-slot-width;
                        y: 0px;
                        width: root.suffix-slot-width;
                        height: parent.height;
                        text: root.suffix;
                        color: dark-mode ? #888888 : #666666;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                Rectangle {
                    width: 22px;
                    background: plus-touch.pressed ? (dark-mode ? #2a2a2a : #e0e0e0) : transparent;

                    Text {
                        x: (parent.width - self.preferred-width) / 2;
                        y: (parent.height - self.preferred-height) / 2;
                        text: "+";
                        color: dark-mode ? #888888 : #666666;
                        font-size: 14px;
                    }

                    plus-touch := TouchArea {
                        clicked => {
                            if (value + step <= max-value) {
                                value = value + step;
                                is-overridden = !check-equal(value, default-value);
                                debug(label, show-all, is-overridden, show-all || is-overridden);
                                root.sync-edit-text();
                            }
                        }
                    }
                }
            }
        }

        // Spacer keeps the compact numeric field left-aligned at the column start.
        if !is-token-mode || !allow-token-mode: Rectangle { horizontal-stretch: 1; }

        // Token selector (shown when in token mode) - fills the control column.
        if allow-token-mode && is-token-mode: Rectangle {
            horizontal-stretch: 1;
            height: 22px;
            opacity: is-inherited ? 0.7 : 1.0;

            Dropdown {
                width: parent.width;
                label: "";
                size: ControlSize.sm;
                options: root.number-tokens;
                selected-index <=> root.selected-token;
                placeholder: root.number-tokens.length > 0 ? root.number-tokens[0] : "";
                max-visible-items: 8;
                font-size: 11px;
                control-height: 22px;
                option-height: 24px;
                padding-horizontal: 8px;
                icon-size: 12px;
                border-radius: 4px;
            }
        }

        // Token/Value mode toggle button (#/$)
        if allow-token-mode: Rectangle {
            width: 20px;
            height: 22px;
            background: mode-toggle-touch.has-hover ? (dark-mode ? #2a2a2a : #e0e0e0) : (dark-mode ? #1a1a1a : #f0f0f0);
            border-radius: 4px;

            Text {
                x: (parent.width - self.preferred-width) / 2;
                y: (parent.height - self.preferred-height) / 2;
                text: is-token-mode ? "$" : "#";
                color: is-token-mode ? #1a9a9a : (dark-mode ? #888888 : #666666);
                font-size: 12px;
                font-weight: 600;
            }

            mode-toggle-touch := TouchArea {
                clicked => {
                    is-token-mode = !is-token-mode;
                    if (is-token-mode) {
                        value = selected-token-value;
                        is-overridden = !check-equal(value, default-value);
                        debug(label, show-all, is-overridden, show-all || is-overridden);
                    }
                }
            }
        }
        }
    }
}

component FontSelectorRow inherits Rectangle {
    in property <string> label;
    // Left inset for the label text only (sub-prop nesting); value column stays aligned.
    in property <length> indent: 0px;
    in property <bool> dark-mode;
    in property <string> default-value: "Arial";
    in-out property <string> value: "Arial";
    in property <bool> show-all: true;
    in property <bool> allow-reset: true;
    in property <bool> allow-token-mode: true;
    in-out property <bool> is-overridden: false;
    in-out property <bool> is-token-mode: false;
    in property <[string]> font-tokens: ["Font.primary", "Font.secondary", "Font.tertiary"];
    in property <[string]> font-token-values: ["Arial", "Verdana", "Georgia"];
    in-out property <int> selected-token: 0;
    in property <[string]> actual-font-options: ["Arial", "Verdana", "Trebuchet MS", "Georgia", "Palatino", "Times New Roman", "Courier New", "Menlo", "Monaco"];
    in-out property <int> selected-actual-font: 0;
    property <bool> is-inherited: !is-overridden;
    property <string> selected-token-value:
        selected-token >= 0 && selected-token < font-token-values.length ? font-token-values[selected-token] : default-value;
    property <string> selected-actual-value:
        selected-actual-font >= 0 && selected-actual-font < actual-font-options.length ? actual-font-options[selected-actual-font] : default-value;

    callback reset();
    reset => {
        value = default-value;
        is-overridden = false;
        is-token-mode = false;
    }

    changed selected-token-value => {
        if (is-token-mode) {
            value = selected-token-value;
            // is-overridden is driven by the parent (from Rust's prop-value.is-overridden
            // via sync-from-prop). DO NOT auto-derive it here: in GenericSizePropEditor
            // `value` and `default-value` are both bound to root.local-string, so the
            // `value != default-value` comparison is always false and used to silently
            // clear every prop's override flag during sync.
        }
    }

    changed selected-actual-value => {
        if (!is-token-mode) {
            value = selected-actual-value;
            // See changed selected-token-value comment: do NOT auto-set is-overridden.
        }
    }

    height: (show-all || is-overridden) ? 30px : 0px;
    clip: true;

    HorizontalLayout {
        spacing: 8px;  // gap between the label column and the value fields
        padding-bottom: 6px;

        HorizontalLayout {
            width: RowLayout.label-width;
            padding-left: root.indent;

            Text {
                text: label;
                color: is-inherited ?
                    (dark-mode ? #555555 : #aaaaaa) :
                    (dark-mode ? #cccccc : #444444);
                font-size: 12px;
                font-weight: is-inherited ? 400 : 500;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        // Control column: label has a fixed shared width, so every row's
        // label/control boundary lines up; the control column fills the rest.
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 4px;

        if allow-reset && !is-inherited: Rectangle {
            width: 18px;
            height: 24px;

            Rectangle {
                x: 0;
                y: (parent.height - 18px) / 2;
                width: 18px;
                height: 18px;
                border-radius: 4px;
                background: reset-touch.has-hover ? (dark-mode ? #3a3a3a : #e0e0e0) : transparent;

                Text {
                    x: (parent.width - self.preferred-width) / 2;
                    y: (parent.height - self.preferred-height) / 2;
                    text: "↺";
                    color: dark-mode ? #888888 : #666666;
                    font-size: 12px;
                }

                reset-touch := TouchArea {
                    clicked => { root.reset(); }
                }
            }
        }

        if allow-token-mode && is-token-mode: Rectangle {
            horizontal-stretch: 1;
            height: 22px;
            opacity: is-inherited ? 0.7 : 1.0;

            Dropdown {
                width: parent.width;
                label: "";
                size: ControlSize.sm;
                options: root.font-tokens;
                selected-index <=> root.selected-token;
                placeholder: root.font-tokens.length > 0 ? root.font-tokens[0] : "";
                max-visible-items: 8;
                font-size: 11px;
                control-height: 22px;
                option-height: 24px;
                padding-horizontal: 8px;
                icon-size: 12px;
                border-radius: 4px;
                font-family: root.value;
            }
        }

        if !allow-token-mode || !is-token-mode: Rectangle {
            horizontal-stretch: 1;
            height: 22px;
            opacity: is-inherited ? 0.7 : 1.0;

            Dropdown {
                width: parent.width;
                label: "";
                size: ControlSize.sm;
                options: root.actual-font-options;
                selected-index <=> root.selected-actual-font;
                placeholder: root.actual-font-options.length > 0 ? root.actual-font-options[0] : "";
                max-visible-items: 8;
                font-size: 11px;
                control-height: 22px;
                option-height: 24px;
                padding-horizontal: 8px;
                icon-size: 12px;
                border-radius: 4px;
                font-family: root.value;
            }
        }

        if allow-token-mode: Rectangle {
            width: 20px;
            height: 22px;
            background: mode-toggle-touch.has-hover ? (dark-mode ? #2a2a2a : #e0e0e0) : (dark-mode ? #1a1a1a : #f0f0f0);
            border-radius: 4px;

            Text {
                x: (parent.width - self.preferred-width) / 2;
                y: (parent.height - self.preferred-height) / 2;
                text: is-token-mode ? "$" : "#";
                color: is-token-mode ? #1a9a9a : (dark-mode ? #888888 : #666666);
                font-size: 12px;
                font-weight: 600;
            }

            mode-toggle-touch := TouchArea {
                clicked => {
                    is-token-mode = !is-token-mode;
                    if (is-token-mode) {
                        value = selected-token-value;
                    } else {
                        value = selected-actual-value;
                    }
                    is-overridden = value != default-value;
                }
            }
        }
        }
    }
}

// Color swatch row for theme tokens with inline picker
component ColorRow inherits Rectangle {
    in property <string> label;
    // Left inset for the label text only (sub-prop nesting); value column stays aligned.
    in property <length> indent: 0px;
    in property <bool> dark-mode;
    in property <color> default-value: #1a9a9a;  // Parent/default value for comparison
    in-out property <color> value: #1a9a9a;
    property <bool> picker-open: false;
    // When false, only shows if value != default (overridden)
    in property <bool> show-all: true;

    // Hex input/output callbacks - connected from parent
    callback parse-hex(string) -> color;
    callback format-hex(color) -> string;
    // Callback to check if color values are equal (connected from Rust)
    callback check-equal(color, color) -> bool;
    // Callback when value changes - notifies parent immediately
    callback value-changed(color);

    // Override state - two-way bound to parent for persistence
    in-out property <bool> is-overridden: false;
    // For styling, use the inverse
    property <bool> is-inherited: !is-overridden;

    // Store hex string for display (updated when value changes or user edits)
    in-out property <string> hex-text: "";

    // Token mode: false = direct value (#), true = token reference ($)
    in-out property <bool> is-token-mode: false;
    in property <bool> allow-reset: true;
    in property <bool> allow-token-mode: true;
    // Available color tokens for selection
    in property <[string]> color-tokens: [
        "color.primary",
        "color.primary.light",
        "color.primary.dark",
        "color.secondary",
        "color.secondary.dark",
        "color.danger",
        "color.danger.light",
        "color.danger.dark",
        "color.foreground",
        "color.foreground.light",
        "color.surface",
        "color.background",
        "color.muted",
        "color.border",
        "color.transparent",
        "color.white",
        "color.success",
        "color.warning",
    ];
    // Selected token index
    in-out property <int> selected-token: 0;

    callback reset();
    reset => { value = default-value; is-overridden = false; is-token-mode = false; value-changed(value); }
    changed selected-token => {
        if (is-token-mode) {
            is-overridden = true;
            value-changed(value);
        }
    }
    changed is-token-mode => {
        if (allow-token-mode) {
            picker-open = false;
            if (is-token-mode) {
                is-overridden = true;
            }
            value-changed(value);
        }
    }

    // Height: row + picker (24px input + 3 rows of 22px + spacing + padding)
    // Use 0 height when hidden to collapse the row (include 6px spacing when visible)
    // Visibility: show if show-all OR if overridden (inline for better reactivity)
    // Only show picker when in value mode (not token mode)
    height: (show-all || is-overridden) ? (picker-open && !is-token-mode ? 30px + 8px + 120px : 30px) : 0px;
    clip: true;  // Clip content when height is 0 instead of using visible

    VerticalLayout {
        spacing: 8px;
        padding-bottom: 6px;  // spacing between rows

        HorizontalLayout {
            spacing: 8px;  // gap between the label column and the value fields

            HorizontalLayout {
                width: RowLayout.label-width;
                padding-left: root.indent;

                Text {
                    text: label;
                    color: is-inherited ?
                        (dark-mode ? #555555 : #aaaaaa) :
                        (dark-mode ? #cccccc : #444444);
                    font-size: 12px;
                    font-weight: is-inherited ? 400 : 500;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            // Control column: label has a fixed shared width, so every row's
            // label/control boundary lines up; the control column fills the rest.
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 4px;

            // Reset button (only shown when overridden) - to the left of value editor
            if allow-reset && !is-inherited: Rectangle {
                width: 18px;
                height: 24px;  // Match row height for vertical centering

                Rectangle {
                    x: 0;
                    y: (parent.height - 18px) / 2;
                    width: 18px;
                    height: 18px;
                    border-radius: 4px;
                    background: reset-touch.has-hover ? (dark-mode ? #3a3a3a : #e0e0e0) : transparent;

                    Text {
                        x: (parent.width - self.preferred-width) / 2;
                        y: (parent.height - self.preferred-height) / 2;
                        text: "↺";
                        color: dark-mode ? #888888 : #666666;
                        font-size: 12px;
                    }

                    reset-touch := TouchArea {
                        clicked => { root.reset(); }
                    }
                }
            }

            // Value editor (shown when NOT in token mode)
            if !is-token-mode || !allow-token-mode: Rectangle {
                width: 80px;
                height: 22px;
                background: dark-mode ? #1a1a1a : #f0f0f0;
                border-radius: 4px;
                opacity: is-inherited ? 0.7 : 1.0;

                HorizontalLayout {
                    padding: 3px;
                    spacing: 4px;

                    Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: 4px;
                        background: value;
                        border-width: 1px;
                        border-color: dark-mode ? #3a3a3a : #d0d0d0;
                    }

                    Text {
                        text: picker-open ? "Close" : "Edit";
                        color: dark-mode ? #888888 : #666666;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => {
                        if (!picker-open) {
                            // Opening picker: format current color as hex
                            hex-text = format-hex(value);
                        }
                        picker-open = !picker-open;
                    }
                }
            }

            // Spacer keeps the compact swatch button left-aligned at column start.
            if !is-token-mode || !allow-token-mode: Rectangle { horizontal-stretch: 1; }

            // Token selector (shown when in token mode) - fills the control column.
            if allow-token-mode && is-token-mode: Rectangle {
                horizontal-stretch: 1;
                height: 22px;
                opacity: is-inherited ? 0.7 : 1.0;

                Rectangle {
                    x: 0px;
                    y: (parent.height - 16px) / 2;
                    width: 16px;
                    height: 16px;
                    border-radius: 4px;
                    background: root.value;
                    border-width: 1px;
                    border-color: dark-mode ? #3a3a3a : #d0d0d0;
                }

                Dropdown {
                    x: 20px;
                    y: 0px;
                    width: parent.width - 20px;
                    height: parent.height;
                    label: "";
                    size: ControlSize.sm;
                    options: root.color-tokens;
                    selected-index <=> root.selected-token;
                    placeholder: root.color-tokens.length > 0 ? root.color-tokens[0] : "";
                    max-visible-items: 8;
                    font-size: 11px;
                    control-height: 22px;
                    option-height: 24px;
                    padding-horizontal: 8px;
                    icon-size: 12px;
                    border-radius: 4px;
                    changed(index, _label) => {
                        root.selected-token = index;
                        root.is-overridden = true;
                    }
                }
            }

            // Token/Value mode toggle button (#/$)
            if allow-token-mode: Rectangle {
                width: 20px;
                height: 22px;
                background: mode-toggle-touch.has-hover ? (dark-mode ? #2a2a2a : #e0e0e0) : (dark-mode ? #1a1a1a : #f0f0f0);
                border-radius: 4px;

                Text {
                    x: (parent.width - self.preferred-width) / 2;
                    y: (parent.height - self.preferred-height) / 2;
                    text: is-token-mode ? "$" : "#";
                    color: is-token-mode ? #1a9a9a : (dark-mode ? #888888 : #666666);
                    font-size: 12px;
                    font-weight: 600;
                }

                mode-toggle-touch := TouchArea {
                    clicked => {
                        is-token-mode = !is-token-mode;
                        picker-open = false;  // Close picker when switching modes
                    }
                }
            }
            }
        }

        // Color picker (aligned to right side, fits content)
        if picker-open: HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: self.preferred-width;
                height: self.preferred-height;
                background: dark-mode ? #1a1a1a : #f0f0f0;
                border-radius: 6px;

                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;

                    // Hex input row - full width
                    Rectangle {
                        height: 24px;
                        background: transparent;

                        HorizontalLayout {
                            spacing: 4px;

                            hex-input := EditorTextField {
                                horizontal-stretch: 1;
                                field-height: parent.height;
                                dark-mode: root.dark-mode;
                                text <=> root.hex-text;
                                prefix: "#";
                                text-font-size: 12px;
                                text-padding-left: 8px;
                                text-padding-right: 4px;
                                field-background: dark-mode ? #2a2a2a : #ffffff;
                                focused-border-width: 2px;
                                unfocused-border-width: 1px;
                                unfocused-border-color: dark-mode ? #3a3a3a : #d0d0d0;

                                accepted(value) => {
                                    root.value = root.parse-hex(value);
                                    root.is-overridden = !root.check-equal(root.value, root.default-value);
                                    root.value-changed(root.value);
                                    picker-open = false;
                                }

                                edited(value) => {
                                    if (value.character-count >= 6) {
                                        root.value = root.parse-hex(value);
                                        root.is-overridden = !root.check-equal(root.value, root.default-value);
                                        root.value-changed(root.value);
                                    }
                                }
                            }

                            // Current color preview - wrap in container for vertical centering
                            Rectangle {
                                width: 18px;
                                vertical-stretch: 0;

                                Rectangle {
                                    x: 0;
                                    y: (parent.height - 18px) / 2;
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 4px;
                                    background: value;
                                    border-width: 1px;
                                    border-color: dark-mode ? #3a3a3a : #d0d0d0;
                                }
                            }
                        }
                    }

                    // Row 1: Primary/brand colors (8 colors)
                    HorizontalLayout {
                        spacing: 4px;

                        for preset-color in [
                            #1a9a9a, #2abaaa, #158080, #0d6969,
                            #3b82f6, #2563eb, #1d4ed8, #1e40af
                        ]: Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 4px;
                            background: preset-color;
                            border-width: value == preset-color ? 2px : 1px;
                            border-color: value == preset-color ? #ffffff : (dark-mode ? #3a3a3a : #d0d0d0);

                            TouchArea {
                                clicked => {
                                    value = preset-color;
                                    hex-text = format-hex(preset-color);
                                    is-overridden = !check-equal(preset-color, default-value);
                                    value-changed(preset-color);
                                    picker-open = false;
                                }
                            }
                        }
                    }

                    // Row 2: Semantic colors (8 colors)
                    HorizontalLayout {
                        spacing: 4px;

                        for preset-color in [
                            #22c55e, #16a34a, #ef4444, #dc2626,
                            #f59e0b, #d97706, #8b5cf6, #7c3aed
                        ]: Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 4px;
                            background: preset-color;
                            border-width: value == preset-color ? 2px : 1px;
                            border-color: value == preset-color ? #ffffff : (dark-mode ? #3a3a3a : #d0d0d0);

                            TouchArea {
                                clicked => {
                                    value = preset-color;
                                    hex-text = format-hex(preset-color);
                                    is-overridden = !check-equal(preset-color, default-value);
                                    value-changed(preset-color);
                                    picker-open = false;
                                }
                            }
                        }
                    }

                    // Row 3: Neutrals (8 colors)
                    HorizontalLayout {
                        spacing: 4px;

                        for preset-color in [
                            #ffffff, #f5f5f5, #e8e8e8, #d0d0d0,
                            #888888, #666666, #3a3a3a, #1a1a1a
                        ]: Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 4px;
                            background: preset-color;
                            border-width: value == preset-color ? 2px : 1px;
                            border-color: value == preset-color ? #1a9a9a : (dark-mode ? #3a3a3a : #d0d0d0);

                            TouchArea {
                                clicked => {
                                    value = preset-color;
                                    hex-text = format-hex(preset-color);
                                    is-overridden = !check-equal(preset-color, default-value);
                                    value-changed(preset-color);
                                    picker-open = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component CompactDropdownSelector inherits Rectangle {
    in property <bool> dark-mode;
    in property <[string]> options;
    in property <length> selector-width: 110px;
    // When true, fill the control column (stretch); otherwise use selector-width.
    in property <bool> fill: false;
    in-out property <int> selected-index: 0;

    // Filling: stretch within min/max. Fixed: pin both bounds to selector-width.
    horizontal-stretch: fill ? 1 : 0;
    min-width: fill ? 0px : root.selector-width;
    max-width: fill ? 100000px : root.selector-width;
    preferred-width: root.selector-width;
    height: dropdown.preferred-height;
    preferred-height: dropdown.preferred-height;

    dropdown := Dropdown {
        width: parent.width;
        label: "";
        size: ControlSize.sm;
        options: root.options;
        selected-index <=> root.selected-index;
        placeholder: root.options.length > 0 ? root.options[0] : "";
        max-visible-items: 8;
        font-size: 11px;
        control-height: 22px;
        option-height: 24px;
        padding-horizontal: 8px;
        icon-size: 12px;
        border-radius: 4px;
    }
}

// Enum selector row with show-all support
component EnumRow inherits Rectangle {
    in property <string> label;
    in property <bool> dark-mode;
    in property <[string]> options;
    in property <int> default-index: 0;
    in-out property <int> selected-index: 0;
    in property <bool> show-all: true;
    in property <length> selector-width: 80px;

    property <bool> is-inherited: selected-index == default-index;
    property <bool> should-show: show-all || !is-inherited;

    height: should-show ? 24px : 0px;
    visible: should-show;

    HorizontalLayout {
        spacing: 8px;  // gap between the label column and the value fields

        Text {
            text: label;
            color: is-inherited ?
                (dark-mode ? #555555 : #aaaaaa) :
                (dark-mode ? #cccccc : #444444);
            font-size: 12px;
            font-weight: is-inherited ? 400 : 500;
            vertical-alignment: center;
            width: RowLayout.label-width;
        }

        CompactDropdownSelector {
            dark-mode: root.dark-mode;
            options: root.options;
            selector-width: root.selector-width;
            fill: true;
            selected-index <=> root.selected-index;
        }
    }
}

// Enum selector row
component EnumSelector inherits Rectangle {
    in property <string> label;
    in property <bool> dark-mode;
    in property <[string]> options;
    in property <bool> inherited: false;
    in property <length> selector-width: 110px;
    in-out property <int> selected-index: 0;

    height: 24px;

    HorizontalLayout {
        spacing: 8px;  // gap between the label column and the value fields

        Text {
            text: label;
            color: inherited ?
                (dark-mode ? #666666 : #999999) :
                (dark-mode ? #888888 : #666666);
            font-size: 12px;
            vertical-alignment: center;
            width: RowLayout.label-width;
        }

        CompactDropdownSelector {
            dark-mode: root.dark-mode;
            options: root.options;
            selector-width: root.selector-width;
            fill: true;
            selected-index <=> root.selected-index;
        }
    }
}

component GenericVariantPropEditor inherits Rectangle {
    in property <bool> dark-mode;
    // Label inset for variant props (nested under Variants > State, so deeper).
    in property <length> indent: 32px;
    in property <PropertyDef> prop-def;
    in property <PropertyValueData> prop-value;
    in property <int> sync-version: 0;
    callback parse-hex(string) -> color;
    callback format-hex(color) -> string;
    callback check-color-equal(color, color) -> bool;
    callback check-float-equal(float, float) -> bool;
    callback value-changed(PropertyValueData);

    property <bool> syncing: false;
    property <bool> local-overridden: prop-value.is-overridden;
    property <color> local-color: prop-value.color-value;
    property <float> local-float: prop-value.float-value;
    property <int> local-int: prop-value.int-value;
    property <bool> local-token-mode: prop-value.is-token-mode;
    property <int> local-selected-token: prop-value.selected-token;

    callback sync-from-prop();
    sync-from-prop => {
        syncing = true;
        local-color = prop-value.color-value;
        local-float = prop-value.float-value;
        local-int = prop-value.int-value;
        local-overridden = prop-value.is-overridden;
        local-token-mode = prop-value.is-token-mode;
        local-selected-token = prop-value.selected-token;
        syncing = false;
    }

    callback emit-current();
    emit-current => {
        if (!syncing) {
            root.value-changed({
                color-value: local-color,
                float-value: local-float,
                int-value: local-int,
                bool-value: false,
                string-value: "",
                is-overridden: local-overridden,
                is-token-mode: local-token-mode,
                selected-token: local-selected-token,
                selected-actual-index: 0,
            });
        }
    }

    changed sync-version => {
        root.sync-from-prop();
    }

    width: 100%;

    color-editor := ColorRow {
        width: parent.width;
        indent: root.indent;
        visible: prop-def.prop-type == "color";
        label: prop-def.display-name;
        dark-mode: root.dark-mode;
        value <=> root.local-color;
        default-value: root.local-color;
        show-all: true;
        allow-reset: false;
        allow-token-mode: true;
        is-overridden <=> root.local-overridden;
        is-token-mode <=> root.local-token-mode;
        selected-token <=> root.local-selected-token;
        parse-hex(hex) => { return root.parse-hex(hex); }
        format-hex(color) => { return root.format-hex(color); }
        check-equal(value, default) => { return root.check-color-equal(value, default); }
        value-changed(color) => {
            root.local-color = color;
            root.emit-current();
        }
        changed is-token-mode => { root.emit-current(); }
        changed selected-token => { root.emit-current(); }
    }

    number-editor := NumberInput {
        width: parent.width;
        indent: root.indent;
        visible: prop-def.prop-type == "float" || prop-def.prop-type == "int";
        label: prop-def.display-name;
        dark-mode: root.dark-mode;
        suffix:
            prop-def.name == "animation-speed" ? "RPM" :
            prop-def.name == "opacity" || prop-def.name == "button-opacity" || prop-def.name == "font-weight" ? "" :
            "px";
        value <=> root.local-float;
        min-value: prop-def.min-value;
        max-value: prop-def.max-value;
        step: prop-def.step;
        default-value: root.local-float;
        show-all: true;
        allow-reset: false;
        allow-token-mode: false;
        is-overridden <=> root.local-overridden;
        check-equal(value, default) => { return root.check-float-equal(value, default); }
        changed value => {
            root.local-int = Math.round(root.local-float);
            root.emit-current();
        }
    }

    height: prop-def.prop-type == "color" ? color-editor.height : number-editor.height;
    preferred-height: self.height;
}

component GenericSizePropEditor inherits Rectangle {
    in property <bool> dark-mode;
    // Label inset for size props (nested one level under Sizes).
    in property <length> indent: 24px;
    in property <PropertyDef> prop-def;
    in property <PropertyValueData> prop-value;
    in property <int> sync-version: 0;
    in property <[string]> font-token-options;
    in property <[string]> font-token-values;
    in property <[string]> actual-font-options;
    in property <[string]> number-token-options;
    in property <[float]> number-token-values;
    // When true, the leaf shows a reset (↺) button that emits `clear-override`
    // — used in concrete-size mode to drop the per-size override and re-inherit
    // from the "Default" base. Disabled in the Default-base view (nothing to
    // reset there — the Default IS the source).
    in property <bool> enable-reset: false;
    callback check-float-equal(float, float) -> bool;
    callback value-changed(PropertyValueData);
    // Emitted when the user clicks the reset button on a size prop. The parent
    // turns this into a `clear-size-override(size_index, prop_index)` call into
    // Rust so the override is removed and the row re-inherits the Default base.
    callback clear-override();

    property <bool> syncing: false;
    property <bool> local-overridden: prop-value.is-overridden;
    property <float> local-float: prop-value.float-value;
    property <string> local-string: prop-value.string-value;
    property <bool> local-token-mode: prop-value.is-token-mode;
    property <int> local-selected-token: prop-value.selected-token;
    property <int> local-selected-actual-index: prop-value.selected-actual-index;

    // True when every local field already equals the value it would be read
    // from prop-value — i.e., the leaf's `changed` handlers just fired because
    // we synced from Rust, not because the user actually edited anything. The
    // `syncing` boolean alone isn't enough: Slint runs `changed` callbacks
    // AFTER the sync-from-prop body completes (and clears syncing), so a
    // clear-override sync would otherwise echo back as a fresh user edit and
    // Rust would immediately re-establish the override.
    property <bool> locals-match-prop-value:
        local-float == prop-value.float-value
        && local-string == prop-value.string-value
        && local-token-mode == prop-value.is-token-mode
        && local-selected-token == prop-value.selected-token
        && local-selected-actual-index == prop-value.selected-actual-index;

    callback sync-from-prop();
    sync-from-prop => {
        syncing = true;
        local-float = prop-value.float-value;
        local-string = prop-value.string-value;
        local-token-mode = prop-value.is-token-mode;
        local-selected-token = prop-value.selected-token;
        local-selected-actual-index = prop-value.selected-actual-index;
        local-overridden = prop-value.is-overridden;
        syncing = false;
    }

    callback emit-current();
    emit-current => {
        if (!syncing && !locals-match-prop-value) {
            root.value-changed({
                color-value: #000000,
                float-value: local-float,
                int-value: Math.round(local-float),
                bool-value: false,
                string-value: local-string,
                is-overridden: true,
                is-token-mode: local-token-mode,
                selected-token: local-selected-token,
                selected-actual-index: local-selected-actual-index,
            });
        }
    }

    changed sync-version => {
        root.sync-from-prop();
    }

    width: 100%;

    font-editor := FontSelectorRow {
        width: parent.width;
        indent: root.indent;
        visible: prop-def.prop-type == "string";
        label: prop-def.display-name;
        dark-mode: root.dark-mode;
        value <=> root.local-string;
        default-value: root.local-string;
        show-all: true;
        allow-reset: root.enable-reset;
        allow-token-mode: true;
        is-overridden <=> root.local-overridden;
        is-token-mode <=> root.local-token-mode;
        font-tokens: root.font-token-options;
        font-token-values: root.font-token-values;
        selected-token <=> root.local-selected-token;
        actual-font-options: root.actual-font-options;
        selected-actual-font <=> root.local-selected-actual-index;
        reset => { root.clear-override(); }
        changed value => { root.emit-current(); }
        changed is-token-mode => { root.emit-current(); }
        changed selected-token => { root.emit-current(); }
        changed selected-actual-font => { root.emit-current(); }
    }

    number-editor := NumberInput {
        width: parent.width;
        indent: root.indent;
        visible: prop-def.prop-type == "float" || prop-def.prop-type == "int";
        label: prop-def.display-name;
        dark-mode: root.dark-mode;
        suffix:
            prop-def.name == "animation-speed" ? "RPM" :
            prop-def.name == "opacity" || prop-def.name == "button-opacity" || prop-def.name == "font-weight" ? "" :
            "px";
        value <=> root.local-float;
        min-value: prop-def.min-value;
        max-value: prop-def.max-value;
        step: prop-def.step;
        default-value: root.local-float;
        show-all: true;
        allow-reset: root.enable-reset;
        allow-token-mode: true;
        is-overridden <=> root.local-overridden;
        is-token-mode <=> root.local-token-mode;
        number-tokens: root.number-token-options;
        token-values: root.number-token-values;
        selected-token <=> root.local-selected-token;
        check-equal(value, default) => { return root.check-float-equal(value, default); }
        reset => { root.clear-override(); }
        changed value => { root.emit-current(); }
        changed is-token-mode => { root.emit-current(); }
        changed selected-token => { root.emit-current(); }
    }

    height: prop-def.prop-type == "string" ? font-editor.height : number-editor.height;
    preferred-height: self.height;
}

export component ThemeEditor inherits Rectangle {
    in property <bool> dark-mode;

    // Theme selection state
    in-out property <int> selected-theme: 0;  // 0 = Default Theme
    // Dynamic theme list (managed by Rust)
    in-out property <[ThemeInfo]> theme-list: [
        { name: "Default Theme", is-builtin: true },
        { name: "My Custom Theme", is-builtin: false },
        { name: "Verdant Theme", is-builtin: false },
        { name: "Sunset Serif", is-builtin: false },
        { name: "Signal Mono", is-builtin: false },
    ];

    // ===== DYNAMIC PLUGIN DATA (populated by Rust from JSON plugins) =====
    in-out property <[ThemeComponentInfo]> component-list: [];
    in-out property <[string]> component-name-list: [];
    in-out property <int> selected-component-index: 0;
    in-out property <string> selected-component-key: "button";
    in-out property <string> selected-component-name: "Button";

    // Component metadata from plugins
    in-out property <[VariantInfo]> variant-list: [];
    in-out property <[string]> variant-name-list: [];
    in-out property <[StateInfo]> state-list: [];
    in-out property <[string]> state-name-list: [];
    in-out property <[SizeInfo]> size-list: [];
    in-out property <[string]> size-name-list: [];
    // Matrix-only size list: the size-list with the virtual "Default" entry
    // removed. Editing UI uses size-list (with Default first); the matrix
    // preview iterates this filtered list. The offset is how many entries the
    // selector has BEFORE the first matrix entry (1 when Default is prepended,
    // 0 otherwise) so the active-cell highlight maps from selector index →
    // matrix index correctly.
    in-out property <[SizeInfo]> matrix-size-list: [];
    in-out property <int> matrix-size-index-offset: 0;

    // Property definitions from plugins
    in-out property <[PropertyDef]> variant-prop-defs: [];
    in-out property <[PropertyDef]> size-prop-defs: [];

    // Current property values for the selected variant (flat array: state_index * prop_count + prop_index)
    in-out property <[PropertyValueData]> current-variant-values: [];
    in-out property <int> variant-values-version: 0;

    // Current property values for the selected size
    in-out property <[PropertyValueData]> current-size-values: [];
    in-out property <int> size-values-version: 0;

    // Callback when a variant property value changes
    callback variant-prop-changed(int /* state_index */, int /* prop_index */, PropertyValueData /* new_value */);

    // Callback when a size property value changes
    callback size-prop-changed(int /* size_index */, int /* prop_index */, PropertyValueData /* new_value */);
    callback component-theme-selected(string /* component_key */);

    // Settings panel width (for splitter)
    in-out property <length> settings-panel-width: 320px;

    // ===== EDITABLE TOKEN PROPERTIES (managed by Rust, swapped on theme change) =====
    // Light mode tokens for current theme
    in-out property <color> light-token-primary: #1a9a9a;
    in-out property <color> light-token-primary-pressed: #158080;
    in-out property <color> light-token-secondary: #e8e4df;
    in-out property <color> light-token-danger: #dc2626;
    in-out property <color> light-token-surface: #ffffff;
    in-out property <color> light-token-background: #ffffff;
    in-out property <color> light-token-text: #1a1a1a;
    in-out property <color> light-token-text-muted: #6b6b6b;

    // Dark mode tokens for current theme
    in-out property <color> dark-token-primary: #2abaaa;
    in-out property <color> dark-token-primary-pressed: #1a9a9a;
    in-out property <color> dark-token-secondary: #3a3a3a;
    in-out property <color> dark-token-danger: #ef4444;
    in-out property <color> dark-token-surface: #1e1e1e;
    in-out property <color> dark-token-background: #121212;
    in-out property <color> dark-token-text: #fafafa;
    in-out property <color> dark-token-text-muted: #9a9a9a;

    // ===== ACTIVE TOKENS (based on current mode) =====
    // These are computed from the mode-specific tokens for use in preview
    property <color> token-primary: dark-mode ? dark-token-primary : light-token-primary;
    property <color> token-primary-pressed: dark-mode ? dark-token-primary-pressed : light-token-primary-pressed;
    property <color> token-secondary: dark-mode ? dark-token-secondary : light-token-secondary;
    property <color> token-danger: dark-mode ? dark-token-danger : light-token-danger;
    property <color> token-surface: dark-mode ? dark-token-surface : light-token-surface;
    property <color> token-background: dark-mode ? dark-token-background : light-token-background;
    property <color> token-text: dark-mode ? dark-token-text : light-token-text;
    property <color> token-text-muted: dark-mode ? dark-token-text-muted : light-token-text-muted;

    // ===== SHARED TOKENS (same for light and dark) =====
    // Spacing tokens
    in-out property <float> token-spacing-xs: 4.0;
    in-out property <float> token-spacing-sm: 8.0;
    in-out property <float> token-spacing-md: 12.0;
    in-out property <float> token-spacing-lg: 16.0;
    in-out property <float> token-spacing-xl: 24.0;
    // Font size tokens
    in-out property <float> token-font-size-sm: 20.0;
    in-out property <float> token-font-size-md: 22.0;
    in-out property <float> token-font-size-lg: 24.0;
    // Font family tokens
    in-out property <string> token-font-primary: "Montserrat";
    in-out property <string> token-font-secondary: "Montserrat";
    in-out property <string> token-font-tertiary: "Montserrat";
    in-out property <int> token-font-primary-index: 0;
    in-out property <int> token-font-secondary-index: 0;
    in-out property <int> token-font-tertiary-index: 0;
    in property <[string]> font-token-options: ["Font.primary", "Font.secondary", "Font.tertiary"];
    in property <[string]> actual-font-options: ["Montserrat", "Arial", "Verdana", "Trebuchet MS", "Georgia", "Palatino", "Times New Roman", "Courier New", "Menlo", "Monaco"];
    in property <[string]> number-token-options: [
        "font-size-sm",
        "font-size-md",
        "font-size-lg",
        "spacing-xs",
        "spacing-sm",
        "spacing-md",
        "spacing-lg",
        "spacing-xl",
        "radius-sm",
        "radius-default",
        "radius-lg",
        "radius-full",
        "control-size-sm",
        "control-size-md",
        "control-size-lg",
        "icon-size-sm",
        "icon-size-md",
        "icon-size-lg",
        "control-radius-sm",
        "control-radius-md",
        "control-radius-lg",
        "control-padding-inline-sm",
        "control-padding-inline-md",
        "control-padding-inline-lg"
    ];
    property <[float]> number-token-values: [
        token-font-size-sm,
        token-font-size-md,
        token-font-size-lg,
        token-spacing-xs,
        token-spacing-sm,
        token-spacing-md,
        token-spacing-lg,
        token-spacing-xl,
        token-radius-sm,
        token-radius-default,
        token-radius-lg,
        token-radius-full,
        token-control-size-sm,
        token-control-size-md,
        token-control-size-lg,
        token-icon-size-sm,
        token-icon-size-md,
        token-icon-size-lg,
        token-control-radius-sm,
        token-control-radius-md,
        token-control-radius-lg,
        token-control-padding-inline-sm,
        token-control-padding-inline-md,
        token-control-padding-inline-lg
    ];

    // Control scale tokens
    in-out property <float> token-control-size-sm: 48.0;
    in-out property <float> token-control-size-md: 56.0;
    in-out property <float> token-control-size-lg: 64.0;
    in-out property <float> token-icon-size-sm: 20.0;
    in-out property <float> token-icon-size-md: 24.0;
    in-out property <float> token-icon-size-lg: 28.0;
    in-out property <float> token-control-radius-sm: 20.0;
    in-out property <float> token-control-radius-md: 24.0;
    in-out property <float> token-control-radius-lg: 28.0;
    in-out property <float> token-control-padding-inline-sm: 14.0;
    in-out property <float> token-control-padding-inline-md: 16.0;
    in-out property <float> token-control-padding-inline-lg: 20.0;

    // Radius tokens
    in-out property <float> token-radius-sm: 8.0;
    in-out property <float> token-radius-md: 16.0;
    in-out property <float> token-radius-lg: 24.0;
    in-out property <float> token-radius-full: 9999.0;
    in-out property <int> token-radius-default-index: 2; // sm, md, lg, full
    property <float> token-radius-default:
        token-radius-default-index == 0 ? token-radius-sm :
        token-radius-default-index == 1 ? token-radius-md :
        token-radius-default-index == 2 ? token-radius-lg :
        token-radius-full;
    property <ButtonVariant> preview-button-variant:
        btn-selected-variant == 1 ? ButtonVariant.secondary :
        btn-selected-variant == 2 ? ButtonVariant.tertiary :
        btn-selected-variant == 3 ? ButtonVariant.ghost :
        btn-selected-variant == 4 ? ButtonVariant.danger :
        ButtonVariant.primary;
    property <ControlSize> preview-button-size:
        btn-selected-size == 0 ? ControlSize.sm :
        btn-selected-size == 2 ? ControlSize.lg :
        ControlSize.md;
    property <int> active-variant-index:
        component-selected-variant;
    property <int> active-size-index:
        component-selected-size;
    in-out property <int> preview-state-index: 0;
    property <string> preview-state-key:
        state-list.length > 0 && preview-state-index >= 0 && preview-state-index < state-list.length ?
        state-list[preview-state-index].key :
        "normal";
    pure function component-preview-cell-width() -> length {
        if root.selected-component-key == "dialog" {
            return 420px;
        }
        if root.selected-component-key == "sheet" {
            return 420px;
        }
        if root.selected-component-key == "toast" {
            return 360px;
        }
        if root.selected-component-key == "image" {
            return 360px;
        }
        if root.selected-component-key == "icon" {
            return 132px;
        }
        if root.selected-component-key == "tabs" {
            return 392px;
        }
        if root.selected-component-key == "input" || root.selected-component-key == "search" {
            return 280px;
        }
        if root.selected-component-key == "dropdown" {
            return 300px;
        }
        if root.selected-component-key == "slide_to_confirm" {
            return 320px;
        }
        if root.selected-component-key == "slider" {
            return 280px;
        }
        if root.selected-component-key == "card" {
            return 320px;
        }
        if root.selected-component-key == "progress_bar" {
            return 280px;
        }
        if root.selected-component-key == "divider" {
            return 240px;
        }
        if root.selected-component-key == "textarea" {
            return 340px;
        }
        if root.selected-component-key == "checkbox" || root.selected-component-key == "radio" || root.selected-component-key == "switch" {
            return 400px;
        }
        if root.selected-component-key == "menu" || root.selected-component-key == "menu_item" {
            return 360px;
        }
        if root.selected-component-key == "accordion" {
            return 440px;
        }
        if root.selected-component-key == "radio_group" {
            return 320px;
        }
        return 180px;
    }
    pure function component-preview-cell-height() -> length {
        if root.selected-component-key == "dialog" {
            return 320px;
        }
        if root.selected-component-key == "sheet" {
            return 420px;
        }
        if root.selected-component-key == "toast" {
            return 160px;
        }
        if root.selected-component-key == "image" {
            return 324px;
        }
        if root.selected-component-key == "icon" {
            return 96px;
        }
        if root.selected-component-key == "card" {
            return 220px;
        }
        if root.selected-component-key == "progress_bar" {
            return 112px;
        }
        if root.selected-component-key == "divider" {
            return 72px;
        }
        if root.selected-component-key == "checkbox" || root.selected-component-key == "radio" || root.selected-component-key == "switch" {
            return 96px;
        }
        if root.selected-component-key == "tabs" {
            return 220px;
        }
        if root.selected-component-key == "dropdown" {
            return 128px;
        }
        if root.selected-component-key == "textarea" {
            return 320px;
        }
        if root.selected-component-key == "menu" {
            return 220px;
        }
        if root.selected-component-key == "accordion" {
            return 300px;
        }
        if root.selected-component-key == "menu_item" {
            return 128px;
        }
        if root.selected-component-key == "radio_group" {
            return 188px;
        }
        return 96px;
    }
    property <length> preview-grid-cell-width: root.component-preview-cell-width();
    property <length> preview-grid-cell-height: root.component-preview-cell-height();
    property <length> preview-grid-label-width: 92px;

    // ===== BUTTON THEME PROPERTIES (per state) =====
    // --- NORMAL STATE ---
    // Style Props
    in-out property <float> btn-normal-border-radius: 16.0;
    in-out property <float> btn-normal-border-width: 0.0;
    in-out property <color> btn-normal-border-color: transparent;
    in-out property <color> btn-normal-background: #1a9a9a;
    in-out property <color> btn-normal-foreground: #ffffff;
    in-out property <float> btn-normal-font-weight: 500.0;
    in-out property <float> btn-normal-touch-expansion: 4.0;
    in-out property <float> btn-normal-opacity: 1.0;
    // Size Props
    in-out property <string> btn-normal-font-family: "Arial";
    in-out property <float> btn-normal-font-size: 16.0;
    in-out property <float> btn-normal-padding-h: 16.0;
    in-out property <float> btn-normal-padding-v: 8.0;
    in-out property <float> btn-normal-icon-size: 20.0;
    in-out property <float> btn-normal-min-height: 44.0;
    // Token binding state for the currently selected size
    in-out property <bool> btn-normal-font-family-token-mode: true;
    in-out property <int> btn-normal-font-family-selected-token: 0;
    in-out property <int> btn-normal-font-family-actual-index: 0;
    in-out property <bool> btn-normal-font-size-token-mode: true;
    in-out property <int> btn-normal-font-size-selected-token: 1;
    in-out property <bool> btn-normal-padding-h-token-mode: true;
    in-out property <int> btn-normal-padding-h-selected-token: 6;
    in-out property <bool> btn-normal-padding-v-token-mode: true;
    in-out property <int> btn-normal-padding-v-selected-token: 4;
    in-out property <bool> btn-normal-icon-size-token-mode: false;
    in-out property <int> btn-normal-icon-size-selected-token: 0;
    in-out property <bool> btn-normal-min-height-token-mode: false;
    in-out property <int> btn-normal-min-height-selected-token: 0;
    in-out property <bool> btn-normal-border-radius-token-mode: true;
    in-out property <int> btn-normal-border-radius-selected-token: 9;

    // --- PRESSED STATE ---
    // Style Props
    in-out property <float> btn-pressed-border-radius: 16.0;
    in-out property <float> btn-pressed-border-width: 0.0;
    in-out property <color> btn-pressed-border-color: transparent;
    in-out property <color> btn-pressed-background: #158080;
    in-out property <color> btn-pressed-foreground: #ffffff;
    in-out property <float> btn-pressed-font-weight: 500.0;
    in-out property <float> btn-pressed-touch-expansion: 4.0;
    in-out property <float> btn-pressed-opacity: 1.0;
    // Size Props
    in-out property <float> btn-pressed-font-size: 16.0;
    in-out property <float> btn-pressed-padding-h: 16.0;
    in-out property <float> btn-pressed-padding-v: 8.0;
    in-out property <float> btn-pressed-icon-size: 20.0;
    in-out property <float> btn-pressed-min-height: 44.0;

    // --- DISABLED STATE ---
    // Style Props
    in-out property <float> btn-disabled-border-radius: 16.0;
    in-out property <float> btn-disabled-border-width: 0.0;
    in-out property <color> btn-disabled-border-color: transparent;
    in-out property <color> btn-disabled-background: #1a9a9a;
    in-out property <color> btn-disabled-foreground: #ffffff;
    in-out property <float> btn-disabled-font-weight: 500.0;
    in-out property <float> btn-disabled-touch-expansion: 4.0;
    in-out property <float> btn-disabled-opacity: 0.5;
    // Size Props
    in-out property <float> btn-disabled-font-size: 16.0;
    in-out property <float> btn-disabled-padding-h: 16.0;
    in-out property <float> btn-disabled-padding-v: 8.0;
    in-out property <float> btn-disabled-icon-size: 20.0;
    in-out property <float> btn-disabled-min-height: 44.0;

    // ===== BUTTON OVERRIDE TRACKING (for eye toggle filtering) =====
    // Normal State
    in-out property <bool> btn-normal-border-radius-overridden: false;
    in-out property <bool> btn-normal-border-width-overridden: false;
    in-out property <bool> btn-normal-border-color-overridden: false;
    in-out property <bool> btn-normal-background-overridden: false;
    in-out property <bool> btn-normal-foreground-overridden: false;
    in-out property <bool> btn-normal-font-weight-overridden: false;
    in-out property <bool> btn-normal-touch-expansion-overridden: false;
    in-out property <bool> btn-normal-opacity-overridden: false;
    in-out property <bool> btn-normal-font-family-overridden: false;
    in-out property <bool> btn-normal-font-size-overridden: false;
    in-out property <bool> btn-normal-padding-h-overridden: false;
    in-out property <bool> btn-normal-padding-v-overridden: false;
    in-out property <bool> btn-normal-icon-size-overridden: false;
    in-out property <bool> btn-normal-min-height-overridden: false;
    // Pressed State
    in-out property <bool> btn-pressed-border-radius-overridden: false;
    in-out property <bool> btn-pressed-border-width-overridden: false;
    in-out property <bool> btn-pressed-border-color-overridden: false;
    in-out property <bool> btn-pressed-background-overridden: false;
    in-out property <bool> btn-pressed-foreground-overridden: false;
    in-out property <bool> btn-pressed-font-weight-overridden: false;
    in-out property <bool> btn-pressed-touch-expansion-overridden: false;
    in-out property <bool> btn-pressed-opacity-overridden: false;
    in-out property <bool> btn-pressed-font-size-overridden: false;
    in-out property <bool> btn-pressed-padding-h-overridden: false;
    in-out property <bool> btn-pressed-padding-v-overridden: false;
    in-out property <bool> btn-pressed-icon-size-overridden: false;
    in-out property <bool> btn-pressed-min-height-overridden: false;
    // Disabled State
    in-out property <bool> btn-disabled-border-radius-overridden: false;
    in-out property <bool> btn-disabled-border-width-overridden: false;
    in-out property <bool> btn-disabled-border-color-overridden: false;
    in-out property <bool> btn-disabled-background-overridden: false;
    in-out property <bool> btn-disabled-foreground-overridden: false;
    in-out property <bool> btn-disabled-font-weight-overridden: false;
    in-out property <bool> btn-disabled-touch-expansion-overridden: false;
    in-out property <bool> btn-disabled-opacity-overridden: false;
    in-out property <bool> btn-disabled-font-size-overridden: false;
    in-out property <bool> btn-disabled-padding-h-overridden: false;
    in-out property <bool> btn-disabled-padding-v-overridden: false;
    in-out property <bool> btn-disabled-icon-size-overridden: false;
    in-out property <bool> btn-disabled-min-height-overridden: false;

    // Button variant selection (0=Primary, 1=Secondary, 2=Tertiary, 3=Ghost, 4=Danger)
    in-out property <int> btn-selected-variant: 0;
    // Button size selection (0=sm, 1=md, 2=lg)
    in-out property <int> btn-selected-size: 1;  // Default to md
    // Generic component selection for the theme editor
    in-out property <int> component-selected-variant: 0;
    in-out property <int> component-selected-size: 0;

    // Callbacks
    callback new-theme();
    callback import-json();
    callback export-json();
    callback rename-theme(string);  // Called when user edits the theme name
    // Hex color conversion callbacks - connected from Rust
    callback parse-hex-color(string) -> color;
    callback format-hex-color(color) -> string;
    // Value comparison callbacks - connected from Rust for reliable equality checks
    callback check-float-equal(float, float) -> bool;
    callback check-color-equal(color, color) -> bool;
    // Debug callback for visibility tracking
    callback debug-visibility(string, bool, bool, bool);
    // Button variant change - notifies Rust when user selects a different variant
    callback btn-variant-changed(int);
    // Button size change - notifies Rust when user selects a different size
    callback btn-size-changed(int);
    // Theme change - notifies Rust when user selects a different theme (saves current, loads new)
    callback theme-changed(int);
    // Token value change - notifies Rust immediately when a token value is edited
    // Parameters: token_name (e.g. "primary"), new_color, is_dark_mode
    callback token-value-changed(string, color, bool);
    // Theme value edit - notifies Rust to sync Theme global for live previews
    callback theme-values-edited();
    // Token edit - notifies Rust to sync token-backed runtime values
    callback theme-tokens-edited();

    // Size props (selected size is edited through the "normal" fields)
    changed btn-normal-font-family => { root.theme-values-edited(); }
    changed btn-normal-font-size => { root.theme-values-edited(); }
    changed btn-normal-padding-h => { root.theme-values-edited(); }
    changed btn-normal-padding-v => { root.theme-values-edited(); }
    changed btn-normal-icon-size => { root.theme-values-edited(); }
    changed btn-normal-min-height => { root.theme-values-edited(); }
    changed btn-normal-border-radius => { root.theme-values-edited(); }

    // Variant state style props
    changed btn-normal-border-width => { root.theme-values-edited(); }
    changed btn-normal-border-color => { root.theme-values-edited(); }
    changed btn-normal-background => { root.theme-values-edited(); }
    changed btn-normal-foreground => { root.theme-values-edited(); }
    changed btn-normal-font-weight => { root.theme-values-edited(); }
    changed btn-normal-touch-expansion => { root.theme-values-edited(); }
    changed btn-normal-opacity => { root.theme-values-edited(); }
    changed btn-pressed-border-width => { root.theme-values-edited(); }
    changed btn-pressed-border-color => { root.theme-values-edited(); }
    changed btn-pressed-background => { root.theme-values-edited(); }
    changed btn-pressed-foreground => { root.theme-values-edited(); }
    changed btn-pressed-font-weight => { root.theme-values-edited(); }
    changed btn-pressed-touch-expansion => { root.theme-values-edited(); }
    changed btn-pressed-opacity => { root.theme-values-edited(); }
    changed btn-disabled-border-width => { root.theme-values-edited(); }
    changed btn-disabled-border-color => { root.theme-values-edited(); }
    changed btn-disabled-background => { root.theme-values-edited(); }
    changed btn-disabled-foreground => { root.theme-values-edited(); }
    changed btn-disabled-font-weight => { root.theme-values-edited(); }
    changed btn-disabled-touch-expansion => { root.theme-values-edited(); }
    changed btn-disabled-opacity => { root.theme-values-edited(); }
    changed token-font-primary-index => { root.token-font-primary = root.actual-font-options[root.token-font-primary-index]; }
    changed token-font-secondary-index => { root.token-font-secondary = root.actual-font-options[root.token-font-secondary-index]; }
    changed token-font-tertiary-index => { root.token-font-tertiary = root.actual-font-options[root.token-font-tertiary-index]; }

    // Shared token edits that affect runtime resolution
    changed token-spacing-xs => { root.theme-tokens-edited(); }
    changed token-spacing-sm => { root.theme-tokens-edited(); }
    changed token-spacing-md => { root.theme-tokens-edited(); }
    changed token-spacing-lg => { root.theme-tokens-edited(); }
    changed token-spacing-xl => { root.theme-tokens-edited(); }
    changed token-control-size-sm => { root.theme-tokens-edited(); }
    changed token-control-size-md => { root.theme-tokens-edited(); }
    changed token-control-size-lg => { root.theme-tokens-edited(); }
    changed token-icon-size-sm => { root.theme-tokens-edited(); }
    changed token-icon-size-md => { root.theme-tokens-edited(); }
    changed token-icon-size-lg => { root.theme-tokens-edited(); }
    changed token-control-radius-sm => { root.theme-tokens-edited(); }
    changed token-control-radius-md => { root.theme-tokens-edited(); }
    changed token-control-radius-lg => { root.theme-tokens-edited(); }
    changed token-control-padding-inline-sm => { root.theme-tokens-edited(); }
    changed token-control-padding-inline-md => { root.theme-tokens-edited(); }
    changed token-control-padding-inline-lg => { root.theme-tokens-edited(); }
    changed token-font-size-sm => { root.theme-tokens-edited(); }
    changed token-font-size-md => { root.theme-tokens-edited(); }
    changed token-font-size-lg => { root.theme-tokens-edited(); }
    changed token-font-primary => { root.theme-tokens-edited(); }
    changed token-font-secondary => { root.theme-tokens-edited(); }
    changed token-font-tertiary => { root.theme-tokens-edited(); }
    changed token-radius-sm => { root.theme-tokens-edited(); }
    changed token-radius-md => { root.theme-tokens-edited(); }
    changed token-radius-default-index => { root.theme-tokens-edited(); }
    changed token-radius-lg => { root.theme-tokens-edited(); }
    changed token-radius-full => { root.theme-tokens-edited(); }

    background: dark-mode ? #1a1a1a : #f5f5f5;

    HorizontalLayout {
        spacing: 0px;

        // Themes sidebar
        Rectangle {
            width: 220px;
            background: dark-mode ? #242424 : #ffffff;
            border-width: 0px;

            VerticalLayout {
                padding: 12px;
                spacing: 4px;

                // DEFAULT section
                TreeSectionHeader {
                    title: "DEFAULT";
                    dark-mode: root.dark-mode;
                }

                // Built-in themes
                for theme[idx] in root.theme-list: ThemeItem {
                    name: theme.name;
                    selected: root.selected-theme == idx;
                    dark-mode: root.dark-mode;
                    clicked => { root.theme-changed(idx); }
                }

                Rectangle { vertical-stretch: 1; }

                // New Theme button
                Rectangle {
                    height: 32px;
                    background: new-theme-touch.has-hover ? (dark-mode ? #2a2a2a : #f0f0f0) : transparent;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: dark-mode ? #3a3a3a : #e0e0e0;

                    HorizontalLayout {
                        padding-left: 12px;
                        spacing: 8px;

                        Text {
                            text: "+";
                            color: dark-mode ? #888888 : #666666;
                            font-size: 14px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "New Theme";
                            color: dark-mode ? #888888 : #666666;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }

                    new-theme-touch := TouchArea {
                        clicked => { root.new-theme(); }
                    }
                }

                Rectangle { height: 8px; }

                // Import JSON button
                Rectangle {
                    height: 32px;
                    background: import-touch.has-hover ? (dark-mode ? #2a2a2a : #f0f0f0) : transparent;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: dark-mode ? #3a3a3a : #e0e0e0;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: "Import JSON";
                            color: dark-mode ? #888888 : #666666;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }

                    import-touch := TouchArea {
                        clicked => { root.import-json(); }
                    }
                }

                Rectangle { height: 4px; }

                // Export JSON button
                Rectangle {
                    height: 32px;
                    background: export-json-touch.has-hover ? #1a9a9a : (dark-mode ? #2a9a9a : #1a9a9a);
                    border-radius: 6px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: "Export JSON";
                            color: #ffffff;
                            font-size: 13px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }

                    export-json-touch := TouchArea {
                        clicked => { root.export-json(); }
                    }
                }

                Rectangle { height: 4px; }
            }
        }

        // Main editing area
        main-area := Rectangle {
            property <bool> splitter-dragging: false;
            property <length> drag-start-total-width;

            HorizontalLayout {
                spacing: 0px;

                // Preview panel
                preview-panel := Rectangle {
                    horizontal-stretch: 1;
                    background: dark-mode ? #1a1a1a : #f5f5f5;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        // Header
                        Text {
                            text: "Preview";
                            color: dark-mode ? #888888 : #666666;
                            font-size: 11px;
                            font-weight: 600;
                        }

                        // Preview content - mock dialog
                        Rectangle {
                            vertical-stretch: 1;
                            horizontal-stretch: 1;
                            background: dark-mode ? #242424 : #ffffff;
                            border-radius: 8px;

                            preview-card := Rectangle {
                                x: 16px;
                                y: 16px;
                                width: parent.width - 32px;
                                height: parent.height - 32px;
                                background: dark-mode ? #2a2a2a : #ffffff;
                                border-radius: token-radius-lg * 1px;
                                border-width: 1px;
                                border-color: dark-mode ? #3a3a3a : #e0e0e0;
                                clip: true;
                                drop-shadow-blur: 20px;
                                drop-shadow-color: #00000022;
                                drop-shadow-offset-y: 4px;

                                Flickable {
                                    width: parent.width;
                                    height: parent.height;
                                    viewport-width: preview-content.preferred-width;
                                    viewport-height: preview-content.preferred-height;

                                    preview-content := VerticalLayout {
                                        padding: token-spacing-lg * 1px;
                                        spacing: token-spacing-md * 1px;

                                        Text {
                                            text: "Live Component Matrix";
                                            color: dark-mode ? #ffffff : token-text;
                                            font-family: root.token-font-primary;
                                            font-size: 18px;
                                            font-weight: 600;
                                        }

                                        Text {
                                            text: "Edit the theme props on the right and compare every size and variant for the selected component here.";
                                            color: dark-mode ? #aaaaaa : token-text-muted;
                                            font-family: root.token-font-secondary;
                                            font-size: 14px;
                                            wrap: word-wrap;
                                        }

                                        Text {
                                            text: "Secondary text uses Font.secondary so subheads and descriptions are easy to evaluate.";
                                            color: dark-mode ? #d8d8d8 : token-text;
                                            font-family: root.token-font-secondary;
                                            font-size: token-font-size-md * 1px;
                                            wrap: word-wrap;
                                        }

                                        Text {
                                            text: "Tertiary note: metadata, helper copy, and captions can use Font.tertiary.";
                                            color: dark-mode ? #9a9a9a : token-text-muted;
                                            font-family: root.token-font-tertiary;
                                            font-size: token-font-size-sm * 1px;
                                            font-weight: 500;
                                            wrap: word-wrap;
                                        }

                                        if root.state-list.length > 1 && root.selected-component-key != "icon": VerticalLayout {
                                            spacing: 8px;

                                            Text {
                                                text: "Preview State";
                                                color: dark-mode ? #aaaaaa : token-text-muted;
                                                font-family: root.token-font-secondary;
                                                font-size: 12px;
                                                font-weight: 600;
                                            }

                                            SegmentedControl {
                                                width: 620px;
                                                size: ControlSize.sm;
                                                options: root.state-name-list;
                                                selected-index <=> root.preview-state-index;
                                            }
                                        }

                                        Rectangle { height: 4px; }

                                        Text {
                                            text: root.selected-component-name + " Variants";
                                            color: dark-mode ? #ffffff : token-text;
                                            font-family: root.token-font-primary;
                                            font-size: 15px;
                                            font-weight: 600;
                                        }

                                        Text {
                                            text: "Sizes run across the top, variants down the left, and each cell renders the real component with the active theme.";
                                            color: dark-mode ? #aaaaaa : token-text-muted;
                                            font-family: root.token-font-secondary;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }

                                        Rectangle { height: 4px; }

                                        HorizontalLayout {
                                            spacing: 12px;

                                            Rectangle {
                                                width: root.preview-grid-label-width;
                                                height: 24px;
                                            }

                                            for size in root.size-list: Rectangle {
                                                width: root.preview-grid-cell-width;
                                                height: 24px;

                                                Text {
                                                    text: size.name;
                                                    color: dark-mode ? #aaaaaa : token-text-muted;
                                                    font-family: root.token-font-secondary;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        for variant in root.variant-list: HorizontalLayout {
                                            spacing: 12px;

                                            Rectangle {
                                                width: root.preview-grid-label-width;
                                                height: root.preview-grid-cell-height;

                                                Text {
                                                    text: variant.name;
                                                    color: dark-mode ? #d8d8d8 : token-text;
                                                    font-family: root.token-font-secondary;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            for size in root.size-list: ThemePreviewCell {
                                                width: root.preview-grid-cell-width;
                                                height: root.preview-grid-cell-height;
                                                component-key: root.selected-component-key;
                                                variant-key: variant.key;
                                                size-key: size.key;
                                                preview-state-key: root.preview-state-key;
                                                dark-mode: root.dark-mode;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Splitter handle
                Rectangle {
                    width: 6px;
                    background: main-area.splitter-dragging || splitter-touch.has-hover ?
                        (dark-mode ? #3a3a3a : #d0d0d0) :
                        (dark-mode ? #2a2a2a : #e0e0e0);

                    Rectangle {
                        x: 2px;
                        y: (parent.height - 40px) / 2;
                        width: 2px;
                        height: 40px;
                        border-radius: 1px;
                        background: main-area.splitter-dragging ? #1a9a9a :
                            (dark-mode ? #444444 : #bbbbbb);
                    }

                    splitter-touch := TouchArea {
                        mouse-cursor: col-resize;

                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                main-area.splitter-dragging = true;
                                main-area.drag-start-total-width = preview-panel.width + root.settings-panel-width;
                            }
                            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                main-area.splitter-dragging = false;
                            }
                        }

                        moved => {
                            if (self.pressed) {
                                root.settings-panel-width = clamp(
                                    root.settings-panel-width - (self.mouse-x - self.pressed-x),
                                    250px,
                                    main-area.drag-start-total-width - 250px
                                );
                            }
                        }
                    }
                }

                // Settings panel
                Rectangle {
                    width: root.settings-panel-width;
                    background: dark-mode ? #242424 : #ffffff;
                    clip: true;

                    Flickable {
                        viewport-height: settings-content.preferred-height;

                        settings-content := VerticalLayout {
                            padding: 16px;
                            spacing: 4px;

                            // Header with parent selector and reset
                            HorizontalLayout {
                                spacing: 8px;

                                Text {
                                    text: dark-mode ? "Theme Settings: Dark" : "Theme Settings: Light";
                                    color: dark-mode ? #ffffff : #1a1a1a;
                                    font-size: 14px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Rectangle {
                                    width: reset-text.preferred-width + 16px;
                                    height: 24px;
                                    background: reset-touch.has-hover ? (dark-mode ? #2a2a2a : #f0f0f0) : transparent;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: dark-mode ? #3a3a3a : #e0e0e0;

                                    reset-text := Text {
                                        x: (parent.width - self.preferred-width) / 2;
                                        y: (parent.height - self.preferred-height) / 2;
                                        text: "Reset All";
                                        color: dark-mode ? #888888 : #666666;
                                        font-size: 11px;
                                    }

                                    reset-touch := TouchArea {
                                        // TODO: Reset all overrides
                                    }
                                }
                            }

                            Rectangle { height: 8px; }

                            // Theme name editor
                            HorizontalLayout {
                                height: 24px;
                                spacing: 8px;

                                Text {
                                    text: "Theme Name";
                                    color: dark-mode ? #888888 : #666666;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Rectangle {
                                    width: 140px;
                                    height: 22px;
                                    background: transparent;

                                    theme-name-input := EditorTextField {
                                        width: parent.width;
                                        height: parent.height;
                                        dark-mode: root.dark-mode;
                                        text: root.theme-list.length > root.selected-theme ? root.theme-list[root.selected-theme].name : "";
                                        field-height: parent.height;
                                        text-font-size: 11px;
                                        text-padding-left: 8px;
                                        text-padding-right: 8px;
                                        field-background: dark-mode ? #1a1a1a : #f0f0f0;
                                        focused-border-width: 1px;
                                        unfocused-border-width: 0px;
                                        unfocused-border-color: transparent;

                                        accepted(value) => {
                                            root.rename-theme(value);
                                        }

                                        edited(value) => {
                                            root.rename-theme(value);
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 8px; }

                            // Parent theme selector (Default Theme has no parent)
                            if selected-theme != 0: EnumSelector {
                                label: "Parent Theme";
                                dark-mode: root.dark-mode;
                                selector-width: 140px;
                                // Options: all themes except the current one
                                options: selected-theme == 1 ? ["Default Theme", "Verdant Theme", "Sunset Serif", "Signal Mono"] :
                                         selected-theme == 2 ? ["Default Theme", "My Custom Theme", "Sunset Serif", "Signal Mono"] :
                                         selected-theme == 3 ? ["Default Theme", "My Custom Theme", "Verdant Theme", "Signal Mono"] :
                                         ["Default Theme", "My Custom Theme", "Verdant Theme", "Sunset Serif"];
                                selected-index: 0;  // Default to inheriting from Default Theme
                            }

                            // Show "No parent" label for Default Theme
                            if selected-theme == 0: HorizontalLayout {
                                height: 24px;
                                spacing: 8px;

                                Text {
                                    text: "Parent Theme";
                                    color: dark-mode ? #888888 : #666666;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: "(Base theme)";
                                    color: dark-mode ? #666666 : #999999;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle { height: 12px; }

                            // TOKENS section
                            tokens-header := TreeSectionHeader {
                                title: "TOKENS";
                                dark-mode: root.dark-mode;
                            }

                            if tokens-header.expanded: VerticalLayout {
                                padding-left: 8px;
                                spacing: 4px;

                                // Colors subsection
                                colors-header := TreeSectionHeader {
                                    title: "Colors";
                                    dark-mode: root.dark-mode;
                                }

                                if colors-header.expanded: VerticalLayout {
                                    padding-left: 20px;
                                    padding-top: 4px;
                                    padding-bottom: 8px;
                                    spacing: 6px;

                                    // ===== LIGHT MODE TOKEN EDITORS =====
                                    if !root.dark-mode: ColorRow {
                                        label: "primary";
                                        dark-mode: root.dark-mode;
                                        value <=> light-token-primary;
                                        default-value: #1a9a9a;
                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                        format-hex(c) => { return root.format-hex-color(c); }
                                        value-changed(c) => { root.token-value-changed("primary", c, false); }
                                    }

                                    if !root.dark-mode: ColorRow {
                                        label: "primary-pressed";
                                        dark-mode: root.dark-mode;
                                        value <=> light-token-primary-pressed;
                                        default-value: #158080;
                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                        format-hex(c) => { return root.format-hex-color(c); }
                                        value-changed(c) => { root.token-value-changed("primary-pressed", c, false); }
                                    }

                                    if !root.dark-mode: ColorRow {
                                        label: "secondary";
                                        dark-mode: root.dark-mode;
                                        value <=> light-token-secondary;
                                        default-value: #e8e4df;
                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                        format-hex(c) => { return root.format-hex-color(c); }
                                        value-changed(c) => { root.token-value-changed("secondary", c, false); }
                                    }

                                    if !root.dark-mode: ColorRow {
                                        label: "danger";
                                        dark-mode: root.dark-mode;
                                        value <=> light-token-danger;
                                        default-value: #dc2626;
                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                        format-hex(c) => { return root.format-hex-color(c); }
                                        value-changed(c) => { root.token-value-changed("danger", c, false); }
                                    }

                                    if !root.dark-mode: ColorRow {
                                        label: "surface";
                                        dark-mode: root.dark-mode;
                                        value <=> light-token-surface;
                                        default-value: #ffffff;
                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                        format-hex(c) => { return root.format-hex-color(c); }
                                        value-changed(c) => { root.token-value-changed("surface", c, false); }
                                    }

                                    if !root.dark-mode: ColorRow {
                                        label: "background";
                                        dark-mode: root.dark-mode;
                                        value <=> light-token-background;
                                        default-value: #ffffff;
                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                        format-hex(c) => { return root.format-hex-color(c); }
                                        value-changed(c) => { root.token-value-changed("background", c, false); }
                                    }

                                    if !root.dark-mode: ColorRow {
                                        label: "text";
                                        dark-mode: root.dark-mode;
                                        value <=> light-token-text;
                                        default-value: #1a1a1a;
                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                        format-hex(c) => { return root.format-hex-color(c); }
                                        value-changed(c) => { root.token-value-changed("text", c, false); }
                                    }

                                    if !root.dark-mode: ColorRow {
                                        label: "text-muted";
                                        dark-mode: root.dark-mode;
                                        value <=> light-token-text-muted;
                                        default-value: #6b6b6b;
                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                        format-hex(c) => { return root.format-hex-color(c); }
                                        value-changed(c) => { root.token-value-changed("text-muted", c, false); }
                                    }

                                    // ===== DARK MODE TOKEN EDITORS =====
                                    if root.dark-mode: ColorRow {
                                        label: "primary";
                                        dark-mode: root.dark-mode;
                                        value <=> dark-token-primary;
                                        default-value: #2abaaa;
                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                        format-hex(c) => { return root.format-hex-color(c); }
                                        value-changed(c) => { root.token-value-changed("primary", c, true); }
                                    }

                                    if root.dark-mode: ColorRow {
                                        label: "primary-pressed";
                                        dark-mode: root.dark-mode;
                                        value <=> dark-token-primary-pressed;
                                        default-value: #1a9a9a;
                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                        format-hex(c) => { return root.format-hex-color(c); }
                                        value-changed(c) => { root.token-value-changed("primary-pressed", c, true); }
                                    }

                                    if root.dark-mode: ColorRow {
                                        label: "secondary";
                                        dark-mode: root.dark-mode;
                                        value <=> dark-token-secondary;
                                        default-value: #3a3a3a;
                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                        format-hex(c) => { return root.format-hex-color(c); }
                                        value-changed(c) => { root.token-value-changed("secondary", c, true); }
                                    }

                                    if root.dark-mode: ColorRow {
                                        label: "danger";
                                        dark-mode: root.dark-mode;
                                        value <=> dark-token-danger;
                                        default-value: #ef4444;
                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                        format-hex(c) => { return root.format-hex-color(c); }
                                        value-changed(c) => { root.token-value-changed("danger", c, true); }
                                    }

                                    if root.dark-mode: ColorRow {
                                        label: "surface";
                                        dark-mode: root.dark-mode;
                                        value <=> dark-token-surface;
                                        default-value: #1e1e1e;
                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                        format-hex(c) => { return root.format-hex-color(c); }
                                        value-changed(c) => { root.token-value-changed("surface", c, true); }
                                    }

                                    if root.dark-mode: ColorRow {
                                        label: "background";
                                        dark-mode: root.dark-mode;
                                        value <=> dark-token-background;
                                        default-value: #121212;
                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                        format-hex(c) => { return root.format-hex-color(c); }
                                        value-changed(c) => { root.token-value-changed("background", c, true); }
                                    }

                                    if root.dark-mode: ColorRow {
                                        label: "text";
                                        dark-mode: root.dark-mode;
                                        value <=> dark-token-text;
                                        default-value: #fafafa;
                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                        format-hex(c) => { return root.format-hex-color(c); }
                                        value-changed(c) => { root.token-value-changed("text", c, true); }
                                    }

                                    if root.dark-mode: ColorRow {
                                        label: "text-muted";
                                        dark-mode: root.dark-mode;
                                        value <=> dark-token-text-muted;
                                        default-value: #9a9a9a;
                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                        format-hex(c) => { return root.format-hex-color(c); }
                                        value-changed(c) => { root.token-value-changed("text-muted", c, true); }
                                    }
                                }

                                // Spacing subsection
                                spacing-header := TreeSectionHeader {
                                    title: "Spacing";
                                    dark-mode: root.dark-mode;
                                }

                                if spacing-header.expanded: VerticalLayout {
                                    padding-left: 20px;
                                    padding-top: 4px;
                                    padding-bottom: 8px;
                                    spacing: 6px;

                                    NumberInput {
                                        label: "xs";
                                        dark-mode: root.dark-mode;
                                        value <=> token-spacing-xs;
                                        min-value: 0; max-value: 16; step: 1;
                                        default-value: 4;
                                    }

                                    NumberInput {
                                        label: "sm";
                                        dark-mode: root.dark-mode;
                                        value <=> token-spacing-sm;
                                        min-value: 0; max-value: 24; step: 2;
                                        default-value: 8;
                                    }

                                    NumberInput {
                                        label: "md";
                                        dark-mode: root.dark-mode;
                                        value <=> token-spacing-md;
                                        min-value: 0; max-value: 48; step: 4;
                                        default-value: 12;
                                    }

                                    NumberInput {
                                        label: "lg";
                                        dark-mode: root.dark-mode;
                                        value <=> token-spacing-lg;
                                        min-value: 0; max-value: 64; step: 4;
                                        default-value: 16;
                                    }

                                    NumberInput {
                                        label: "xl";
                                        dark-mode: root.dark-mode;
                                        value <=> token-spacing-xl;
                                        min-value: 0; max-value: 96; step: 8;
                                        default-value: 24;
                                    }
                                }

                                control-scale-header := TreeSectionHeader {
                                    title: "Control Scale";
                                    dark-mode: root.dark-mode;
                                }

                                if control-scale-header.expanded: VerticalLayout {
                                    padding-left: 20px;
                                    padding-top: 4px;
                                    padding-bottom: 8px;
                                    spacing: 6px;

                                    NumberInput {
                                        label: "control-size-sm";
                                        dark-mode: root.dark-mode;
                                        value <=> token-control-size-sm;
                                        min-value: 0; max-value: 160; step: 1;
                                        default-value: 48;
                                    }

                                    NumberInput {
                                        label: "control-size-md";
                                        dark-mode: root.dark-mode;
                                        value <=> token-control-size-md;
                                        min-value: 0; max-value: 160; step: 1;
                                        default-value: 56;
                                    }

                                    NumberInput {
                                        label: "control-size-lg";
                                        dark-mode: root.dark-mode;
                                        value <=> token-control-size-lg;
                                        min-value: 0; max-value: 160; step: 1;
                                        default-value: 64;
                                    }

                                    NumberInput {
                                        label: "icon-size-sm";
                                        dark-mode: root.dark-mode;
                                        value <=> token-icon-size-sm;
                                        min-value: 0; max-value: 64; step: 1;
                                        default-value: 20;
                                    }

                                    NumberInput {
                                        label: "icon-size-md";
                                        dark-mode: root.dark-mode;
                                        value <=> token-icon-size-md;
                                        min-value: 0; max-value: 64; step: 1;
                                        default-value: 24;
                                    }

                                    NumberInput {
                                        label: "icon-size-lg";
                                        dark-mode: root.dark-mode;
                                        value <=> token-icon-size-lg;
                                        min-value: 0; max-value: 64; step: 1;
                                        default-value: 28;
                                    }

                                    NumberInput {
                                        label: "control-radius-sm";
                                        dark-mode: root.dark-mode;
                                        value <=> token-control-radius-sm;
                                        min-value: 0; max-value: 64; step: 1;
                                        default-value: 20;
                                    }

                                    NumberInput {
                                        label: "control-radius-md";
                                        dark-mode: root.dark-mode;
                                        value <=> token-control-radius-md;
                                        min-value: 0; max-value: 64; step: 1;
                                        default-value: 24;
                                    }

                                    NumberInput {
                                        label: "control-radius-lg";
                                        dark-mode: root.dark-mode;
                                        value <=> token-control-radius-lg;
                                        min-value: 0; max-value: 64; step: 1;
                                        default-value: 28;
                                    }

                                    NumberInput {
                                        label: "control-padding-inline-sm";
                                        dark-mode: root.dark-mode;
                                        value <=> token-control-padding-inline-sm;
                                        min-value: 0; max-value: 64; step: 1;
                                        default-value: 14;
                                    }

                                    NumberInput {
                                        label: "control-padding-inline-md";
                                        dark-mode: root.dark-mode;
                                        value <=> token-control-padding-inline-md;
                                        min-value: 0; max-value: 64; step: 1;
                                        default-value: 16;
                                    }

                                    NumberInput {
                                        label: "control-padding-inline-lg";
                                        dark-mode: root.dark-mode;
                                        value <=> token-control-padding-inline-lg;
                                        min-value: 0; max-value: 64; step: 1;
                                        default-value: 20;
                                    }
                                }

                                // Typography subsection
                                typography-header := TreeSectionHeader {
                                    title: "Typography";
                                    dark-mode: root.dark-mode;
                                }

                                if typography-header.expanded: VerticalLayout {
                                    padding-left: 20px;
                                    padding-top: 4px;
                                    padding-bottom: 8px;
                                    spacing: 6px;

                                    NumberInput {
                                        label: "font-size-sm";
                                        dark-mode: root.dark-mode;
                                        value <=> token-font-size-sm;
                                        min-value: 8; max-value: 32; step: 1;
                                        default-value: 20;
                                    }

                                    NumberInput {
                                        label: "font-size-md";
                                        dark-mode: root.dark-mode;
                                        value <=> token-font-size-md;
                                        min-value: 8; max-value: 36; step: 1;
                                        default-value: 22;
                                    }

                                    NumberInput {
                                        label: "font-size-lg";
                                        dark-mode: root.dark-mode;
                                        value <=> token-font-size-lg;
                                        min-value: 8; max-value: 40; step: 1;
                                        default-value: 24;
                                    }

                                    EnumRow {
                                        label: "Font.primary";
                                        dark-mode: root.dark-mode;
                                        options: root.actual-font-options;
                                        default-index: 0;
                                        selected-index <=> token-font-primary-index;
                                        selector-width: 140px;
                                    }

                                    EnumRow {
                                        label: "Font.secondary";
                                        dark-mode: root.dark-mode;
                                        options: root.actual-font-options;
                                        default-index: 0;
                                        selected-index <=> token-font-secondary-index;
                                        selector-width: 140px;
                                    }

                                    EnumRow {
                                        label: "Font.tertiary";
                                        dark-mode: root.dark-mode;
                                        options: root.actual-font-options;
                                        default-index: 0;
                                        selected-index <=> token-font-tertiary-index;
                                        selector-width: 140px;
                                    }
                                }

                                // Radius subsection
                                radius-header := TreeSectionHeader {
                                    title: "Radius";
                                    dark-mode: root.dark-mode;
                                }

                                if radius-header.expanded: VerticalLayout {
                                    padding-left: 20px;
                                    padding-top: 4px;
                                    padding-bottom: 8px;
                                    spacing: 6px;

                                    NumberInput {
                                        label: "sm";
                                        dark-mode: root.dark-mode;
                                        value <=> token-radius-sm;
                                        min-value: 0; max-value: 24; step: 1;
                                        default-value: 8;
                                    }

                                    NumberInput {
                                        label: "md";
                                        dark-mode: root.dark-mode;
                                        value <=> token-radius-md;
                                        min-value: 0; max-value: 32; step: 2;
                                        default-value: 16;
                                    }

                                    EnumRow {
                                        label: "default";
                                        dark-mode: root.dark-mode;
                                        options: ["sm", "md", "lg", "full"];
                                        default-index: 2;
                                        selected-index <=> token-radius-default-index;
                                        selector-width: 120px;
                                    }

                                    NumberInput {
                                        label: "lg";
                                        dark-mode: root.dark-mode;
                                        value <=> token-radius-lg;
                                        min-value: 0; max-value: 40; step: 2;
                                        default-value: 24;
                                    }

                                    NumberInput {
                                        label: "full";
                                        dark-mode: root.dark-mode;
                                        value <=> token-radius-full;
                                        min-value: 0; max-value: 9999; step: 100;
                                        default-value: 9999;
                                    }
                                }
                            }

                            Rectangle { height: 8px; }

                            // COMPONENTS section
                            components-header := TreeSectionHeader {
                                title: "COMPONENTS";
                                dark-mode: root.dark-mode;
                            }

                            if components-header.expanded: VerticalLayout {
                                padding-left: 8px;
                                spacing: 4px;

                                Dropdown {
                                    label: "Component";
                                    size: ControlSize.sm;
                                    options: root.component-name-list;
                                    selected-index <=> root.selected-component-index;
                                    placeholder: "Select component";
                                    max-visible-items: 8;
                                    changed(index, _label) => {
                                        if index >= 0 && index < root.component-list.length {
                                            root.selected-component-index = index;
                                            root.component-theme-selected(root.component-list[index].key);
                                        }
                                    }
                                }

                                if root.size-prop-defs.length > 0: VerticalLayout {
                                    padding-left: 12px;
                                    padding-top: 4px;
                                    padding-bottom: 8px;
                                    spacing: 4px;

                                    component-sizes-header := TreeSectionHeader {
                                        title: "Sizes";
                                        dark-mode: root.dark-mode;
                                    }

                                    if component-sizes-header.expanded: VerticalLayout {
                                        padding-left: 12px;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 4px;

                                            Text {
                                                text: "Edit Size";
                                                color: root.dark-mode ? #888888 : #666666;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                width: RowLayout.label-width;
                                            }

                                            CompactDropdownSelector {
                                                dark-mode: root.dark-mode;
                                                options: root.size-name-list;
                                                selector-width: 132px;
                                                fill: true;
                                                selected-index <=> root.component-selected-size;
                                                changed selected-index => {
                                                    root.btn-size-changed(self.selected-index);
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            padding-left: 8px;
                                            padding-top: 4px;
                                            spacing: 0px;

                                            for prop[prop-index] in root.size-prop-defs: Rectangle {
                                                clip: true;

                                                size-prop-editor := GenericSizePropEditor {
                                                    visible: prop-index < root.current-size-values.length;
                                                    dark-mode: root.dark-mode;
                                                    prop-def: prop;
                                                    prop-value: prop-index < root.current-size-values.length ? root.current-size-values[prop-index] : {
                                                        color-value: #000000,
                                                        float-value: 0,
                                                        int-value: 0,
                                                        bool-value: false,
                                                        string-value: "",
                                                        is-overridden: false,
                                                        is-token-mode: false,
                                                        selected-token: 0,
                                                        selected-actual-index: 0,
                                                    };
                                                    sync-version: root.size-values-version;
                                                    font-token-options: root.font-token-options;
                                                    font-token-values: [root.token-font-primary, root.token-font-secondary, root.token-font-tertiary];
                                                    actual-font-options: root.actual-font-options;
                                                    number-token-options: root.number-token-options;
                                                    number-token-values: root.number-token-values;
                                                    check-float-equal(v, d) => { return root.check-float-equal(v, d); }
                                                    value-changed(val) => {
                                                        root.size-prop-changed(root.active-size-index, prop-index, val);
                                                    }
                                                }

                                                height: size-prop-editor.visible ? size-prop-editor.height : 0px;
                                            }
                                        }
                                    }
                                }

                                if root.variant-prop-defs.length > 0: VerticalLayout {
                                    padding-left: 12px;
                                    spacing: 4px;

                                    component-variants-header := TreeSectionHeader {
                                        title: "Variants";
                                        dark-mode: root.dark-mode;
                                    }

                                    if component-variants-header.expanded: VerticalLayout {
                                        padding-left: 12px;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 4px;

                                            Text {
                                                text: "Edit Variant";
                                                color: root.dark-mode ? #888888 : #666666;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                width: RowLayout.label-width;
                                            }

                                            CompactDropdownSelector {
                                                dark-mode: root.dark-mode;
                                                options: root.variant-name-list;
                                                selector-width: 148px;
                                                fill: true;
                                                selected-index <=> root.component-selected-variant;
                                                changed selected-index => {
                                                    root.btn-variant-changed(self.selected-index);
                                                }
                                            }
                                        }

                                        for state[state-index] in root.state-list: VerticalLayout {
                                            state-header := TreeSectionHeader {
                                                title: state.name + " State";
                                                dark-mode: root.dark-mode;
                                                expanded: state-index == 0;
                                            }

                                            if state-header.expanded: VerticalLayout {
                                                padding-left: 20px;
                                                padding-top: 4px;
                                                padding-bottom: 4px;
                                                spacing: 0px;

                                                for prop[prop-index] in root.variant-prop-defs: Rectangle {
                                                    property <int> value-index: state-index * root.variant-prop-defs.length + prop-index;
                                                    clip: true;

                                                    variant-prop-editor := GenericVariantPropEditor {
                                                        visible: value-index < root.current-variant-values.length;
                                                        dark-mode: root.dark-mode;
                                                        prop-def: prop;
                                                        prop-value: value-index < root.current-variant-values.length ? root.current-variant-values[value-index] : {
                                                            color-value: #000000,
                                                            float-value: 0,
                                                            int-value: 0,
                                                            bool-value: false,
                                                            string-value: "",
                                                            is-overridden: false,
                                                            is-token-mode: false,
                                                            selected-token: 0,
                                                            selected-actual-index: 0,
                                                        };
                                                        sync-version: root.variant-values-version;
                                                        parse-hex(hex) => { return root.parse-hex-color(hex); }
                                                        format-hex(color) => { return root.format-hex-color(color); }
                                                        check-color-equal(value, default) => { return root.check-color-equal(value, default); }
                                                        check-float-equal(value, default) => { return root.check-float-equal(value, default); }
                                                        value-changed(val) => {
                                                            root.variant-prop-changed(state-index, prop-index, val);
                                                        }
                                                    }

                                                    height: variant-prop-editor.visible ? variant-prop-editor.height : 0px;
                                                }
                                            }
                                        }
                                    }
                                }

                                if root.variant-prop-defs.length == 0 && root.size-prop-defs.length == 0: Rectangle {
                                    height: 28px;

                                    Text {
                                        y: (parent.height - self.preferred-height) / 2;
                                        text: "No editable theme props are defined for this component yet.";
                                        color: dark-mode ? #666666 : #999999;
                                        font-size: 11px;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component ThemeTokenPanel inherits Rectangle {
    in property <bool> dark-mode;
    callback parse-hex-color(string) -> color;
    callback format-hex-color(color) -> string;
    callback token-value-changed(string, color, bool);
    callback theme-tokens-edited();

    in-out property <color> light-token-primary: #1a9a9a;
    in-out property <color> light-token-primary-pressed: #158080;
    in-out property <color> light-token-secondary: #e8e4df;
    in-out property <color> light-token-danger: #dc2626;
