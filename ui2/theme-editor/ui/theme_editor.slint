// Shared label-column WIDTH (px) for every theme-editor row, so labels and
// controls line up in two columns. Each row gives its label this fixed width and
// lets the control column fill the rest, so every control starts at the same x.
// The splitter drives label-width.
export global RowLayout {
    in-out property <length> label-width: 150px;
}

// Reusable right-sidebar frame shared by the Theme, Props, and Tokens editors:
// a flush white panel with an optional fixed header band (mode selector + title)
// and 1px divider, a scrolling body that top-aligns its rows and never scrolls or
// centers horizontally, plus the draggable label/value column splitter. The rows
// for each view are passed as @children.
export component SidebarPanel inherits Rectangle {
    in property <bool> dark-mode;
    // Header band (omitted entirely when there is neither a selector nor a title).
    in property <bool> show-mode-selector: false;
    in property <[string]> mode-options: [];
    in-out property <int> mode-index: 0;
    callback mode-changed(int);
    in property <string> title: "";
    // Column splitter: sits at splitter-base-x + RowLayout.label-width (the label
    // column's right edge). base-x = body padding (16) + the rows' section indent.
    in property <bool> show-splitter: true;
    in property <length> splitter-base-x: 28px;
    property <bool> label-col-dragging: false;
    property <bool> has-header: root.show-mode-selector || root.title != "";

    background: dark-mode ? #242424 : #ffffff;
    clip: true;

    VerticalLayout {
        // Fixed header band (does not scroll). vertical-stretch: 0 pins it to its
        // content height (a nested layout otherwise defaults to stretch 1).
        if root.has-header: VerticalLayout {
            vertical-stretch: 0;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 16px;
            padding-bottom: 8px;
            spacing: 8px;

            if root.show-mode-selector: Rectangle {
                horizontal-stretch: 1;
                height: mode-sel.preferred-height;
                background: transparent;

                mode-sel := SegmentedControl {
                    width: parent.width;
                    size: ControlSize.sm;
                    options: root.mode-options;
                    selected-index <=> root.mode-index;
                    changed(index, _label) => {
                        root.mode-changed(index);
                    }
                }
            }

            if root.title != "": Text {
                text: root.title;
                color: dark-mode ? #ffffff : #1a1a1a;
                font-size: 14px;
                font-weight: 600;
            }
        }

        if root.has-header: Rectangle {
            vertical-stretch: 0;
            height: 1px;
            background: dark-mode ? #333333 : #ededed;
        }

        // Scrolling body. vertical-stretch makes it take the height left after the
        // header; the Flickable pins viewport-width (no h-scroll/centering) and
        // fills at least the visible height so content top-aligns with slack below.
        sidebar-body := Rectangle {
            vertical-stretch: 1;
            clip: true;

            Flickable {
                viewport-width: self.width;
                viewport-height: max(self.height, sidebar-content.preferred-height);

                sidebar-content := VerticalLayout {
                    width: parent.width;
                    padding: 16px;
                    spacing: 8px;
                    alignment: start;

                    @children
                }
            }
        }
    }

    // Draggable label/value column splitter, confined to the body band.
    if root.show-splitter: Rectangle {
        x: root.splitter-base-x + RowLayout.label-width;
        y: sidebar-body.y;
        width: 2px;
        height: sidebar-body.height;
        background: root.label-col-dragging || label-col-splitter-touch.has-hover
            ? #1a9a9a
            : (dark-mode ? #333333 : #ededed);

        label-col-splitter-touch := TouchArea {
            x: -6px;
            width: 14px;
            height: parent.height;
            mouse-cursor: col-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.label-col-dragging = true;
                }
                if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.label-col-dragging = false;
                }
            }
            moved => {
                if (self.pressed) {
                    RowLayout.label-width = clamp(
                        RowLayout.label-width + (self.mouse-x - self.pressed-x),
                        140px,
                        280px
                    );
                }
            }
        }
    }
}

// ===== EXPORTED STRUCTS FOR THEME DATA =====
// (The former hand-written ButtonStyleProps / ButtonSizeProps / ButtonStateTheme
// / ButtonStateOverrides structs were unused and have been removed; button
// styling now flows through the generated ButtonTheme global.)

// Theme info for sidebar display
export struct ThemeInfo {
    name: string,
    is-builtin: bool,  // Built-in themes cannot be deleted
}

export struct ThemeComponentInfo {
    name: string,
    key: string,
}

// ===== DYNAMIC PLUGIN MODEL STRUCTS =====

// Variant info for dynamic variant tabs
export struct VariantInfo {
    name: string,      // Display name (e.g., "Primary")
    key: string,       // Key for lookup (e.g., "primary")
}

// State info for dynamic state sections
export struct StateInfo {
    name: string,      // Display name (e.g., "Normal")
    key: string,       // Key for lookup (e.g., "normal")
}

// Size info for dynamic size tabs
export struct SizeInfo {
    name: string,      // Display name (e.g., "Small")
    key: string,       // Key for lookup (e.g., "small")
}

// Property definition for dynamic property editors
export struct PropertyDef {
    name: string,           // Property name (e.g., "background")
    display-name: string,   // Display name (e.g., "Background")
    prop-type: string,      // "color", "float", "int", "bool", "string"
    min-value: float,       // For numeric types
    max-value: float,       // For numeric types
    step: float,            // For numeric types
}

// Current value of a property (for binding to UI)
export struct PropertyValueData {
    color-value: color,     // For color properties
    float-value: float,     // For float/int properties
    int-value: int,         // For int properties (also stored in float-value)
    bool-value: bool,       // For bool properties
    string-value: string,   // For string properties
    is-overridden: bool,    // Whether this value differs from default
    is-token-mode: bool,    // Whether the value is currently token-backed
    selected-token: int,    // Selected token index for token-backed values
    selected-actual-index: int, // Selected direct font index for string values
}

// Simple icon button with desktop feedback
component ToolbarIconButton inherits Rectangle {
    in property <bool> dark-mode;
    in property <image> icon;
    callback clicked();

    width: 20px;
    height: 28px;
    border-radius: 4px;
    background: touch.has-hover ? (dark-mode ? #3a3a3a : #e0e0e0) : transparent;

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: icon;
        colorize: dark-mode ? #888888 : #666666;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Collapsible tree section header with optional eyeball toggle
export component TreeSectionHeader inherits Rectangle {
    in property <string> title;
    in property <bool> dark-mode;
    in-out property <bool> expanded: true;
    // Eyeball toggle: when true, shows eyeball icon for toggling show-all vs show-overridden-only
    in property <bool> has-visibility-toggle: false;
    in-out property <bool> show-all: true;  // true = show all props, false = show only overridden
    // Debug callback - reports when eye is toggled
    callback on-eye-toggle(bool);

    height: 28px;
    background: header-touch.has-hover ? (dark-mode ? #2a2a2a : #f0f0f0) : transparent;
    border-radius: 4px;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 8px;
        spacing: 4px;
        alignment: start;

        // Expand/collapse touch area (chevron + title)
        header-touch := TouchArea {
            horizontal-stretch: 1;
            clicked => {
                expanded = !expanded;
            }

            HorizontalLayout {
                spacing: 4px;

                // Chevron
                Rectangle {
                    width: 24px;
                    height: 28px;

                    Text {
                        x: (parent.width - self.preferred-width) / 2;
                        y: (parent.height - self.preferred-height) / 2;
                        text: expanded ? "▼" : "▶";
                        color: dark-mode ? #666666 : #999999;
                        font-size: 24px;
                    }
                }

                Text {
                    text: title;
                    color: dark-mode ? #cccccc : #444444;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        // Eyeball toggle button
        if has-visibility-toggle: ToolbarIconButton {
            dark-mode: root.dark-mode;
            icon: show-all ? @image-url("../../resources/icons/eye.svg") : @image-url("../../resources/icons/eye-off.svg");
            clicked => {
                show-all = !show-all;
                on-eye-toggle(show-all);
            }
        }
    }
}

// Theme item in sidebar
component ThemeItem inherits Rectangle {
    in property <string> name;
    in property <bool> selected;
    in property <bool> dark-mode;
    callback clicked();

    height: 32px;
    background: selected ? (dark-mode ? #1a9a9a : #1a9a9a) : touch.has-hover ? (dark-mode ? #2a2a2a : #f0f0f0) : transparent;
    border-radius: 6px;

    HorizontalLayout {
        padding-left: 28px;
        padding-right: 12px;

        Text {
            text: name;
            color: selected ? #ffffff : (dark-mode ? #cccccc : #444444);
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component ThemePreviewCell inherits Rectangle {
    in property <string> component-key;
    in property <string> variant-key;
    in property <string> size-key;
    in property <string> preview-state-key: "normal";
    in property <bool> dark-mode;
    in property <int> preview-version: 0;
    pure callback variant-prop(string, int) -> PropertyValueData;
    pure callback size-prop(string, int) -> PropertyValueData;

    pure function control-size() -> ControlSize {
        if root.size-key == "sm" || root.size-key == "small" {
            return ControlSize.sm;
        }
        if root.size-key == "lg" || root.size-key == "large" {
            return ControlSize.lg;
        }
        return ControlSize.md;
    }

    pure function button-size() -> ControlSize {
        if root.size-key == "sm" || root.size-key == "small" {
            return ControlSize.sm;
        }
        if root.size-key == "lg" || root.size-key == "large" {
            return ControlSize.lg;
        }
        return ControlSize.md;
    }

    pure function icon-button-size() -> IconButtonSize {
        if root.size-key == "sm" || root.size-key == "small" {
            return IconButtonSize.sm;
        }
        if root.size-key == "lg" || root.size-key == "large" {
            return IconButtonSize.lg;
        }
        return IconButtonSize.md;
    }

    pure function chip-size() -> ChipSize {
        if root.size-key == "sm" || root.size-key == "small" {
            return ChipSize.sm;
        }
        if root.size-key == "lg" || root.size-key == "large" {
            return ChipSize.lg;
        }
        return ChipSize.md;
    }

    pure function spinner-size() -> SpinnerSize {
        if root.size-key == "sm" || root.size-key == "small" {
            return SpinnerSize.sm;
        }
        if root.size-key == "lg" || root.size-key == "large" {
            return SpinnerSize.lg;
        }
        return SpinnerSize.md;
    }

    pure function choice-control-size() -> length {
        if root.size-key == "sm" || root.size-key == "small" {
            return 16px;
        }
        if root.size-key == "lg" || root.size-key == "large" {
            return 24px;
        }
        return 20px;
    }

    pure function default-slider-track-height() -> length {
        if root.size-key == "sm" || root.size-key == "small" {
            return 4px;
        }
        if root.size-key == "lg" || root.size-key == "large" {
            return 8px;
        }
        return 6px;
    }

    pure function slider-track-height() -> length {
        let
        prop = root.size-prop("track-height"
        , root.preview-version);
        return prop.is-overridden ? prop.float-value * 1px : root.default-slider-track-height();
    }

        pure function slider-thumb-size() -> length {
            let
            prop = root.size-prop("thumb-size"
            , root.preview-version);
        return prop.is-overridden ? prop.float-value * 1px : root.slider-track-height()
            * 2;
    
        
        
        
        
        }

        pure function button-variant() -> ButtonVariant {
        if root.variant-key == "secondary" { return ButtonVariant.secondary; }
        if root.variant-key == "tertiary" || root.variant-key == "outline" { return ButtonVariant.tertiary; }
        if root.variant-key == "ghost" { return ButtonVariant.ghost; }
        if root.variant-key == "danger" { return ButtonVariant.danger; }
        return ButtonVariant.primary;
    }

    pure function icon-button-variant() -> IconButtonVariant {
        if root.variant-key == "ghost" { return IconButtonVariant.ghost; }
        if root.variant-key == "outlined" { return IconButtonVariant.outlined; }
        return IconButtonVariant.default;
    }

    pure function chip-variant() -> ChipVariant {
        if root.variant-key == "outlined" { return ChipVariant.outlined; }
        if root.variant-key == "soft" { return ChipVariant.soft; }
        return ChipVariant.filled;
    }

    pure function input-variant() -> InputVariant {
        if root.variant-key == "filled" { return InputVariant.filled; }
        if root.variant-key == "outlined" { return InputVariant.outlined; }
        return InputVariant.default;
    }

    pure function textarea-variant() -> TextAreaVariant {
        if root.variant-key == "bordered" { return TextAreaVariant.bordered; }
        if root.variant-key == "faded" { return TextAreaVariant.faded; }
        return TextAreaVariant.flat;
    }

    pure function tabs-variant() -> TabsVariant {
        if root.variant-key == "bordered" { return TabsVariant.bordered; }
        if root.variant-key == "light" { return TabsVariant.light; }
        if root.variant-key == "underlined" { return TabsVariant.underlined; }
        return TabsVariant.solid;
    }

    pure function dialog-variant() -> DialogVariant {
        if root.variant-key == "danger" { return DialogVariant.danger; }
        return DialogVariant.default;
    }

    pure function toast-variant() -> ToastVariant {
        if root.variant-key == "success" { return ToastVariant.success; }
        if root.variant-key == "warning" { return ToastVariant.warning; }
        if root.variant-key == "error" { return ToastVariant.error; }
        return ToastVariant.default;
    }

    pure function progress-tone() -> ProgressBarTone {
        if root.variant-key == "default" { return ProgressBarTone.default; }
        if root.variant-key == "secondary" { return ProgressBarTone.secondary; }
        if root.variant-key == "success" { return ProgressBarTone.success; }
        if root.variant-key == "warning" { return ProgressBarTone.warning; }
        if root.variant-key == "danger" { return ProgressBarTone.danger; }
        return ProgressBarTone.primary;
    }

    pure function spinner-tone() -> SpinnerTone {
        if root.variant-key == "neutral" { return SpinnerTone.neutral; }
        if root.variant-key == "success" { return SpinnerTone.success; }
        if root.variant-key == "warning" { return SpinnerTone.warning; }
        if root.variant-key == "danger" { return SpinnerTone.danger; }
        return SpinnerTone.primary;
    }

    property <bool> preview-focused: root.preview-state-key == "focused";
    property <bool> preview-pressed: root.preview-state-key == "pressed";
    property <bool> preview-disabled: root.preview-state-key == "disabled";
    property <bool> preview-visited: root.preview-state-key == "visited";
    property <bool> preview-selected:
        root.preview-state-key == "selected" ||
        root.preview-state-key == "focused";
    property <bool> preview-confirmed:
        root.preview-state-key == "confirmed" ||
        root.preview-state-key == "pressed";
    property <[AccordionItemData]> accordion-items: [
        {
            title: "Authentication",
            subtitle: "Single sign-on and sessions",
            body: "Configure Google Workspace SSO and session length.",
            disabled: false,
        },
        {
            title: "Notifications",
            subtitle: "Email and mobile alerts",
            body: "Choose when the system sends reminders and summaries.",
            disabled: false,
        },
        {
            title: "Danger Zone",
            subtitle: "Archive or remove data",
            body: "These actions are permanent and require confirmation.",
            disabled: root.preview-disabled,
        },
    ];
    property <[bool]> accordion-expanded: [
        true,
        root.preview-focused || root.preview-pressed,
        false,
    ];

    clip: true;
    border-radius: 10px;
    border-width: 1px;
    border-color: dark-mode ? #383838 : #e4e4e4;
    background: dark-mode ? #1f1f1f : #fafafa;

    if root.component-key == "button": Rectangle {
        width: parent.width;
        height: parent.height;

        Button {
            x: (parent.width - self.preferred-width) / 2;
            y: (parent.height - self.preferred-height) / 2;
            text: "Button";
            variant: root.button-variant();
            size: root.button-size();
            force-focused: root.preview-focused;
            force-pressed: root.preview-pressed;
            disabled: root.preview-disabled;
            // Drive the preview from the edited component_themes (via the
            // variant-prop/size-prop callbacks), like every other component —
            // not from the ButtonTheme global, which the editor no longer pushes.
            background: root.variant-prop("background", root.preview-version).is-overridden ? root.variant-prop("background", root.preview-version).color-value : transparent;
            foreground: root.variant-prop("foreground", root.preview-version).is-overridden ? root.variant-prop("foreground", root.preview-version).color-value : transparent;
            border-color: root.variant-prop("borderColor", root.preview-version).is-overridden ? root.variant-prop("borderColor", root.preview-version).color-value : transparent;
            border-width: root.variant-prop("borderWidth", root.preview-version).is-overridden ? root.variant-prop("borderWidth", root.preview-version).float-value * 1px : 0px;
            font-weight: root.variant-prop("fontWeight", root.preview-version).is-overridden ? root.variant-prop("fontWeight", root.preview-version).int-value : 500;
            button-opacity: root.variant-prop("opacity", root.preview-version).is-overridden ? root.variant-prop("opacity", root.preview-version).float-value : 1.0;
            touch-expansion: root.variant-prop("touchExpansion", root.preview-version).is-overridden ? root.variant-prop("touchExpansion", root.preview-version).float-value * 1px : 0px;
            font-family: root.size-prop("fontFamily", root.preview-version).is-overridden ? root.size-prop("fontFamily", root.preview-version).string-value : "Montserrat";
            font-size: root.size-prop("fontSize", root.preview-version).is-overridden ? root.size-prop("fontSize", root.preview-version).float-value * 1px : 0px;
            padding-horizontal: root.size-prop("paddingH", root.preview-version).is-overridden ? root.size-prop("paddingH", root.preview-version).float-value * 1px : 0px;
            padding-vertical: root.size-prop("paddingV", root.preview-version).is-overridden ? root.size-prop("paddingV", root.preview-version).float-value * 1px : 0px;
            icon-size: root.size-prop("iconSize", root.preview-version).is-overridden ? root.size-prop("iconSize", root.preview-version).float-value * 1px : 0px;
            border-radius: root.size-prop("borderRadius", root.preview-version).is-overridden ? root.size-prop("borderRadius", root.preview-version).float-value * 1px : 0px;
            min-button-height: root.size-prop("minHeight", root.preview-version).is-overridden ? root.size-prop("minHeight", root.preview-version).float-value * 1px : 0px;
        }
    }

    if root.component-key == "icon_button": Rectangle {
        width: parent.width;
        height: parent.height;

        IconButton {
            x: (parent.width - self.preferred-width) / 2;
            y: (parent.height - self.preferred-height) / 2;
            icon: @image-url("../../resources/icons/star.svg");
            label: "Favorite";
            variant: root.icon-button-variant();
            size: root.icon-button-size();
            shape: root.variant-key == "outlined" ? IconButtonShape.square : IconButtonShape.circle;
            disabled: root.preview-disabled;
            background: root.variant-prop("background", root.preview-version).is-overridden ? root.variant-prop("background", root.preview-version).color-value : transparent;
            icon-color: root.variant-prop("icon-color", root.preview-version).is-overridden ? root.variant-prop("icon-color", root.preview-version).color-value : transparent;
            border-color: root.variant-prop("border-color", root.preview-version).is-overridden ? root.variant-prop("border-color", root.preview-version).color-value : transparent;
            border-width: root.size-prop("border-width", root.preview-version).is-overridden ? root.size-prop("border-width", root.preview-version).float-value * 1px : 0px;
            border-radius: root.size-prop("border-radius", root.preview-version).is-overridden ? root.size-prop("border-radius", root.preview-version).float-value * 1px : 0px;
            control-size: root.size-prop("control-size", root.preview-version).is-overridden ? root.size-prop("control-size", root.preview-version).float-value * 1px : 0px;
            icon-size: root.size-prop("icon-size", root.preview-version).is-overridden ? root.size-prop("icon-size", root.preview-version).float-value * 1px : 0px;
            button-opacity: root.variant-prop("button-opacity", root.preview-version).is-overridden ? root.variant-prop("button-opacity", root.preview-version).float-value : 1.0;
            touch-expansion: root.variant-prop("touch-expansion", root.preview-version).is-overridden ? root.variant-prop("touch-expansion", root.preview-version).float-value * 1px : 0px;
        }
    }

    if root.component-key == "icon": Rectangle {
        width: parent.width;
        height: parent.height;

        Icon {
            x: (parent.width - self.preferred-width) / 2;
            y: (parent.height - self.preferred-height) / 2;
            icon: @image-url("../../resources/icons/star.svg");
            size: root.control-size();
            icon-color: root.variant-prop("icon-color", root.preview-version).is-overridden ? root.variant-prop("icon-color", root.preview-version).color-value : transparent;
            icon-size: root.size-prop("icon-size", root.preview-version).is-overridden ? root.size-prop("icon-size", root.preview-version).float-value * 1px : 0px;
        }
    }

    if root.component-key == "chip": Rectangle {
        width: parent.width;
        height: parent.height;

        Chip {
            x: (parent.width - self.preferred-width) / 2;
            y: (parent.height - self.preferred-height) / 2;
            text: root.preview-disabled ? "Disabled" : "Chip";
            icon: @image-url("../../resources/icons/star.svg");
            variant: root.chip-variant();
            size: root.chip-size();
            selected: root.preview-selected;
            closable: !root.preview-disabled && root.variant-key == "outlined";
