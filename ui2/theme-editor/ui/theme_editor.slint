    in property <[string]> actual-font-options: ["Montserrat", "Arial", "Verdana", "Trebuchet MS", "Georgia", "Palatino", "Times New Roman", "Courier New", "Menlo", "Monaco"];

    changed token-font-primary-index => { root.token-font-primary = root.actual-font-options[root.token-font-primary-index]; }
    changed token-font-secondary-index => { root.token-font-secondary = root.actual-font-options[root.token-font-secondary-index]; }
    changed token-font-tertiary-index => { root.token-font-tertiary = root.actual-font-options[root.token-font-tertiary-index]; }
    changed token-spacing-xs => { root.theme-tokens-edited(); }
    changed token-spacing-sm => { root.theme-tokens-edited(); }
    changed token-spacing-md => { root.theme-tokens-edited(); }
    changed token-spacing-lg => { root.theme-tokens-edited(); }
    changed token-spacing-xl => { root.theme-tokens-edited(); }
    changed token-control-size-sm => { root.theme-tokens-edited(); }
    changed token-control-size-md => { root.theme-tokens-edited(); }
    changed token-control-size-lg => { root.theme-tokens-edited(); }
    changed token-icon-size-sm => { root.theme-tokens-edited(); }
    changed token-icon-size-md => { root.theme-tokens-edited(); }
    changed token-icon-size-lg => { root.theme-tokens-edited(); }
    changed token-control-radius-sm => { root.theme-tokens-edited(); }
    changed token-control-radius-md => { root.theme-tokens-edited(); }
    changed token-control-radius-lg => { root.theme-tokens-edited(); }
    changed token-control-padding-inline-sm => { root.theme-tokens-edited(); }
    changed token-control-padding-inline-md => { root.theme-tokens-edited(); }
    changed token-control-padding-inline-lg => { root.theme-tokens-edited(); }
    changed token-font-size-sm => { root.theme-tokens-edited(); }
    changed token-font-size-md => { root.theme-tokens-edited(); }
    changed token-font-size-lg => { root.theme-tokens-edited(); }
    changed token-font-primary => { root.theme-tokens-edited(); }
    changed token-font-secondary => { root.theme-tokens-edited(); }
    changed token-font-tertiary => { root.theme-tokens-edited(); }
    changed token-radius-sm => { root.theme-tokens-edited(); }
    changed token-radius-md => { root.theme-tokens-edited(); }
    changed token-radius-default-index => { root.theme-tokens-edited(); }
    changed token-radius-lg => { root.theme-tokens-edited(); }
    changed token-radius-full => { root.theme-tokens-edited(); }

    background: dark-mode ? #242424 : #ffffff;

    SidebarPanel {
        width: 100%;
        height: 100%;
        dark-mode: root.dark-mode;
        title: "Tokens";
        splitter-base-x: 32px;

            colors-header := TreeSectionHeader {
                title: "Colors";
                dark-mode: root.dark-mode;
            }

            if colors-header.expanded: VerticalLayout {
                padding-left: 16px;
                spacing: 6px;

                if !root.dark-mode: ColorRow {
                    label: "primary";
                    dark-mode: root.dark-mode;
                    value <=> light-token-primary;
                    default-value: #1a9a9a;
                    parse-hex(hex) => { return root.parse-hex-color(hex); }
                    format-hex(c) => { return root.format-hex-color(c); }
                    value-changed(c) => { root.token-value-changed("primary", c, false); }
                }
                if !root.dark-mode: ColorRow {
                    label: "primary-pressed";
                    dark-mode: root.dark-mode;
                    value <=> light-token-primary-pressed;
                    default-value: #158080;
                    parse-hex(hex) => { return root.parse-hex-color(hex); }
                    format-hex(c) => { return root.format-hex-color(c); }
                    value-changed(c) => { root.token-value-changed("primary-pressed", c, false); }
                }
                if !root.dark-mode: ColorRow {
                    label: "secondary";
                    dark-mode: root.dark-mode;
                    value <=> light-token-secondary;
                    default-value: #e8e4df;
                    parse-hex(hex) => { return root.parse-hex-color(hex); }
                    format-hex(c) => { return root.format-hex-color(c); }
                    value-changed(c) => { root.token-value-changed("secondary", c, false); }
                }
                if !root.dark-mode: ColorRow {
                    label: "danger";
                    dark-mode: root.dark-mode;
                    value <=> light-token-danger;
                    default-value: #dc2626;
                    parse-hex(hex) => { return root.parse-hex-color(hex); }
                    format-hex(c) => { return root.format-hex-color(c); }
                    value-changed(c) => { root.token-value-changed("danger", c, false); }
                }
                if !root.dark-mode: ColorRow {
                    label: "surface";
                    dark-mode: root.dark-mode;
                    value <=> light-token-surface;
                    default-value: #ffffff;
                    parse-hex(hex) => { return root.parse-hex-color(hex); }
                    format-hex(c) => { return root.format-hex-color(c); }
                    value-changed(c) => { root.token-value-changed("surface", c, false); }
                }
                if !root.dark-mode: ColorRow {
                    label: "background";
                    dark-mode: root.dark-mode;
                    value <=> light-token-background;
                    default-value: #ffffff;
                    parse-hex(hex) => { return root.parse-hex-color(hex); }
                    format-hex(c) => { return root.format-hex-color(c); }
                    value-changed(c) => { root.token-value-changed("background", c, false); }
                }
                if !root.dark-mode: ColorRow {
                    label: "text";
                    dark-mode: root.dark-mode;
                    value <=> light-token-text;
                    default-value: #1a1a1a;
                    parse-hex(hex) => { return root.parse-hex-color(hex); }
                    format-hex(c) => { return root.format-hex-color(c); }
                    value-changed(c) => { root.token-value-changed("text", c, false); }
                }
                if !root.dark-mode: ColorRow {
                    label: "text-muted";
                    dark-mode: root.dark-mode;
                    value <=> light-token-text-muted;
                    default-value: #6b6b6b;
                    parse-hex(hex) => { return root.parse-hex-color(hex); }
                    format-hex(c) => { return root.format-hex-color(c); }
                    value-changed(c) => { root.token-value-changed("text-muted", c, false); }
                }

                if root.dark-mode: ColorRow {
                    label: "primary";
                    dark-mode: root.dark-mode;
                    value <=> dark-token-primary;
                    default-value: #2abaaa;
                    parse-hex(hex) => { return root.parse-hex-color(hex); }
                    format-hex(c) => { return root.format-hex-color(c); }
                    value-changed(c) => { root.token-value-changed("primary", c, true); }
                }
                if root.dark-mode: ColorRow {
                    label: "primary-pressed";
                    dark-mode: root.dark-mode;
                    value <=> dark-token-primary-pressed;
                    default-value: #1a9a9a;
                    parse-hex(hex) => { return root.parse-hex-color(hex); }
                    format-hex(c) => { return root.format-hex-color(c); }
                    value-changed(c) => { root.token-value-changed("primary-pressed", c, true); }
                }
                if root.dark-mode: ColorRow {
                    label: "secondary";
                    dark-mode: root.dark-mode;
                    value <=> dark-token-secondary;
                    default-value: #3a3a3a;
                    parse-hex(hex) => { return root.parse-hex-color(hex); }
                    format-hex(c) => { return root.format-hex-color(c); }
                    value-changed(c) => { root.token-value-changed("secondary", c, true); }
                }
                if root.dark-mode: ColorRow {
                    label: "danger";
                    dark-mode: root.dark-mode;
                    value <=> dark-token-danger;
                    default-value: #ef4444;
                    parse-hex(hex) => { return root.parse-hex-color(hex); }
                    format-hex(c) => { return root.format-hex-color(c); }
                    value-changed(c) => { root.token-value-changed("danger", c, true); }
                }
                if root.dark-mode: ColorRow {
                    label: "surface";
                    dark-mode: root.dark-mode;
                    value <=> dark-token-surface;
                    default-value: #1e1e1e;
                    parse-hex(hex) => { return root.parse-hex-color(hex); }
                    format-hex(c) => { return root.format-hex-color(c); }
                    value-changed(c) => { root.token-value-changed("surface", c, true); }
                }
                if root.dark-mode: ColorRow {
                    label: "background";
                    dark-mode: root.dark-mode;
                    value <=> dark-token-background;
                    default-value: #121212;
                    parse-hex(hex) => { return root.parse-hex-color(hex); }
                    format-hex(c) => { return root.format-hex-color(c); }
                    value-changed(c) => { root.token-value-changed("background", c, true); }
                }
                if root.dark-mode: ColorRow {
                    label: "text";
                    dark-mode: root.dark-mode;
                    value <=> dark-token-text;
                    default-value: #fafafa;
                    parse-hex(hex) => { return root.parse-hex-color(hex); }
                    format-hex(c) => { return root.format-hex-color(c); }
                    value-changed(c) => { root.token-value-changed("text", c, true); }
                }
                if root.dark-mode: ColorRow {
                    label: "text-muted";
                    dark-mode: root.dark-mode;
                    value <=> dark-token-text-muted;
                    default-value: #9a9a9a;
                    parse-hex(hex) => { return root.parse-hex-color(hex); }
                    format-hex(c) => { return root.format-hex-color(c); }
                    value-changed(c) => { root.token-value-changed("text-muted", c, true); }
                }
            }

            spacing-header := TreeSectionHeader {
                title: "Spacing";
                dark-mode: root.dark-mode;
            }

            if spacing-header.expanded: VerticalLayout {
                padding-left: 16px;
                spacing: 6px;

                NumberInput { label: "xs"; dark-mode: root.dark-mode; value <=> token-spacing-xs; min-value: 0; max-value: 16; step: 1; default-value: 4; }
                NumberInput { label: "sm"; dark-mode: root.dark-mode; value <=> token-spacing-sm; min-value: 0; max-value: 24; step: 2; default-value: 8; }
                NumberInput { label: "md"; dark-mode: root.dark-mode; value <=> token-spacing-md; min-value: 0; max-value: 48; step: 4; default-value: 12; }
                NumberInput { label: "lg"; dark-mode: root.dark-mode; value <=> token-spacing-lg; min-value: 0; max-value: 64; step: 4; default-value: 16; }
                NumberInput { label: "xl"; dark-mode: root.dark-mode; value <=> token-spacing-xl; min-value: 0; max-value: 96; step: 8; default-value: 24; }
            }

            control-scale-header := TreeSectionHeader {
                title: "Control Scale";
                dark-mode: root.dark-mode;
            }

            if control-scale-header.expanded: VerticalLayout {
                padding-left: 16px;
                spacing: 6px;

                NumberInput { label: "control-size-sm"; dark-mode: root.dark-mode; value <=> token-control-size-sm; min-value: 0; max-value: 160; step: 1; default-value: 48; }
                NumberInput { label: "control-size-md"; dark-mode: root.dark-mode; value <=> token-control-size-md; min-value: 0; max-value: 160; step: 1; default-value: 56; }
                NumberInput { label: "control-size-lg"; dark-mode: root.dark-mode; value <=> token-control-size-lg; min-value: 0; max-value: 160; step: 1; default-value: 64; }
                NumberInput { label: "icon-size-sm"; dark-mode: root.dark-mode; value <=> token-icon-size-sm; min-value: 0; max-value: 64; step: 1; default-value: 20; }
                NumberInput { label: "icon-size-md"; dark-mode: root.dark-mode; value <=> token-icon-size-md; min-value: 0; max-value: 64; step: 1; default-value: 24; }
                NumberInput { label: "icon-size-lg"; dark-mode: root.dark-mode; value <=> token-icon-size-lg; min-value: 0; max-value: 64; step: 1; default-value: 28; }
                NumberInput { label: "control-radius-sm"; dark-mode: root.dark-mode; value <=> token-control-radius-sm; min-value: 0; max-value: 64; step: 1; default-value: 20; }
                NumberInput { label: "control-radius-md"; dark-mode: root.dark-mode; value <=> token-control-radius-md; min-value: 0; max-value: 64; step: 1; default-value: 24; }
                NumberInput { label: "control-radius-lg"; dark-mode: root.dark-mode; value <=> token-control-radius-lg; min-value: 0; max-value: 64; step: 1; default-value: 28; }
                NumberInput { label: "control-padding-inline-sm"; dark-mode: root.dark-mode; value <=> token-control-padding-inline-sm; min-value: 0; max-value: 64; step: 1; default-value: 14; }
                NumberInput { label: "control-padding-inline-md"; dark-mode: root.dark-mode; value <=> token-control-padding-inline-md; min-value: 0; max-value: 64; step: 1; default-value: 16; }
                NumberInput { label: "control-padding-inline-lg"; dark-mode: root.dark-mode; value <=> token-control-padding-inline-lg; min-value: 0; max-value: 64; step: 1; default-value: 20; }
            }

            typography-header := TreeSectionHeader {
                title: "Typography";
                dark-mode: root.dark-mode;
            }

            if typography-header.expanded: VerticalLayout {
                padding-left: 16px;
                spacing: 6px;

                NumberInput { label: "font-size-sm"; dark-mode: root.dark-mode; value <=> token-font-size-sm; min-value: 8; max-value: 32; step: 1; default-value: 20; }
                NumberInput { label: "font-size-md"; dark-mode: root.dark-mode; value <=> token-font-size-md; min-value: 8; max-value: 36; step: 1; default-value: 22; }
                NumberInput { label: "font-size-lg"; dark-mode: root.dark-mode; value <=> token-font-size-lg; min-value: 8; max-value: 40; step: 1; default-value: 24; }
                EnumRow { label: "Font.primary"; dark-mode: root.dark-mode; options: root.actual-font-options; default-index: 0; selected-index <=> token-font-primary-index; selector-width: 140px; }
                EnumRow { label: "Font.secondary"; dark-mode: root.dark-mode; options: root.actual-font-options; default-index: 0; selected-index <=> token-font-secondary-index; selector-width: 140px; }
                EnumRow { label: "Font.tertiary"; dark-mode: root.dark-mode; options: root.actual-font-options; default-index: 0; selected-index <=> token-font-tertiary-index; selector-width: 140px; }
            }

            radius-header := TreeSectionHeader {
                title: "Radius";
                dark-mode: root.dark-mode;
            }

            if radius-header.expanded: VerticalLayout {
                padding-left: 16px;
                spacing: 6px;

                NumberInput { label: "sm"; dark-mode: root.dark-mode; value <=> token-radius-sm; min-value: 0; max-value: 24; step: 1; default-value: 8; }
                NumberInput { label: "md"; dark-mode: root.dark-mode; value <=> token-radius-md; min-value: 0; max-value: 32; step: 2; default-value: 16; }
                EnumRow { label: "default"; dark-mode: root.dark-mode; options: ["sm", "md", "lg", "full"]; default-index: 2; selected-index <=> token-radius-default-index; selector-width: 120px; }
                NumberInput { label: "lg"; dark-mode: root.dark-mode; value <=> token-radius-lg; min-value: 0; max-value: 40; step: 2; default-value: 24; }
                NumberInput { label: "full"; dark-mode: root.dark-mode; value <=> token-radius-full; min-value: 0; max-value: 9999; step: 100; default-value: 9999; }
            }
    }
}

export component ComponentThemeWorkspace inherits Rectangle {
    in property <bool> dark-mode;
    in-out property <int> preview-state-index: 0;
    in-out property <int> component-page-mode: 0;
    in-out property <int> preview-version: 0;
    in-out property <int> btn-selected-variant: 0;
    in-out property <int> btn-selected-size: 1;
    in-out property <string> selected-component-key: "button";
    in-out property <string> selected-component-name: "Button";
    in-out property <int> component-selected-variant: 0;
    in-out property <int> component-selected-size: 0;
    in-out property <[VariantInfo]> variant-list: [];
    in-out property <[string]> variant-name-list: [];
    in-out property <[StateInfo]> state-list: [];
    in-out property <[string]> state-name-list: [];
    in-out property <[SizeInfo]> size-list: [];
    in-out property <[string]> size-name-list: [];
    // Matrix-only size list: the size-list with the virtual "Default" entry
    // removed. Editing UI uses size-list (with Default first); the matrix
    // preview iterates this filtered list. The offset is how many entries the
    // selector has BEFORE the first matrix entry (1 when Default is prepended,
    // 0 otherwise) so the active-cell highlight maps from selector index →
    // matrix index correctly.
    in-out property <[SizeInfo]> matrix-size-list: [];
    in-out property <int> matrix-size-index-offset: 0;
    // True when the active component's plugin has an `extends:` — enables the
    // reset button on Default-base rows for child components so they can drop
    // a local override and re-inherit live from the parent.
    in-out property <bool> component-has-parent: false;
    in-out property <[PropertyDef]> variant-prop-defs: [];
    in-out property <[PropertyDef]> size-prop-defs: [];
    in-out property <[PropertyValueData]> current-variant-values: [];
    in-out property <[PropertyValueData]> current-size-values: [];
    in-out property <int> variant-values-version: 0;
    in-out property <int> size-values-version: 0;
    in property <string> token-font-primary: "Montserrat";
    in property <string> token-font-secondary: "Montserrat";
    in property <string> token-font-tertiary: "Montserrat";
    in property <[string]> component-page-mode-options: ["Theme", "Props"];
    in property <[string]> font-token-options: ["Font.primary", "Font.secondary", "Font.tertiary"];
    in property <[string]> actual-font-options: ["Montserrat", "Arial", "Verdana", "Trebuchet MS", "Georgia", "Palatino", "Times New Roman", "Courier New", "Menlo", "Monaco"];
    in property <[string]> number-token-options: [
        "font-size-sm",
        "font-size-md",
        "font-size-lg",
        "spacing-xs",
        "spacing-sm",
        "spacing-md",
        "spacing-lg",
        "spacing-xl",
        "radius-sm",
        "radius-default",
        "radius-lg",
        "radius-full",
        "control-size-sm",
        "control-size-md",
        "control-size-lg",
        "icon-size-sm",
        "icon-size-md",
        "icon-size-lg",
        "control-radius-sm",
        "control-radius-md",
        "control-radius-lg",
        "control-padding-inline-sm",
        "control-padding-inline-md",
        "control-padding-inline-lg"
    ];
    in property <[float]> number-token-values: [];
    in-out property <length> settings-panel-width: 360px;
    property <bool> settings-dragging: false;
    property <length> settings-drag-start-total: 0px;
    // Drag state for the label/value column splitter (resizes RowLayout.label-width).
    property <bool> label-col-dragging: false;

    callback parse-hex-color(string) -> color;
    callback format-hex-color(color) -> string;
    callback check-float-equal(float, float) -> bool;
    callback check-color-equal(color, color) -> bool;
    callback btn-variant-changed(int);
    callback btn-size-changed(int);
    callback variant-prop-changed(int, int, PropertyValueData);
    callback size-prop-changed(int, int, PropertyValueData);
    // Drop a per-size override and re-inherit the "Default" base for that prop.
    callback clear-size-override(int /* size_index */, int /* prop_index */);
    callback component-page-mode-changed(int);
    pure callback preview-variant-prop(string, string, string, string, int) -> PropertyValueData;
    pure callback preview-size-prop(string, string, string, int) -> PropertyValueData;

    property <int> active-variant-index:
        component-selected-variant;
    property <int> active-size-index:
        component-selected-size;
    property <string> active-variant-key:
        variant-list.length > 0 && active-variant-index >= 0 && active-variant-index < variant-list.length ?
            variant-list[active-variant-index].key :
            "default";
    property <string> preview-state-key:
        state-list.length > 0 && preview-state-index >= 0 && preview-state-index < state-list.length ?
        state-list[preview-state-index].key :
        "normal";
    property <length> preview-grid-label-width: 92px;
    property <length> preview-grid-cell-width:
        selected-component-key == "dialog" ? 420px :
        selected-component-key == "sheet" ? 420px :
        selected-component-key == "toast" ? 360px :
        selected-component-key == "image" ? 360px :
        selected-component-key == "icon" ? 132px :
        selected-component-key == "tabs" ? 588px :
        (selected-component-key == "input" || selected-component-key == "search") ? 280px :
        selected-component-key == "dropdown" ? 300px :
        selected-component-key == "slide_to_confirm" ? 320px :
        selected-component-key == "slider" ? 280px :
        selected-component-key == "card" ? 320px :
        selected-component-key == "progress_bar" ? 280px :
        selected-component-key == "divider" ? 240px :
        selected-component-key == "textarea" ? 340px :
        (selected-component-key == "checkbox" || selected-component-key == "radio" || selected-component-key == "switch") ? 400px :
        (selected-component-key == "menu" || selected-component-key == "menu_item") ? 360px :
        selected-component-key == "accordion" ? 440px :
        selected-component-key == "radio_group" ? 320px :
        180px;
    pure function default-control-height(size_key: string) -> length {
        if size_key == "sm" || size_key == "small" {
            return 36px;
        }
        if size_key == "lg" || size_key == "large" {
            return 52px;
        }
        return 44px;
    }
    pure function default-row-height(size_key: string) -> length {
        if size_key == "sm" || size_key == "small" {
            return 36px;
        }
        if size_key == "lg" || size_key == "large" {
            return 52px;
        }
        return 44px;
    }
    pure function default-item-gap(size_key: string) -> length {
        if size_key == "sm" || size_key == "small" {
            return 8px;
        }
        if size_key == "lg" || size_key == "large" {
            return 12px;
        }
        return 10px;
    }
    pure function default-font-size(size_key: string) -> length {
        if size_key == "sm" || size_key == "small" {
            return 14px;
        }
        if size_key == "lg" || size_key == "large" {
            return 18px;
        }
        return 16px;
    }
    pure function default-menu-height(size_key: string) -> length {
        if size_key == "sm" || size_key == "small" {
            return 148px;
        }
        if size_key == "lg" || size_key == "large" {
            return 196px;
        }
        return 172px;
    }
    pure function default-accordion-header-height(size_key: string) -> length {
        if size_key == "sm" || size_key == "small" {
            return 36px;
        }
        if size_key == "lg" || size_key == "large" {
            return 52px;
        }
        return 44px;
    }
    pure function default-accordion-padding-horizontal(size_key: string) -> length {
        if size_key == "sm" || size_key == "small" {
            return 12px;
        }
        if size_key == "lg" || size_key == "large" {
            return 18px;
        }
        return 14px;
    }
    pure function preview-size-length(size_key: string, prop_name: string, fallback: length) -> length {
        let prop = root.preview-size-prop(root.selected-component-key, size_key, prop_name, root.preview-version);
        return prop.is-overridden ? prop.float-value * 1px : fallback;
    }
    pure function component-preview-cell-height(size_key: string) -> length {
        if root.selected-component-key == "dropdown" {
            return max(128px, root.preview-size-length(size_key, "control-height", root.default-control-height(size_key)) + 64px);
        }
        if root.selected-component-key == "checkbox" || root.selected-component-key == "radio" || root.selected-component-key == "switch" {
            return max(96px, root.preview-size-length(size_key, "row-height", root.default-row-height(size_key)) + 32px);
        }
        if root.selected-component-key == "radio_group" {
            let row-height = root.preview-size-length(size_key, "row-height", root.default-row-height(size_key));
            let item-gap = root.preview-size-length(size_key, "item-gap", root.default-item-gap(size_key));
            return max(188px, row-height * 3 + item-gap * 2 + 24px);
        }
        if root.selected-component-key == "slider" {
            return max(112px, root.preview-size-length(size_key, "row-height", root.default-row-height(size_key)) + 32px);
        }
        if root.selected-component-key == "tabs" {
            let control-height = root.preview-size-length(size_key, "control-height", root.default-control-height(size_key));
            let list-padding =
                root.preview-size-length(
                    size_key,
                    "list-padding",
                    root.active-variant-key == "underlined" ? 0px : 4px
                );
            let panel-min-height =
                root.preview-size-length(
                    size_key,
                    "panel-min-height",
                    size_key == "sm" || size_key == "small" ? 88px :
                    size_key == "lg" || size_key == "large" ? 120px :
                    104px
                );
            return max(220px, control-height + list-padding * 2 + 12px + panel-min-height + 24px);
        }
        if root.selected-component-key == "dialog" {
            return 320px;
        }
        if root.selected-component-key == "sheet" {
            return 420px;
        }
        if root.selected-component-key == "toast" {
            return 160px;
        }
        if root.selected-component-key == "image" {
            return 324px;
        }
        if root.selected-component-key == "icon" {
            return 96px;
        }
        if root.selected-component-key == "card" {
            return 220px;
        }
        if root.selected-component-key == "progress_bar" {
            return 112px;
        }
        if root.selected-component-key == "divider" {
            return 72px;
        }
        if root.selected-component-key == "textarea" {
            return 320px;
        }
        if root.selected-component-key == "menu" {
            // The matrix renders 3 MenuItems. Size the cell to 3 × MenuItem height
            // (per-size) plus 40px (10px y offset in ThemePreviewCell + small bottom
            // margin). The Menu component now uses menu-height as a min, not a
            // ceiling, so its actual rendered height tracks content.
            let item-height =
                size_key == "sm" || size_key == "small" ? 56px :
                size_key == "lg" || size_key == "large" ? 72px :
                64px;
            return item-height * 3 + 40px;
        }
        if root.selected-component-key == "accordion" {
            let header-height =
                root.preview-size-length(size_key, "header-height", root.default-accordion-header-height(size_key));
            let font-size =
                root.preview-size-length(size_key, "font-size", root.default-font-size(size_key));
            let padding-horizontal =
                root.preview-size-length(
                    size_key,
                    "padding-horizontal",
                    root.default-accordion-padding-horizontal(size_key)
                );
            let expanded-item-height =
                header-height + 11px + font-size * 3 + padding-horizontal * 1.5;
            let collapsed-item-height = header-height + 11px;
            return max(expanded-item-height + collapsed-item-height * 2 + 20px, 220px);
        }
        if root.selected-component-key == "menu_item" {
            return 128px;
        }
        return 96px;
    }
    pure function preview-grid-row-height() -> length {
        let first-key = root.size-list.length > 0 ? root.size-list[0].key : "default";
        let first-height = root.component-preview-cell-height(first-key);
        let second-height =
            root.size-list.length > 1 ?
            root.component-preview-cell-height(root.size-list[1].key) :
            first-height;
        let third-height =
            root.size-list.length > 2 ?
            root.component-preview-cell-height(root.size-list[2].key) :
            second-height;
        return max(first-height, max(second-height, third-height));
    }
    property <length> preview-grid-cell-height: root.preview-grid-row-height();
    background: dark-mode ? #1a1a1a : #f5f5f5;

    preview-panel := Rectangle {
        x: 0px;
        y: 0px;
        width:
            parent.width > root.settings-panel-width + 6px ?
            parent.width - root.settings-panel-width - 6px :
            0px;
        height: parent.height;
        background: dark-mode ? #1a1a1a : #f5f5f5;

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding: 16px;
            spacing: 12px;

            Text {
                text: "Theme Preview";
                color: dark-mode ? #888888 : #666666;
                font-size: 11px;
                font-weight: 600;
            }

            Rectangle {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                background: dark-mode ? #242424 : #ffffff;
                border-radius: 8px;

                Flickable {
                    // Grow the viewport to the content so a wide matrix scrolls
                    // horizontally and stays LEFT-aligned, instead of being centered
                    // with empty space on the left when the panel is narrower than it.
                    viewport-width: max(self.width, preview-content.preferred-width);
                    viewport-height: preview-content.preferred-height;

                    preview-content := VerticalLayout {
                        width: max(parent.width, self.preferred-width);
                        padding: 16px;
                        spacing: 12px;

                        Text {
                            text: root.selected-component-name + " Matrix";
                            color: dark-mode ? #ffffff : #1a1a1a;
                            font-size: 16px;
                            font-weight: 600;
                        }

                        if root.state-list.length > 1 && root.selected-component-key != "icon": VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "Preview State";
                                color: dark-mode ? #888888 : #666666;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            SegmentedControl {
                                width: 620px;
                                size: ControlSize.sm;
                                options: root.state-name-list;
                                selected-index <=> root.preview-state-index;
                            }
                        }

                        Rectangle {
                            min-width: 0px;
                            preferred-width: preview-grid-header.preferred-width;
                            max-width: 100000px;
                            height: 24px;
                            background: transparent;

                            preview-grid-header := HorizontalLayout {
                                width: parent.width;
                                height: parent.height;
                                spacing: 12px;

                                Rectangle {
                                    width: root.preview-grid-label-width;
                                    height: 24px;
                                }

                                for size[size-index] in root.size-list: Rectangle {
                                    width: root.preview-grid-cell-width;
                                    height: 24px;

                                    Text {
                                        text: size.name;
                                        color: dark-mode ? #888888 : #666666;
                                        font-size: 11px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        for variant[variant-index] in root.variant-list: HorizontalLayout {
                            spacing: 12px;

                            Rectangle {
                                width: root.preview-grid-label-width;
                                height: root.preview-grid-cell-height;

                                Text {
                                    text: variant.name;
                                    color: dark-mode ? #cccccc : #444444;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            for size[size-index] in root.size-list: Rectangle {
                                width: root.preview-grid-cell-width;
                                height: root.preview-grid-cell-height;
                                border-radius: 10px;
                                border-width: root.active-variant-index == variant-index && root.active-size-index == size-index ? 2px : 0px;
                                border-color: #1a9a9a;

                                ThemePreviewCell {
                                    width: parent.width;
                                    height: parent.height;
                                    component-key: root.selected-component-key;
                                    variant-key: variant.key;
                                    size-key: size.key;
                                    preview-state-key: root.preview-state-key;
                                    preview-version: root.preview-version;
                                    dark-mode: root.dark-mode;
                                    variant-prop(prop_name, version) => { return root.preview-variant-prop(root.selected-component-key, variant.key, root.preview-state-key, prop_name, version); }
                                    size-prop(prop_name, version) => { return root.preview-size-prop(root.selected-component-key, size.key, prop_name, version); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Splitter between the preview and the settings panel (drag to resize).
    Rectangle {
        x: preview-panel.width;
        y: 0px;
        width: 6px;
        height: parent.height;
        background: root.settings-dragging || settings-splitter-touch.has-hover
            ? (dark-mode ? #3a3a3a : #d0d0d0)
            : (dark-mode ? #2a2a2a : #e0e0e0);

        Rectangle {
            x: 2px;
            y: (parent.height - 40px) / 2;
            width: 2px;
            height: 40px;
            border-radius: 1px;
            background: root.settings-dragging ? #1a9a9a : (dark-mode ? #444444 : #bbbbbb);
        }

        settings-splitter-touch := TouchArea {
            mouse-cursor: col-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.settings-dragging = true;
                    root.settings-drag-start-total = preview-panel.width + root.settings-panel-width;
                }
                if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.settings-dragging = false;
                }
            }
            moved => {
                if (self.pressed) {
                    root.settings-panel-width = clamp(
                        root.settings-panel-width - (self.mouse-x - self.pressed-x),
                        250px,
                        root.settings-drag-start-total - 250px
                    );
                }
            }
        }
    }

    settings-panel := SidebarPanel {
        x: preview-panel.width + 6px;
        y: 0px;
        width: root.settings-panel-width;
        height: parent.height;
        dark-mode: root.dark-mode;
        show-mode-selector: true;
        mode-options: root.component-page-mode-options;
        mode-index <=> root.component-page-mode;
        mode-changed(index) => { root.component-page-mode-changed(index); }
        title: root.selected-component-name + " Theme";
        splitter-base-x: 28px;

                    if root.size-prop-defs.length > 0: VerticalLayout {
                        spacing: 4px;

                        component-sizes-header := TreeSectionHeader {
                            title: "Sizes";
                            dark-mode: root.dark-mode;
                        }

                        if component-sizes-header.expanded: VerticalLayout {
                            padding-left: 12px;
                            spacing: 4px;

                            EnumSelector {
                                label: "Edit Size";
                                dark-mode: root.dark-mode;
                                options: root.size-name-list;
                                selected-index <=> root.component-selected-size;
                                selector-width: 132px;
                                changed selected-index => { root.btn-size-changed(self.selected-index); }
                            }

                            for prop[prop-index] in root.size-prop-defs: Rectangle {
                                clip: true;

                                size-prop-editor := GenericSizePropEditor {
                                    visible: prop-index < root.current-size-values.length;
                                    dark-mode: root.dark-mode;
                                    prop-def: prop;
                                    prop-value: prop-index < root.current-size-values.length ? root.current-size-values[prop-index] : {
                                        color-value: #000000,
                                        float-value: 0,
                                        int-value: 0,
                                        bool-value: false,
                                        string-value: "",
                                        is-overridden: false,
                                        is-token-mode: false,
                                        selected-token: 0,
                                        selected-actual-index: 0,
                                    };
                                    sync-version: root.size-values-version;
                                    font-token-options: root.font-token-options;
                                    font-token-values: [root.token-font-primary, root.token-font-secondary, root.token-font-tertiary];
                                    actual-font-options: root.actual-font-options;
                                    number-token-options: root.number-token-options;
                                    number-token-values: root.number-token-values;
                                    // Enable the reset (↺) button when the row has something
                                    // meaningful to reset to:
                                    //   - Concrete-size row: clear the per-size override and
                                    //     re-inherit the component's own Default base.
                                    //   - Default row of a CHILD component (extends another):
                                    //     clear the parent-level override and re-inherit live
                                    //     from the parent's Default.
                                    //   - Default row of a top-level component (no parent):
                                    //     no reset (Default IS the source there).
                                    enable-reset: (root.size-name-list.length > root.active-size-index
                                        && root.size-name-list[root.active-size-index] != "Default")
                                        || root.component-has-parent;
                                    check-float-equal(v, d) => { return root.check-float-equal(v, d); }
                                    value-changed(val) => { root.size-prop-changed(root.active-size-index, prop-index, val); }
                                    clear-override => { root.clear-size-override(root.active-size-index, prop-index); }
                                }

                                height: size-prop-editor.visible ? size-prop-editor.height : 0px;
                            }
                        }
                    }

                    if root.variant-prop-defs.length > 0: VerticalLayout {
                        spacing: 4px;

                        component-variants-header := TreeSectionHeader {
                            title: "Variants";
                            dark-mode: root.dark-mode;
                        }

                        if component-variants-header.expanded: VerticalLayout {
                            padding-left: 12px;
                            spacing: 4px;

                            EnumSelector {
                                label: "Edit Variant";
                                dark-mode: root.dark-mode;
                                options: root.variant-name-list;
                                selected-index <=> root.component-selected-variant;
                                selector-width: 148px;
                                changed selected-index => { root.btn-variant-changed(self.selected-index); }
                            }

                            for state[state-index] in root.state-list: VerticalLayout {
                                state-header := TreeSectionHeader {
                                    title: state.name + " State";
                                    dark-mode: root.dark-mode;
                                    expanded: state-index == 0;
                                }

                                if state-header.expanded: VerticalLayout {
                                    // No extra indent: every prop row shares one left
                                    // edge so the value column aligns across sections.
                                    padding-left: 0px;
                                    spacing: 0px;

                                    for prop[prop-index] in root.variant-prop-defs: Rectangle {
                                        property <int> value-index: state-index * root.variant-prop-defs.length + prop-index;
                                        clip: true;

                                        variant-prop-editor := GenericVariantPropEditor {
                                            visible: value-index < root.current-variant-values.length;
                                            dark-mode: root.dark-mode;
                                            prop-def: prop;
                                            prop-value: value-index < root.current-variant-values.length ? root.current-variant-values[value-index] : {
                                                color-value: #000000,
                                                float-value: 0,
                                                int-value: 0,
                                                bool-value: false,
                                                string-value: "",
                                                is-overridden: false,
                                                is-token-mode: false,
                                                selected-token: 0,
                                                selected-actual-index: 0,
                                            };
                                            sync-version: root.variant-values-version;
                                            parse-hex(hex) => { return root.parse-hex-color(hex); }
                                            format-hex(color) => { return root.format-hex-color(color); }
                                            check-color-equal(value, default) => { return root.check-color-equal(value, default); }
                                            check-float-equal(value, default) => { return root.check-float-equal(value, default); }
                                            value-changed(val) => { root.variant-prop-changed(state-index, prop-index, val); }
                                        }

                                        height: variant-prop-editor.visible ? variant-prop-editor.height : 0px;
                                    }
                                }
                            }
                        }
                    }

                    if root.variant-prop-defs.length == 0 && root.size-prop-defs.length == 0: Text {
                        text: "No editable theme props are defined for this component yet.";
                        color: dark-mode ? #666666 : #999999;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
    }
    }
