{
  "schemaVersion": 1,
  "component": "Dropdown",
  "extends": "Input",
  "sizeProps": [
    {
      "name": "control-height",
      "displayName": "Control Height",
      "type": "float",
      "min": 0,
      "max": 160,
      "step": 1,
      "defaults": {
        "sm": "controlSize.sm",
        "md": "controlSize.md",
        "lg": "controlSize.lg"
      }
    },
    {
      "name": "option-height",
      "displayName": "Option Height",
      "type": "float",
      "min": 0,
      "max": 160,
      "step": 1,
      "defaults": {
        "sm": 56,
        "md": 64,
        "lg": 72
      }
    },
    {
      "name": "icon-size",
      "displayName": "Icon Size",
      "type": "float",
      "min": 0,
      "max": 64,
      "step": 1,
      "defaults": {
        "sm": "iconSize.sm",
        "md": 22,
        "lg": "iconSize.md"
      }
    }
  ]
}
