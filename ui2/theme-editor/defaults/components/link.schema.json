{
  "schemaVersion": 1,
  "component": "Link",
  "variants": [
    "default"
  ],
  "states": [
    "normal",
    "focused",
    "pressed",
    "disabled",
    "visited"
  ],
  "sizes": [
    "sm",
    "md",
    "lg"
  ],
  "variantProps": [
    {
      "name": "text-color",
      "displayName": "Text Color",
      "type": "color",
      "defaults": {
        "default": {
          "normal": "color.primary",
          "focused": "color.primary",
          "pressed": "color.primary.dark",
          "disabled": "color.muted",
          "visited": "color.muted"
        }
      }
    },
    {
      "name": "underline-color",
      "displayName": "Underline Color",
      "type": "color",
      "defaults": {
        "default": {
          "normal": "color.primary",
          "focused": "color.primary",
          "pressed": "color.primary.dark",
          "disabled": "color.transparent",
          "visited": "color.muted"
        }
      }
    }
  ],
  "sizeProps": [
    {
      "name": "font-family",
      "displayName": "Font Family",
      "type": "string",
      "min": 0,
      "max": 256,
      "step": 1,
      "defaults": {
        "default": "font.primary"
      }
    },
    {
      "name": "font-size",
      "displayName": "Font Size",
      "type": "float",
      "min": 0,
      "max": 64,
      "step": 1,
      "defaults": {
        "default": "fontSize.md",
        "sm": "fontSize.sm",
        "lg": "fontSize.lg"
      }
    },
    {
      "name": "row-height",
      "displayName": "Row Height",
      "type": "float",
      "min": 0,
      "max": 64,
      "step": 1,
      "defaults": {
        "default": 52,
        "sm": 44,
        "lg": 60
      }
    },
    {
      "name": "icon-size",
      "displayName": "Icon Size",
      "type": "float",
      "min": 0,
      "max": 64,
      "step": 1,
      "defaults": {
        "default": 18,
        "sm": 16,
        "lg": "iconSize.sm"
      }
    }
  ]
}
