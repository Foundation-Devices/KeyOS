      "defaults": {
        "default": "font.primary"
      }
    },
    {
      "name": "font-size",
      "displayName": "Font Size",
      "type": "float",
      "min": 0.0,
      "max": 64.0,
      "step": 1.0,
      "defaults": {
        "default": "fontSize.md",
        "sm": "fontSize.sm",
        "lg": "fontSize.lg"
      }
    },
    {
      "name": "track-height",
      "displayName": "Track Height",
      "type": "float",
      "min": 0.0,
      "max": 64.0,
      "step": 1.0,
      "defaults": {
        "default": "switchSize.md",
        "sm": "switchSize.sm",
        "lg": "switchSize.lg"
      }
    },
    {
      "name": "knob-size",
      "displayName": "Knob Size",
      "type": "float",
      "min": 0.0,
      "max": 64.0,
      "step": 1.0,
      "defaults": {
        "default": "switchSize.md",
        "sm": "switchSize.sm",
        "lg": "switchSize.lg"
