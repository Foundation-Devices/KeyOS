          "unchecked": "color.secondary",
          "checked": "color.primary",
          "indeterminate": "color.primary",
          "disabled": "color.border"
        }
      }
    },
    {
      "name": "knob-color",
      "displayName": "Knob Color",
      "type": "color",
      "defaults": {
        "default": {
          "unchecked": "color.background",
          "checked": "color.background",
          "indeterminate": "color.background",
          "disabled": "color.background"
        }
      }
    },
    {
      "name": "label-color",
      "displayName": "Label Color",
      "type": "color",
      "defaults": {
        "default": {
          "unchecked": "color.foreground",
          "checked": "color.foreground",
          "indeterminate": "color.foreground",
          "disabled": "color.muted"
        }
      }
    },
    {
      "name": "description-color",
      "displayName": "Description Color",
      "type": "color",
      "defaults": {
        "default": {
          "unchecked": "color.muted",
          "checked": "color.muted",
          "indeterminate": "color.muted",
          "disabled": "color.muted"
        }
      }
    }
  ],
  "sizeProps": [
