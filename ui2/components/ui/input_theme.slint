// GENERATED from input.schema.json by foundation theme tooling — do not edit by hand.
// Token-backed props reference the shared Theme global; JSON literals are inlined.

import { Theme, ControlSize } from "theme.slint";

export enum InputThemeVariant {
    default,
    filled,
    outlined,
}

export enum InputState {
    normal,
    focused,
    disabled,
}

export struct InputVariantProps {
    background: color,
    foreground: color,
    placeholder-color: color,
    border-color: color,
    border-color-error: color,
}

export struct InputSizeProps {
    border-width: length,
    border-radius: length,
    padding-horizontal: length,
    padding-vertical: length,
    field-height: length,
    font-size: length,
    font-family: string,
}

export global InputTheme {
    public pure function style(v: InputThemeVariant, st: InputState) -> InputVariantProps {
        if st == InputState.focused {
            return {
                background: Theme.color-surface,
                foreground: Theme.color-primary,
                placeholder-color: Theme.color-foreground-light,
                border-color: Theme.color-primary,
                border-color-error: Theme.color-danger,
            };
        }
        return {
            background: Theme.color-surface,
            foreground: Theme.color-primary,
            placeholder-color: Theme.color-foreground-light,
            border-color: Theme.color-border,
            border-color-error: Theme.color-danger,
        };
    }
    public pure function size(s: ControlSize) -> InputSizeProps {
        if s == ControlSize.sm {
            return {
                border-width: 1px,
                border-radius: Theme.control-radius-sm,
                padding-horizontal: Theme.control-padding-inline-sm,
                padding-vertical: Theme.spacing-sm,
                field-height: Theme.control-size-sm,
                font-size: Theme.font-size-sm,
                font-family: Theme.font-primary,
            };
        }
        if s == ControlSize.md {
            return {
                border-width: 1px,
                border-radius: Theme.control-radius-md,
                padding-horizontal: Theme.control-padding-inline-md,
                padding-vertical: 10px,
                field-height: Theme.control-size-md,
                font-size: Theme.font-size-md,
                font-family: Theme.font-primary,
            };
        }
        return {
            border-width: 1px,
            border-radius: Theme.control-radius-lg,
            padding-horizontal: Theme.control-padding-inline-lg,
            padding-vertical: Theme.spacing-md,
            field-height: Theme.control-size-lg,
            font-size: Theme.font-size-lg,
            font-family: Theme.font-primary,
        };
    }
}
