import { Theme, ControlSize } from "theme.slint";
import { InputTheme } from "input_theme.slint";

export enum InputVariant {
    default,
    filled,
    outlined,
}

export component Input {
    in-out property <string> value: "";
    in property <string> placeholder: "";
    in property <string> label: "";
    in property <InputVariant> variant: InputVariant.default;
    in property <ControlSize> size: ControlSize.md;
    in property <InputType> input-type: InputType.text;
    in property <TextHorizontalAlignment> text-alignment: TextHorizontalAlignment.left;
    in property <image> prefix-icon;
    in property <image> suffix-icon;
    in property <bool> clearable: false;
    in property <string> error: "";
    in property <bool> disabled: false;
    in property <bool> read-only: false;
    in property <bool> force-focused: false;

    // ===== THEMEABLE PROPS =====
    // Defaults follow the active theme; callers only set values they override.
    in property <color> background: root.disabled ? Theme.palette-secondary : themed-background();
    in property <color> foreground: root.disabled ? Theme.palette-muted : Theme.palette-foreground;
    in property <color> placeholder-color: Theme.palette-muted;
    in property <color> border-color: themed-border-color();
    in property <color> border-color-focus: Theme.palette-primary;
    in property <color> border-color-error: Theme.palette-danger;
    in property <color> label-color: root.disabled ? Theme.palette-muted : Theme.palette-muted;
    in property <length> border-width: root.has-focus ? 2px : 1px;
    in property <length> border-radius: InputTheme.size(root.size).border-radius;
    in property <length> padding-horizontal: InputTheme.size(root.size).padding-horizontal;
    in property <length> padding-vertical: InputTheme.size(root.size).padding-vertical;
    in property <length> field-height: InputTheme.size(root.size).field-height;
    in property <length> font-size: InputTheme.size(root.size).font-size;
    in property <string> font-family: InputTheme.size(root.size).font-family;
    in property <length> label-font-size: Theme.font-size-label;
    in property <int> label-font-weight: 500;
    in property <length> helper-font-size: Theme.font-size-helper;
    in property <length> field-spacing: 6px;
    in property <length> side-icon-size: max(20px, actual-font-size);

    out property <bool> has-focus: text-field.has-focus || root.force-focused;

    callback changed(string);
    callback submitted(string);
    callback focused();
    callback blurred();

    forward-focus: text-field;

    pure function themed-background() -> color {
        if root.variant == InputVariant.filled {
            return Theme.palette-secondary;
        }
        if root.variant == InputVariant.outlined {
            return transparent;
        }
        return Theme.palette-surface;
    }

    pure function themed-border-color() -> color {
        if root.variant == InputVariant.filled {
            return transparent;
        }
        return Theme.palette-border;
    }

    property <color> actual-background: root.background;
    property <color> actual-foreground: root.foreground;
    property <color> actual-placeholder-color: root.placeholder-color;
    property <color> actual-border-color-default: root.border-color;
    property <color> actual-border-color-focus: root.border-color-focus;
    property <color> actual-border-color-error: root.border-color-error;
    property <length> actual-border-width: root.border-width;
    // Clamp the requested radius to half the field height — a "radius-full"
    // token (often 9999px) would otherwise render the field as an ellipse
    // instead of a pill, since Slint's Rectangle does not auto-clamp like CSS.
    property <length> actual-border-radius:
        min(root.border-radius, actual-field-height / 2);
    property <length> actual-padding-horizontal: root.padding-horizontal;
    property <length> actual-padding-vertical: root.padding-vertical;
    property <length> actual-field-height: root.field-height;
    property <length> actual-font-size: root.font-size;
    property <string> actual-font-family: root.font-family;

    property <color> active-border-color:
        root.error != "" ? actual-border-color-error : root.has-focus ? actual-border-color-focus : actual-border-color-default;
    property <bool> show-clear-button:
        root.clearable && root.value != "" && !root.disabled && !root.read-only;
    property <length> icon-slot-size: max(side-icon-size, actual-field-height - 20px);
    property <length> helper-line-height: root.error != "" ? max(18px, helper-font-size + 2px) : 0px;
    property <length> label-line-height: root.label != "" ? max(18px, label-font-size + 2px) : 0px;

    preferred-width: 280px;
    preferred-height: label-line-height + actual-field-height + helper-line-height + (root.label != "" ? 6px : 0px) + (root.error != "" ? 6px : 0px);

    changed has-focus => {
        if (has-focus) {
            root.focused();
        } else {
            root.blurred();
        }
    }

    VerticalLayout {
        spacing: root.field-spacing;

        if root.label != "": Text {
            text: root.label;
            color: root.label-color;
            font-family: root.actual-font-family;
            font-size: root.label-font-size;
            font-weight: root.label-font-weight;
        }

        field-container := Rectangle {
            width: 100%;
            height: root.actual-field-height;
            preferred-height: root.actual-field-height;
            background: root.actual-background;
            border-color: root.active-border-color;
            border-width: root.actual-border-width;
            border-radius: root.actual-border-radius;
            property <length> slot-gap: 8px;
            property <bool> has-prefix-icon: root.prefix-icon.width > 0;
            property <bool> has-suffix-icon: root.suffix-icon.width > 0;
            property <length> prefix-slot-width: has-prefix-icon ? root.icon-slot-size + slot-gap : 0px;
            property <length> suffix-slot-width: has-suffix-icon ? root.icon-slot-size + slot-gap : 0px;
            property <length> clear-slot-width: root.show-clear-button ? root.icon-slot-size + slot-gap : 0px;
            property <length> content-left: root.actual-padding-horizontal + prefix-slot-width;
            property <length> content-right: root.actual-padding-horizontal + suffix-slot-width + clear-slot-width;
            property <length> content-width: max(0px, self.width - content-left - content-right);

            if self.has-prefix-icon: Rectangle {
                x: root.actual-padding-horizontal;
                y: 0px;
                width: root.icon-slot-size;
                height: parent.height;

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: root.side-icon-size;
                    height: root.side-icon-size;
                    source: root.prefix-icon;
                    colorize: root.actual-placeholder-color;
                }
            }

            Rectangle {
                x: field-container.content-left;
                y: 0px;
                width: field-container.content-width;
                height: parent.height;
                clip: true;

                if root.value == "" && text-field.preedit-text == "": Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.placeholder;
                    color: root.actual-placeholder-color;
                    font-family: root.actual-font-family;
                    font-size: root.actual-font-size;
                    horizontal-alignment: root.text-alignment;
                    vertical-alignment: center;
                    overflow: elide;
                }

                text-field := TextInput {
                    width: parent.width;
                    height: parent.height;
                    text <=> root.value;
                    color: root.actual-foreground;
                    font-family: root.actual-font-family;
                    font-size: root.actual-font-size;
                    horizontal-alignment: root.text-alignment;
                    vertical-alignment: center;
                    enabled: !root.disabled;
                    read-only: root.read-only;
                    input-type: root.input-type;

                    accepted => {
                        root.submitted(self.text);
                    }

                    edited => {
                        root.changed(self.text);
                    }
                }
            }

            if self.has-suffix-icon: Rectangle {
                x: parent.width - root.actual-padding-horizontal - root.icon-slot-size - field-container.clear-slot-width;
                y: 0px;
                width: root.icon-slot-size;
                height: parent.height;

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: root.side-icon-size;
                    height: root.side-icon-size;
                    source: root.suffix-icon;
                    colorize: root.actual-placeholder-color;
                }
            }

            if root.show-clear-button: Rectangle {
                x: parent.width - root.actual-padding-horizontal - root.icon-slot-size;
                y: 0px;
                width: root.icon-slot-size;
                height: parent.height;

                bubble := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: root.icon-slot-size;
                    height: root.icon-slot-size;
                    border-radius: self.width / 2;
                    background: transparent;

                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: root.side-icon-size;
                        height: root.side-icon-size;
                        source: @image-url("../../resources/icons/x.svg");
                        colorize: root.actual-placeholder-color;
                    }
                }

                clear-touch := TouchArea {
                    clicked => {
                        root.value = "";
                        root.changed("");
                        text-field.focus();
                    }
                }
            }
        }

        if root.error != "": Text {
            text: root.error;
            color: root.actual-border-color-error;
            font-family: root.actual-font-family;
            font-size: root.helper-font-size;
        }
    }
}
