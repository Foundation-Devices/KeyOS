import { MenuRow } from "menu.slint";
import { Theme, ControlSize } from "theme.slint";
import { MenuItemTheme, MenuItemSizeProps } from "@theme/menu_item_theme.slint";

export component MenuItem inherits MenuRow {
    in property <string> label: "";
    in property <string> subtitle: "";
    in property <ControlSize> size: ControlSize.md;
    in property <image> start-icon;
    in property <image> end-icon;
    in property <string> trailing-text: "";
    in property <bool> selected: false;
    in property <bool> destructive: false;
    in property <bool> disabled: false;
    in property <string> font-family: theme-size.font-family;
    in property <length> font-size: theme-size.font-size;
    in property <length> item-height: theme-size.item-height;
    in property <length> padding-horizontal: theme-size.padding-horizontal;
    in property <length> icon-size: theme-size.icon-size;
    property <MenuItemSizeProps> theme-size: MenuItemTheme.size(root.size);

    // ===== THEMEABLE PROPS =====
    // Defaults follow the active theme; callers only set values they override.
    in property <length> subtitle-font-size: Theme.font-size-subtitle;
    in property <length> trailing-font-size: root.actual-font-size;
    in property <color> label-color:
        root.disabled ? Theme.palette-muted : root.destructive ? Theme.palette-danger : Theme.palette-foreground;
    in property <color> accent-color:
        root.disabled ? Theme.palette-muted : root.destructive ? Theme.palette-danger : root.selected ? Theme.palette-primary : root.label-color;
    in property <color> secondary-color:
        root.disabled ? Theme.palette-muted : root.destructive ? Theme.palette-danger : Theme.palette-muted;
    in property <int> label-font-weight: root.selected ? 600 : 500;
    in property <int> subtitle-font-weight: 500;
    in property <int> trailing-font-weight: 500;
    in property <length> item-spacing: 12px;

    property <string> actual-font-family: root.font-family;
    property <length> actual-font-size: root.font-size;
    property <length> actual-item-height: root.item-height;
    property <length> actual-padding-horizontal: root.padding-horizontal;
    property <length> actual-icon-size: root.icon-size;
    property <length> content-gap: root.subtitle != "" ? 3px : 0px;
    property <bool> has-leading: root.start-icon.width > 0;
    property <bool> has-trailing: root.trailing-text != "" || root.end-icon.width > 0;

    interactive: true;
    row-disabled: root.disabled;
    divider: true;
    content-padding-horizontal: root.actual-padding-horizontal;
    preferred-width: 314px;
    preferred-height: max(root.actual-item-height, root.actual-icon-size + 20px);
    horizontal-stretch: 1;
    height: self.preferred-height;

    // NOTE: do NOT add invisible measurement Text elements at this level — MenuItem
    // inherits MenuRow, and any direct child of MenuItem is placed into MenuRow's
    // content VerticalLayout via @children. A sibling Text (even with visible:false)
    // contributes its preferred-height to the VerticalLayout, which silently shrinks
    // the visible HorizontalLayout's share of the row and clips the label text at
    // the top. If you need a measurement, nest it inside HorizontalLayout instead.

    Rectangle {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        background: transparent;

        if root.has-leading: Rectangle {
            x: 0px;
            width: root.actual-icon-size;
            height: parent.height;
            background: transparent;

            Image {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: root.actual-icon-size;
                height: root.actual-icon-size;
                source: root.start-icon;
                colorize: root.accent-color;
            }
        }

        trailing-content := HorizontalLayout {
            x: parent.width - self.width;
            y: 0px;
            width: root.has-trailing ? self.preferred-width : 0px;
            height: parent.height;
            spacing: root.trailing-text != "" && root.end-icon.width > 0 ? 10px : 0px;
            alignment: center;
            horizontal-stretch: 0;

            if root.trailing-text != "": Text {
                text: root.trailing-text;
                color: root.secondary-color;
                font-family: root.actual-font-family;
                font-size: root.trailing-font-size;
                font-weight: root.trailing-font-weight;
                vertical-alignment: center;
                horizontal-alignment: left;
            }

            if root.end-icon.width > 0: Rectangle {
                width: root.actual-icon-size;
                height: parent.height;
                background: transparent;

                Image {
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    width: root.actual-icon-size;
                    height: root.actual-icon-size;
                    source: root.end-icon;
                    colorize: root.accent-color;
                }
            }
        }

        text-column := VerticalLayout {
            x: root.has-leading ? root.actual-icon-size + root.item-spacing : 0px;
            width: max(0px, (root.has-trailing ? trailing-content.x - root.item-spacing : parent.width) - self.x);
            height: parent.height;
            spacing: root.content-gap;
            alignment: center;

            Text {
                text: root.label;
                color: root.accent-color;
                font-family: root.actual-font-family;
                font-size: root.actual-font-size;
                font-weight: root.label-font-weight;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                color: root.secondary-color;
                font-family: root.actual-font-family;
                font-size: root.subtitle-font-size;
                font-weight: root.subtitle-font-weight;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
