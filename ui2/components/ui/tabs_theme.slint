// GENERATED from tabs.json by foundation theme tooling — do not edit by hand.
// Token-backed props reference the shared Theme global; JSON literals are inlined.

import { Theme, ControlSize } from "theme.slint";

export struct TabsSizeProps {
    font-family: string,
    font-size: length,
    control-height: length,
    tab-padding-horizontal: length,
    icon-size: length,
    tab-gap: length,
    list-padding: length,
    panel-padding: length,
    panel-min-height: length,
    border-radius: length,
}

export global TabsTheme {
    in-out property <TabsSizeProps> size-sm: {
        font-family: Theme.font-primary,
        font-size: Theme.font-size-sm,
        control-height: Theme.control-size-sm,
        tab-padding-horizontal: Theme.control-padding-inline-sm,
        icon-size: 18px,
        tab-gap: 2px,
        list-padding: 4px,
        panel-padding: 16px,
        panel-min-height: 88px,
        border-radius: Theme.radius-default,
    };
    in-out property <TabsSizeProps> size-md: {
        font-family: Theme.font-primary,
        font-size: Theme.font-size-md,
        control-height: Theme.control-size-md,
        tab-padding-horizontal: Theme.control-padding-inline-md,
        icon-size: 20px,
        tab-gap: 2px,
        list-padding: 4px,
        panel-padding: 20px,
        panel-min-height: 104px,
        border-radius: Theme.radius-default,
    };
    in-out property <TabsSizeProps> size-lg: {
        font-family: Theme.font-primary,
        font-size: Theme.font-size-lg,
        control-height: Theme.control-size-lg,
        tab-padding-horizontal: Theme.control-padding-inline-lg,
        icon-size: 24px,
        tab-gap: 2px,
        list-padding: 4px,
        panel-padding: 24px,
        panel-min-height: 120px,
        border-radius: Theme.radius-default,
    };

    public pure function size(s: ControlSize) -> TabsSizeProps {
        if s == ControlSize.sm {
            return self.size-sm;
        }
        if s == ControlSize.lg {
            return self.size-lg;
        }
        return self.size-md;
    }
}
