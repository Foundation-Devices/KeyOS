// GENERATED from menu.schema.json by foundation theme tooling — do not edit by hand.
// Token-backed props reference the shared Theme global; JSON literals are inlined.

import { Theme, ControlSize } from "theme.slint";

export enum MenuState {
    normal,
}

export struct MenuVariantProps {
    menu-background: color,
    menu-border-color: color,
    menu-border-width: length,
}

export struct MenuSizeProps {
    menu-height: length,
    menu-border-radius: length,
    menu-padding: length,
}

export global MenuTheme {
    public pure function style(st: MenuState) -> MenuVariantProps {
        return {
            menu-background: Theme.color-surface,
            menu-border-color: Theme.color-border,
            menu-border-width: 1px,
        };
    }
    public pure function size(s: ControlSize) -> MenuSizeProps {
        if s == ControlSize.sm {
            return {
                menu-height: 148px,
                menu-border-radius: Theme.control-radius-sm,
                menu-padding: 0px,
            };
        }
        if s == ControlSize.md {
            return {
                menu-height: 172px,
                menu-border-radius: Theme.control-radius-md,
                menu-padding: 0px,
            };
        }
        return {
            menu-height: 196px,
            menu-border-radius: Theme.control-radius-lg,
            menu-padding: 0px,
        };
    }
}
