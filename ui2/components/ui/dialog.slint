import { Theme, ControlSize } from "theme.slint";
import { DialogTheme, DialogSizeProps } from "@theme/dialog_theme.slint";

export enum DialogVariant {
    default,
    danger,
}

export component Dialog {
    in property <bool> open: true;
    in property <ControlSize> size: ControlSize.md;
    in property <DialogVariant> variant: DialogVariant.default;
    in property <bool> fill-container: false;
    in property <bool> dismissable: true;
    in property <string> font-family: theme-size.font-family;
    in property <length> font-size: theme-size.font-size;
    in property <length> panel-width: theme-size.panel-width;
    in property <length> panel-padding: theme-size.panel-padding;
    in property <length> icon-size: theme-size.icon-size;
    in property <length> border-radius: theme-size.border-radius;
    property <DialogSizeProps> theme-size: DialogTheme.size(root.size);

    // ===== THEMEABLE PROPS =====
    // Defaults follow the active theme; callers only set values they override.
    in property <color> accent-color:
        root.variant == DialogVariant.danger ? Theme.palette-danger : Theme.palette-primary;
    in property <color> backdrop-color:
        Theme.palette-foreground.with-alpha(Theme.is-dark ? 0.72 : 0.24);
    in property <color> panel-background: Theme.palette-surface;
    in property <color> panel-border-color: root.variant == DialogVariant.danger ? root.accent-color.with-alpha(Theme.is-dark ? 0.7 : 0.42) : Theme.palette-border;
    in property <length> panel-border-width: 1px;
    in property <color> icon-circle-background: root.accent-color.with-alpha(Theme.is-dark ? 0.18 : 0.12);
    in property <color> title-color: Theme.palette-foreground;
    in property <length> title-font-size: Theme.font-size-title;
    in property <int> title-font-weight: 700;
    in property <color> message-color: Theme.palette-muted;
    in property <color> separator-color: Theme.palette-border.with-alpha(0.75);
    in property <length> close-button-size: 28px;
    in property <length> close-icon-size: 16px;
    in property <color> close-icon-color: Theme.palette-muted;

    callback dismissed();

    property <string> actual-font-family: root.font-family;
    property <length> actual-font-size: root.font-size;
    property <length> actual-panel-width:
        root.fill-container ? max(280px, root.width - 32px) : min(root.panel-width, max(280px, root.width - 32px));
    property <length> actual-panel-padding: root.panel-padding;
    property <length> actual-icon-size: root.icon-size;
    property <length> actual-border-radius: root.border-radius;

    preferred-width: 420px;
    preferred-height: 320px;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.open ? root.backdrop-color : transparent;

        if root.open && root.dismissable: backdrop-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                root.dismissed();
            }
        }

        panel := Rectangle {
            visible: root.open;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.actual-panel-width;
            height: content.preferred-height;
            background: root.panel-background;
            border-color: root.panel-border-color;
            border-width: root.panel-border-width;
            border-radius: root.actual-border-radius;
            clip: true;

            panel-touch-blocker := TouchArea {
                width: parent.width;
                height: parent.height;
            }

            content := VerticalLayout {
                padding-left: root.actual-panel-padding;
                padding-right: root.actual-panel-padding;
                padding-top: root.actual-panel-padding;
                padding-bottom: root.actual-panel-padding;
                spacing: 16px;

                @children
            }

            if root.dismissable: Rectangle {
                x: parent.width - root.actual-panel-padding - self.width;
                y: root.actual-panel-padding;
                width: root.close-button-size;
                height: root.close-button-size;
                border-radius: self.width / 2;
                background: transparent;

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: root.close-icon-size;
                    height: root.close-icon-size;
                    source: @image-url("../../resources/icons/x.svg");
                    colorize: root.close-icon-color;
                }

                dismiss-touch := TouchArea {
                    clicked => {
                        root.dismissed();
                    }
                }
            }
        }
    }
}
