            message-color: Theme.color-foreground,
            separator-color: Theme.color-border,
            close-icon-color: Theme.color-muted,
        };
    }
    public pure function size(s: ControlSize) -> DialogSizeProps {
        if s == ControlSize.sm {
            return {
                font-family: Theme.font-primary,
                font-size: Theme.font-size-sm,
                panel-width: 360px,
                panel-padding: Theme.icon-size-sm,
                icon-size: Theme.control-radius-sm,
                border-radius: 20px,
                title-font-size: 14px,
                close-button-size: 14px,
                close-icon-size: 14px,
            };
        }
        if s == ControlSize.md {
            return {
                font-family: Theme.font-primary,
                font-size: Theme.font-size-md,
                panel-width: 420px,
                panel-padding: Theme.icon-size-md,
                icon-size: Theme.control-radius-md,
                border-radius: Theme.radius-default,
                title-font-size: 14px,
                close-button-size: 14px,
                close-icon-size: 14px,
            };
        }
        return {
            font-family: Theme.font-primary,
            font-size: Theme.font-size-lg,
            panel-width: 480px,
            panel-padding: Theme.icon-size-lg,
            icon-size: Theme.control-radius-lg,
            border-radius: 28px,
            title-font-size: 14px,
