export global DialogTheme {
    public pure function style(st: DialogState) -> DialogVariantProps {
        return {
            accent-color: Theme.color-primary,
            backdrop-color: Theme.color-foreground,
            panel-background: Theme.color-surface,
            panel-border-color: Theme.color-border,
            panel-border-width: 1px,
            icon-circle-background: Theme.color-secondary,
            title-color: Theme.color-foreground,
