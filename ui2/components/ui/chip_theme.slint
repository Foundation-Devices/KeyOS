// GENERATED from chip.schema.json by foundation theme tooling — do not edit by hand.
// Token-backed props reference the shared Theme global; JSON literals are inlined.

import { Theme, ControlSize } from "theme.slint";

export enum ChipThemeVariant {
    filled,
    outlined,
    soft,
}

export enum ChipState {
    normal,
    focused,
    pressed,
    disabled,
}

export struct ChipVariantProps {
    background: color,
    foreground: color,
    border-color: color,
}

export struct ChipSizeProps {
    border-width: length,
    border-radius: length,
    padding-horizontal: length,
    padding-vertical: length,
    font-size: length,
    font-family: string,
    icon-size: length,
}

export global ChipTheme {
    public pure function style(v: ChipThemeVariant, st: ChipState) -> ChipVariantProps {
        if v == ChipThemeVariant.filled {
            if st == ChipState.focused {
                return {
                    background: Theme.color-primary,
                    foreground: Theme.color-white,
                    border-color: Theme.color-primary,
                };
            }
            if st == ChipState.pressed {
                return {
                    background: Theme.color-primary-dark,
                    foreground: Theme.color-white,
                    border-color: Theme.color-transparent,
                };
            }
            return {
                background: Theme.color-primary,
                foreground: Theme.color-white,
                border-color: Theme.color-transparent,
            };
        }
        if v == ChipThemeVariant.outlined {
            if st == ChipState.pressed {
                return {
                    background: Theme.color-transparent,
                    foreground: Theme.color-primary-dark,
                    border-color: Theme.color-primary-dark,
                };
            }
            return {
                background: Theme.color-transparent,
                foreground: Theme.color-primary,
                border-color: Theme.color-primary,
            };
        }
        if st == ChipState.focused {
            return {
                background: Theme.color-secondary,
                foreground: Theme.color-primary,
                border-color: Theme.color-primary,
            };
        }
        if st == ChipState.pressed {
            return {
                background: Theme.color-secondary,
                foreground: Theme.color-primary-dark,
                border-color: Theme.color-transparent,
            };
        }
        return {
            background: Theme.color-secondary,
            foreground: Theme.color-primary,
            border-color: Theme.color-transparent,
        };
    }
    public pure function size(s: ControlSize) -> ChipSizeProps {
        if s == ControlSize.sm {
            return {
                border-width: 1px,
                border-radius: Theme.radius-default,
                padding-horizontal: 8px,
                padding-vertical: 6px,
                font-size: 12px,
                font-family: Theme.font-primary,
                icon-size: 12px,
            };
        }
        if s == ControlSize.md {
            return {
                border-width: 1px,
                border-radius: Theme.radius-default,
                padding-horizontal: 10px,
                padding-vertical: 7px,
                font-size: 14px,
                font-family: Theme.font-primary,
                icon-size: 14px,
            };
        }
        return {
            border-width: 1px,
            border-radius: Theme.radius-default,
            padding-horizontal: 12px,
            padding-vertical: 8px,
            font-size: 16px,
            font-family: Theme.font-primary,
            icon-size: 16px,
        };
    }
}
