import { Theme, ControlSize } from "theme.slint";
import { SheetTheme } from "sheet_theme.slint";

export component Sheet {
    in property <bool> open: true;
    in property <string> title: "";
    in property <string> body: "";
    in property <ControlSize> size: ControlSize.md;
    in property <bool> show-handle: true;
    in property <bool> dismissable: true;
    in property <[float]> detents: [0.4, 0.72, 0.92];
    in-out property <int> selected-detent: 1;
    in property <string> font-family: SheetTheme.size(root.size).font-family;
    in property <length> font-size: SheetTheme.size(root.size).font-size;
    in property <length> panel-padding: SheetTheme.size(root.size).panel-padding;
    in property <length> content-padding: SheetTheme.size(root.size).content-padding;
    in property <length> border-radius: SheetTheme.size(root.size).border-radius;
    in property <length> handle-width: SheetTheme.size(root.size).handle-width;

    // ===== THEMEABLE PROPS =====
    // Defaults follow the active theme; callers only set values they override.
    in property <color> overlay-color: root.open ? Theme.palette-foreground.with-alpha(Theme.is-dark ? 0.64 : 0.18) : transparent;
    in property <color> panel-background: Theme.palette-surface;
    in property <color> panel-border-color: Theme.palette-border;
    in property <length> panel-border-width: 1px;
    in property <color> handle-color: Theme.palette-border;
    in property <length> handle-height: 6px;
    in property <length> handle-radius: 3px;
    in property <color> title-color: Theme.palette-foreground;
    in property <length> title-font-size: Theme.font-size-title;
    in property <int> title-font-weight: 700;
    in property <color> body-color: Theme.palette-muted;
    in property <length> close-size: 28px;
    in property <length> close-radius: 14px;
    in property <color> close-background: transparent;
    in property <length> close-icon-size: 16px;
    in property <color> close-icon-color: Theme.palette-muted;
    in property <length> divider-height: 1px;
    in property <color> divider-color: Theme.palette-border.with-alpha(0.75);
    in property <color> detent-card-background: Theme.palette-secondary.with-alpha(Theme.is-dark ? 0.34 : 0.52);
    in property <length> detent-card-radius: 24px;
    in property <color> detent-label-color: Theme.palette-muted;
    in property <length> detent-label-font-size: Theme.font-size-label;
    in property <int> detent-label-font-weight: 600;
    in property <color> detent-value-color: Theme.palette-foreground;
    in property <length> detent-value-font-size: root.actual-font-size + 2px;
    in property <int> detent-value-font-weight: 600;
    in property <color> detent-helper-color: Theme.palette-muted;

    callback dismissed();
    callback detent-changed(int);

    property <string> actual-font-family: root.font-family;
    property <length> actual-font-size: root.font-size;
    property <length> actual-panel-padding: root.panel-padding;
    property <length> actual-content-padding: root.content-padding;
    property <length> actual-border-radius: root.border-radius;
    property <length> actual-handle-width: root.handle-width;
    property <float> active-detent:
        root.selected-detent >= 0 && root.selected-detent < root.detents.length ? root.detents[root.selected-detent] : 0.72;
    property <length> sheet-height: max(180px, root.height * root.active-detent);

    preferred-width: 420px;
    preferred-height: 420px;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.overlay-color;

        if root.open && root.dismissable: overlay-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                root.dismissed();
            }
        }

        if root.open: panel := Rectangle {
            x: 0px;
            y: parent.height - self.height;
            width: parent.width;
            height: root.sheet-height;
            background: root.panel-background;
            border-color: root.panel-border-color;
            border-width: root.panel-border-width;
            border-top-left-radius: root.actual-border-radius;
            border-top-right-radius: root.actual-border-radius;
            border-bottom-left-radius: 0px;
            border-bottom-right-radius: 0px;
            clip: true;

            VerticalLayout {
                padding-left: root.actual-panel-padding;
                padding-right: root.actual-panel-padding;
                padding-top: root.actual-panel-padding - 6px;
                padding-bottom: root.actual-panel-padding;
                spacing: 14px;

                if root.show-handle: HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: root.actual-handle-width;
                        height: root.handle-height;
                        border-radius: root.handle-radius;
                        background: root.handle-color;

                        TouchArea {
                            clicked => {
                                if root.detents.length > 1 {
                                    if root.selected-detent + 1 < root.detents.length {
                                        root.selected-detent = root.selected-detent + 1;
                                    } else {
                                        root.selected-detent = 0;
                                    }
                                    root.detent-changed(root.selected-detent);
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;

                        if root.title != "": Text {
                            text: root.title;
                            color: root.title-color;
                            font-family: root.actual-font-family;
                            font-size: root.title-font-size;
                            font-weight: root.title-font-weight;
                            wrap: word-wrap;
                        }

                        if root.body != "": Text {
                            text: root.body;
                            color: root.body-color;
                            font-family: root.actual-font-family;
                            font-size: root.actual-font-size;
                            wrap: word-wrap;
                        }
                    }

                    if root.dismissable: Rectangle {
                        width: root.close-size;
                        height: root.close-size;
                        border-radius: root.close-radius;
                        background: root.close-background;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: root.close-icon-size;
                            height: root.close-icon-size;
                            source: @image-url("../../resources/icons/x.svg");
                            colorize: root.close-icon-color;
                        }

                        close-touch := TouchArea {
                            clicked => {
                                root.dismissed();
                            }
                        }
                    }
                }

                Rectangle {
                    height: root.divider-height;
                    background: root.divider-color;
                }

                Rectangle {
                    background: root.detent-card-background;
                    border-radius: root.detent-card-radius;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 10px;

                        Text {
                            text: "Current detent";
                            color: root.detent-label-color;
                            font-family: root.actual-font-family;
                            font-size: root.detent-label-font-size;
                            font-weight: root.detent-label-font-weight;
                        }

                        Text {
                            text: root.selected-detent == 0 ? "Compact" : root.selected-detent == 1 ? "Comfortable" : "Expanded";
                            color: root.detent-value-color;
                            font-family: root.actual-font-family;
                            font-size: root.detent-value-font-size;
                            font-weight: root.detent-value-font-weight;
                        }

                        Text {
                            text: "Click the handle to cycle through the configured stops.";
                            color: root.detent-helper-color;
                            font-family: root.actual-font-family;
                            font-size: root.actual-font-size;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
