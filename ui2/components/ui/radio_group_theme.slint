// GENERATED from radio_group.json by foundation theme tooling — do not edit by hand.
// Token-backed props reference the shared Theme global; JSON literals are inlined.

import { Theme, ControlSize } from "theme.slint";

export struct RadioGroupSizeProps {
    font-family: string,
    font-size: length,
    control-size: length,
    row-height: length,
    item-gap: length,
}

export global RadioGroupTheme {
    in-out property <RadioGroupSizeProps> size-sm: {
        font-family: Theme.font-primary,
        font-size: Theme.font-size-sm,
        control-size: 24px,
        row-height: Theme.control-size-sm,
        item-gap: 10px,
    };
    in-out property <RadioGroupSizeProps> size-md: {
        font-family: Theme.font-primary,
        font-size: Theme.font-size-md,
        control-size: 28px,
        row-height: Theme.control-size-md,
        item-gap: 12px,
    };
    in-out property <RadioGroupSizeProps> size-lg: {
        font-family: Theme.font-primary,
        font-size: Theme.font-size-lg,
        control-size: 32px,
        row-height: Theme.control-size-lg,
        item-gap: 14px,
    };

    public pure function size(s: ControlSize) -> RadioGroupSizeProps {
        if s == ControlSize.sm {
            return self.size-sm;
        }
        if s == ControlSize.lg {
            return self.size-lg;
        }
        return self.size-md;
    }
}
