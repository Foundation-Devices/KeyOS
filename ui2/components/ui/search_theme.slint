// GENERATED from search.json by foundation theme tooling — do not edit by hand.
// Token-backed props reference the shared Theme global; JSON literals are inlined.

import { Theme, ControlSize } from "theme.slint";

export struct SearchSizeProps {
    border-width: length,
    border-radius: length,
    padding-horizontal: length,
    padding-vertical: length,
    field-height: length,
    font-size: length,
    font-family: string,
}

export global SearchTheme {
    in-out property <SearchSizeProps> size-sm: {
        border-width: 1px,
        border-radius: Theme.control-radius-sm,
        padding-horizontal: Theme.control-padding-inline-sm,
        padding-vertical: Theme.spacing-sm,
        field-height: Theme.control-size-sm,
        font-size: Theme.font-size-sm,
        font-family: Theme.font-primary,
    };
    in-out property <SearchSizeProps> size-md: {
        border-width: 1px,
        border-radius: Theme.control-radius-md,
        padding-horizontal: Theme.control-padding-inline-md,
        padding-vertical: 10px,
        field-height: Theme.control-size-md,
        font-size: Theme.font-size-md,
        font-family: Theme.font-primary,
    };
    in-out property <SearchSizeProps> size-lg: {
        border-width: 1px,
        border-radius: Theme.control-radius-lg,
        padding-horizontal: Theme.control-padding-inline-lg,
        padding-vertical: Theme.spacing-md,
        field-height: Theme.control-size-lg,
        font-size: Theme.font-size-lg,
        font-family: Theme.font-primary,
    };

    public pure function size(s: ControlSize) -> SearchSizeProps {
        if s == ControlSize.sm {
            return self.size-sm;
        }
        if s == ControlSize.lg {
            return self.size-lg;
        }
        return self.size-md;
    }
}
