import { Theme, ControlSize } from "theme.slint";
import {
    CheckboxTheme,
    CheckboxVariantProps,
    CheckboxSizeProps,
    CheckboxState,
} from "@theme/checkbox_theme.slint";

export component Checkbox {
    in property <string> label: "";
    in property <string> description: "";
    in property <ControlSize> size: ControlSize.md;
    in-out property <bool> checked: false;
    in-out property <bool> indeterminate: false;
    in property <bool> disabled: false;

    // ===== THEMEABLE PROPS =====
    // Defaults follow the active theme; callers only set values they override.
    in property <string> font-family: theme-size.font-family;
    in property <length> font-size: theme-size.font-size;
    in property <length> control-size: theme-size.control-size;
    in property <length> row-height: theme-size.row-height;
    in property <length> description-font-size: theme-size.description-font-size;
    in property <color> checked-background: theme-style.checked-background;
    in property <color> checked-border-color: theme-style.checked-border-color;
    in property <length> checked-border-width: theme-style.checked-border-width;
    in property <color> box-background: theme-style.box-background;
    in property <color> box-border-color: theme-style.box-border-color;
    in property <length> box-border-width: theme-style.box-border-width;
    in property <length> box-border-radius: theme-size.box-border-radius;
    in property <color> mark-color: theme-style.mark-color;
    in property <color> label-color: theme-style.label-color;
    in property <color> description-color: theme-style.description-color;

    callback changed(bool);

    property <string> actual-font-family: root.font-family;
    property <length> actual-font-size: root.font-size;
    property <length> actual-box-size: root.control-size;
    property <length> actual-row-height: root.row-height;
    property <bool> active: root.checked || root.indeterminate;
    property <color> actual-box-background:
        root.active ? root.checked-background : root.box-background;
    property <color> actual-box-border-color:
        root.active ? root.checked-border-color : root.box-border-color;
    property <length> actual-box-border-width:
        root.active ? root.checked-border-width : root.box-border-width;
    property <CheckboxState> current-state: root.disabled ? CheckboxState.disabled : CheckboxState.normal;
    property <CheckboxVariantProps> theme-style: CheckboxTheme.style(root.current-state);
    property <CheckboxSizeProps> theme-size: CheckboxTheme.size(root.size);

    preferred-width: content-row.preferred-width;
    preferred-height: max(actual-row-height, text-column.preferred-height);
    width: self.preferred-width;
    height: self.preferred-height;

    content-row := HorizontalLayout {
        width: root.width;
        height: root.height;
        spacing: 10px;
        alignment: center;

        // Center the box within the (taller) touch row so it lines up with the label.
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: root.actual-box-size;
                height: root.actual-box-size;
                border-radius: root.box-border-radius;
                background: root.actual-box-background;
                border-color: root.actual-box-border-color;
                border-width: root.actual-box-border-width;

                if root.indeterminate: Rectangle {
                    x: max(3px, parent.width * 0.22);
                    y: (parent.height - self.height) / 2;
                    width: max(6px, parent.width * 0.56);
                    height: max(2px, parent.height * 0.12);
                    border-radius: 1px;
                    background: root.mark-color;
                }

                if root.checked && !root.indeterminate: Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: max(10px, parent.width * 0.66);
                    height: max(10px, parent.height * 0.66);
                    source: @image-url("../../resources/icons/check.svg");
                    colorize: root.mark-color;
                }
            }
        }

        text-column := VerticalLayout {
            alignment: center;
            spacing: root.description != "" ? 2px : 0px;

            if root.label != "": Text {
                text: root.label;
                color: root.label-color;
                font-family: root.actual-font-family;
                font-size: root.actual-font-size;
                vertical-alignment: center;
            }

            if root.description != "": Text {
                text: root.description;
                color: root.description-color;
                font-family: root.actual-font-family;
                font-size: root.description-font-size;
                overflow: elide;
            }
        }
    }

    TouchArea {
        width: root.width;
        height: root.height;
        enabled: !root.disabled;

        clicked => {
            if (root.indeterminate) {
                root.indeterminate = false;
                root.checked = true;
            } else {
                root.checked = !root.checked;
            }
            root.changed(root.checked);
        }
    }
}
