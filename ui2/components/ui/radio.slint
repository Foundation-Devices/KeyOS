import { Theme, ControlSize } from "theme.slint";
import {
    RadioTheme,
    RadioVariantProps,
    RadioSizeProps,
    RadioState,
} from "@theme/radio_theme.slint";

export component Radio {
    in property <string> label: "";
    in property <string> description: "";
    in property <ControlSize> size: ControlSize.md;
    in-out property <bool> checked: false;
    in property <bool> disabled: false;
    in property <bool> manage-checked-state: true;
    in property <string> font-family: theme-size.font-family;
    in property <length> font-size: theme-size.font-size;
    in property <length> control-size: theme-size.control-size;
    in property <length> row-height: theme-size.row-height;

    // ===== THEMEABLE PROPS =====
    // Defaults follow the active theme; callers only set values they override.
    in property <length> description-font-size: theme-size.description-font-size;
    in property <color> accent-color: theme-style.accent-color;
    in property <color> box-background: theme-style.box-background;
    in property <color> box-border-color: root.checked ? root.accent-color : theme-style.box-border-color;
    in property <length> box-border-width: root.checked ? 2px : theme-style.box-border-width;
    in property <color> dot-color: theme-style.dot-color;
    in property <color> label-color: theme-style.label-color;
    in property <color> description-color: theme-style.description-color;

    callback changed(bool);

    property <string> actual-font-family: root.font-family;
    property <length> actual-font-size: root.font-size;
    property <length> actual-control-size: root.control-size;
    property <length> actual-row-height: root.row-height;
    property <RadioState> current-state: root.disabled ? RadioState.disabled : RadioState.normal;
    property <RadioVariantProps> theme-style: RadioTheme.style(root.current-state);
    property <RadioSizeProps> theme-size: RadioTheme.size(root.size);

    preferred-width: content-row.preferred-width;
    preferred-height: max(actual-row-height, text-column.preferred-height);
    width: self.preferred-width;
    height: self.preferred-height;

    content-row := HorizontalLayout {
        width: root.width;
        height: root.height;
        spacing: 10px;
        alignment: start;

        // Center the dot within the (taller) touch row so it lines up with the label.
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: root.actual-control-size;
                height: root.actual-control-size;
                border-radius: root.actual-control-size / 2;
                background: root.box-background;
                border-color: root.box-border-color;
                border-width: root.box-border-width;

                if root.checked: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: max(6px, parent.width * 0.44);
                    height: max(6px, parent.height * 0.44);
                    border-radius: self.width / 2;
                    background: root.dot-color;
                }
            }
        }

        text-column := VerticalLayout {
            alignment: center;
            spacing: root.description != "" ? 2px : 0px;

            if root.label != "": Text {
                text: root.label;
                color: root.label-color;
                font-family: root.actual-font-family;
                font-size: root.actual-font-size;
                vertical-alignment: center;
            }

            if root.description != "": Text {
                text: root.description;
                color: root.description-color;
                font-family: root.actual-font-family;
                font-size: root.description-font-size;
                overflow: elide;
            }
        }
    }

    TouchArea {
        width: root.width;
        height: root.height;
        enabled: !root.disabled;

        clicked => {
            if (!root.checked) {
                if (root.manage-checked-state) {
                    root.checked = true;
                }
                root.changed(true);
            }
        }
    }
}
