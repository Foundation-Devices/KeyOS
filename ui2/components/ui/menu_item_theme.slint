import { Theme, ControlSize } from "theme.slint";

export enum MenuItemState {
    normal,
    pressed,
    disabled,
}

export struct MenuItemVariantProps {
    label-color: color,
    accent-color: color,
    secondary-color: color,
    label-font-weight: int,
    subtitle-font-weight: int,
    trailing-font-weight: int,
}

export struct MenuItemSizeProps {
    font-family: string,
    font-size: length,
    item-height: length,
    padding-horizontal: length,
    icon-size: length,
    subtitle-font-size: length,
    trailing-font-size: length,
}

export global MenuItemTheme {
    public pure function style(st: MenuItemState) -> MenuItemVariantProps {
        return {
            label-color: Theme.color-foreground,
            accent-color: Theme.color-primary,
            secondary-color: Theme.color-muted,
            label-font-weight: Theme.font-weight-medium,
            subtitle-font-weight: Theme.font-weight-medium,
            trailing-font-weight: Theme.font-weight-medium,
        };
    }
    public pure function size(s: ControlSize) -> MenuItemSizeProps {
        if s == ControlSize.sm {
            return {
                font-family: Theme.font-primary,
                font-size: Theme.font-size-sm,
                item-height: 56px,
                padding-horizontal: Theme.control-padding-inline-sm,
                icon-size: Theme.icon-size-sm,
                subtitle-font-size: 14px,
                trailing-font-size: 14px,
            };
        }
        if s == ControlSize.md {
            return {
                font-family: Theme.font-primary,
                font-size: Theme.font-size-md,
                item-height: 64px,
                padding-horizontal: Theme.control-padding-inline-md,
                icon-size: Theme.icon-size-md,
                subtitle-font-size: 14px,
                trailing-font-size: 14px,
            };
        }
        return {
            font-family: Theme.font-primary,
            font-size: Theme.font-size-lg,
            item-height: 72px,
            padding-horizontal: Theme.control-padding-inline-lg,
            icon-size: Theme.icon-size-lg,
            subtitle-font-size: 14px,
            trailing-font-size: 14px,
        };
    }
}
