// GENERATED from progress_bar.json by foundation theme tooling — do not edit by hand.
// Token-backed props reference the shared Theme global; JSON literals are inlined.

import { Theme, ControlSize } from "theme.slint";

export struct ProgressBarSizeProps {
    font-family: string,
    font-size: length,
    label-gap: length,
    bar-height: length,
    border-radius: length,
}

export global ProgressBarTheme {
    in-out property <ProgressBarSizeProps> size-sm: {
        font-family: Theme.font-primary,
        font-size: 12px,
        label-gap: 6px,
        bar-height: 8px,
        border-radius: 999px,
    };
    in-out property <ProgressBarSizeProps> size-md: {
        font-family: Theme.font-primary,
        font-size: 13px,
        label-gap: 8px,
        bar-height: 10px,
        border-radius: 999px,
    };
    in-out property <ProgressBarSizeProps> size-lg: {
        font-family: Theme.font-primary,
        font-size: 14px,
        label-gap: 10px,
        bar-height: 12px,
        border-radius: 999px,
    };

    public pure function size(s: ControlSize) -> ProgressBarSizeProps {
        if s == ControlSize.sm {
            return self.size-sm;
        }
        if s == ControlSize.lg {
            return self.size-lg;
        }
        return self.size-md;
    }
}
