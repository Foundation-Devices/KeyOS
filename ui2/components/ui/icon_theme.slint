// GENERATED from icon.schema.json by foundation theme tooling — do not edit by hand.
// Token-backed props reference the shared Theme global; JSON literals are inlined.

import { Theme, ControlSize } from "theme.slint";

export enum IconState {
    normal,
}

export struct IconVariantProps {
    icon-color: color,
}

export struct IconSizeProps {
    icon-size: length,
}

export global IconTheme {
    public pure function style(st: IconState) -> IconVariantProps {
        return {
            icon-color: Theme.color-foreground,
        };
    }
    public pure function size(s: ControlSize) -> IconSizeProps {
        if s == ControlSize.sm {
            return {
                icon-size: 16px,
            };
        }
        if s == ControlSize.md {
            return {
                icon-size: Theme.icon-size-sm,
            };
        }
        return {
            icon-size: Theme.icon-size-md,
        };
    }
}
