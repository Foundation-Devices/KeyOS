// GENERATED from icon.json by foundation theme tooling — do not edit by hand.
// Token-backed props reference the shared Theme global; JSON literals are inlined.

import { Theme, ControlSize } from "theme.slint";

export struct IconSizeProps {
    icon-size: length,
}

export global IconTheme {
    in-out property <IconSizeProps> size-sm: {
        icon-size: 16px,
    };
    in-out property <IconSizeProps> size-md: {
        icon-size: 20px,
    };
    in-out property <IconSizeProps> size-lg: {
        icon-size: 24px,
    };

    public pure function size(s: ControlSize) -> IconSizeProps {
        if s == ControlSize.sm {
            return self.size-sm;
        }
        if s == ControlSize.lg {
            return self.size-lg;
        }
        return self.size-md;
    }
}
