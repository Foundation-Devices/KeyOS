# Passport Prime — USB composite device (HID + CDC-ACM + vendor debug + mass storage)
SUBSYSTEM=="usb", ATTRS{idVendor}=="1307", ATTRS{idProduct}=="0165", MODE="0666", TAG+="uaccess"

# Passport Prime — legacy mode (Flux apps change the USB identity)
SUBSYSTEM=="usb", ATTRS{idVendor}=="2c97", ATTRS{idProduct}=="7011", MODE="0666", TAG+="uaccess"

# Passport Prime — SAM-BA bootloader mode
SUBSYSTEM=="usb", ATTRS{idVendor}=="03eb", ATTRS{idProduct}=="6124", MODE="0666", TAG+="uaccess"
